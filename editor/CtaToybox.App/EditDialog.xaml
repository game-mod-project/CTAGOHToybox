<Window x:Class="CtaToybox.App.EditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="값 고치기" Width="760" Height="560" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Malgun Gothic" FontSize="13">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="KeyText" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"/>
      <TextBlock x:Name="ContextText" Foreground="#555555" TextWrapping="Wrap"/>
      <TextBlock x:Name="NoteText" TextWrapping="Wrap" Margin="0,6,0,6"/>
      <TextBlock x:Name="OriginText" Foreground="#666666" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <DockPanel Margin="0,10,0,0">
        <Button x:Name="RemoveButton" DockPanel.Dock="Left" Content="이 줄의 수정 지우기 (원래 값으로)" Padding="8,3" Click="Remove_Click"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="OkButton" Content="수정 목록에 넣기" Padding="14,3" IsDefault="True" Click="Ok_Click"/>
          <Button Content="취소" Width="70" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
      </DockPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="새 값" FontWeight="Bold" Margin="0,10,0,2"/>
      <TextBlock Foreground="#666666" FontSize="12" TextWrapping="Wrap" Text="바꿀 값만 고친다. 문자열 값은 따옴표 없이 쓰면 원래 형태로 넣는다. 원래 값으로 되돌리면 그 값의 수정은 지운다."/>
      <StackPanel x:Name="ValuesPanel" Margin="0,4,0,0"/>
      <StackPanel x:Name="ScopePanel" Margin="0,10,0,0">
        <TextBlock Text="어디에 적용할까" FontWeight="Bold"/>
        <RadioButton x:Name="SharedRadio" IsChecked="True" Checked="Scope_Changed" Margin="0,3,0,0"/>
        <RadioButton x:Name="UnitRadio" Content="이 유닛만 (같은 파일을 쓰는 다른 유닛은 그대로)" Checked="Scope_Changed" Margin="0,3,0,0"/>
        <TextBlock x:Name="BlockerText" Foreground="#B00020" TextWrapping="Wrap" Margin="20,0,0,0"/>
        <Expander x:Name="UsersExpander" Margin="0,6,0,0">
          <ListBox x:Name="UsersList" MaxHeight="160"/>
        </Expander>
      </StackPanel>
    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
