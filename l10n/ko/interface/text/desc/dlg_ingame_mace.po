msgctxt "actionbar/littledavid"
msgid "Place 36-inch Little David"
msgstr "36인치 리틀 데이비드 설치"

msgctxt "actionbar/deploy_weapon1"
msgid "Place Down Type 99 Smoke Candle"
msgstr "Type 99 연막통 설치"

msgctxt "actionbar/deploy_weapon1/usage"
msgid "After clicking this button, click and drag on the map to define the position for placing down the smoke grenade."
msgstr "이 단추를 누른 뒤 지도에서 끌어 연막탄을 놓을 위치를 정한다."

msgctxt "actionbar/deploy_weapon2"
msgid "Place Down 10kg Smoke Candle"
msgstr "10kg 연막통 설치"

msgctxt "actionbar/deploy_weapon2/usage"
msgid "After clicking this button, click and drag on the map to define the position for placing down the smoke grenade."
msgstr "이 단추를 누른 뒤 지도에서 끌어 연막탄을 놓을 위치를 정한다."

msgctxt "actionbar/littledavid/usage"
msgid "After clicking this button, click and drag on the map to define the position for building a coastal gun emplacement. Upgrade by clicking on concrete pad again with engineers, <c(F44336)>REMEMBER the gun cannot turn</c>"
msgstr "이 단추를 누른 뒤 지도에서 끌어 해안포 진지를 지을 위치를 정한다. 공병으로 콘크리트 받침을 다시 눌러 강화한다. <c(F44336)>포는 회전하지 않는다</c>"

msgctxt "actionbar/ammo_switch_normal"
msgid "Switch to AP/HE"
msgstr "AP/HE로 전환"

msgctxt "actionbar/ammo_switch_normal/usage"
msgid "Click this button to switch between firing modes: Fire Only AP/HE."
msgstr "이 단추를 눌러 사격 방식을 전환한다: AP/HE만 사격."

msgctxt "actionbar/ammo_switch_heat"
msgid "Switch to HEAT"
msgstr "HEAT로 전환"

msgctxt "actionbar/ammo_switch_heat/usage"
msgid "Click this button to switch between firing modes: Fire Only HEAT."
msgstr "이 단추를 눌러 사격 방식을 전환한다: HEAT만 발사."

msgctxt "actionbar/smine_decoy"
msgid "S-Mine Screen"
msgstr "S-Mine 연막"

msgctxt "actionbar/toggle_back_mg"
msgid "Enable/Disable Side/Back MG"
msgstr "측면/후방 기관총 켜기/끄기"

msgctxt "actionbar/toggle_back_mg/usage"
msgid "Click this button to enable or disable the Side/Back mg's"
msgstr "이 단추를 눌러 측면/후방 기관총을 켜거나 끈다."

msgctxt "main_menu2/dynamic_campaign/region_hint_Ostfront_Talvisota_West"
msgid "Ostfront Maps + Talsivota Maps + Western Europe - (All Maps)"
msgstr "동부전선 지도 + 겨울전쟁 지도 + 서유럽 - (모든 지도)"

msgctxt "actionbar/jap_type21_buildable"
msgid "Place Rocket Pod emplacement"
msgstr "로켓 포좌 설치"

msgctxt "actionbar/jap_type21_buildable/usage"
msgid "After clicking this button, click and drag on the map to define the position for the field cannon. Remember that it is static, cannot move and has min and max range."
msgstr "이 단추를 누른 뒤 지도에서 끌어 야포의 위치를 정한다. 고정식이라 움직일 수 없고 최소·최대 사거리가 있다는 점을 기억하라."

msgctxt "actionbar/swe_gun_buildable/action"
msgid "Place Rocket Pod emplacement"
msgstr "로켓 포좌 설치"

msgctxt "actionbar/jap_type21_buildable"
msgid "Place Field Gun emplacement"
msgstr "야포 포좌 설치"

msgctxt "actionbar/swe_gun_buildable/usage"
msgid "After clicking this button, click and drag on the map to define the position for the field cannon. Remember that it is static and cannot move."
msgstr "이 단추를 누른 뒤 지도에서 끌어 야포의 위치를 정한다. 고정식이라 움직일 수 없다는 점을 기억하라."

msgctxt "actionbar/swe_gun_buildable/action"
msgid "Place field gun emplacement"
msgstr "야포 포좌 설치"

