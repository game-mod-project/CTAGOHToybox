msgctxt "mp/game/ammunition"
msgid "Domination"
msgstr "도미네이션"

msgctxt "mp/game/ammunition/rules"
msgid "Domination"
msgstr "도미네이션"

msgctxt "mp/game/ammunition/objective"
msgid ""
msgstr ""

msgid "Destroy as many enemy targets as possible! Fortify and Protect your HQ at all costs. Lead cautious raids to apply pressure on the front line."
msgstr "가능한 한 많은 적 목표를 파괴하라! 본부를 요새화해 어떻게든 지켜라. 신중하게 기습해 전선에 압박을 가하라."

msgctxt "mp/game/ammunition/info"
msgid "\nInflict as many losses to the enemy as possible. \nProtect your field HQ at all costs. \nCapture designated points to seize the initiative!"
msgstr "\n적에게 가능한 한 많은 손실을 입혀라. \n야전 본부를 어떻게든 지켜라. \n지정된 지점을 점령해 주도권을 잡아라!"

msgctxt "mp/game/text/ammunition_base_won"
msgid "You have captured the enemy outpost!"
msgstr "적 전초기지를 점령했습니다!"

msgctxt "mp/game/text/ammunition_base_lost"
msgid "The enemy has captured our outpost!"
msgstr "적이 아군 전초기지를 점령했다!"

msgctxt "mp/game/text/ammunition_point_enabled"
msgid "High command requests to secure a strategic position!"
msgstr "사령부가 전략 거점 확보를 요청한다!"

msgctxt "mp/game/text/ammunition_point_lost"
msgid "<f(arial_hq)c(FFFFFF)s(8)>The enemy forces raided the strategic location and received additional reinforcements!"
msgstr "<f(arial_hq)c(FFFFFF)s(8)>적군이 전략 거점을 급습해 추가 증원을 받았다!"

msgctxt "mp/game/text/ammunition_point_won"
msgid "<f(arial_hq)c(FFFFFF)s(8)>Your forces have captured the strategic position and receive additional reinforcements!"
msgstr "<f(arial_hq)c(FFFFFF)s(8)>아군이 전략 거점을 점령해 추가 증원을 받는다!"
