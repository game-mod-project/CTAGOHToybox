msgctxt "mission/single/04-usa/1944_12_hill400/capture400"
msgid "Capture Hill 400!"
msgstr "400 고지를 점령하라!"

msgctxt "mission/single/04-usa/1944_12_hill400/doctrine_allround"
msgid "Doctrine: All-Round"
msgstr "교리: 전방위"

msgctxt "mission/single/04-usa/1944_12_hill400/doctrine_defensive"
msgid "Doctrine: Defensive"
msgstr "교리: 방어"

msgctxt "mission/single/04-usa/1944_12_hill400/doctrine_irregular"
msgid "Doctrine: Irregular"
msgstr "교리: 비정규"

