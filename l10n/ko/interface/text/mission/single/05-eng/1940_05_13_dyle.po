msgstr "<c(B29557)>[방어]</c> Light Tank Mk. VIb"

msgctxt "mission/single/05-eng/1940_05_13_dyle/ui/reinf_doc_irregular"
msgid "<c(B29557)>[Irregular]</c> Signaller"
msgstr "<c(B29557)>[비정규]</c> 통신병"

msgctxt "mission/single/05-eng/1940_05_13_dyle/ui/reinf_doc_offensive"
msgid "<c(B29557)>[Offensive]</c> Matilda II"
msgstr "<c(B29557)>[공격]</c> Matilda II"

msgctxt "mission/single/05-eng/1940_05_13_dyle/ui/reinf_gren"
msgid "Rifle grenadier"
msgstr "소총 유탄병"

msgctxt "mission/single/05-eng/1940_05_13_dyle/ui/reinf_skip_preparation"
msgid "Skip preparation"
msgstr "준비 생략"

msgctxt "mission/single/05-eng/1940_05_13_dyle/ui/timer_preparation"
msgid "Prepare your defensive lines"
msgstr "방어선을 준비하라"

msgctxt "mission/single/05-eng/1940_05_13_dyle/ui/timer_truck"
msgid "Evacuation truck arrival"
msgstr "후송 트럭 도착"

msgctxt "mission/single/05-eng/1940_05_13_dyle/mission_option_select1"
msgid "Select your Doctrine for the mission.\nIt affects available units list and objectives."
msgstr "임무에 쓸 교리를 선택하라.\n사용 가능한 유닛 목록과 목표에 영향을 준다."

msgctxt "mission/single/05-eng/1940_05_13_dyle/doctrine_allround"
msgid "All-Round: BL 6-inch howitzer"
msgstr "종합: BL 6인치 곡사포"

