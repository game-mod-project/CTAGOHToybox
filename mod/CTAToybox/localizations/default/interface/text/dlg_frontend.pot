msgctxt "promo/upgrade_to_full"
msgid "Call to Arms를 플레이해 주셔서 감사합니다. 지금까지 즐거우셨기를 바랍니다!\n\n아래에서 훌륭한 업그레이드 옵션을 찾아보십시오. 더 많은 진영, 싱글플레이어와 협동 지원, 워크숍 콘텐츠, 커스텀 에디터 전투, 모든 진영의 즉시 이용을 즐기십시오!"
msgstr ""

msgctxt "promo/upgrade_to_deluxe"
msgid "Call to Arms 기본판을 소유해 주셔서 감사합니다!\n\n디럭스 에디션이나 얼티밋 에디션으로 업그레이드해 더 많은 콘텐츠와 추가 혜택과 함께 게임을 즐기십시오!"
msgstr ""

msgctxt "promo/upgrade_to_ultimate"
msgid "Call to Arms 디럭스 에디션을 소유해 주셔서 감사합니다!\n\n시즌 패스로 얼티밋 에디션으로 업그레이드해 더 많은 협동 캠페인과 신규 진영 선행 이용을 즐겨 보시는 것은 어떨까요?"
msgstr ""

msgctxt "announce_sale_text"
msgid "Call to Arms가 현재 할인 중입니다!\n\n오늘 패키지를 좋은 가격에 업그레이드할 수 있습니다.\n즉시 유닛 해금, 싱글플레이어와 협동 콘텐츠, 워크숍 지원 등을 즐기십시오!"
msgstr ""

msgctxt "announce_sale_xmas_text"
msgid "즐거운 연휴 보내세요!\n\n모든 Call to Arms 업그레이드 패키지와 게임 내 아이템이 현재 파격 할인 중입니다. 나 자신이나 친구에게 작은 선물을 하기에 딱 좋은 때입니다.\n\n즐거운 시간 보내시고, 사랑하는 이들과 함께하는 시간을 만끽하십시오!"
msgstr ""

msgctxt "announce_appeal"
msgid "플레이어 여러분께!"
msgstr ""

msgctxt "feedback_text"
msgid "친애하는 병사에게,\n\nCall to Arms에 참여해 주셔서 감사합니다. 보내 주신 모든 기여에 감사하는 뜻으로 동성 훈장을 수여합니다. 축하합니다!\n\n독립 개발 스튜디오인 저희에게는 여러분의 의견이 무엇보다 중요합니다. 아직 남기지 않으셨다면 좋은 리뷰를 남겨 주시기를 부탁드립니다. 게임에서 가장 마음에 드는 점에 대한 소중한 의견과 생각을 듣고 싶습니다. 게임을 알게 되는 사람이 많을수록 모두를 위해 더 좋은 게임을 만들 수 있다는 점을 기억해 주십시오.\n\n감사합니다. 전장에서 행운을 빕니다!\n"
msgstr ""

msgctxt "feedback_text3"
msgid "친애하는 병사에게,\n\nCall to Arms에 참여해 주셔서 감사합니다. 보내 주신 모든 기여에 감사하는 뜻으로 금성 훈장을 수여합니다. 축하합니다!\n\n독립 개발 스튜디오인 저희에게는 여러분의 의견이 무엇보다 중요합니다. 아직 남기지 않으셨다면 좋은 리뷰를 남겨 주시기를 부탁드립니다. 게임에서 가장 마음에 드는 점에 대한 소중한 의견과 생각을 듣고 싶습니다. 게임을 알게 되는 사람이 많을수록 모두를 위해 더 좋은 게임을 만들 수 있다는 점을 기억해 주십시오.\n\n감사합니다. 전장에서 행운을 빕니다!\n"
