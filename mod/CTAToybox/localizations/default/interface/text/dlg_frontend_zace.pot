msgctxt "main_menu2/dynamic_campaign/hint_difficulty_easy"
msgid "쉬움 난이도: \n• 적 보병 체력 대폭 감소 \n• 모든 적 유닛 무기 명중률 대폭 감소 \n• 적 수류탄 투척 빈도 감소 \n• 플레이어 보병 체력 대폭 증가 \n• 아군 AI 보병 체력 증가 \n• 처음 엿새 동안은 복엽기만 등장 (Mace)"
msgstr ""

msgctxt "main_menu2/dynamic_campaign/hint_difficulty_normal"
msgid "보통 난이도: \n• 적 보병 체력 감소 \n• 모든 적 유닛 무기 명중률 감소 \n• 그 밖의 능력치는 기본값 \n• 처음 엿새 동안은 복엽기만 등장 (Mace)"
msgstr ""

msgctxt "main_menu2/dynamic_campaign/hint_difficulty_hard"
msgid "어려움 난이도: \n• 적 보병 체력 감소 \n• 모든 적 유닛 무기 명중률 소폭 감소 \n• 그 밖의 능력치는 기본값 \n• 처음 엿새 동안은 복엽기만 등장 (Mace)"
msgstr ""

msgctxt "main_menu2/dynamic_campaign/hint_difficulty_heroic"
msgid "하드코어 난이도: \n• 적 보병 체력 소폭 감소 \n• 그 밖의 능력치는 기본값 \n• 모든 임무에서 항공기 등장 가능 \n• 공습은 정찰 비행 없이 목표를 바로 폭격 (Mace)"
msgstr ""

