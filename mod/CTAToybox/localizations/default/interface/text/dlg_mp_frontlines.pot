msgctxt "mp/game/frontlines"
msgid "프런트라인"
msgstr ""

msgctxt "mp/game/frontlines/info"
msgid "\n한 군대가 상대 팀의 방어 진지를 공격한다. \n영토를 두고 싸워 적에게 최대한 많은 손실을 입혀라!"
msgstr ""

msgctxt "mp/game/frontlines/rules"
msgid "프런트라인\n\n프런트라인은 공격과 방어 시나리오입니다. A팀이 공격하고 B팀이 방어합니다. 공격팀의 목표는 제한 시간 안에 모든 방어선을 점령하는 것입니다. 방어팀의 목표는 이 방어선을 지키는 것입니다. 각 방어선은 깃발 묶음으로 표시되며, 방어선이 무너지려면 모든 깃발을 점령해야 합니다. 모든 방어선이 점령되면 게임이 끝나고 공격팀이 승리합니다. 적 병력을 처치하고 공방 효율에 따라 점수를 얻습니다. 게임이 끝났을 때 가장 좋은 성과를 낸 팀이 승리합니다."
msgstr ""

msgctxt "mp/game/frontlines/objective/a"
msgid "시간이 다 되기 전에 적 방어선을 모두 점령하라."
msgstr ""

msgctxt "mp/game/frontlines/objective/b"
msgid "시간이 끝날 때까지 방어선에서 적을 막아라."
msgstr ""

