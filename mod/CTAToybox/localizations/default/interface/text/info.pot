msgctxt "info/squad/squad_light(ger)"
msgid "경보병 분대"
msgstr ""

msgctxt "info/squad/snipers(usa)"
msgid "저격수는 소총으로 안전한 거리에서 적 병력을 제거하고, 소총에 달린 조준경으로 숨어 있는 적 파괴 공작원을 찾아낸다. 위장이 저격수의 주된 무기다. 그래서 조준경이 달린 Springfield 소총 외에 투척용 칼과 위장용 덤불을 여러 개 갖고 다닌다."
msgstr ""

msgctxt "info/squad/mp_squad_shock(rus)"
msgid "돌격 보병"
msgstr ""

msgctxt "info/squad/mp_squad_reserve(ger)"
msgid "예비대"
msgstr ""

msgctxt "info/squad/mp_single_rifleaut(ger)"
msgid "반자동 보병"
msgstr ""

msgctxt "info/mk8"
msgid "가장 널리 쓰인 영국 순항 전차의 하나로, 1943년 1월에 양산에 들어간 Crusader 전차의 개량형이다. 포탑에 장착된 75mm 포로는 최신 독일 전차의 전면 장갑을 뚫을 수 없었지만, Mk.VIII Cromwell은 속도와 기동성 덕에 전차병들의 신뢰를 얻었다. 적 영토 깊숙이 빠르게 돌파하고 전략적 주도권을 뒷받침하도록 설계된 전차다."
msgstr ""

msgctxt "info/squad/mp_squad_guards(rus)"
msgid "전선의 한 사단이 계속되는 전투에서 용맹한 전과를 거두면 소련군 최고사령부는 그 사단에 소련 근위대라는 명예로운 지위를 내렸다. 근위 사단은 작전 계획에서 우선순위를 받았고 대체로 장비도 더 좋았다. <c(DB465A)>소련 근위 사단은 일반 보병보다 전투 경험이 많고 장비가 좋으며, 분대에 제압용 기관총을 갖추고 있다.</c>"
msgstr ""

msgctxt "info/squad/riflemans(ger)"
msgid "병사 여섯 명으로 이루어진 분대로, 저마다 대인 수류탄 두 발과 Mauser 소총으로 무장했다. 소총의 긴 사거리 덕에 중거리와 장거리에서 가장 효과적이다. 그러나 Mauser는 장탄수가 적고 발사 속도가 느려, 근거리에서는 기관단총수와 돌격 보병의 손쉬운 표적이 된다."
msgstr ""

msgctxt "info/squad/mp_single_rifle(ger)"
msgid "소총수"
msgstr ""

msgctxt "info/squad/mp_squad_paratrooper(rus)"
msgid "전쟁 초기 소련 공수부대는 겨울 전쟁과 여러 차례의 적진 후방 작전에서 활약했다. 그래서 파괴 공작, 암살, 전투 등 다재다능한 작전을 수행하도록 훈련받았다. <c(DB465A)>소련 공수부대는 파괴 공작과 전선 전투의 절충안이다. 반쯤 은밀하게 움직이며 강력한 폭약 가방과 화염병을 들고 다니지만, 중근거리 교전용 경량 반자동 무기도 갖췄다. 또한 더 빨리 질주할 수 있어 신속한 치고 빠지기를 할 수 있다. 잠재력을 최대한 끌어내려면 세밀한 직접 조작이 필요하다.</c>"
msgstr ""

msgctxt "info/universal_carrier_rus"
msgid "유니버설 캐리어는 (잘못된 이름이지만) Bren 건 캐리어로도 알려진, Vickers-암스트롱이 만든 경장갑 궤도 차량 계열을 가리키는 통칭이다. 1934년부터 1960년까지 생산되어 제2차 세계 대전 중 영연방군이 널리 사용했다. 주로 병력과 장비, 특히 지원 화기를 나르거나 기관총 거치대로 쓰였다. 영국과 해외에서 약 11만 3천 대가 생산되어 역사상 가장 많이 만들어진 장갑 전투 차량이다"
msgstr ""

msgctxt "info/entity/gmc_art"
msgid "이 트럭의 적재함에는 철갑탄과 고폭탄, 이를 담는 상자, 수리 키트가 들어 있다. \n 이 군용 트럭은 민간용 ACX-353을 개량한 것이다. 전쟁 중에는 화물 수송과 병력 이동, 포 견인에 쓰였다. 일부 개량형은 유조차로도 쓸 수 있었다."
msgstr ""

msgctxt "info/squad/mp_single_medic(ger)"
msgid "위생병"
msgstr ""

msgctxt "info/squad/mp_squad_heavy(ger)"
msgid "일반 보병"
msgstr ""

msgctxt "info/squad/mp_single_engineer(ger)"
msgid "야전 공병"
msgstr ""

msgctxt "info/pz6e"
msgid "1942년 독일군에 배치되어 1943년 말까지 최고의 전차로 평가받았다. 소련의 45mm 포는 Tiger의 장갑을 근거리에서도 뚫지 못했지만, Tiger의 88mm 포는 당시 어떤 전차든 파괴할 수 있었다."
msgstr ""

msgctxt "info/squad/homeguard(usa)"
msgid "미국 민병대"
msgstr ""

msgctxt "info/squad/mp_single_smg(ger)"
msgid "MP-40 병사"
msgstr ""

msgctxt "info/squad/at_miners(usa)"
msgid "대전차 지뢰밭은 주로 아군 병력 배치 구역을 적 차량과 전차로부터 지키려고 설치하며, 점령한 진지 앞이나 측면 방어에 쓴다. 지뢰 매설 전문가 네 명으로 이루어진 이 분대는 Thompson 기관단총으로 무장했고, 지뢰밭을 빠르게 깔아 분쟁 지역이나 전략적 요충지를 지킬 수 있다."
msgstr ""

msgctxt "info/squad/mp_single_mg(ger)"
msgid "기관총 분견대"
msgstr ""

msgctxt "info/squad/flamers(eng)"
msgid "화염방사기를 든 병사는 건물 안의 보병에게 큰 피해를 주고 혼자서 한 구역의 적을 소탕할 수도 있다. 그러나 가연성 액체를 다 쓰고 나면 무장이 없는 상태가 되고, 유탄 한 발이 연료통을 맞히면 폭발하기 때문에 극도로 취약하다. 그래서 전투 부대에는 호위용 기관단총수 몇 명이 함께 편성된다."
msgstr ""

msgctxt "info/squad/ap_miners(ger)"
msgid "대전차 지뢰밭은 주로 아군 병력 배치 구역을 적 차량과 전차로부터 지키려고 설치하며, 점령한 진지 앞이나 측면 방어에 쓴다. 지뢰 매설 전문가 네 명으로 이루어진 이 분대는 MP-40 기관단총으로 무장했고, 지뢰밭을 빠르게 깔아 분쟁 지역이나 전략적 요충지를 지킬 수 있다."
msgstr ""

msgctxt "info/squad/mp_single_at_miner(ger)"
msgid "대전차 지뢰밭은 주로 아군 병력 배치 구역을 적 차량과 전차로부터 지키려고 설치하며, 점령한 진지 앞이나 측면 방어에 쓴다. 지뢰 매설 전문가 네 명으로 이루어진 이 분대는 MP-40 기관단총으로 무장했고, 지뢰밭을 빠르게 깔아 분쟁 지역이나 전략적 요충지를 지킬 수 있다."
msgstr ""

msgctxt "info/squad/mp_single_ap_miner(ger)"
msgid "AP 지뢰병"
msgstr ""

msgctxt "info/squad/bazookers(usa)"
msgid "휴대용 대전차 로켓 발사기 Bazooka는 적 장비를 상대하려고 설계되었으며, 능숙하게 쓰면 어떤 전차든 무력화할 수 있다. 고폭탄 탄두의 위력은 거리에 따라 줄지 않지만, 로켓 발사기는 여전히 근거리와 중거리에서 가장 효율적이다. Bazooka로 먼 거리의 목표를 맞히기는 매우 어렵다. 로켓 발사기를 든 보병은 극도로 취약하므로, 전투 부대에는 그를 호위하고 엄호하는 기관단총수가 포함된다."
msgstr ""

msgctxt "info/squad/mp_single_at(ger)"
msgid "대전차 분견대"
msgstr ""

msgctxt "info/squad/mp_single_engineer(rus)"
msgid "야전 공병"
msgstr ""

msgctxt "info/squad/mp_single_at_44(ger)"
msgid "대전차 분견대"
msgstr ""

msgctxt "info/squad/mp_single_medic(rus)"
msgid "위생병"
msgstr ""

msgctxt "info/squad/mp_single_flamer(ger)"
msgid "화염방사병"
msgstr ""

msgctxt "info/squad/at_rifle(eng)"
msgid "영국의 대전차 소총 보이즈 AT는 1937년 11월에 채택되었다. 60그램짜리 탄환이 최대 15mm 장갑을 뚫을 정도로 살상력이 낮아 경장갑 목표에만 쓰였다. 이 소총으로는 중전차나 중형 전차를 파괴할 수 없었고, 궤도를 끊거나 포를 손상시키는 데 그쳤다."
msgstr ""

msgctxt "info/vickers"
msgid "잘 알려지지 않은 물건이다."
msgstr ""

msgctxt "info/squad/scouts(rus)"
msgid "파괴 공작원은 잘 훈련된 병사로, 혼자서도 적에게 치명적인 피해를 줄 수 있다. 덤불이나 높은 풀숲에 숨어 포복하면 거의 보이지 않는다. 소음기 달린 권총과 투척용 칼 몇 자루, 소이 수류탄, 그리고 가장 무거운 전차도 고철 더미로 만들 만큼 강력한 폭약을 갖고 있다."
msgstr ""

msgctxt "info/squad/mp_single_sniper(ger)"
msgid "저격수"
msgstr ""

msgctxt "info/squad/mp_single_officer(ger)"
msgid "장교"
msgstr ""

msgctxt "info/squad/mp_squad_basic(rus)"
msgid "경보병은 제2차 세계 대전 중 소련이 서둘러 병력을 모집하고 배치할 때 뼈대가 된 부대다. <c(DB465A)>분대장은 기관단총과 수류탄 몇 발을 들고, 일반 분대원은 평범한 소총을 든다.</c>]"
msgstr ""

msgctxt "info/squad/mp_squad_volkssturm(ger)"
msgid "국민돌격대는 소량의 탄약과 값싼 무기, 악명 높은 Panzerfaust 대전차 성형작약 로켓을 지급받은 민간인들로, 조국의 마지막 방어선 역할을 맡았다. 약했지만 전쟁 말기 독일로 진격하는 적에게 의미 있는 피해를 입혔다. 지휘권은 SS와 나치 정치 인사들이 쥐고 있어 효율적인 전투 병력으로서의 잠재력이 크게 떨어졌다.<c(DB465A)> 절박한 상황에서 쓸 마지막 수단으로는 좋지만, 이 병력에게 기적을 기대하지는 마라.</c>"
msgstr ""

msgctxt "info/vickers_mgun"
msgid "Vickers 중기관총은 1912년 영국에서 유명한 Maxim 기관총을 개량해 등장했으며, 영국군이 1960년대까지 사용했다. 원거리에서 뛰어난 발사 속도를 냈지만, 무거워서 운반이 어려웠다."
msgstr ""

msgctxt "info/squad/mp_single_mg(rus)"
msgid "기관총 분견대"
msgstr ""

msgctxt "info/squad/mp_squad_pioneer(ger)"
msgid "공병 분대는 국방군 보병 돌격의 선봉으로, 최고사령부의 큰 존경과 찬사를 받았다. <c(DB465A)>화염방사기와 수류탄, 그 밖의 폭파 장비를 들고 다닌다. 전문 분야는 적 전선의 방어 시설을 정면에서 상대하는 것이다. 개활지를 지나 적 거점에 다다르기만 하면 폭파가 시작되면서 대혼란이 번질 것이다."
msgstr ""

msgctxt "info/squad/mp_squad_basic(ger)"
msgid "경보병"
msgstr ""

msgctxt "info/mk4"
msgid "새 보병 지원 전차의 첫 양산형이 1941년 6월에 나왔다. 빠르게 구식이 되어 가던 Mk.II 「Matilda」를 대체할 설계였으나, 개발 기간이 짧아 여러 결함을 안은 채 양산에 들어갔다. 차체가 낮고 장갑이 두꺼웠지만 지나치게 약한 무장이 이 장점을 상쇄했다. 이후 개량으로 75mm 포를 새로 달았어도 대전차 능력은 나아지지 않아 Mk.IV는 보병 지원 차량의 역할에 머물렀다."
msgstr ""

msgctxt "info/squad/mp_squad_militia(rus)"
msgid "독일이 소련을 침공할 당시 국경은 종종 국경 민병대가 지키고 있었다. 이들은 군에 속했지만 정규군만큼 훈련받거나 무장하지 못했고, 민간 복장을 한 이들도 있었다.<c(DB465A)>수류탄도 자동화기도 없이 소총만 든 단순한 무장이라 중거리와 장거리 교전에는 쓸 만하지만, 적의 정예 보병과 맞붙도록 훈련받지는 않았다. 방어선의 빈틈을 메우는 데 전략적으로 활용하라. 값과 CP가 낮아 쉽게 투입할 수 있다.</c>]"
msgstr ""

msgctxt "info/squad/bazookers(eng)"
msgid "1942년 영국은 효과가 떨어지는 대전차 소총을 대체하려고 자체 대전차 로켓 발사기를 생산하기 시작했다. PIAT에서 발사된 성형작약탄은 120mm 장갑판도 태워 뚫을 수 있어 거의 모든 적 차량을 파괴할 수 있었다. 먼 거리에서는 명중률이 크게 떨어졌기에 로켓 발사기는 근거리와 중거리에서 가장 효과적이었다. 로켓 발사기를 든 보병은 매우 취약했으므로, 이 분대에도 그를 엄호하는 기관단총수가 포함되었다."
msgstr ""

msgctxt "info/squad/mp_single_flamer(rus)"
msgid "화염방사병"
msgstr ""

msgctxt "info/squad/officer(rus)"
msgid "전장에 노련한 장교가 있으면 어떤 전투의 흐름도 바꿀 수 있다. 야전 쌍안경으로 덤불과 높은 풀숲에 숨은 적 보병과 파괴 공작원을 찾아낸다. 또 먼 곳의 적 유닛을 발견해 미리 재편성하고 대응할 수 있게 해 준다. 쌍안경 외에 칼과 Nagant 권총도 지니지만, 이 무기들은 격렬한 전투에는 알맞지 않다."
msgstr ""

msgctxt "info/squad/mp_squad_luftwaffe(ger)"
msgid "공군 야전 부대는 국방군의 전선을 지원하고 전투 지역의 비행장을 지상 습격으로부터 지키려고 투입되었다. <c(DB465A)>가장 강인한 병사들은 아니고 다른 정예처럼 훈련받지도 않았지만, 장비 면에서는 놀랄 만큼 치명적이다. 적 차량과 항공기에 맞설 대전차 무기, 그리고 항공기용에서 가져온 MG15 기관총으로 더없이 정확한 제압 사격을 한다. 방어용으로 훌륭한 부대다.</c>"
msgstr ""

msgctxt "info/squad/mp_squad_sturm_p(ger)"
msgid "돌격공병은 기갑병과(기갑 병과) 지휘 아래 있는 차량화 공병다. <c(DB465A)>Hanomag에 탑승해 이동한다.</c>"
msgstr ""

msgctxt "info/squad/at_miners(ger)"
msgid "대전차 지뢰밭은 주로 아군 병력 배치 지점을 지키려고 설치하며, 점령한 진지 앞에, 때로는 측면에 둔다. 지뢰 매설 전문가 네 명으로 이루어진 이 분대는 MP-40 기관단총으로 무장했고, 장애물 선을 빠르게 깔아 분쟁 지역이나 전략적 요충지를 지킬 수 있다."
msgstr ""

msgctxt "info/squad/tankmans(ger)"
msgid "전차의 효율은 무엇보다 승무원의 단결력과 어떤 상황에서도 일관되게 행동하는 능력에 달려 있다. 가장 강력하고 위험한 기계도 조종하는 사람이 갑자기 사라지면 고철 더미일 뿐이다. 전차 승무원을 훈련할 때는 모든 승무원이 서로의 임무를 익히는 교차 훈련이 핵심이다. 승무원이 한 명만 살아남아도 전차가 전투 능력을 유지해야 하기 때문이다... \n 전차병은 소형 MP-40 기관단총으로 무장했지만 전투 훈련을 받지 않아 극도로 취약하다."
msgstr ""

msgctxt "info/squad/mp_squad_brandenburger(ger)"
msgid "브란덴부르거 특공대는 외국어, 전투, 폭파 임무에 훈련된 은밀 부대였다. 전쟁 중 다리 폭파와 적 파괴 공작에서부터 적 영토의 도로 표지판 방향을 모조리 바꿔 적을 혼란에 빠뜨리는 일까지, 가장 위험한 잠입 임무에 투입되었다. <c(DB465A)>폭파 장비와 좋은 무기를 갖췄고, 빠르게 달리며 은밀하다.</c>"
msgstr ""

msgctxt "info/squad/mp_squad_fallschirmjaeger(ger)"
msgid "강하엽병(공수부대)는 독일군에서 전투 훈련이 가장 잘된 부대로 평가받았으며, 전쟁 중 에방에말 요새 강습, 크레타 점령, 몬테카시노 방어 같은 작전을 도맡아 수행했다. 크레타를 점령한 뒤 히틀러는 정예를 너무 많이 잃을 것을 우려해 대규모 공수 작전을 더는 하지 말라고 명령했다.<c(DB465A)> 만능에 가까운 견실한 부대로, 분대에 기관총 사수부터 저격수까지 편성되어 있다. 전쟁 말기에는 FG-42 자동 소총과 Panzerfaust를 갖춰 더욱 치명적이 되었다.</c>"
msgstr ""

msgctxt "info/squad/mp_squad_gebirgsjaeger(ger)"
msgid "독일의 산악엽병은 가장 험난한 지형과 위험한 상황에서 적과 맞설 수 있도록 준비된 산악 부대였다. 휴식 없이 먼 거리를 이동하도록 훈련받은 것이 비할 데 없는 강점이다. 어디로 보내든 에델바이스 휘장을 단 채 신속하게 도착해 전투 태세를 갖춘다.<c(DB465A)> 더 가벼운 소총을 갖췄고, 주력 병사는 이중 탄통을 단 MG34를 들어 재장전할 때마다 두 배의 탄약을 쏟아붓는다.</c>"
msgstr ""

msgctxt "info/squad/at_miners(rus)"
msgid "대전차 지뢰밭은 주로 아군 병력 배치 구역을 적 차량과 전차로부터 지키려고 설치하며, 점령한 진지 앞이나 측면 방어에 쓴다. 지뢰 매설 전문가 네 명으로 이루어진 이 분대는 PPSh 기관단총으로 무장했고, 지뢰밭을 빠르게 깔아 분쟁 지역이나 전략적 요충지를 지킬 수 있다."
msgstr ""

msgctxt "info/entity/machinegewehr_34_no_bipod_belt"
msgid "MG-34는 1934년 국방군에 배치되어 휴대용, 거치형, 대공용, 전차용으로 쓰였다. 삼각대에 올린 기관총은 지상 목표와 공중 목표를 모두 사격할 수 있었다. 발사 속도는 서방의 경쟁 기종을 능가했지만, 연속 사격을 하면 총열이 금세 과열되었다."
msgstr ""

msgctxt "info/squad/mp_squad_ss_grenadiers(ger)"
msgid "SS 척탄병은 전쟁 말기 독일군의 믿을 만한 주력이었고 어떤 명령이든 받을 준비가 되어 있었다. 1944~45년의 신병 SS 부대는 훈련이 부족했지만, 독일 산업이 서둘러 만든 최고의 무장, 곧 STG-44 돌격 소총과 Panzerfaust 대전차 무기를 받아 전투에 미치는 영향이 컸다. <c(DB465A)>공격하고, 지속 사격으로 진지를 지키고, 적 전차를 파괴할 수 있는 다재다능한 소규모 분대다.</c>"
msgstr ""

msgctxt "info/squad/mp_single_tankman(rus)"
msgid "전차 승무원"
msgstr ""

msgctxt "info/squad/mp_single_rifle(rus)"
msgid "소총수"
msgstr ""

msgctxt "info/squad/mp_single_smg(rus)"
msgid "PPSh 병사"
msgstr ""

msgctxt "info/squad/mp_single_rifleauto(rus)"
msgid "SVT 명사수"
msgstr ""

msgctxt "info/squad/mp_single_ap_miner(rus)"
msgid "AP 지뢰병"
msgstr ""

msgctxt "info/pz5g"
msgid "Ausf.G Panther는 소련의 T34에 대응해 만들어져 1944년 3월에 양산에 들어갔다. 비교적 좋은 기동성과 긴 75mm 포 덕에 위험한 적수였다. 부족한 측면 방어력은 뛰어난 전면 장갑으로 보완했다."
msgstr ""

msgctxt "info/squad/mp_single_at_miner(rus)"
msgid "대전차 지뢰밭은 주로 아군 병력 배치 구역을 적 차량과 전차로부터 지키려고 설치하며, 점령한 진지 앞이나 측면 방어에 쓴다. 지뢰 매설 전문가 네 명으로 이루어진 이 분대는 MP-40 기관단총으로 무장했고, 지뢰밭을 빠르게 깔아 분쟁 지역이나 전략적 요충지를 지킬 수 있다."
msgstr ""

msgctxt "info/entity/d1"
msgid "152mm 구경의 소련 중형 야전 곡사포로, 고폭탄과 연막탄을 쏠 수 있다. \n 이 152mm 곡사포는 1943년 8월 8일 붉은 군대에 배치되었다. 적 병력과 방어 시설, 참호선을 간접 사격으로 공격하도록 설계되었다. D-1은 같은 종류 중 세계 최고의 포와 어깨를 나란히 한다고 평가받았으며, 기동성과 사거리, 고폭탄의 파괴력으로 당대의 거의 완벽한 무기가 되었다. 전장에서는 뛰어난 탄도 특성과 높은 기동성을 갖춘 믿음직하고 정확한 포라는 평판을 얻었다."
msgstr ""

msgctxt "info/squad/mp_single_at(rus)"
msgid "대전차 분견대"
msgstr ""

msgctxt "info/squad/mp_squad_sappers(rus)"
msgid "돌격 공병"
msgstr ""

msgctxt "info/squad/mp_single_supply(rus)"
msgid "보급 분견대"
msgstr ""

msgctxt "info/squad/mp_single_officer(rus)"
msgid "정치위원"
msgstr ""

msgctxt "info/squad/mp_single_sniper(rus)"
msgid "저격수"
msgstr ""

msgctxt "info/squad/mp_single_sabotage(rus)"
msgid "SMERSH 병사"
msgstr ""

msgctxt "info/pz6bh"
msgid "1944년 국방군에 배치되었다. 포탑에 장착된 88mm 장포신 포는 먼 거리에서도 어떤 적 전차든 파괴할 수 있었다. 뛰어난 장갑과 결합된 이 포 덕에 King Tiger는 제2차 세계 대전에서 가장 강력한 전차가 되었다. Pz VI Ausf.B는 적의 포에 거의 뚫리지 않지만, 70톤의 무게 탓에 기동성이 떨어진다."
msgstr ""

msgctxt "info/squad/bazookers(rus)"
msgid "휴대용 로켓 발사기 Bazooka는 미국 설계자들이 적 장비를 상대하려고 개발했다. 일부는 무기 대여 계획에 따라 소련에 공급되었다. 고폭탄 탄두의 위력은 거리에 따라 줄지 않지만, 로켓 발사기는 근거리와 중거리에서 가장 효율적이다. Bazooka로 먼 거리의 목표를 맞히기는 매우 어렵다. 로켓 발사기를 든 보병은 극도로 취약하므로, 전투 부대에는 그를 엄호하는 기관단총수가 포함된다."
msgstr ""

msgctxt "info/squad/smgs(ger)"
msgid "병사들은 MP-40 기관단총과 장갑 차량을 상대할 MP24 수류탄 묶음, 대인 파편 수류탄 몇 발로 무장했다. 이런 분대는 근거리와 중거리에서 적 보병과 싸울 때 매우 효과적이며, 적 진지를 습격하는 데도, 적의 공격을 격퇴하는 데도 쓸 수 있다."
msgstr ""

msgctxt "info/squad/mp_squad_partisans(rus)"
msgid "파르티잔은 집에서 가져온 무기나 적이나 전사한 동료의 무기를 든 민간인들이었다. 이들은 독일의 침공에 맞서 일어섰으며, 불타 버린 고향 마을과 죽은 가족을 위해 마지막 숨이 다할 때까지 싸울 각오를 했다. <c(DB465A)>정규군과 달리 정면 전투 훈련은 받지 않았지만 매복과 기습에 이상적이고 값도 싸다.</c>"
msgstr ""

msgctxt "info/squad/at_rifle(ger)"
msgid "이 독일제 대전차 소총은 1939년 국방군에 배치되었고, Panzerfaust가 도입되기 전까지 경장갑 장비를 상대하는 보병의 주요 수단이었다. 텅스텐 심이 든 14.5g 탄환은 중거리에서 20mm 장갑판을 뚫을 수 있었다. 덕분에 Panzerbushe 39는 제2차 세계 대전 초기에 훌륭한 평판을 얻었다. 그러나 Matilda와 T-34가 등장하면서 소총의 효과는 크게 떨어졌고, 이 전차들의 궤도를 끊거나 포를 손상시키는 것이 고작이었다. 대전차 소총 팀은 두 명으로 구성된다."
msgstr ""

msgctxt "info/squad/at_miners(eng)"
msgid "대전차 지뢰밭은 주로 아군 병력 배치 지점을 지키려고 설치하며, 구축된 진지 앞에, 때로는 측면에 둔다. 지뢰 매설 전문가 네 명으로 이루어진 이 분대는 M3A1 기관단총으로 무장했고, 장애물 선을 빠르게 깔아 방어가 비어 있거나 전략적으로 중요한 구역을 지킬 수 있다."
msgstr ""

msgctxt "info/squad/mp_squad_nkvd(rus)"
msgid "1941년 NKVD는 소련의 범죄자와 죄수를 모아 악명 높은 징벌 대대를 편성하기 시작했다. 죄수들은 적 영토로 밀고 들어가는 대규모 자살 공격으로 피를 흘려 죄를 씻을 기회를 얻었다. 후퇴하면 자기편 NKVD 지휘관에게 총살당하기도 했다. <c(DB465A)>이 병력은 무장이 좋지 않고 탄약도 많이 들고 있지 않다. 중요한 것은 압도적인 숫자와, 큰 비용 없이 투입할 수 있다는 점이다.</c>"
msgstr ""

msgctxt "info/squad/mp_squad_heavy(rus)"
msgid "중보병 분대는 소련 교리가 전쟁 중 표준으로 요구한 편제였다. 그러나 독일의 갑작스러운 침공 이후 계속된 손실과 혼란 탓에 분대들은 교범대로 온전히 편성되지 못하는 경우가 많았다.<c(DB465A)>중 분대, 곧 완편 분대에는 기관총 사수와 그 부사수가 있어 경보병에 비해 적을 제압하는 수단이 좋다.</c>"
msgstr ""

msgctxt "info/squad/ap_miners(eng)"
msgid "대인 지뢰밭은 적 병력이 배치 지점에 접근하지 못하게 막으려고 설치하며, 구축된 진지 앞이나 측면에 둔다. 지뢰 매설병 네 명으로 이루어진 이 분대는 M3A1 기관단총으로 무장했고, 지뢰밭을 빠르게 깔아 방어가 비어 있거나 전략적으로 중요한 구역을 지킬 수 있다."
msgstr ""

msgctxt "info/squad/mp_squad_marines(rus)"
msgid "검은 재킷"
msgstr ""

msgctxt "info/squad/mp_squad_spetsnaz(rus)"
msgid "오스나즈 부대"
msgstr ""

msgctxt "info/squad/ap_miners(rus)"
msgid "대인 지뢰밭은 적 병력이 배치 지점에 접근하지 못하게 막으려고 설치하며, 대개 점령한 진지 앞이나 측면 방어에 쓴다. 지뢰 매설 전문가 네 명으로 이루어진 이 분대는 PPSh 기관단총으로 무장했고, 지뢰밭을 빠르게 깔아 분쟁 지역이나 전략적 요충지를 지킬 수 있다."
msgstr ""

msgctxt "info/tortez"
msgid "Tortoise는 1942년 영국에서 시작된 중돌격 전차 개발의 결과물이다. 무거운 무게 탓에 기동성은 떨어졌지만, 요새화된 진지를 소탕하는 데는 속도가 중요하지 않다고 판단했다. 압연 장갑판으로 만든 차체는 직격탄 여러 발을 견딜 수 있었고, 개량된 대공포로 독일 전차를 쓰러뜨릴 수 있었다. 그러나 개발 기간이 길어 A39는 제2차 세계 대전에서 실전을 치르지 못했다."
msgstr ""

msgctxt "info/squad/ap_miners(usa)"
msgid "대인 지뢰밭은 적 병력이 배치 지점에 접근하지 못하게 막으려고 설치하며, 대개 점령한 진지 앞이나 측면 방어에 쓴다. 지뢰 매설 전문가 네 명으로 이루어진 이 분대는 Thompson 기관단총으로 무장했고, 지뢰밭을 빠르게 깔아 분쟁 지역이나 전략적 요충지를 지킬 수 있다."
msgstr ""

msgctxt "info/entity/kubel_mgun"
msgid "이 경량 사륜구동 차량의 생산은 1940년에 시작되었다. 단순하고 믿음직한 덕분에 Kubelwagen은 곧 제2차 세계 대전에서 가장 유명한 차량 중 하나가 되었고 독일군의 상징이 되었다. 공랭식 엔진은 뜨거운 아프리카에서도 얼어붙는 러시아에서도 잘 작동했고, 가벼운 차체는 야지 주행 능력에 도움이 되었다. 일부 개량형에는 기관총 거치대가 달린 수직 봉이 장착되었다."
msgstr ""

msgctxt "info/entity/hummel"
msgid "Hummel 자주 중곡사포(150mm)는 1943년 5월 국방군에 배치되었으며, 적 방어 시설을 파괴하고 돌격 부대를 지원하도록 설계되었다. 탄약 적재량이 적고 장갑이 얇은 개방형 차체라 근접전에는 맞지 않았다. 그럼에도 「호박벌」은 적에게 엄청난 피해를 줄 수 있는 무서운 무기였다."
msgstr ""

msgctxt "info/squad/bazookers(ger)"
msgid "휴대용 대전차 무기 Panzerschreck은 값비싸지만 강력해서 관통 성능이 미국의 Bazooka를 크게 앞섰다. 고폭탄 탄두의 위력은 거리에 따라 줄지 않지만 로켓 발사기는 여전히 근거리와 중거리에서 가장 효율적이다. 이런 무기로 먼 거리의 목표를 맞히기는 매우 어렵다. 로켓 발사기를 든 보병은 극도로 취약하므로, 전투 부대에는 호위용 기관단총수가 포함된다."
msgstr ""

msgctxt "info/squad/at_rifle(rus)"
msgid "Simonov가 설계한 이 대전차 소총은 1941년 8월 29일 붉은 군대에 배치되어 곧 양산에 들어갔다. 다른 모델과 달리 무게가 더 나가고 자동 장전 급탄 방식을 썼다. 전쟁 초기에는 모든 종류의 독일 장비를 상대하는 데 쓰였으나 시간이 지날수록 효과가 눈에 띄게 떨어졌다. 전쟁 후반에는 대전차 소총으로 적 중형 전차와 중전차를 더는 파괴할 수 없었고 궤도와 포를 손상시키는 정도에 그쳤다. PTRS 팀은 두 명으로 구성된다."
msgstr ""

msgctxt "info/squad/elite(eng)"
msgid "코만도 특수부대는 적 후방의 정찰과 파괴 공작, 가장 중요한 강습 작전을 위해 1940년 6월 처칠의 주도로 창설되었다. 코만도는 미국제 Thompson 기관단총, Bren 경기관총, 연막탄과 대인 수류탄, 대전차 수류탄으로 무장했다. 코만도 분대는 우수한 훈련과 인상적인 무기고 덕에 어떤 상황에서도 효과적으로 싸울 수 있어 당연히 정예로 여겨졌다."
msgstr ""

msgctxt "info/squad/elite(ger)"
msgid "독일 공수부대는 1935년에 생겨나 제2차 세계 대전 초기 여러 강습 작전에 참가했다. 다른 나라의 비슷한 부대와 달리 독일 낙하산병은 특수부대에 속하지 않았고, 사실은 공중에서 작전하는 잘 훈련된 보병이었다. 이 겁 없는 병사들은 대전차 수류탄, 대인 수류탄, 연막탄, 다이너마이트 막대, 칼, 기관단총, FG 42 돌격 소총으로 무장해 어떤 상황에서도 효과적으로 싸울 수 있었다."
msgstr ""

msgctxt "info/squad/elite(rus)"
msgid "붉은 군기 해병 대대는 소련 해군의 수병과 장교로 편성되었다. 이 용감하고 강인한 병사들은 전선에서 가장 위험한 지역에 투입되었고, 그곳에서 치른 격전으로 소련 정예 부대라는 지위를 얻었다. 해병은 겁이 없고 무장이 좋다. Tokarev가 설계한 자동 소총은 발사 속도가 뛰어나고, 많이 지급되는 대전차, 대인, 연막 수류탄 덕에 어떤 상황에서도 효과적으로 싸울 수 있다."
msgstr ""

msgctxt "info/squad/elite(usa)"
msgid "레인저 부대는 1942년 태평양과 아프리카에서 정찰과 파괴 공작 임무를 수행하려고 미국에서 창설되었다. 항공기나 배로 상륙할 수 있었고, 무기고에는 대전차, 대인, 연막 수류탄과 M1A1 반자동 카빈, Thompson 기관단총, 다이너마이트 막대가 있었다. 이런 무장 덕에 특수부대는 적 후방에서도 전선에서도 효과적으로 싸울 수 있었다."
msgstr ""

msgctxt "info/squad/flamers(ger)"
msgid "화염방사기를 든 병사는 건물 안의 보병에게 큰 피해를 주고 혼자서 한 구역의 적을 소탕할 수도 있다. 그러나 가연성 액체를 다 쓰고 나면 무장이 없는 상태가 되고, 유탄 한 발이 연료통을 맞히면 폭발하기 때문에 극도로 취약하다. 그래서 전투 부대에는 호위용 기관단총수 몇 명이 함께 편성된다."
msgstr ""

msgctxt "info/squad/flamers(rus)"
msgid "화염방사기를 든 병사는 건물 안의 보병에게 큰 피해를 주고 혼자서 한 구역의 적을 소탕할 수도 있다. 그러나 가연성 액체를 다 쓰고 나면 무장이 없는 상태가 되고, 유탄 한 발이 연료통을 맞히면 폭발하기 때문에 극도로 취약하다. 그래서 전투 부대에는 호위용 기관단총수 몇 명이 함께 편성된다."
msgstr ""

msgctxt "info/squad/flamers(usa)"
msgid "화염방사기를 든 병사는 건물 안의 보병에게 큰 피해를 주고 혼자서 한 구역의 적을 소탕할 수도 있다. 그러나 가연성 액체를 다 쓰고 나면 무장이 없는 상태가 되고, 유탄 한 발이 연료통을 맞히면 폭발하기 때문에 극도로 취약하다. 그래서 전투 부대에는 호위용 기관단총수 몇 명이 함께 편성된다."
msgstr ""

msgctxt "info/squad/homeguard(eng)"
msgid "영국 민병대"
msgstr ""

msgctxt "info/squad/homeguard(ger)"
msgid "독일 민병대"
msgstr ""

msgctxt "info/squad/homeguard(rus)"
msgid "러시아 민병대"
msgstr ""

msgctxt "info/squad/mgs(eng)"
msgid "Bren 경기관총으로 무장한 병사 두 명으로 이루어진 전투 조는 돌격하는 아군 보병에게 훌륭한 화력 지원을 할 수 있다. Bren의 적은 탄창 용량은 높은 발사 속도와 살상력으로 보완된다. 또 엄폐물 뒤나 엎드린 자세에서 쏠 수 있는 특수 받침에 올리면 명중률과 탄막 밀도가 크게 향상된다."
msgstr ""

msgctxt "info/squad/mgs(ger)"
msgid "뛰어난 발사 속도와 높은 화력, 넉넉한 탄 용량을 겸비한 MG42는 적 보병에게 위험한 무기이며 전진하는 아군에게 꼭 필요한 화력 지원을 한다. 엄폐물 뒤나 엎드린 자세에서 쏠 때는 특수 거치대에 올려 명중률을 크게 높인다."
msgstr ""

msgctxt "info/squad/mgs(rus)"
msgid "강한 저지력과 발사 속도 덕에 Degtyaryov 경기관총은 엄호 사격을 하기에 이상적인 무기이며, 동시에 기관총 사수 한 명 한 명을 모든 적 병력에게 무서운 상대로 만든다. 차폐물 뒤나 엎드린 자세에서 쏠 때는 특수 거치대에 올려 명중률을 극적으로 높인다."
msgstr ""

msgctxt "info/squad/mgs(usa)"
msgid "Browning 자동 소총으로 무장한 병사 두 명으로 이루어진 전투 조는 전진하는 아군 보병에게 훌륭한 화력 지원을 할 수 있다. 적은 탄 용량은 높은 발사 속도와 B.A.R.의 저지력으로 충분히 보완된다. 거치 자세에서 쏘면 명중률이 크게 오른다."
msgstr ""

msgctxt "info/squad/officer(eng)"
msgid "전장에 노련한 장교가 있으면 전투의 흐름을 바꿀 수 있다. 야전 쌍안경으로 덤불이나 긴 풀숲에 숨은 적 보병과 파괴 공작원을 찾아낸다. 또 먼 거리의 적을 발견해 재편성하고 대응할 시간을 벌어 준다. 쌍안경 외에 칼과 개인 권총을 지니지만, 이 무기들은 격렬한 전투에는 알맞지 않다."
msgstr ""

msgctxt "info/squad/officer(ger)"
msgid "전장에 노련한 장교가 있으면 어떤 전투의 흐름도 바꿀 수 있다. 야전 쌍안경으로 덤불과 높은 풀숲에 숨은 적 보병과 파괴 공작원을 찾아낸다. 또 먼 곳의 적 유닛을 발견해 미리 재편성하고 대응할 수 있게 해 준다. 쌍안경 외에 칼과 Walther 권총도 지니지만, 이 무기들은 격렬한 전투에는 알맞지 않다."
msgstr ""

msgctxt "info/squad/officer(usa)"
msgid "전장에 노련한 장교가 있으면 어떤 전투의 흐름도 바꿀 수 있다. 야전 쌍안경으로 덤불과 높은 풀숲에 숨은 적 보병과 파괴 공작원을 찾아낸다. 또 먼 곳의 적 유닛을 발견해 미리 재편성하고 대응할 수 있게 해 준다. 쌍안경 외에 칼과 Colt 권총도 지니지만, 이 무기들은 격렬한 전투에는 알맞지 않다."
msgstr ""

msgctxt "info/squad/riflemans(eng)"
msgid "대인 수류탄 몇 발과 EM-3 소총으로 무장한 영국 보병 여섯 명의 분대. 이 소총수들은 장거리와 중거리에서 가장 효과적이다. 근접전에서는 적 기관단총수와 돌격 분대의 손쉬운 먹잇감이 된다."
msgstr ""

msgctxt "info/squad/riflemans(rus)"
msgid "병사 여섯 명으로 이루어진 분대로, 저마다 대인 수류탄 두 발과 표준 지급품인 Mosin 소총으로 무장했다. 소총의 긴 사거리 덕에 중거리와 장거리에서 가장 효과적이다. 그러나 Mosin은 장탄수가 적고 발사 속도가 비교적 느려, 근거리에서는 기관단총수와 돌격 보병의 손쉬운 표적이 된다."
msgstr ""

msgctxt "info/squad/riflemans(usa)"
msgid "대인 수류탄 몇 발과 Springfield 소총으로 무장한 미군 보병 여섯 명의 분대. 소총수는 장거리와 중거리에서 가장 효율적이다. 근접전에서는 적 기관단총수와 돌격 분대의 손쉬운 먹잇감이 된다."
msgstr ""

msgctxt "info/sgrw42"
msgid "이 81mm 포의 설계는 소련제 대응품과 비슷하며 발사관, 지지판, 두 다리 거치대의 세 부분으로 구성된다. 3.5kg짜리 HE 탄을 간접 사격으로 발사한다. 관 안의 공이가 떨어지는 포탄의 뇌관을 때리면 발사된다."
msgstr ""

msgctxt "info/squad/saboteur"
msgid "이런 유닛 하나면 적 전차를 손쉽게 고철로 만들 수 있다. 적 전초를 은밀히 공격하기에 완벽한 유닛이다."
msgstr ""

msgctxt "info/universal"
msgid "유니버설 트랙터. 1940년대 시골에서 흔했다."
msgstr ""

msgctxt "info/entity/m4a1"
msgid "이 미국 중형 전차는 1942년 양산에 들어가 모든 전선에서 널리 쓰였다. 무기 대여 계획에 따라 미국의 동맹국에 대량으로 공급되었다. 전체가 주조된 차체와 두꺼운 장갑 덕에 M4A1은 소련의 T-34 계열보다 약하지 않았고, 인체공학이 더 좋았으며 포탑 내부도 더 넓고 속도도 괜찮았다. 75mm 포는 적의 경장비와 중형 장비를 상대로 잘 통했지만, Tiger와 Panther가 등장한 뒤로는 예전 같은 효과를 잃었다."
msgstr ""

msgctxt "info/squad/sappers(eng)"
msgid "휴대용 지뢰 탐지기로 무장한 숙련된 폭파 전문가 두 명의 이 분대는 모든 지뢰밭을 빠르게 찾아 제거할 수 있다. 해체한 지뢰는 주워서 다시 쓸 수 있다. 전선 작전용으로는 Sten Mk.1 기관단총으로 무장해 어느 정도 저항할 수 있다. 그래도 이 전문가들을 요새화된 적 진지 공격에 보내는 것은 권장하지 않는다."
msgstr ""

msgctxt "info/squad/sappers(ger)"
msgid "휴대용 지뢰 탐지기로 무장한 숙련된 폭파 전문가 두 명의 분대는 모든 지뢰밭을 빠르게 찾아 제거할 수 있다. 해체한 지뢰는 주워서 다시 쓸 수 있다. 적과 마주쳤을 때를 대비해 MP-40 기관단총으로 무장했다. 스스로를 지킬 수는 있지만, 이 전문가들을 요새화된 적 진지 공격에 보내는 것은 권장하지 않는다."
msgstr ""

msgctxt "info/entity/m4a3m"
msgid "이 Sherman 전차 개량형은 1942년 특수 지뢰 제거 도리깨로 지뢰밭을 개척하려고 만들어졌다. 엔진으로 구동되는 회전 로터가 차량 앞쪽의 두 팔에 달려 있었다. 로터에는 쇠사슬과 쇠공이 매달려 있었다. 회전하면서 쇠사슬이 땅을 때려 차량 앞의 지뢰를 모두 터뜨렸다. 이 전차의 포탑은 흔히 제거되어 방어용 기관총만 남았다."
msgstr ""

msgctxt "info/squad/sappers(rus)"
msgid "휴대용 지뢰 탐지기로 무장한 숙련된 폭파 전문가 두 명의 분대는 모든 지뢰밭을 빠르게 찾아 제거할 수 있다. 해체한 지뢰는 주워서 다시 쓸 수 있다. 적과 마주쳤을 때를 대비해 PPSh 기관단총으로 무장했다. 스스로를 지킬 수는 있지만, 이 전문가들을 요새화된 적 진지 공격에 보내는 것은 권장하지 않는다."
msgstr ""

msgctxt "info/entity/m36"
msgid "미군 구축전차 중 가장 강력한 이 차량은 1943년 11월 양산에 들어갔다. 차체는 전작인 M10A1 자주 대전차포의 것을 가져왔다. 「슬러거」에 장착된 개량 90mm 포의 뛰어난 장갑 관통력 덕에 독일 중전차와도 맞붙을 수 있었다. 두꺼운 전면 장갑은 적 포탄을 막아 주었고, 좋은 기동성은 유일한 심각한 결함, 곧 승무원을 노출시키는 개방형 포탑을 보완했다."
msgstr ""

msgctxt "info/squad/sappers(usa)"
msgid "휴대용 지뢰 탐지기로 무장한 숙련된 폭파 전문가 두 명의 분대는 모든 지뢰밭을 빠르게 찾아 제거할 수 있다. 해체한 지뢰는 주워서 다시 쓸 수 있다. 적과 마주쳤을 때를 대비해 Thompson 기관단총으로 무장했다. 스스로를 지킬 수는 있지만, 이 전문가들을 요새화된 적 진지 공격에 보내는 것은 권장하지 않는다."
msgstr ""

msgctxt "info/squad/scouts(eng)"
msgid "SAS 요원은 혼자서도 적에게 치명적인 피해를 줄 수 있다. 눈에 띄지 않게 포복해 적 진지를 정찰하며 시야 밖에 머문다. 소음기 달린 De Lisle 카빈과 투척용 칼, 적의 중전차를 쓸모없는 금속 더미로 만들 만큼 강력한 폭약 몇 개로 무장했다."
msgstr ""

msgctxt "info/squad/scouts(ger)"
msgid "이 병사는 독일 최고의 정보 학교에서 훈련을 받아 혼자서도 적에게 치명적인 피해를 줄 수 있다. 덤불이나 높은 풀숲에 숨어 적의 눈을 피하고, 포복할 때는 거의 보이지 않는다. 소음기 달린 권총과 투척용 칼 몇 자루, 중장갑 차량을 파괴할 다이너마이트 막대 두어 개로 무장했다."
msgstr ""

msgctxt "info/squad/tankmans(rus)"
msgid "전차의 효율은 무엇보다 승무원의 단결력과 어떤 상황에서도 일관되게 행동하는 능력에 달려 있다. 가장 강력하고 위험한 기계도 조종하는 사람이 갑자기 사라지면 고철 더미일 뿐이다. 전차 승무원을 훈련할 때는 모든 승무원이 서로의 임무를 익히는 교차 훈련이 핵심이다. 승무원이 한 명만 살아남아도 전차가 전투 능력을 유지해야 하기 때문이다... \n 소련 전차병은 소형 PPS-43 기관단총으로 무장했지만 전투 훈련을 받지 않아 극도로 취약하다."
msgstr ""

msgctxt "info/squad/stormtroopers(usa)"
msgid "미 육군 해병 분대는 전략적 요충지를 점령하는 특수 작전에 가장 알맞다. Garand 소총, Browning 자동 소총, 대인·연막·대전차 수류탄으로 무장했다. 이런 특수부대 병사는 장거리와 중거리에서 가장 효과적이며, 강철 흉갑이 작은 파편과 유탄으로부터 병사를 보호한다."
msgstr ""

msgctxt "info/squad/scouts(usa)"
msgid "파괴 공작원은 잘 훈련된 병사로, 혼자서도 적에게 치명적인 피해를 줄 수 있다. 덤불이나 높은 풀숲에 숨어 포복하면 거의 보이지 않는다. 소음기 달린 권총과 투척용 칼 몇 자루, 소이 수류탄, 그리고 가장 무거운 전차도 고철 더미로 만들 만큼 강력한 폭약을 갖고 있다."
msgstr ""

msgctxt "info/squad/smgs(eng)"
msgid "기관단총수는 Sten Mk.1, 대인·대전차·연막 수류탄으로 무장했다. 기관단총수 여섯 명의 분대는 방어와 공격 모두에 쓸 수 있고 근거리와 중거리에서 적 보병과 효과적으로 싸울 수 있다."
msgstr ""

msgctxt "info/squad/smgs(rus)"
msgid "병사 여섯 명으로 이루어진 분대로, 저마다 PPSh 기관단총과 AP 수류탄 몇 발, RPG-40 대전차 수류탄 한 발로 무장했다. PPSh에는 71발이 들어가는 대용량 드럼 탄창이 달려 있어 근거리와 중거리에서 특히 효과적이다. 이 여섯 명의 분대는 적 진지 강습이나 전차와 야포 호위에 쓸 수 있다."
msgstr ""

msgctxt "info/squad/snipers(ger)"
msgid "숙련된 저격수의 손에서 Mauser 98K 소총은 먼 거리의 적 병력을 제거할 수 있다. 장착된 조준경으로 숨어 있는 적 파괴 공작원을 찾아낼 수 있다. 위장이 저격수의 주된 무기이므로, 조준경이 달린 소총 외에 투척용 칼과 위장용 덤불을 여러 개 갖고 다닌다."
msgstr ""

msgctxt "info/squad/smgs(usa)"
msgid "이 병사들은 Thompson 기관단총과 대인 수류탄 몇 발, No.73 대전차 수류탄 한 발로 무장했다. 기관단총수 여섯 명으로 이루어진 이 전투 부대는 방어와 공격 어느 쪽에도 쓸 만하다. 근거리와 중거리에서 적 보병을 효과적으로 상대할 수 있다."
msgstr ""

msgctxt "info/squad/snipers(eng)"
msgid "저격수는 소총으로 안전한 거리에서 적 병력을 제거할 수 있고, 장착된 조준경으로 아주 잘 숨은 적 파괴공작원까지 찾아낸다. 위장이 저격수의 주무기이므로 조준경이 달린 EM-2 소총 외에 투척용 칼과 위장용 덤불 여러 개를 지닌다."
msgstr ""

msgctxt "info/squad/snipers(rus)"
msgid "저격수는 소총으로 안전한 거리에서 적 병력을 제거할 수 있고, 소총에 장착된 조준경으로 숨어 있는 적 파괴공작원을 찾아낸다. 위장이 저격수의 주무기이므로 조준경이 달린 Mosin 소총 외에 투척용 칼과 위장용 덤불 여러 개를 지닌다."
msgstr ""

msgctxt "info/squad/stormtroopers(eng)"
msgid "영국군 돌격대는 체력이 뛰어난 젊은 병사들로 구성되며, 독립 화기 진지 공격부터 방어선과 영구 요새 확보에 이르기까지 가장 어렵고 중요한 임무에 투입되기 전에 추가 훈련을 받았다. 이들은 미제 기관단총과 영국제 Bren 경기관총으로 무장했고, 다이너마이트, 대인 수류탄, 대전차 수류탄, 연막탄도 갖췄다. 총탄과 포탄 파편을 막기 위해 특수 강철 흉갑을 착용했다."
msgstr ""

msgctxt "info/squad/stormtroopers(ger)"
msgid "국방군의 정예 부대로, 훈련 수준과 장비가 뛰어나다. 중보병 여섯 명으로 이루어진 분대는 적 진지를 돌파하고 전략 거점을 점령하는 데 이상적이다. 분대의 무장에는 MP-44 기관단총, Panzerfaust 대전차 발사기, 연막탄, 대인 수류탄, 고폭 대전차 수류탄이 있다. 금속 흉갑이 소총탄을 막아 주므로 근거리와 중거리 전투에서 가장 효과적이다."
msgstr ""

msgctxt "info/squad/stormtroopers(rus)"
msgid "돌격 공병 여단은 1943년 5월 최고사령부 대본영의 명령으로 창설되었으며, 견고한 적 방어선을 돌파하고 시가전을 치르는 것이 목적이었다. 이런 병사 여섯 명으로 이루어진 분대는 적 방어선을 공격하고 전략 거점을 점령하는 데 가장 알맞다. 분대는 Sudaev 기관단총, 고폭 대전차 RPG43 수류탄, 화염병, 다이너마이트, 연막탄과 대인 수류탄으로 무장했다. 금속 흉갑이 소총탄을 막아 주므로 근거리와 중거리 전투에서 가장 효과적이다."
msgstr ""

msgctxt "info/squad/tankmans(eng)"
msgid "전차의 효율은 무엇보다 승무원의 단결과, 어떤 상황에서도 일관되게 움직일 수 있는 능력에 달려 있다. 아무리 강력하고 위험한 전차도 조종하는 사람이 갑자기 사라지면 고철 덩어리일 뿐이다. 전차 승무원을 훈련할 때는 모든 승무원이 서로의 역할을 익히는 교차 훈련이 핵심이다. 승무원이 한 명만 살아남아도 전차는 전투력을 유지해야 하기 때문이다... \n 전차 승무원은 소형 Sten Mk.1 기관단총으로 무장하지만 전투 훈련을 받지 않아 극도로 취약하다."
msgstr ""

msgctxt "info/squad/tankmans(usa)"
msgid "전차의 효율은 무엇보다 승무원의 단결과, 어떤 상황에서도 일관되게 움직일 수 있는 능력에 달려 있다. 아무리 강력하고 위험한 전차도 조종하는 사람이 갑자기 사라지면 고철 덩어리일 뿐이다. 전차 승무원을 훈련할 때는 모든 승무원이 서로의 역할을 익히는 교차 훈련이 핵심이다. 승무원이 한 명만 살아남아도 전차는 전투력을 유지해야 하기 때문이다... \n 전차 승무원은 소형 M3A1 기관단총으로 무장하지만 전투 훈련을 받지 않아 극도로 취약하다."
msgstr ""

msgctxt "info/squad/volksgrenadiers(ger)"
msgid "이런 독일 국민척탄병은 값싼 지원병 부대로, 총과 철모, 군복만 지급받은 채 곧장 전선으로 보내지는 일이 많았다."
msgstr ""

msgctxt "info/entity/m4a2"
msgid "Sherman은 1942년에 대량 생산에 들어갔다. 당시 미군 전차 중 가장 강했지만 독일 전차에는 맞서지 못했다. 높은 차체와 약한 장갑, 주포의 부진한 성능이 전차의 전반적인 취약성에 한몫했다. 그래도 생산비가 비교적 낮았던 덕분에 Sherman은 연합군의 주력 전차 역할을 했다."
msgstr ""

msgctxt "info/entity/gmc_cckw"
msgid "이 트럭의 적재함에는 연료통, 수리 도구, 탄약, 수류탄 등 군수품이 실려 있다. \n 이 군용 트럭은 민간 차량 ACX-353을 개량한 것이다. 전쟁 중에는 화물 운송, 병력 이동, 포 견인에 자주 쓰였다. 일부 개량형은 연료 트럭으로 쓰이기도 했다."
msgstr ""

msgctxt "info/squad/warden(rus)"
msgid "성난 닭의 수호자!"
msgstr ""

msgctxt "info/entity/155gpf"
msgid "잘 알려지지 않은 물건이다."
msgstr ""

msgctxt "info/entity/61k"
msgid "61k Bofors를 잘 모름/위키백과 찾아보기 귀찮음."
msgstr ""

msgctxt "info/entity/blitz3_6eng"
msgid "이 트럭 안에는 장비 수리 도구, 장애물과 방어물 설치 자재, 대인 지뢰와 대전차 지뢰가 있다. 장애물은 보통 점령한 진지 앞이나 때로는 측면과 진지 사이 틈에 설치한다. 방어물은 모래주머니로 만들며 아군 보병의 진지를 보강한다. \n Opel Blitz는 믿음직하고 손이 덜 가는 차량으로 제2차 세계 대전에서 널리 쓰였다. 혹독한 전장 환경에 안성맞춤이어서 구급차부터 이동 사령부까지 다양한 역할을 맡았다. 병력을 대규모로 빠르게 재배치하고 포를 견인하는 데 알맞다."
msgstr ""

msgctxt "info/entity/achilles"
msgid "1944년 영국 기술자들은 미국의 M10 Wolverine 자주포를 바탕으로 개량형 구축전차 Achilles를 만들었다. 기본적으로 M4A2 Sherman 주력 전차의 차체에 관통력이 뛰어난 장포신 QF17 포를 얹은 것이다. 기동성은 훌륭했으나, 그 때문에 튼튼한 장갑을 덧댈 수는 없었다."
msgstr ""

msgctxt "info/entity/archer"
msgid "영국 육군은 공격하는 보병에게 기동 대전차포 지원을 제공하려고 Vickers에 당시 현대전의 모든 요구를 충족하는 새 자주포 개발을 주문했다. 1944년에 처음 생산된 Archer는 독특한 구조였다. 장포신 76mm QF17 포는 독일 전차 어느 것과도 싸울 수 있었지만, 포가 뒤쪽을 향하는 배치는 공세 중에 매우 불편했다."
msgstr ""

msgctxt "info/entity/centurion"
msgid "이 전차의 개발은 1943년 8월 AEC가 시작했다. 2년 만에 양산에 들어갔고, 당시 영국 기갑 차량 중 걸작이 되었다. Centurion은 제2차 세계 대전에는 너무 늦게 나왔지만, 만약 참전했다면 독일 Panther와 Tiger는 일대일 대결에서 승산이 거의 없었을 것이다. 이 신형 전차는 포탄 방어력이 뛰어났고, 안정화된 장포신 76mm 포로 거의 모든 적을 순식간에 파괴했다."
msgstr ""

msgctxt "info/entity/ba11"
msgid "소련이 대량 생산한 중형 장갑차로, 적의 비장갑 및 경장갑 전차와 차량을 상대할 수 있다. 승무원 3명이 필요하다. \n BA-11은 1938년부터 대량 생산된 중장갑 차량으로, 주로 전진하는 보병에게 화력 지원을 제공하는 이동 플랫폼으로 쓰였다. 다른 일부 경전차에 비해 장갑이 두껍고 기동성과 화력도 높았다. 개량된 ZIS-16 엔진 덕분에 빠른 속도를 낼 수 있었고, 포탑에 장착된 45mm 포는 당시 거의 모든 경전차와 중형 전차의 장갑을 관통할 수 있었다."
msgstr ""

msgctxt "info/entity/ba64"
msgid "기관총을 장착한 이 4륜구동 경장갑차는 1942년부터 소련군이 정찰과 전투 중 경계 임무에 사용했다. 방탄 장갑은 소구경 탄조차 승무원을 막아 주지 못했지만, 작은 크기와 높은 지상고 덕분에 BA 64는 적 포병이 맞히기 어려운 표적이었다."
msgstr ""

msgctxt "info/entity/bedford_art"
msgid "이 트럭의 적재함에는 철갑탄과 고폭탄, 탄약 상자, 수리 도구가 실려 있다. \n 믿음직하고 손이 덜 가는 Bedford는 제2차 세계 대전 중 영국 육군이 널리 사용했다. 이 3톤 트럭은 보병과 화물을 싣고 포를 견인했으며, 연료 트럭, 병원 차량, 지휘 차량, 이동 정비소로도 쓰였다."
msgstr ""

msgctxt "info/entity/degtyarev_stan"
msgid "보병과 기갑 부대가 함께 쓰는 소련의 범용 기관총. \n 바실리 데그탸료프가 설계한 이 기관총은 1927년부터 제2차 세계 대전이 끝날 때까지 붉은 군대가 사용했다. 안전하고 다루기 쉬우며 발사 속도가 높아 상당한 성공작이었다. 기존의 어떤 기관총보다 뛰어나 붉은 군대 무기고에서 당연한 자리를 차지했다."
msgstr ""

msgctxt "info/entity/bedford_eng"
msgid "이 트럭 안에는 장비 수리 도구, 장애물과 방어물 설치 자재, 대인 지뢰와 대전차 지뢰가 있다. 장애물은 보통 점령한 진지 앞이나 때로는 측면과 진지 사이 틈에 설치한다. 방어물은 모래주머니로 만들며 아군 보병의 진지를 보강한다. \n 믿음직하고 손이 덜 가는 Bedford는 제2차 세계 대전 중 영국 육군이 널리 사용했다. 이 3톤 트럭은 보병과 화물을 싣고 포를 견인했으며, 연료 트럭, 병원 차량, 지휘 차량, 이동 정비소로도 쓰였다."
msgstr ""

msgctxt "info/entity/fi156"
msgid "Fi 156 Storch는 전형적인 정찰기였다."
msgstr ""

msgctxt "info/entity/bedford_inf"
msgid "이 트럭 안에는 수리 도구, 소화기 탄약, 수류탄 등 탄약이 있다. \n 믿음직하고 손이 덜 가는 Bedford는 제2차 세계 대전 중 영국 육군이 널리 사용했다. 이 3톤 트럭은 보병과 화물을 싣고 포를 견인했으며, 연료 트럭, 병원 차량, 지휘 차량, 이동 정비소로도 쓰였다."
msgstr ""

msgctxt "info/qf6"
msgid "QF2 포는 채택 직후부터 효율이 낮다는 사실이 드러났고, 영국은 제2차 세계 대전 이전에 새 대전차포 개발에 들어갔다. 4년 뒤 채택되어 구식이 된 2파운드 포를 대체했다. QF6 포는 북아프리카에서 적 경전차와 중형 전차를 파괴하는 데 성공적으로 쓰였지만, 신형 Tiger와 Panther의 두꺼운 장갑은 관통하지 못했다."
msgstr ""

msgctxt "info/entity/bedford"
msgid "이 트럭 안에는 휘발유통, 수리 도구, 소화기 탄약, 수류탄 등 탄약이 있다. \n 믿음직하고 손이 덜 가는 Bedford는 제2차 세계 대전 중 영국 육군이 널리 사용했다. 이 3톤 트럭은 보병과 화물을 싣고 포를 견인했으며, 연료 트럭, 병원 차량, 지휘 차량, 이동 정비소로도 쓰였다."
msgstr ""

msgctxt "info/entity/m8_howitzer"
msgid "이 경야포는 1930년부터 미군에서 운용되었다. 글라이더로 공수될 것을 전제로 분해와 운반이 최대한 쉽도록 설계되었다. 크기가 비교적 작은 이 개량 75mm 포는 공수 부대에 직접 화력 지원을 제공하도록 만들어졌으며, 기동성과 발사 속도에서 같은 종류의 포를 앞섰다."
msgstr ""

msgctxt "info/entity/bf109g"
msgid "Bf 109는 독일 공군의 기본 전투기로, 여러 전선에서 쓰였으며 민첩성과 화력으로 유명하다."
msgstr ""

msgctxt "info/entity/bishop"
msgid "Valentine 전차 차체에 얹은 자주 곡사포. 주목적은 25파운드 곡사포에 기동 플랫폼을 제공하는 것이었다. 서둘러 설계한 탓에 결함이 있었다. 고정식 포탑이 매우 높았고, 낮은 속도와 맞물려 이상적인 표적이 되었다. 그럼에도 Bishop은 보병 지원 화기와 공성포로 성공적으로 활용되었다."
msgstr ""

msgctxt "info/entity/bl6"
msgid "Vickers 6인치 26 cwt 곡사포는 1915년에 개발되어 오랫동안 영국 육군에서 이 종류의 주력 화기로 쓰였다. BL6의 고폭탄은 적 병력을 효과적으로 제거했고 적 방어 시설에 큰 피해를 입혔다. 그러나 방패 장갑이 없어 포병이 매우 취약했다."
msgstr ""

msgctxt "info/entity/blitz3_6"
msgid "연료통, 수리 도구, 탄약, 수류탄 등 장비를 실은 보급 트럭. \n Opel Blitz는 믿음직하고 정비가 쉬운 차량으로 제2차 세계 대전 전 전장에서 볼 수 있었다. 혹독한 전장 환경에 잘 맞았고 구급차부터 이동 본부까지 여러 형식으로 쓰였다. Blitz는 병력 수송과 포 견인에 안성맞춤이다."
msgstr ""

msgctxt "info/entity/blitz3_6art"
msgid "철갑탄과 고폭탄 상자, 수리 도구를 실은 보급 트럭. \n Opel Blitz는 믿음직하고 정비가 쉬운 차량으로 제2차 세계 대전 전 전장에서 볼 수 있었다. 혹독한 전장 환경에 잘 맞았고 구급차부터 이동 본부까지 여러 형식으로 쓰였다. Blitz는 병력 수송과 포 견인에 안성맞춤이다."
msgstr ""

msgctxt "info/entity/blitz3_6inf"
msgid "이 트럭 안에는 수리 도구, 소화기 및 경포 탄약, 수류탄, 지뢰 등 탄약이 있다. \n 3톤 Opel Blitz는 믿음직하고 손이 덜 가는 차량으로 제2차 세계 대전에서 널리 쓰였다. 혹독한 전장 환경에 안성맞춤이어서 구급차부터 이동 사령부까지 다양한 역할을 맡았다. 병력을 대규모로 빠르게 재배치하고 포를 견인하는 데 알맞다."
msgstr ""

msgctxt "info/entity/bm_37"
msgid "고폭탄, 연막탄, 파편탄을 쏠 수 있는 소련의 표준 구경 보병 야전 박격포. \n 1937년에 개발된 소련 82mm 박격포는 활강포 방식의 곡사 유탄 발사기로, 적 병력을 공격하고 방어 진지를 제압하는 데 쓰였다. 구조는 보통의 방식을 따른다. 포탄 안에 고정 격침이 있는 뇌관이 폭발을 일으키고, 이각 받침대가 포신을 필요한 각도로 지지한다. 신뢰성과 사용 편의성, 기동성 덕분에 정예 보병 부대 사이에서 인기를 얻었다."
msgstr ""

msgctxt "info/entity/bm13"
msgid "Katyusha 양산 명령은 1941년 6월 21일에 서명되었고, 불과 3주 뒤 이 로켓 발사기는 오르샤 전장에 모습을 드러냈다. M13 로켓을 쏘는 유도 레일을 ZIS-6 트럭 위에 설치해 꼭 필요했던 기동성을 확보했다. 사거리가 길어 로켓이 넓은 지역에 흩어졌기에 정밀 타격에는 맞지 않았다. 반면 지역 타격에는 매우 효과적이었다."
msgstr ""

msgctxt "info/pz3"
msgid "Pz.Kpfw.III는 1939년 9월 양산에 들어갔다. 1년 뒤 개량된 장갑과 새 장포신 50mm 포를 받았다. 이 전차는 장갑차와 경전차를 성공적으로 상대하고 파괴할 수 있었으나, T-34가 등장하면서 대부분 구식이 되었다."
msgstr ""

msgctxt "info/entity/bm37"
msgid "고폭탄, 연막탄, 파편탄을 쏠 수 있는 소련의 표준 구경 보병 야전 박격포. \n 1937년에 개발된 소련 82mm 박격포는 활강포 방식의 곡사 유탄 발사기로, 적 병력을 공격하고 방어 진지를 제압하는 데 쓰였다. 구조는 보통의 방식을 따른다. 포탄 안에 고정 격침이 있는 뇌관이 폭발을 일으키고, 이각 받침대가 포신을 필요한 각도로 지지한다. 신뢰성과 사용 편의성, 기동성 덕분에 정예 보병 부대 사이에서 인기를 얻었다."
msgstr ""

msgctxt "info/entity/browning_stan"
msgid "Browning은 처음에는 공군용으로 개발되었으나, 1923년에 지상군용 버전도 개발되었다. 개량형은 M1919로 불렸고 미 육군이 널리 사용했다. 좋은 발사 속도와 유효 사거리 덕분에 미 육군에서 가장 성공적이고 널리 퍼진 거치식 기관총 중 하나가 되었다."
msgstr ""

msgctxt "info/entity/bt7a"
msgid "빠르고 민첩한 소련의 중경량 보병 지원 전차로, 병력 한 분대를 전장에 실어 나르면서 경전차와 차량과도 싸울 수 있다. \n BT(Bystrokhodny tank, '고속 전차'라는 뜻)는 '변환식' M1931 Christie 전차를 바탕으로 1935년부터 소련에서 생산되었다. 무게 13.5톤인 이 '자주포' 형식은 비교적 두꺼운 장갑을 유지하면서 고속을 낼 수 있었고, 76mm 포 덕분에 화력도 높았다. BT는 적 영토로 빠르게 치고 들어가거나, 보병 지원 없이 신속한 공세 작전을 펼치도록 설계되었다."
msgstr ""

msgctxt "info/entity/karlthor"
msgid "이 포의 역사는 모르겠다. 알고 싶으면 역사 공부나 해라! 멍청이!"
msgstr ""

msgctxt "info/entity/cg-4a"
msgid "내가 아는 건 1944년 프랑스에서 영국군과 미군이 이걸 썼다는 것뿐이고, 나머지는 다 헛소리다."
msgstr ""

msgctxt "info/sgrw_34"
msgid "8 cm Granatwerfer 34(8 cm GrW 34)는 제2차 세계 대전 내내 독일군의 표준 중형 박격포였다. 극도의 정확성과 빠른 발사 속도로 명성을 얻었으나, 그 공의 상당 부분은 승무원 훈련에 돌려야 한다. 설계는 평범했고 운반을 위해 세 짐(포신, 이각, 받침판)으로 분해되었다. 포신은 활강식이었다. 이각에는 방향 조절 핸들과, 고각 조정 장치 아래에 수평 조정 핸들이 달렸다. 방향 조정기 요크에는 미세 조정용 파노라마 조준경이 장착되었다. 포신의 선은 대략적인 조준에 쓸 수 있었다. 8 cm GrW 34/1은 자주포 탑재용 개조형이다. 포신을 줄여 가볍게 만든 형식은 kurzer 8 cm Granatwerfer 42라는 이름으로 생산되었다. 이 박격포는 일반적인 8 cm 3.5 kg 고폭탄이나 연막탄을 충격 신관과 함께 사용했고, 사거리는 1km를 조금 넘었다."
msgstr ""

msgctxt "info/entity/crusaderaa2"
msgid "ZSU 자주 대공포는 1942년 \"Crusader\" 순항 전차의 차체로 만들어졌다. 차체는 그대로 두고 기본 포탑을 전용 포탑으로 교체했으며, 여기에 20mm Oerlikon 포 두 문이 쌍열로 들어갔다. 발사 속도가 뛰어나 항공기뿐 아니라 경장갑 지상 목표와 보병도 상대할 수 있었다. 부족한 장갑은 좋은 기동성으로 어느 정도 보완했다."
msgstr ""

msgctxt "info/entity/dodgewc55"
msgid "1941년 영국 Dodge는 영국군이 주문한 전륜구동 화기 운반 차량 생산을 시작했다. 이 차량은 미국 쪽 동급 차량보다 크고 엔진이 더 강력했으며 적재 용량도 더 높았다. 특수 차체 거치대로 경장갑 적 차량과 맞서는 37mm 포를 설치할 수 있었다. 적 병력에 대응하려고 Vickers 기관총을 달 수도 있었다."
msgstr ""

msgctxt "info/entity/elefant"
msgid "Elefant 구축전차는 1943년 봄 국방군에 배치되었다. 전투실에 장착한 88mm 포는 당대 가장 치명적인 무기로 여겨졌고, 대부분의 적 전차를 그 유효 사거리 밖에서 파괴할 수 있었다. 장갑은 두꺼운 곳이 200mm에 이르러 정면 공격에는 끄떡없었지만, 무게 탓에 속도가 느렸고 험지 주행 능력도 제한적이었다."
msgstr ""

msgctxt "info/entity/flak18"
msgid "88mm 포는 가장 단단한 장갑도 양철처럼 뚫는 혁신적인 포탄 구경으로 유명하다. 제2차 세계 대전 중 유럽 곳곳에서 쓰였고, 가장 유명한 곳은 노르망디(오버로드 작전)와 네덜란드 일대(마켓가든 작전)다."
msgstr ""

msgctxt "info/entity/flak38_wheeled"
msgid "Flak 38 포는 바퀴 달린 포가에 장착된 Flak-30 대공포의 발전형으로, 더 가볍고 발사 속도는 더 높았다. 국방군, 공군, SS 부대가 대공 방어에 사용했다. 그러나 보병과 경장갑 차량에도 쉽게 사용할 수 있었다."
msgstr ""

msgctxt "info/entity/gaz67b"
msgid "GAZ-67 양산은 1943년 10월에 시작되었다. 미국 쪽 동급 차량보다 눈에 띄게 무거웠지만 이 소련제 4륜구동 차량은 기동성에서 뒤지지 않았고, 높은 험지 주파 능력과 신뢰성, 단순한 구조 덕분에 Ivan-Wyllis라는 별명으로 붉은 군대 병사와 장교들 사이에서 금세 인기를 얻었다. 이 차량은 중급 지휘관과 사령부 참모의 이동, 정찰, 통신, 경포 견인에 널리 쓰였다. 일부 개량형에는 기관총 거치대가 달린 수직 지지대가 설치되었다."
msgstr ""

msgctxt "info/entity/gmc_eng"
msgid "이 트럭 안에는 장비 수리 도구, 장애물과 방어물 설치 자재, 대인 지뢰와 대전차 지뢰가 있다. 장애물은 보통 점령한 진지 앞이나 때로는 측면과 진지 사이 틈에 설치한다. 방어물은 모래주머니로 만들며 아군 보병의 진지를 보강한다. \n 이 군용 트럭은 민간 차량 ASKh-353을 개량한 것이다. 전쟁 중 이 차량 대부분은 화물 운송, 보병 재배치, 포 견인에 쓰였다. 일부 개량형은 연료 탱크 트럭으로 쓰였을 수도 있다."
msgstr ""

msgctxt "info/entity/gmc_inf"
msgid "이 트럭 안에는 수리 도구, 소화기 및 경포 탄약, 수류탄, 지뢰 등 탄약이 있다. \n 이 군용 트럭은 민간 차량 ASKh-353을 개량한 것이다. 전쟁 중 이 차량 대부분은 짐 운반, 보병 재배치, 포 견인에 쓰였다. 일부 개량형은 연료 탱크 트럭으로 쓰였을 수도 있다."
msgstr ""

msgctxt "info/entity/grant_m3"
msgid "독창적인 다단 구조 덕분에 이 미국 중형 전차는 세계에서 가장 눈에 띄는 전차 중 하나가 되었다. 차체 오른쪽에는 75mm 곡사포가, 포탑에는 두 번째 45mm 포가 달렸고, 그 위에 기관총이 든 작은 큐폴라가 하나 더 얹혔다. 전장에서 General Lee의 높은 차체는 적 포의 좋은 표적이 되었고, 비교적 강력한 무장과 장갑에도 불구하고 1942년에 생산이 중단되었다."
msgstr ""

msgctxt "info/entity/hamilcar"
msgid "Hamilcar 글라이더는 Tetrarch 경전차를 수송하는 데 쓰였다. 주로 영국 왕립 코만도가 사용했다."
msgstr ""

msgctxt "info/entity/hetzer"
msgid "이 단순하고 값싼 구축전차의 생산은 1944년 3월에 시작되어 종전까지 이어졌다. 75mm PaK 39 대전차포를 체코제 Lt38 경전차 차체에 얹어 기동성이 좋았다. 작은 크기와 낮은 높이, 경사 전면 장갑은 포탄 저항력을 높였지만, 그 대신 적재할 수 있는 탄약량에는 불리했다. 측면 방어는 부족했으나 Hetzer는 이 종류에서 가장 성공한 차량 중 하나로 널리 평가받는다."
msgstr ""

msgctxt "info/su100"
msgid "이 차량은 1944년 7월 3일 붉은 군대에 배치되었고, 기본적으로 SU-85를 발전시킨 형식이었다. 해군 대공포를 바탕으로 한 새 100mm 포는 발사 속도가 높고 탄도 성능이 뛰어나 중거리와 장거리에서 어떤 적 전차든 파괴할 수 있었다. 차체는 경사진 두꺼운 장갑판을 용접해 만들었고, 차대는 T-34/85에서 가져왔다. 훌륭한 화력과 두꺼운 장갑, 무난한 기동성이 어우러져 SU-100은 대조국 전쟁 최고의 기갑 차량 중 하나가 되었다."
msgstr ""

msgctxt "info/entity/il-2"
msgid "급강하 폭격기 Il-2는 치명적이고 성가신 존재여서 독일군의 죽음을 확실히 보장했고, 결국 독일군은 이 기체를 '하얀 죽음'이라고 부르기 시작했다."
msgstr ""

msgctxt "info/entity/is1"
msgid "이 소련 중전차는 1945년 10월 KV-85를 대체하며 생산에 들어갔다. 이름 Iosif Stalin은 이 기체가 이 부류의 선두가 되어야 함을 뜻했고, 걸린 기대에 부응했다. 무게는 전작들과 거의 같았지만 방어력이 높아졌고, 전체 주조 포탑에는 포신 길이 48.8구경의 85mm D-5T 포가 들어갔다. 이 전차는 요새화된 지역을 돌파하는 공세 작전에 쓰였고, 빽빽한 적 포화 속에서도 쉬지 않고 독일군 방어선을 부수며 움직였다. 무게는 주행 성능에 불리했지만, 그런 상황에서는 속도보다 튼튼한 장갑과 강력한 무장이 더 중요했다."
msgstr ""

msgctxt "info/sdkfz234"
msgid "SdKfz 234 장갑 전륜구동 차량은 1943년에 양산되었다. 경사진 장갑판 덕분에 차체는 포탄 파편과 보병 화기뿐 아니라 소구경 포격까지 막아 승무원을 보호했다. 그뿐 아니라 강력한 엔진으로 높은 속도를 낼 수 있었고, 무장은 적 보병과 경장갑 차량에 매우 효과적이었다. 그 덕에 \"Puma\"는 제2차 세계 대전 최고의 장갑차라는 칭호를 얻을 자격이 충분하다."
msgstr ""

msgctxt "info/entity/is2_44"
msgid "IS-2는 1943년 10월 양산에 들어갔고, 장포신 122mm 포로 멀리서 독일 전차를 파괴할 수 있어 제2차 세계 대전 소련 전차 중 가장 강력하다고 여겨졌다. 그러나 탄약이 분리 장전식이라 포의 재장전 시간이 심각하게 길었다. 항공기와 경장갑 목표에는 포탑에 장착한 대구경 기관총을 썼다."
msgstr ""

msgctxt "info/entity/is3"
msgid "소련 중전차 IS-3는 제2차 세계 대전에서 가장 강한 전차 중 하나다. 이 계열의 첫 차량은 1945년 5월 생산에 들어갔고 관동군 격파 때 첫 실전을 치렀다. IS-3를 설계할 때 전작들의 모든 결점을 자세히 분석했다. 포탑과 차체 배치를 개선하고 전면 장갑판 위치를 바꿔 결국 거의 뚫을 수 없는 전차가 되었다. 122mm 포는 적의 장비와 야전 방어 시설을 똑같은 효율로 파괴했지만, 분리 장전 방식 때문에 재장전이 매우 느렸다. 포탑에 장착한 DShK 대공 중기관총은 보병은 물론 공중 및 경장갑 지상 목표에도 성공적으로 쓰였다."
msgstr ""

msgctxt "info/entity/isu152"
msgid "ISU-152 중자주포는 1943년 11월 6일 붉은 군대에 배치되었다. 이전의 SU-152에 비해 장갑이 더 좋았고, 더 믿음직한 IS-1 전차 차대를 썼으며, 탑재한 곡사포의 유효 사거리도 길었다. 하지만 분리 장전 방식이 발사 속도에 악영향을 주어 전차 대 전차 전투 능력을 떨어뜨렸다. 그 결과 ISU-152가 쏘는 대구경 HE탄은 주로 요새 파괴와 전진하는 보병 지원에 쓰였다. 근접 공격으로부터 차량을 지키기 위해 상부에 대구경 DShK 기관총을 달았다."
msgstr ""

msgctxt "info/entity/jagdpanther"
msgid "Jagdpanther는 1944년 2월부터 양산되어 종전까지 모든 전선에서 쓰였다. Panther 전차 차대는 새 구축전차를 만드는 데 가장 알맞았다. 여기에 탄도 형태가 좋은 새 전투실과 장포신 PaK 43/3 포를 얹었고, 이 포는 먼 거리에서도 적 전차의 장갑을 관통할 수 있었다. 막강한 화력, 높은 기동성, 낮은 차체 덕분에 Jagdpanther는 가장 강력하고 유명한 구축전차 중 하나가 되었다."
msgstr ""

msgctxt "info/entity/m1mortar"
msgid "미국이 생산한 이 박격포의 설계는 프랑스 기술자 Edgar Brandt에게서 사들였다. 활강 포신은 직사각형 받침판 위에 놓이고 단순한 이각 받침대가 지지했다. 이 표준 구조 덕분에 박격포는 곡사 탄도로 파편탄, 소이탄, 조명탄을 쏠 수 있었다. 포탄 뇌관이 포신 안 고정 격침에 닿으며 발사되었다."
msgstr ""

msgctxt "info/entity/jagdtiger"
msgid "1944년 여름 국방군은 역대 가장 무거운 구축전차 Jagdtiger를 받았다. King Tiger 차대에 만들어져 극도로 무거운 것이 약점이었고 그 때문에 기동성이 낮았다. 하지만 장갑과 화력만큼은 견줄 상대가 없었다. 128mm 장포신 포는 어떤 상대든 쉽게 파괴했고, 장갑 두께는 250mm에 이르렀다."
msgstr ""

msgctxt "info/entity/m3_ally"
msgid "이 장갑 반궤도 차량은 미국에서 보병과 포를 수송하려고 제작했다. 널찍한 차체는 개방형이고 보병 8명이 탈 공간이 있으며 중기관총이 달린 특수 거치대도 있다. M3는 빠르고 믿음직해서 혹독한 전쟁 환경에 매우 알맞았다."
msgstr ""

msgctxt "info/entity/ju-52"
msgid "Ju 52 Tante Ju는 독일 공수 부대가 사용했다."
msgstr ""

msgctxt "info/entity/ju-87"
msgid "슈투카를 모르는 사람은 없다."
msgstr ""

msgctxt "info/entity/kpvt"
msgid "연약한 차량과 얇은 장갑 차량을 파괴하고 대공 임무도 수행할 수 있는 소련의 대구경 기관총. \n 대구경 ShVAK 기관총은 1944년에 개발되어 붉은 군대의 보병, 대공, 기갑 부대가 사용했다. 무게가 161kg으로 꽤 무거워서 운반을 쉽게 하려고 바퀴 달린 거치대를 쓸 수밖에 없었다. 높은 발사 속도와 화력을 겸비한 ShVAK은 적 보병과 경장갑에 효과적으로 쓰였다."
msgstr ""

msgctxt "info/entity/kv1"
msgid "가장 강력한 적 무기를 견디도록 만든 소련의 대량 생산 중전차. 느리게 움직이고 느리게 쏘므로 연료를 아끼고 측면을 지키려면 고정된 방어 진지에 배치하는 것이 가장 좋다. \n 세계 최초로 대포 방어 장갑을 갖춘 양산 전차가 1939년 12월 19일 붉은 군대에 배치되었다. 독일 Tiger가 나오기 전까지 KV-1은 사실상 무적이었다. 76mm 주포는 어떤 적 전차든 격파할 수 있었고, 독일 포는 두꺼운 전면 장갑을 전혀 관통하지 못했다."
msgstr ""

msgctxt "info/sdkfz223"
msgid "경량 4x4 전륜구동 SdKfz는 1935년부터 1944년까지 생산되었다. 주로 전차 종대 앞에서 지형을 정찰하는 데 쓰였다. 장갑차 뒤쪽에 있는 휘발유 엔진 덕분에 빠른 속도를 낼 수 있었지만, 비교적 빈약한 방어력 때문에 개활지 전투에서는 성능이 떨어졌다."
msgstr ""

msgctxt "info/entity/kv2"
msgid "직격 포탄도 견디는 장갑과 거대한 122mm 주포를 갖춘 소련의 대량 생산 중전차 '괴물'. 경차량과 요새 진지를 손쉽게 날려 버릴 수 있다. \n 1940년대 초 붉은 군대에 배치된 KV-2는 적 대전차 무기에 사실상 끄떡없었으나, 기동성과 발사 속도가 낮아 주로 공성 무기로 쓰였다."
msgstr ""

msgctxt "info/entity/kv85"
msgid "1943년 8월 8일 붉은 군대에 배치되었고 1944년 내내 전투에서 활발히 쓰였다. KV85의 낮은 기동성은 두꺼운 장갑과, 거의 모든 중형 및 중전차를 격파할 수 있는 강력한 85mm 포로 보완했다."
msgstr ""

msgctxt "info/entity/land_mattress"
msgid "1944년에 개발된 32연장 Land Mattress 다연장 로켓 발사기는 원래 해상 지원용으로 영국 전투함에 쓰였다. 이 무시무시한 포가 월헤렌 섬 전투에서 아주 효과적이어서 곧바로 이동식 지상 개량형 제작이 결정되었다. 막대한 피해를 입히며, 한 번 일제 사격은 곡사포 포대의 사격에 맞먹는 효율이었다. 이 로켓 발사기의 유일한 단점은 아마도 긴 재장전 시간이었을 것이다."
msgstr ""

msgctxt "info/entity/m114"
msgid "이 중야전 곡사포는 옛 155mm 프랑스 포를 바탕으로 설계되어 1941년에 양산에 들어갔다. 적 병력, 요새, 가까운 중요 목표에 대한 간접 사격용이었다. M114는 전장에서 훌륭한 도구임이 입증되었고, 정비가 쉽고 탄도가 좋으며 튼튼해서 미군 포병 사이에서 인기를 얻었다."
msgstr ""

msgctxt "info/entity/m16"
msgid "전쟁 초기의 전투 경험과 독일 기동 대공포의 극도로 높은 효율은 미군 수뇌부가 자체 기동 대공 체계 개발을 고민하게 만들었다. Maxson이 개량한 포탑에 Browning 기관총 네 정을 결합해 M3 다목적 장갑 차량 차대에 얹었고, 1943년 5월에는 새 차량이 미 육군에 배치되었다. 이런 대공 체계는 특수 대공 포병 대대에 편성되었고, 적 항공기, 보병, 경장갑 차량을 똑같이 효과적으로 타격했다."
msgstr ""

msgctxt "info/entity/m18"
msgid "이 18톤급 자주포는 뛰어난 속도가 특징이었고, 거의 모든 적 차량을 파괴할 수 있는 강력한 76mm 포를 갖췄다. 훌륭한 기동성과 낮은 차체 덕분에 M18은 적 포의 표적이 되기 어려웠다. 하지만 포탄 방어력이 부족해 엄폐물 뒤에서 쏴야 했다. Hellcat은 대구경 대공 기관총도 갖췄으며 미군이 이탈리아와 북서 유럽에서 활발히 사용했다."
msgstr ""

msgctxt "info/zis5art"
msgid "105~155mm 포병 구경 탄약을 실은 소련 보급 트럭. \n 3톤급 소련 ZIS-5 트럭은 1930년대 초 양산에 들어갔다. 정비가 쉽고 비교적 빠른 속도를 낼 수 있어 전쟁 중 병력과 화물 수송, 포 견인에 쓰였다."
msgstr ""

msgctxt "info/entity/m19"
msgid "이 자주 대공포는 1945년에 개발되었으며, 주로 이동 중이거나 배치 지역에 있는 차량의 대공 방어에 쓰였다. M24 \"Chaffee\" 차대 덕분에 속도와 기동성이 좋았고, 쌍열 40mm Bofors 포는 항공기뿐 아니라 적 경전차, 심지어 중형 전차까지 상대할 수 있었다. 첫 M19는 종전 무렵 준비되었으나 실전에는 투입되지 못했다."
msgstr ""

msgctxt "info/entity/m2_ally"
msgid "이 반궤도 장갑 차량은 포병 부대의 수송 수단으로 설계되었고 미국이 1941년부터 생산했다. 일부는 무기 대여 계획에 따라 소련에 인도되었다. 넓은 개방형 차체는 강철 장갑판으로 보호되었고, 강력한 엔진 덕분에 험지 주파 능력과 속도가 좋았다. 보병석에는 완전 군장 병사 8명이 앉을 수 있었고, 특수 받침에는 대구경 Browning 기관총이 설치되었다. 차량 측면과 후방에는 추가 무기 거치대가 있었다."
msgstr ""

msgctxt "info/entity/m20"
msgid "이 고속 장갑차는 1943년 3월부터 Ford가 제작했고 M8 Greyhound를 바탕으로 했다. 전작의 회전 포탑을 중기관총 M2HB용 포탑이 달린 상부 구조물로 교체했다. 그 덕에 승객 좌석과 강력한 무전기를 둘 공간이 생겼다. 낮은 방어력 때문에 M20은 지휘 및 정찰 차량으로 쓰였다. 그럼에도 승무원은 적 장갑 차량과 싸우기 위해 로켓 발사기도 갖췄다."
msgstr ""

msgctxt "info/entity/m24"
msgid "구식이 되어 가던 M3 \"Stuart\"를 대체하여 1944년 여름 미 육군에 배치되었다. 화력과 장갑에서 M24는 제2차 세계 대전의 모든 경전차를 능가했다. 75mm 포는 중형 및 중전차에 효과가 없었지만, 뛰어난 기동성 덕분에 \"Chaffee\"는 정찰과 공수 임무에 성공적으로 쓰였다."
msgstr ""

msgctxt "info/entity/m26"
msgid "중무장한 M26 Pershing은 1944년 11월 생산에 들어갔다. 전면 장갑은 Tiger와 Panther의 포격을 견뎠고, 장포신 90mm 포는 중거리와 장거리에서 적 전차를 성공적으로 파괴했다. 무거운 무게가 속도에 악영향을 주었지만, 전반적으로 다른 미국 및 영국 전차보다 효과적인 전차였다."
msgstr ""

msgctxt "info/entity/m3"
msgid "미국이 만든 다목적 장갑 병력 수송 차량으로, 완전 군장 병사를 최대 12명까지 태우고 야전급 포도 견인할 수 있다. \n 이 장갑 반궤도 차량은 1941년부터 미국이 생산했고 전차 군단과 포병 부대의 수송 차량으로 쓰였다. 일부는 무기 대여 계획에 따라 소련에 인도되었다. 널찍한 차체는 위가 열려 있다. 병사 8명이 탈 공간과 함께 대구경 기관총이 있고, 후방과 측면에 기관총을 추가로 거치할 수 있다. M3는 빠르고 믿음직해서 혹독한 전쟁 환경에 잘 맞았다."
msgstr ""

msgctxt "info/entity/maxim_1910_30"
msgid "Sokolov 거치대에 올린 Maxim 1910 기관총은 제1차 세계 대전 중 러시아 제국군이, 제2차 세계 대전 중 붉은 군대가 사용한 중기관총이다. 1910년에 채택되었고 Hiram Maxim의 Maxim 기관총에서 파생되었으며 표준 러시아 7.62x54mmR 소총탄을 쓴다. M1910은 방패가 달린 바퀴식 거치대에 올려졌고, 1943년부터 소련군에서는 바퀴식 방패 포가를 그대로 이은 SG-43 Goryunov로 대체되었다. 주력인 보병형 외에 항공기 탑재형(PV-1)과 해군형도 있었다."
msgstr ""

msgctxt "info/entity/m37"
msgid "122mm 구경의 소련 표준 야전 곡사포로 고폭탄, 연막탄, 파편탄을 쏠 수 있다. \n 전설적인 \"Sorokopyatka\"는 1938년 4월 24일 붉은 군대에 배치되었고 전쟁 초반 주력 포였다. 높은 발사 속도, 컴팩트한 설계, 낮은 방패판 덕분에 은폐하기 쉬웠고, 높은 기동성으로 포병이 진지를 빠르게 바꿀 수 있었다. 새 독일 전차가 등장한 뒤로는 대부분 구식이 되어 주로 보병 지원과 경장갑 목표에 쓰였다."
msgstr ""

msgctxt "info/entity/m3cannon"
msgid "이 경포는 1940년부터 양산되어 전쟁 초기 미군 보병의 표준 대전차 무기가 되었다. 발사 속도가 비교적 높고 기동성도 무난해 경차량과 보병을 성공적으로 상대했으나, 독일 전차의 장갑이 점점 두꺼워지면서 곧 구식이 되었다."
msgstr ""

msgctxt "info/entity/m4a1_eng"
msgid "이 미국 중형 전차는 1942년 양산에 들어갔다. 모든 전장에서 널리 쓰였고 미국의 동맹국들에 대량으로 대여되었다. 주조 차체와 복합 장갑 덕분에 M4A1은 소련 T-34만큼 방어력이 좋았고, 인체공학이 더 낫고 포탑이 더 넓었으며 기동성도 좋았다. 75mm 포는 적 경차량과 중형 차량에 효과적이었으나, Tiger와 Panther가 나타나면서 기술자들은 근대화를 고민하게 되었다."
msgstr ""

msgctxt "info/willysmb_eng"
msgid "1941년, 미국 기술자들은 짧은 기간에 믿음직하고 효율적인 군용 오프로드 차량 \"Willys\"를 개발했다. 이 차량은 좋은 평가를 받았다. 훌륭한 속도와 기동성으로 이 부류 최고 수준이었고, 수직 지지대에 대구경 기관총을 설치할 수 있어 정찰 용도로도 쓸 수 있었다."
msgstr ""

msgctxt "info/entity/m4a2_76w"
msgid "미국 기술자들은 미국 전차의 몇몇 성능 부분을 바탕으로 주력 중형 전차 M4를 계속 개조하고 개선했다. 그리하여 1944년 봄 \"General Sherman\"은 발전의 정점에 이르렀다. \"(76)W\"로 표시된 이 차량은 개량된 포탑, 보강된 전면 장갑, 강력한 장포신 76mm 대전차포를 갖췄다. 이런 혁신 덕분에 이 신형은 적 전차에 심각한 위협이 되었다."
msgstr ""

msgctxt "info/entity/m4a3c"
msgid "다연장 로켓 발사기 Calliope를 이동식으로 만들기 위해 M4 Sherman에 장착했다. 명중률이 낮아 주로 적 보병이나 차량 밀집 지역에 대한 제압 사격에 쓰였다. 로켓을 다 쏜 뒤에는 본래 임무인 전차로 돌아갈 수 있었고, 이것이 설계의 확실한 장점이었다."
msgstr ""

msgctxt "info/mg34_lafette"
msgid "MG-34는 1934년 국방군에 배치되어 휴대용, 거치형, 대공용, 전차용으로 쓰였다. 삼각대에 올린 기관총은 지상 목표와 공중 목표를 모두 사격할 수 있었다. 발사 속도는 서방의 경쟁 기종을 능가했지만, 연속 사격을 하면 총열이 금세 과열되었다."
msgstr ""

msgctxt "info/entity/m4a3e2"
msgid "이 M4 중형 전차의 특수 돌격형은 요새화된 적 방어선을 돌파하려고 설계되었다. 1944년 5월 미 육군에 배치되었고 거기서 Jumbo라는 별명을 얻었다. 포탑과 전면 차체의 두꺼운 장갑 덕분에 적 포에는 거의 끄떡없었다. 그러나 그만큼 늘어난 무게가 속도와 험지 주파 능력에 악영향을 주었다. 75mm 포는 사격 진지, 병력, 경장비와 중장비를 효과적으로 타격할 수 있었으나, 독일 중전차에는 쓸모가 없었다."
msgstr ""

msgctxt "info/sfh18"
msgid "1918년부터 생산된 SFH-18 중야전 곡사포는 제2차 세계 대전 중 국방군 부대가 적 포병, 병력, 요새, 참호선을 상대로 사용했다. 43kg HE탄을 쏘았고 아주 먼 거리에서도 막대한 피해를 입힐 수 있었지만, 무거운 무게가 기동성을 해쳤다."
msgstr ""

msgctxt "info/entity/m4a3vc"
msgid "영국의 17파운드 포로 개조한 Sherman VC는 1944년 생산에 들어갔고 전쟁 마지막 몇 달 동안 연합군이 널리 사용했다. 새 장포신 대전차포의 높은 초속 덕분에 100mm 두께의 장갑까지 관통할 수 있었다. 전차 자체의 장갑도 강화되었다. Firefly는 전장에서 좋은 성능을 보였고, 장착된 대구경 대공 기관총은 효율을 더욱 높였다."
msgstr ""

msgctxt "info/entity/m5"
msgid "1940년 말 미국 기술자들은 3인치 대공포 T9을 대전차용으로 바꾸는 계획을 시작했다. 결과물은 M5로 불렸고 1942년 12월 미 육군에 배치되었다. 포탄의 높은 초속과 훌륭한 장갑 관통력 덕분에 초기 대전차포를 대체하는 데 성공했지만, 곧 새 독일 전차에 효과가 없게 되었다."
msgstr ""

msgctxt "info/t34_0"
msgid "소련이 대량 생산한 크게 성공하고 호평받은 중형 전차. 1941년 첫 등장 때 강력한 76mm 포를 갖춰 장갑이 가장 튼튼한 적 차량과도 싸울 수 있었다. 승무원 4명. \n 유명한 T34 전차의 첫 버전은 1940년 3월 31일 양산에 들어갔다. 장갑판은 비교적 얇았지만 경사각이 커서 적 포격에 대한 차체 저항력과 전반적인 속도, 기동성이 높아졌다. 그 결과 T-34는 장갑과 무장에서 Pz.Kpfw.III, Pz.Kpfw.IV와 대등하면서도 더 빠르고 기동성이 뛰어났다."
msgstr ""

msgctxt "info/entity/m5a1"
msgid "1941년부터 1944년 사이 American Car and Foundry와 Cadillac의 Car Division은 제2차 세계 대전의 여러 전장에서 활약할 이 경전차를 엄청나게 많이 생산했다. 이 전차는 영국, 소련, 프랑스, 중국, 유고슬라비아에 공급되었다. 가볍고 작은 이 차량은 비교적 좋은 방어력을 갖췄고, 쌍발 Cadillac 승용차 엔진과 자동 변속기 덕분에 주행 성능이 완벽했다. 하지만 다소 빈약한 37mm 포와 부족한 방어력 때문에 Stuart는 적 중형 및 중장비의 상대가 되지 못했고, 정찰과 보병 직접 지원 임무에 머물렀다."
msgstr ""

msgctxt "info/entity/m7"
msgid "이 자주포는 1942년 4월부터 대량 생산되었고 주로 보병 지원 역할에 쓰였다. 105mm 야전 곡사포를 중형 M3 전차 차대에 얹고 대구경 대공 기관총을 더해 무장을 보강했다. 주포의 인상적인 화력에 두꺼운 장갑과 이 종류로서는 뛰어난 기동성이 더해졌다. Priest의 유일한 단점은 포탑이 열려 있어 승무원이 취약하다는 점이었다."
msgstr ""

msgctxt "info/entity/m72"
msgid "미국 Harley Davidson에 견줄 만한 성능의 소련 오토바이. 완전 군장 병사 3명을 태울 수 있다. \n M72 \"Dnepr\" 군용 오토바이는 붉은 군대 안에 오토바이 부대를 편성하기로 한 결정에 따라 1941년 양산에 들어갔다. 사이드카 장착형에는 7.62mm DP 기관총이 있었고, 믿음직하고 빠르다고 병사들에게 높은 평가를 받았다."
msgstr ""

msgctxt "info/willysat"
msgid "이 믿음직하고 손이 덜 가는 전지형 지프는 1941년부터 미 육군용으로 제작되었다. 뛰어난 주행 성능과 높은 험지 주파 능력 덕분에 Willys는 미군 병사들 사이에서 금세 인기를 얻었다. 일부 모델에는 로켓 유탄 발사기 한 쌍이 달린 특수 수직 지지대가 설치되었다. 덕분에 이 차량은 적 장갑 차량과 싸우며 부대에 화력 지원을 제공하는 보조 수단으로 쓸 수 있었다."
msgstr ""

msgctxt "info/entity/m8"
msgid "M5 전차 차대에 만든 경자주포로 1942년부터 생산되었다. 열린 포탑에 장착한 75mm 포는 적 전차에는 효과가 없었으나 보병 지원에는 훌륭했다. 승무원이 취약해지는 개방형 상부와 약한 장갑은 좋은 속도와 기동성으로 어느 정도 보완했다. 1944년 말 무렵에는 중형 Sherman 전차가 전장에서 M8 Scott를 완전히 대체했다."
msgstr ""

msgctxt "info/pz4g"
msgid "Pz.IV 돌격 전차의 첫 버전은 소련의 T34와 KV에 효과가 없었다. 그러나 1942년 봄, 국방군은 무장을 개량하고 거의 모든 상대를 격파할 수 있는 장포신 대전차포 Kwk40을 단 새 PzKpfw IV 전차를 받기 시작했다. 게다가 기동성이 좋아, 튼튼한 장갑과 강력한 포와 더불어 무시무시한 전투 차량이 되었다."
msgstr ""

msgctxt "info/entity/m8grayhound"
msgid "Greyhound는 1943년 초 미 육군에 배치되어 제2차 세계 대전에서 가장 널리 보급된 장갑차가 되었다. 완전 용접 차체는 경사진 강판으로 만들었으나, 얇은 장갑은 소화기만 막아 주었다. 37mm 포는 강한 상대에게 큰 위협이 되지 못했지만, 가벼운 무게와 전륜구동 덕분에 속도와 조종성이 뛰어나 병사들에게 큰 인기를 얻었다."
msgstr ""

msgctxt "info/entity/maxim"
msgid "러시아 Maxim을 잘 모름/위키백과 찾아보기 귀찮음."
msgstr ""

msgctxt "info/mg34_stan"
msgid "MG-34는 1934년 국방군에 배치되어 휴대용, 거치형, 대공용, 전차용으로 쓰였다. 삼각대에 올린 기관총은 지상 목표와 공중 목표를 모두 사격할 수 있었다. 발사 속도는 서방의 경쟁 기종을 능가했지만, 연속 사격을 하면 총열이 금세 과열되었다."
msgstr ""

msgctxt "info/mk2a"
msgid "연합군은 1940년 Matilda를 배치하기 시작했다. 이 영국 보병 전차의 개념은 속도와 화력을 희생하고 장갑을 강화하는 것이었다. 실제로 독일의 37mm 대전차포는 Matilda의 장갑을 관통하지 못했지만, 약한 무장과 낮은 기동성 때문에 전차 대결에서는 성능이 좋지 못했고 주로 보병 지원 역할에 머물렀다."
msgstr ""

msgctxt "info/mk2daimler"
msgid "Daimler는 1939년에 개발되었고 제2차 세계 대전 영국 바퀴식 장갑차 중 가장 성공한 차량으로 여겨졌다. 경사각이 좋은 용접 차체는 승무원을 총탄과 파편에서 보호했고, 6기통 기화기 엔진과 전륜구동은 뛰어난 속도와 기동성을 주었다. 완전 회전 포탑에는 기관총과 40mm 포가 있어 경장갑 목표를 상대할 수 있었다."
msgstr ""

msgctxt "info/mk3"
msgid "1940년에 배치된 이 영국 보병 전차는 무게가 16톤이라 경전차로 볼 수 있었지만 장갑은 일부 중형 전차를 능가했다. \"Valentine\"은 단순한 구조와 믿음직한 엔진이 특징이었지만, 무장이 약해 대부분의 적 전차를 상대하지 못했다. 모든 전선에서 보병 지원 역할로 널리 쓰였다."
msgstr ""

msgctxt "info/mk6"
msgid "20톤급 Crusader 순항 전차의 양산은 1940년에 시작되었다. 기동성이 높고 장갑도 좋은 이 차량은 북아프리카에서 처음 등장해 Rommel의 아프리카 군단에 실질적인 위협이 되었다. 1942년 개량형은 당시 거의 모든 전차를 파괴할 수 있는 철갑탄용 57mm 포를 달았다. 하지만 독일이 더 새롭고 장갑이 두꺼운 차량을 도입하면서 효율이 떨어졌다."
msgstr ""

msgctxt "info/mk7"
msgid "영국의 가장 독창적인 군사 계획 중 하나는 1930년대 Vickers-Armstrong Limited가 전형적인 순항 전차로 개발했다. Tetrarch는 높은 기동성과 조종성, 극도로 낮은 무게가 특징이었고, 덕분에 공수 작전에 쓸 수 있었다. 40mm 포의 철갑탄은 적 경차량에 효과적이었다. 그러나 자체의 얇은 장갑은 대구경 탄에서 승무원을 지키지 못했다."
msgstr ""

msgctxt "info/ml_3_inch_mk_ii"
msgid "1920년 영국 육군에 채택된 이 3인치 보병 박격포는 공격하는 보병과 방어하는 보병에게 화력 지원을 제공하는 데 자주 쓰였다. 발사 속도가 높고 구조가 단순해 인공 엄폐물이나 자연 엄폐물 아래에서도 사격 준비 시간이 가장 짧았다."
msgstr ""

msgctxt "info/nashorn"
msgid "Nashorn 구축전차의 양산은 1943년 2월에 시작되어 종전까지 이어졌다. 88mm 포는 적 전차에 거의 기회를 주지 않았다. 뛰어난 기동성과 맞물려 \"Rhinoceros\"는 무시무시한 무기가 되었다. 전면 장갑은 충분히 두꺼웠지만, 개방형 전투실과 거의 수직인 측면 장갑판은 승무원을 충분히 지켜 주지 못했다."
msgstr ""

msgctxt "info/nebelwerfer42"
msgid "이 로켓 포병 발사기는 1944년 6월 등장했고 성공적인 설계 덕분에 곧 국방군 부대에서 널리 쓰이며 비슷한 다른 독일 포들을 밀어냈다. 300mm 로켓용 유도 레일 골조가 바퀴 달린 포가에 설치되었고, 발사 후 폭발하는 로켓은 엄청난 파괴력을 내어 요새를 부수고 적 보병과 장비에 큰 손실을 입혔다."
msgstr ""

msgctxt "info/oerlikon"
msgid "이 20mm Flak 기관포는 스웨덴에서 개발되었고 제2차 세계 대전에서 가장 널리 쓰인 대공포가 되었다. 다루기 쉽고 발사 속도가 높아 인기를 얻었으며, 1939년에 영국군이, 1941년에 미 해군이 배치했다. Oerlikon은 공중과 지상 목표 모두에 쓰였고 보병과 경장갑 차량에 효과적이었다."
msgstr ""

msgctxt "info/p-51mustang"
msgid "머스탱을 모르는 사람은 없다."
msgstr ""

msgctxt "info/pak35"
msgid "PaK 35 포는 적 차량 공격, 화기 진지 파괴, 노출된 병력 제거에 쓰였다. 반자동 쐐기식 포미 덕분에 발사 속도가 높았고, 철갑탄은 당시의 경장갑 차량을 중거리에서 쉽게 격파했다. 제2차 세계 대전 초기에 이 포는 국방군 보병 사단에 주력 대전차 무기로 지급되었으나, 전차 장갑이 두꺼워지면서 효과가 없어졌다."
msgstr ""

msgctxt "info/sturmpz1"
msgid "자주포 Bison Sturmpanzer I은 1940년 독일군에 배치되었다. 기본적으로 150mm sIG-33 중포를 Pz.I의 차체 위에 얹은 것이다. 이 포는 주로 요새와 방어가 두꺼운 지역을 파괴하는 데 쓰였다. 장갑판은 승무원을 파편과 총탄에서 부분적으로 막아 주었지만 포격은 막지 못했다."
msgstr ""

msgctxt "info/pak40"
msgid "이 계열의 포는 1942년 봄 동부전선에 처음 나타났다. PaK 40은 전차와 장갑차를 상대하도록 설계됐지만, 구경이 꽤 크고 고폭탄을 쓸 수 있어 화기 진지 제압, 경방어 시설 파괴, 적 병력 제거에도 쓰였다. 명중률과 유효 사거리는 소련의 ZIS-3 야포보다 뛰어나다."
msgstr ""

msgctxt "info/pdr25_arty"
msgid "구식 18파운드포를 바탕으로 영국 기술자들이 25파운드 포-곡사포를 개발했다. 11kg짜리 고폭탄을 먼 거리까지 쏠 수 있었다. 망원 조준경 덕에 적 전차를 직접 조준 사격하는 데도 크게 쓸모가 있었고, 커다란 방패판이 승무원을 총탄과 파편에서 지켜 주었다. 전장에서 훌륭한 성능을 보여 사거리와 인상적인 파괴력으로 인정받았다."
msgstr ""

msgctxt "info/pdr25"
msgid "구식 18파운드포를 바탕으로 영국 기술자들이 25파운드 포-곡사포를 개발했다. 11kg짜리 고폭탄을 먼 거리까지 쏠 수 있었다. 망원 조준경 덕에 적 전차를 직접 조준 사격하는 데도 크게 쓸모가 있었고, 커다란 방패판이 승무원을 총탄과 파편에서 지켜 주었다. 전장에서 훌륭한 성능을 보여 사거리와 인상적인 파괴력으로 인정받았다."
msgstr ""

msgctxt "info/panzer1b"
msgid "1943년 7월부터 대량 생산된 Pz.I 경전차는 6기통 마이바흐 엔진 덕에 빠르고 기동성이 좋았고, 포탑에 단 쌍열 기관총은 적 보병을 상대하는 데 훌륭한 수단이었다. 하지만 얇은 장갑과 주포의 부재로 전차전에서는 쓸모가 없었다."
msgstr ""

msgctxt "info/pz2l"
msgid "국방군의 마지막 경전차는 1942년에 생산을 시작했다. Lynx는 20mm 자동포와 얇은 장갑 때문에 적 전차에 큰 위협은 못 됐지만, 6단 변속기 덕에 빠른 속도를 낼 수 있었다. 이 장점 덕에 정찰 임무에 알맞아 그에 걸맞은 평가를 받았다."
msgstr ""

msgctxt "info/pz3m"
msgid "독일 공병은 지뢰밭을 개척하려고 특수 지뢰 롤러를 개발했다. Pz.Kpfw.III 전차 차체에 달면 지뢰밭을 피해 없이 통과할 수 있었고, 이렇게 열린 통로는 보병과 일반 전차가 이용했다. 무장은 기관총 하나뿐이었다."
msgstr ""

msgctxt "info/pz4e"
msgid "1940년 9월부터 생산된 Pz.IV Ausf.E는 30mm 장갑판에 30mm 방패를 덧대 강화했다. 하지만 이 개량은 기대한 효과를 내지 못했고, Pz.IV의 짧은 포신은 소련 KV와 T-34 전차의 장갑을 여전히 뚫지 못했다. 오히려 이들이 방어가 허술한 이 차량을 손쉽게 격파했다. 그래도 Pz.IV Ausf.E는 보병 지원 수단으로는 계속 쓸모가 있었다."
msgstr ""

msgctxt "info/pz4h"
msgid "1943년 4월, 가장 많이 쓰인 독일 전차의 또 다른 개량형이 전면에 나섰다. 이 차량은 강화된 장갑과 개선된 무장으로 이전 형과 구별된다. 장갑 두께는 80mm였고 측면에 단 증가장갑은 고폭탄으로부터 믿을 만한 방호를 제공했다. 새 장포신 Kwk40 L/48은 뛰어난 전투 성능을 자랑해 적 중형 전차와의 싸움에서 큰 성과를 올렸다."
msgstr ""

msgctxt "info/qf17"
msgid "이 장포신 17파운드포는 오랫동안 같은 급에서 최고로 평가받았다. 적의 최신 중전차가 북아프리카에 나타난 바로 그 무렵 영국 육군에 채택돼, 최대한 빨리 대량 생산에 들어갔다. 높은 철갑 성능과 뛰어난 탄도 특성 덕에 QF 17은 먼 거리에서도 거의 모든 독일 차량을 파괴할 수 있었다. 다만 포가 지나치게 무거워 운반이 매우 힘들었다."
msgstr ""

msgctxt "info/qf2"
msgid "1936년에 개발된 영국의 2파운드포는 같은 급에서 가장 뛰어난 포 가운데 하나로 평가받았다. 전쟁 초기에는 QF2가 적 장갑차와 경전차, 중형 전차를 상대로 성공적으로 쓰였다. 그러나 방어력이 더 높은 전차가 등장하면서 효율이 급격히 떨어졌다."
msgstr ""

msgctxt "info/r12"
msgid "독일 오토바이 중 가장 성공한 모델 하나가 1934년에 대량 생산에 들어갔다. 빠르고 MG-34 기관총(사이드카에 설치)으로 무장한 R-12는 국방군 기계화 부대에서 큰 인기를 얻었다."
msgstr ""

msgctxt "info/sdkfz222"
msgid "이 4 x 4 경장갑차는 1936년에 생산을 시작했다. 주행 성능이 좋아 독일군에게 큰 인기를 끌었고 제2차 세계대전 초기 전투에서 널리 쓰였다. 작은 회전 포탑에 단 자동포와 20mm 기관총이 어우러져 적 병력과 경장갑 장비를 효과적으로 공격했다. 그러나 SdKfz 222는 방호가 부족해 정찰 및 지원 장비로 격하됐다."
msgstr ""

msgctxt "info/sdkfz251_1"
msgid "SdKfz 251 반궤도 장갑차는 1939년 여름 국방군에 배치됐다. 독소 전선에서 병력 수송 수단으로 널리 쓰였지만 지붕이 열려 있어 승무원이 충분히 보호받지 못했다. 병력실에는 좌석 외에 기관총 여러 정을 거치할 수 있는 장치가 있었다. 하노마크 엔진 덕에 9톤짜리 이 차량이 빠른 속도를 낼 수 있었고, 경사 장갑판이 탑승 보병을 어느 정도 지켜 주었다."
msgstr ""

msgctxt "info/sdkfz4"
msgid "네벨베르퍼의 로켓 일제 사격 때 생기는 연기 꼬리가 위치를 드러내 반격에 매우 취약했기 때문에, 이 무기를 이동식 플랫폼에 싣기로 했다. 로켓 발사기를 얹은 Sdkzf.4의 첫 형식은 1944년 초 국방군에 배치됐다. 방탄 장갑과 괜찮은 기동성으로 차량의 전반적인 생존력이 올랐고, 150mm 로켓 열 발의 일제 사격은 적에게 엄청난 피해를 줄 수 있었다."
msgstr ""

msgctxt "info/sdkfz7_1"
msgid "기본적이지만 효과적인 이 이동식 대공 체계는 1940년에 양산에 들어갔다. 표준형 독일 반궤도 장갑차 차체에 4연장 Flakvierling 38 대공포를 얹은 형태였다. 이 20mm 자동포는 분당 최대 1,800발을 쏠 수 있어 저공 비행하는 적 항공기, 보병, 경장갑 장비를 성공적으로 타격했다. 반면 조종석 방호가 약해 포 승무원이 취약했고, 그 때문에 개활지 전투에서 큰 손실을 입었다."
msgstr ""

msgctxt "info/stug4g"
msgid "PzKpfw IV 차체에 올린 Stug 돌격포는 1943년 12월 생산에 들어갔으며, 주로 적의 반격을 막는 방어 수단으로 쓰였다. 낮은 차체와 튼튼한 경사 전면 장갑이 생존력을 높였고, 포탑에 단 75mm 포와 어우러져 최대 효율로 전투 목표를 달성할 수 있었다. 방어력을 더 높이려고 측면에는 대HEAT 장갑판을 자주 달았다."
msgstr ""

msgctxt "info/stuh42"
msgid "StuG III 자주포 차체와 전투실을 이용한 돌격 곡사포의 양산은 1943년 3월에 시작됐다. Sturmhaubitze 42는 쿠르스크 돌출부에서 처음 전투에 나섰고 이후 아프리카와 서유럽에서도 성공적으로 활약했다. 이 포가 쏘는 105mm 포탄은 적의 경야전 방어 시설과 벙커를 파괴하는 데 꽤 효과적이어서, 요새화 지역을 공격할 때 없어서는 안 될 차량이었다. 장갑이 좋은 이 자주 곡사포는 돌격포 대대에 배치돼 전장에서 보병과 전차를 직접 지원했다."
msgstr ""

msgctxt "info/sturmtiger"
msgid "동부전선 작전을 통해 독일은 적군의 요새와 장기 방어 시설을 신속히 파괴할 수 있는, 방호가 좋은 자주 돌격포가 절실히 필요함을 알게 됐다. Pz.IVe 중전차의 차체가 이 요구를 모두 충족해 새 차량이 거의 변경 없이 그대로 물려받았다. 포탑 대신 두꺼운 장갑판을 전략적으로 배치해 만든 고정 전투실이 설치돼, 개조한 380mm Raketenwerfer 61 해군 로켓 발사기가 들어갔다. 1944년 8월 바르샤바 봉기 때 Sturmtiger 첫 시제차가 시험 투입됐다. 이 자주포는 요새 파괴와 적 사격 진지 무력화에 훌륭한 무기임을 입증했다. 다만 무거운 장갑이 주행 특성에 나쁜 영향을 주었다."
msgstr ""

msgctxt "info/su122"
msgid "이 소련 자주포는 기록적인 속도로 개발됐다. 설계 착수부터 붉은 군대 채택까지 한 달이 채 걸리지 않았다. 대구경 고폭탄은 피해와 파괴 효과가 컸고, 덕분에 SU-122는 야전 방어 시설뿐 아니라 적의 장기 요새 구조물과도 싸울 수 있었다. T-34 중형 전차의 차체 덕에 기동성이 뛰어났고, 낮은 차체와 꽤 좋은 장갑이 어우러져 생존력에 긍정적인 영향을 주었다. 이런 자주포는 보통 진격 부대의 후방 제대에서 움직였지만, 적 보병과 싸울 기관총이 없다는 점이 큰 약점이었다."
msgstr ""

msgctxt "info/su76"
msgid "SU-76은 1942년 가을에 양산에 들어갔다. 경전차 T-70의 차체 덕에 속도와 기동성이 뛰어났고, 포탑에 단 ZIS-3 야포는 전투에서 훌륭한 성능을 보였다. 유일하고 중대한 단점은 불완전하고 약한 장갑이었다. 그래도 SU-76은 적 경전차와 중형 전차를 격파하는 데 성공을 거두었다."
msgstr ""

msgctxt "info/su85"
msgid "1943년에 만들어진 SU-85 자주포는 당시 등장하던 Tiger와 Panther 전차와 싸우도록 설계됐다. 개량된 85mm D-5S 대공포를 T34 차체 위에 얹어, 차체의 뛰어난 속도와 기동성에 강력한 화력을 더했다. SU-85는 주로 T-34와 진격하는 보병을 화력으로 지원하는 데 쓰였다."
msgstr ""

msgctxt "info/t26"
msgid "저속 소구경 주포를 단 소련 경전차. 승무원 3명. \n 포탑이 둘인 Vickers-E 전차가 1931년 2월 13일 붉은 군대에 배치됐다. 이 전차는 T-26으로 명명됐고, 1939년부터는 45mm 포와 경사 차체 장갑판을 갖춘 단포탑형으로 생산됐다. 전쟁이 시작될 무렵 이미 구식이 됐지만, 일부는 정찰 임무와 보병 지원에 계속 쓰였다."
msgstr ""

msgctxt "info/t34_1"
msgid "소련이 대량 생산한 T34 전차 1형. 당시 전장의 어떤 장갑 전투 차량과도 맞먹거나 능가하도록 포를 강화했다. 빠르고 민첩하며 전례 없는 속도를 낼 수 있어, 적 방어선을 파고드는 돌파용 차량으로 가장 알맞다. \n 이 형식은 장포신 대전차포를 달아 장갑 관통력과 탄도 특성에서 뛰어난 독일 KwK40과 겨룰 수 있었다. 장갑과 차체는 그대로였다. 30도로 기울인 장갑판이 비교적 얇은 차체에 포격에 대한 좋은 저항력을 주었고, 500마력 디젤 엔진이 뛰어난 속도와 기동성을 보장했다."
msgstr ""

msgctxt "info/t34_2"
msgid "소련이 대량 생산한 T34 전차 2형. 포와 장갑을 강화하고 무전기와 더 큰 포탑까지 갖췄다. \n 1943년형은 이전 형보다 장갑이 개선되고 포탑이 6각형으로 넓어졌다. 덕분에 설계자들은 개량된 76mm F34 포를 달고 탄을 더 실을 수 있었다. 이런 변화는 가장 유명한 소련 중형 전차인 T34의 이미 뛰어난 장점, 곧 속도와 기동성에 영향을 주지 않았다."
msgstr ""

msgctxt "info/t34_3"
msgid "소련이 대량 생산한 T34 전차 3형. T34 계열의 마지막 개량형이며, 실전에서 단련된 이 형식은 매우 강력한 주포와 포탑 상부 구조 등 공격 면의 혁신을 모두 갖췄다. 이 차량은 공격을 이끄는 군대의 선두에 서는 것이 가장 어울린다. \n 이 개량형은 1944년 1월 23일 붉은 군대에 배치됐다. 강력한 85mm 대전차포를 달기 위해 포탑 설계를 바꿔 더 크고 더 두껍게 방호했다. 측면과 후면 장갑도 강화했고, 가파른 경사각과 어우러져 차체의 내탄성이 크게 올랐다. 그 결과 T-34의 무게는 32톤으로 늘고 속도는 약간 느려졌지만 전투 효율은 크게 높아졌다."
msgstr ""

msgctxt "info/t34m"
msgid "T34 차체를 바탕으로 만든 소련 지뢰 제거 차량. 기관총 1정으로 무장. 승무원 3명. \n 지뢰밭을 처리하려고 특별히 설계한 T34 개량형으로, 전방 플랫폼에 롤러 두 개를 단 PT-3 지뢰 제거기를 도입했다. 포탑은 불필요하다고 여겨져 흔히 떼어 내, 차량에는 기관총만 남았다."
msgstr ""

msgctxt "info/t70"
msgid "제2차 세계대전에서 가장 많이 생산된 소련 경전차는 1942년 1월 붉은 군대에 배치됐다. 이전 형보다 장갑이 개선되고 차체가 낮아졌으며 기동성이 높아졌다. 조용한 엔진 덕에 속도가 뛰어났고 적 후방에 몰래 접근할 수 있어, T70은 45mm 포로 적의 가장 취약한 부분을 공격할 수 있었다. 반면 모든 구경의 탄에 대한 방호가 부실해 적 포의 좋은 표적이 됐고, 그래서 정찰과 보병 직접 지원에만 쓰였다."
msgstr ""

msgctxt "info/welberwind"
msgid "Pz.IV 차체를 바탕으로 한 Wirbelwind 자주 대공포는 1944년에 개발됐다. 장갑은 전차와 같았고, 포탑을 떼고 지붕이 열린 9각형 전투실에 4연장 20mm Flak 38 포를 올렸다. Wirbelwind는 저공 비행하는 공중 목표에 좋은 성능을 보였고, 필요하면 적 보병을 파괴하는 데도 쓸 수 있었다."
msgstr ""

msgctxt "info/willysmb"
msgid "미국 회사 세 곳, Willys, Ford, Bantam이 짧은 기간에 군용으로 믿을 만하고 효율적인 오프로드 차량을 개발했다. 생산은 1941년에 시작됐다. 곧 전장에서 가치를 증명했는데, 뛰어난 속도와 대구경 기관총을 달 수 있다는 점 덕에 Willys는 제2차 세계대전 최고의 군용 차량 중 하나가 됐다."
msgstr ""

msgctxt "info/zis_30"
msgid "1941년, Komsomolet 장갑 트랙터 약 백 대를 개량해 57mm 장포신 포를 얹은 지붕 없는 자주 차량으로 개조했다. 새 차량은 ZiS-30이라는 이름을 받았고 9월 말에는 전선에 투입됐다. 이 대전차포는 적 경장비와 중장비를 상대하는 데 훌륭했지만, 조종석 방호가 부족하고 승무원이 매우 취약해 첫 출격에서부터 이 자주포들은 큰 손실을 입었다."
msgstr ""

msgctxt "info/zis2"
msgid "소련의 고출력 대전차 야포 2형. 57mm 구경, APC형 탄이 추가됐다. \n ZIS-2 대전차포는 1941년 6월 1일 양산에 들어갔으나 곧 생산이 중단됐고, 독일의 Tiger와 Panther 전차가 전장에 나타나서야 재개됐다. 특별히 설계한 폐쇄기 덕에 이 장포신 포는 높은 발사 속도를 보였고 가볍고 작기까지 했다. 57mm 철갑탄은 육중한 독일 전차도 관통할 수 있었다. 이런 장점에도 고폭탄은 위력이 많이 부족해 ZIS를 적 병력이나 요새에 쓰는 데는 제약이 있었다."
msgstr ""

msgctxt "info/zis3"
msgid "소련의 성능 좋은 대전차 야포. 76mm 구경, APC형 탄이 추가됐다. \n ZIS-3은 세계 최초로 컨베이어 방식으로 조립한 포다. 포병 전문가들에게 높은 평가를 받았고 1942년 2월 12일 붉은 군대에 배치됐다. 철갑탄은 중거리에서 70mm 장갑을 관통했고, 고폭탄은 높은 저지력과 넓은 피해 반경을 보였다."
msgstr ""

msgctxt "info/zis5"
msgid "보급품, 병력, 중화기 견인을 맡는 소련의 다목적 트럭. \n 3톤급 소련 ZIS-5 트럭은 1930년대 초에 양산에 들어갔다. 정비가 쉽고 비교적 빠른 속도를 낼 수 있어, 전쟁 중 병력, 화물 수송과 포 견인에 쓰였다."
msgstr ""

msgctxt "info/zis5eng"
msgid "이 트럭 안에는 장비 수리 도구, 장애물과 방어물을 짓는 자재, 대인지뢰와 대전차지뢰가 들어 있다. 장애물은 보통 점령한 진지 앞이나 측면, 진지 사이 틈에 세운다. 방어물은 모래주머니로 만들며 아군 보병의 진지를 보강한다. \n 소련의 3톤급 ZIS-5 트럭은 1930년대에 대량 생산됐다. 까다롭지 않으면서도 꽤 빠른 속도를 낼 수 있어, 전쟁 중 병력, 화물, 포 수송에 쓰였다. 구급차와 유조차로도 쓰였다."
msgstr ""

msgctxt "info/zis5inf"
msgid "이 트럭 안에는 수리 도구, 소화기와 경포 탄약, 수류탄, 지뢰 등 각종 탄약이 들어 있다. \n 소련의 3톤급 ZIS-5 트럭은 1930년대에 대량 생산됐다. 구조가 단순한데도 꽤 빠른 속도를 낼 수 있어, 전쟁 중 병력, 화물, 포 수송에 쓰였다. 구급차와 유조차로도 쓰였다."
msgstr ""

msgctxt "info/zsu37"
msgid "지상 근접 대차량·대보병 자주 무기 플랫폼, 소련제. Su76 차체를 쓰고 37mm 속사포로 무장했다.\n SU-76 차체를 바탕으로 한 자주 대공포. 1945년 붉은 군대에 배치됐다. 37mm 대공포는 적 항공기뿐 아니라 경전차, 심지어 중형 전차에도 쓸 수 있었다. 약한 장갑은 좋은 속도와 기동성으로 충분히 보완됐다."
msgstr ""
