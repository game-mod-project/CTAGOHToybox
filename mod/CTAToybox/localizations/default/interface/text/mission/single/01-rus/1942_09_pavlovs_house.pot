msgctxt "mission/single/01-rus/1942_09_pavlovs_house/180"
msgid "포격"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/date"
msgid "1942년 9월 27일 · 스탈린그라드"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/name"
msgid "파블로프의 집 <c(a655af)>[DLC]</c>"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/name_big"
msgid "파블로프의 집"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/01"
msgid "사랑하는 스탈린그라드가 어떻게 되었단 말인가? 도시의 거리는 폐허다... 거의 모든 것이 무너졌다."
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/02"
msgid "동지들, 나는 제62군의 지휘를 맡았다. 말해 두겠다. 스탈린그라드가 우리의 운명을 결정한다! 나는 파시스트들을 스탈린그라드 밖으로 막아내거나, 그러다 죽겠다. 볼가강 너머에는 땅이 없다!"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/03"
msgid "자네들이 보급도 없이 전선에 불려 나왔다는 걸 안다. 무기와 탄약이 필요하다. 먼저 이 문제부터 해결하겠다. 근처에 독일군 보급소가 있다는 것이 확실하다."
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/04"
msgid "다음 목표는 이 일대를 전부 내려다보는 전략적 아파트 건물을 점령하는 것이다."
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/05"
msgid "처참한 손실 때문에 제166호 명령을 발동했다. 공세는 기관단총, 수류탄, 대전차 소총을 갖춘 소규모 집단으로 편성한다. 이 건물을 점령하는 것이 자네들의 임무다, 동지들. 건물이 자네들 손에 들어오면 증원을 얻어 보내 보겠다."
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/06"
msgid "잘했다, 동지들. 이 건물 주위에 진지를 잡아라. 독일군은 반드시 이런 전략적 요충지를 되찾으려 할 것이다."
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/07"
msgid "제3기관총 중대의 Lieutenant 아파나시예프를 보내 자네들 진지를 보강하겠다. Sergeant 파블로프, 자네가 계속 이 집단을 지휘한다. 건물을 안전하게 지켜라!"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/08"
msgid "악명 높은 저격수를 보내 자네 병사들을 보강하겠다, 파블로프 동지. 젊지만 파시스트 무리 사이에서 이름이 높다. 그를 살려서 안전하게 지켜라."
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/09"
msgid "동지들, 독일군이 두고 간 공병 보급품을 찾았다. 건물 접근로를 보강해서 방어력을 높이도록 명령한다."
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/10"
msgid "우리의 방어를 무너지지 않게 만들어라! 파도가 화강암 바위에 부서지듯, 파시스트 군대의 모든 맹공이 이 장애물에 부서질 것이다!"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/11"
msgid "그렇다, 동지들. 우리가 이기고 있다. 독일 병사 하나하나가 러시아의 총구 아래 살고 있다고 느끼게 만들어야 한다."
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/12"
msgid "독일 포병이 자네들 진지 아주 가까이에 배치돼 볼가강의 우리 상륙지점을 위협하고 있다. 놈들을 제거해라, 동지들!"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/13"
msgid "잘했다, 병사들. 지상에 이런 지옥이 열릴 수 있다는 걸 믿지 못했을 것이다. 자네 병사들은 죽었지만 물러나지 않았다. 대단하다."
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/narrator/chuikov/14"
msgid "적이 파블로프의 집 안에 있는데 방치했군! 상황을 뒤집을 시간을 1분 주겠다, 아니면 끝장이다! 다시는 이런 일이 없게 해라!"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/outro_completed"
msgid "훌륭하다! 지도력과 끈기를 보여 준 놀라운 활약이었다. 자네는 불리한 상황을 이겨내고 파시스트들이 이번 작전의 최대 목표인 스탈린그라드를 차지하는 것을 막아냈다. 자네는 진정한 소련의 영웅이다. 제복을 빨아 다려 두는 게 좋겠다, 기념식이 있을 것이다!"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/outro_failed"
msgid "극적인 전투의 극적인 결말이다. 이제 어떻게 하나? 파시스트들이 스탈린그라드를 장악하게 두는가? 추이코프 장군이 이 소식을 좋아하지 않을 것이다. 다시 들어가야 하고, 이번에는 그 집을 지켜내야 한다. 포기하지 마라, 볼가강 너머에는 땅이 없다!"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/place"
msgid "제62군 제13근위소총사단"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/story"
msgid "독일 B집단군이 "한 걸음도 물러서지 마라"는 스탈린의 제227호 명령에도 불구하고 스탈린그라드에 도달했다. 이미 9월, 시가전은 암울한 일상이 되었다.\n\n추이코프 장군이 지휘하는 소련 제62군은 볼가강 서안의 몇 안 되는 작은 교두보에 매달리고 있다.\n\n독일군이 볼가강에 닿으려면 먼저 파블로프의 집을 넘어야 한다!\n\n이번 임무에서 추이코프 장군이 병사들과 함께 집을 점령하는 방법을 지시한다. 집을 완전히 장악하는 즉시 모든 층과 모든 위치를 파시스트의 불가피한 다음 공격에 대비해 준비하라. 다음 보급이 도착할 때까지 집을 지켜라. 자비를 베풀지 마라.\n\n조국을 위하여!"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/task1"
msgid "전략 건물을 확보하라"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/task2"
msgid "무슨 일이 있어도 건물을 지켜라!"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/task3"
msgid "볼가강 상륙지점을 위협하는 적 포병을 제거하라"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/task4"
msgid "Sergeant 야코프 파블로프는 반드시 살아야 한다!"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/task5"
msgid "저격수 아나톨리 체코프를 살려 두어라."
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/task_supply"
msgid "보급품을 확보하라"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/timer"
msgid "독일군 반격까지:"
msgstr ""

msgctxt "mission/single/01-rus/1942_09_pavlovs_house/mission_heal_pavlov"
msgid "Sergeant 야코프 파블로프가 과다출혈로 죽기 전에 치료하라!"
msgstr ""
