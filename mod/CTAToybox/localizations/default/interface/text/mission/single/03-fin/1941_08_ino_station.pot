msgctxt "mission/single/03-fin/1941_08_ino_station/date"
msgid "1941년 8월 31일 · 핀란드 이노"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/men"
msgid "병사를 모두 잃었다!"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/name"
msgid "스탈린의 대포"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/name_big"
msgid "스탈린의 대포"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/narrator/officer/01"
msgid "병사들, 적은 후퇴 중이지만 공군의 보고에 따르면 진격이 멈췄다. 핵심 장비를 빼앗아 전세를 뒤집을 절호의 기회다!"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/narrator/officer/02"
msgid "오늘 목표는 소련의 장거리 열차포 한 세트를 노획하는 것이다! 숲을 지나 북쪽으로 이동해 철로에 닿을 때까지 가서 다음 지시를 기다려라!"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/narrator/officer/03"
msgid "적과 불필요한 교전은 피해라. 낭비할 병력이 없다. 목표에만 집중해라!"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/narrator/officer/04"
msgid "좋아, 철로를 따라 동쪽에서 열차포를 찾았다! 노획을 피하려고 파괴하려는 것 같다. 열차포 한 문은 이미 폭파됐다! 서둘러 적을 압도하고 마지막 남은 포를 확보해라!"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/narrator/officer/05"
msgid "잘했다, 포는 우리 손에 들어왔다. 다행히 탄약이 장전된 채로 있다. "
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/narrator/officer/06"
msgid "이제 포를 안전하게 철수시켜야 하는데 마을의 적 병력이 작전을 위협하고 있다. 이 마을에서 소련군을 몰아내라. 필요한 수단은 무엇이든 써라, 필요하면 마을을 평지로 만들어라!"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/narrator/officer/07"
msgid "적은 열차포를 잃어서 불만이 큰 모양이다. 관측병이 자산을 되찾으려고 이쪽으로 오는 적 종대를 포착했다. 위치를 사수하고 적이 포를 파괴하지 못하게 막는 것이 절대적이다."
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/narrator/officer/08"
msgid "방어 능력을 보강하도록 추가 증원을 보낸다."
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/narrator/officer/09"
msgid "적 종대가 도착했다! 전부 쓸어버려라!"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/narrator/officer/10"
msgid "적이 남쪽 해안에 상륙 공격을 시작했다! 해변으로 가서 상륙정을 제거해라!"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/narrator/officer/secret"
msgid "어디 보자, 이게 뭐지? 소련군이 뭔가 잃어버린 모양이군."
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/outro_completed"
msgid "해냈다! 이제 중포 두 문과 열차 한 대분의 탄약이 생겼다. 대단한 성과다, 승진이 멀지 않았을 것이다. 열차포는 내일 아군 전선으로 견인될 것이고, 이전 주인에게 쓰는 데도 오래 걸리지 않을 것이다. 잘했다!"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/outro_failed"
msgid "상당한 타격이다. 중화기를 노획할 기회를 놓쳤으니 적이 우리에게 쓰지 않기를 바랄 뿐이다. 이 동남쪽 30킬로미터 지점의 자체 요새선을 지원하려고 열차포를 재배치할 수도 있다. 다시 시도해야 한다, 방법이 없다, 그러지 않으면 전략 계획 전체가 틀어진다!"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/place"
msgid "제4군단"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/story"
msgid " 핀란드군이 레닌그라드를 향해 진격하고 있다. 이노 역에서는 파괴된 기관차가 철로를 막아 소련군이 발이 묶여 있다. 발이 묶인 부대 중에는 열차포 두 문과 승무원이 있다. 전선에서 철수해야 하지만 이동 명령이 너무 늦게 도착했다. 그때 핀란드군이 도착하고 역은 치열한 투쟁의 현장이 된다.\n\n 이 임무에서 당신은 공격을 맡는다. 전술 능력을 발휘해 소련군 방어선을 무너뜨려라. 저 열차포들을 온전하게 손에 넣어라, 우리가 아주 잘 쓸 수 있다!"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/task1"
msgid "철로를 향해 내륙으로 밀고 나가라"
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/task2"
msgid "적을 철도에서 몰아내고 남은 열차포를 노획하라."
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/task3"
msgid "열차포의 도움으로 마을에서 소련군을 몰아내라."
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/task4"
msgid "적의 반격으로부터 열차포를 방어하라."
msgstr ""

msgctxt "mission/single/03-fin/1941_08_ino_station/task5"
msgid "적의 상륙 공격을 격퇴하라."
msgstr ""
