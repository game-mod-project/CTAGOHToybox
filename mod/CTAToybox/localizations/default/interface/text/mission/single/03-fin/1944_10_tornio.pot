msgctxt "mission/single/03-fin/1944_10_tornio/date"
msgid "1944년 10월 8일 · 핀란드-스웨덴 국경, 토르니오"
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/men"
msgid "병사를 모두 잃었다!"
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/name"
msgid "너무 먼 다리"
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/name_big"
msgid "너무 먼 다리"
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/narrator/officer/01"
msgid "엽병들! 오늘 제군에게 매우 중요한 임무가 주어졌다! 나라의 운명이 제군의 손에 달렸다!"
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/narrator/officer/02"
msgid "우리 앞의 다리는 독일군에게 대단히 가치가 크다. 노르웨이로 가는 가장 짧은 길로 이어지기 때문이다."
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/narrator/officer/03"
msgid "그 다리를 장악하고 적 수비대를 섬멸해라! 제군은 우리 군이 내보낼 수 있는 최정예다. 실력을 보여 줘라!"
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/narrator/officer/04"
msgid "됐다, 제군들! 다리는 우리 것이다."
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/narrator/officer/05"
msgid "적은 아직 인근 마을에 남아 있다. 놈들을 몰아내고 견고한 교두보를 확보해야 한다."
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/narrator/officer/06"
msgid "제군들! 적을 몰아냈지만 공격 능력은 아직 남아 있다. 교두보를 요새화하고 있을지 모를 적의 공격에 대비해라!"
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/narrator/officer/07"
msgid "잘 들어라, 아스토베리! 정보에 따르면 이 지역의 독일 전투단에 제211기갑대대가 포함되어 있다. 노획한 낡은 프랑스제 전차에 불과하더라도 기갑 공격을 예상해라. 대전차 무기를 최대한 긁어모으고 적의 공격에 대비해라."
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/narrator/officer/08"
msgid "축하한다, 제군들. 제군의 용기와 희생은 누구에게도 뒤지지 않는다."
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/outro_completed"
msgid "훌륭했다! 독일군은 지금 노르웨이로 달아나려고 북쪽 길을 서둘러 올라가고 있다. 이제부터는 1939년 이래 우리가 겪은 것에 비하면 산책이나 다름없을 것이다. 크리스마스 전에는 집에 돌아갈 것이고, 그때면 핀란드의 전쟁도 끝나 있을 것이다. 잘 싸운 전역과 값진 승리를 축하한다!"
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/outro_failed"
msgid "이것은 소련과 한 약속을 지킬 기회였다. 소련이 우리가 실패했다고 보면 다시 침공할 것이고, 오래 걸리지 않을 것이다. 지금 독일군은 느긋하게 병력을 재배치할 수 있고, 붉은 군대를 다시 막아 내는 것은 우리 몫이 될 것이다."
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/place"
msgid "제11엽병 연대"
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/skip"
msgid "준비 단계 건너뛰기"
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/story"
msgid " 1944년 10월. 몇 주 전 소련과 휴전 협정이 체결되었고, 그 때문에 핀란드는 독일과 외교 관계를 끊고 핀란드 내 독일군을 추방해야 한다. '라플란드 전쟁'이 시작된다. 제3사단 일부가 스웨덴 국경의 항구 토르니오로 수송되고, 증원이 곧 뒤따른다. 토르니오에서 이들은 독일 수비대를 기습해 시내에서 몰아낸다. 곧이어 제3사단의 나머지 병력이 도착할 예정이다.\n\n 이 임무에서 너는 JR 11을 지휘해 최초 상륙 부대를 이끈다. 토르니오 동쪽에 방어선을 쳐야 한다. 크로이틀러 전투단이 동쪽에서 반격해 올 것이다. 놈들은 토르니오로 가려면 리아칸요키 다리가 반드시 필요하니, 옛 동맹군에 맞서 다리를 지키는 것이 너의 일이다. 방어선을 신속히 구축하고, 사단 본대와 전차가 도착할 때까지 다리를 지켜라."
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/task1"
msgid "다리를 확보하라"
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/task2"
msgid "적을 마을에서 몰아내라"
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/task3"
msgid "병력을 재보급하고 크로이틀러 전투단의 도착에 대비하라"
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/task4"
msgid "독일군 종대를 파괴하고 다리를 건너 달아나지 못하게 하라."
msgstr ""

msgctxt "mission/single/03-fin/1944_10_tornio/timer"
msgid "적 도착까지 남은 시간:"
msgstr ""
