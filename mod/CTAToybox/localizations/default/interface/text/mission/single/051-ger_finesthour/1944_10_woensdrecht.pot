msgctxt "mission/single/051-ger_finesthour/1944_10_woensdrecht/outro_completed"
msgid "모든 임무 목표를 완수했지만 이길 수 없는 전투였다. 우리의 결의로 캐나다군의 공격을 충분히 늦춰 병력을 재집결시키고 더 큰 손실을 피할 수 있었다."
msgstr ""

msgctxt "mission/single/051-ger_finesthour/1944_10_woensdrecht/outro_failed"
msgid "정말 그게 전부였나? 연합군이 이제 발헤렌 반도로 쇄도하고 있다. 곧 안트베르펜 항구가 놈들에게 열린다는 뜻이다. 이 손실을 만회할 마지막 노력을 준비해라!"
msgstr ""

msgctxt "mission/single/051-ger_finesthour/1944_10_woensdrecht/date"
msgid "1944년 10월 10일 · 네덜란드 노르트브라반트, 보언스드레흐트"
msgstr ""

msgctxt "mission/single/051-ger_finesthour/1944_10_woensdrecht/place"
msgid "캄프그루페 힐"
msgstr ""

msgctxt "mission/single/051-ger_finesthour/1944_10_woensdrecht/story"
msgid "연합군은 아직 안트베르펜 항구를 쓸 수 없어서 모든 보급품을 노르망디에서 트럭으로 실어 와야 한다. \n\n 이 때문에 캐나다군이 오늘 보언스드레흐트 방향으로 진격을 시작했다. 쥐트베벨란트 반도와 스헬더 하구에 접근하려는 것이다. \n\n 당신은 후게르하이더에 배치되어 놈들이 반도로 돌파하는 것을 막아야 한다. 이보다 큰 판돈은 없다!"
msgstr ""
