{game_entity
	(include "/properties/armoredcar__ctb_daf_39_43281ac5.ext")
	(include "/properties/selection/vehicle_elongated.inc" scale(1.0))
	{props "ba6" "tank" "turret" "wheeled" "with_gun" "vision_lev02" "muzzle_20mm_25mm_auto" "smoke" "nvw" "sq_at_light"}
	{Extension "daf_39.mdl"}
	(include "daf_39.ext")
	{patherId "ba10"}
	{targetclass "armoredcar"}
	{targetSelector "tank_light"}

	{sensor
		{visor "main"
			{vision "recon_main"}
		}
		{visor "commander"
			{vision "recon_open"}
			{bone "vision_rot"}
		}
	}

	{sensor
		{visor "back"
			{vision "tank_rear-mg"}
			{bone "mgun3_rot2"}
		}
	}

	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
			{anm "driver"
				{forward {begin "board_Kubel_driver"} {end "pose_mgun_pz6"} {base "open_driver2"}}
				{reverse {end "board_Kubel_driver" -1} {base "open_driver2" -1}}
			}
			{anm "driver2"
				{forward {begin "board_big-highcar"} {end "pose_mgun_pz6"} {base "open_driver1"}}
				{reverse {end "board_Kubel_driver" -1} {base "open_driver1" -1}}
			}
			{anm "gunner"
				{forward {begin "board_Kubel_driver"} {end "pose_mgun_pz6"} {base "open_driver1"}}
				{reverse {end "board_Kubel_driver" -1} {base "open_driver1" -1}}
			}
			{anm "charger"
				{forward {begin "board_tank_right"} {end "pose_mgun_pz6"} {base "open_charger"}}
				{reverse {end "emit_body"} {base "open_charger" -1}}
			}
			{anm "commander"
				{forward {begin "board_tank_right"} {end "pose_watch_binocular"} {base "open_commander"}}
				{reverse {end "emit_body"} {base "open_commander" -1}}
			}
	}

	("crew_human" place(driver) door(emit1) visor(driver))
    ("crew_human" place(driver2)    door(emit2) visor(back))
    ("crew_human" place(charger)   door(emit2) visor(none))
    ("crew_human" place(gunner) door(emit3) visor(main))
   	("crew_human" place(commander) door(emit3) visor(around))

	{volume "Body2" {able {holed}}}
	{volume "Body7" {able {holed}}}
	
	{extender "inventory"
		{box	
			{item "ammo bullet_37x257 ger aphe" 250}	
			{item "ammo bullet_37x257 ger he" 225}	
			{item "ammo lewis_mag" 11625}	; 33 drums
			{item "nbks grenade" 12}
		}
	}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{Weaponry
		{place "gun"
			{weapon "37mm_pak_39h_ctb_ger" filling "bullet_37x257 ger aphe" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_aaa"
				zeroing(1.2)
				dispersion(0.15)
			)
		}
		{place "mgun2"
			{type "hull"}
			{weapon "lewis_gun_ger_ctb_ger" filled}
			{foresight "foresight5"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun1"
			{type "coaxial"}
			{weapon "lewis_gun_ger_ctb_ger" filled}
			{foresight "foresight4"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun3"
			{type "rear"}
			{weapon "lewis_gun_ger_ctb_ger" filled}
			{foresight "foresight6"}
			{gunner "driver2"}
			{charger "driver2"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}
	

	{mass 5800}
	{Chassis "wheel"
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_btr"
			speed(114) ;----------------------------------Max speed.
			speedatmaxturn(50) ;-------------------------Max speed at max turn.
			reverse(80) ;--------------------------------Max speed in Reverse.
			weight(5.8) ;--------------------------------Weight in Tonnes.
			power(95) ;----------------------------------Horse Power.
			fuel(1200) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(2000) ;---------------------------------Range in Kilometers.
		)
	}

	{bone "gun_rot"
		{limits -10 10}
		{speed2 10}
	}
	{bone "mgun2_rot1"
		{limits -10 10}
	}
	{bone "mgun2_rot2"
		{limits -10 10}
	}
	{bone "mgun3_rot1"
		{limits -10 10}
	}
	{bone "mgun3_rot2"
		{limits -10 10}
	}
	{bone "turret"
		{speed2 25}
	}
}

