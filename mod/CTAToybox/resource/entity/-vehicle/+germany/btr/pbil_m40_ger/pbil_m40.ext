;SDL

	; armor notes
	; tracks 10mm
	; gun 20mm

	("armoredcar_tier2")

	("wheel" args "wheelright1" 10)
	("wheel" args "wheelleft1" 10)
	("wheel" args "wheelright2" 10)
	("wheel" args "wheelleft2" 10)

	("shield" args "shield_window1" 16)
	("shield" args "shield_window2" 16)
	("shield" args "fenders_front" 10)
	("shield" args "fenders_back" 10)

	("glass" args "glass1")
	("glass" args "glass2")

	("turret" repair(45))
	("gun" repair(30) thickness(40))

	("fuel" args "fuel")
	("ammo" args "ammo")
	("transmission" args "transmission")

	{volume "body1"
		{thickness 40
			{top 30}
			{bottom 30}
		}
		{able {holed}}
	}
