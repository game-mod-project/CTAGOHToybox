{game_entity
	(include "/properties/armoredcar__ctb_pbil_m40_ger_c46e688c.ext")
	
	(include "/properties/selection/vehicle_elongated.inc" scale(1.0))
	{props "tank" "turret" "wheeled" "with_gun" "vision_lev02" "muzzle_20mm_25mm_auto" "sq_autocannon"}
	{extension "pbil_m40_ger.mdl"}
	{extension "crew.ext"}
	(include "pbil_m40.ext")
	{patherId "ba10"}
	{targetclass "armoredcar"}
	{targetSelector "tank_light"}


	{sensor
		{visor "main"
			{vision "recon_main"}
		}
	}

	{extender "inventory"
		{box
			{item "ammo bullet_20x120_auto dk ap" 1625}	; 20 clips (10 rounds each)
			{item "ammo bullet_20x120_auto dk he" 1625}	; 20 clips (10 rounds each)
			{item "ammo madsen" 11625}	; 33 drums
		}
	}

	{Weaponry
		{place "gun"
			{weapon "20mm_madsen_m38_ctb_ger" filled}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_aaa"
				zeroing(1.2)
				dispersion(0.15)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "madsen_belt_ctb_ger" filling "ammo madsen" 250}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "madsen_belt_ctb_ger" filling "ammo madsen" 250}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun3"
			{type "rear"}
			{weapon "madsen_belt_ctb_ger" filling "ammo madsen" 250}
			{foresight "foresight6"}
			{gunner "driver2"}
			{charger "driver2"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 5600}
	{Chassis "wheel"
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_btr"
			speed(120) ;----------------------------------Max speed.
			speedatmaxturn(35) ;-------------------------Max speed at max turn.
			reverse(80) ;--------------------------------Max speed in Reverse.
			weight(5.6) ;--------------------------------Weight in Tonnes.
			power(135) ;----------------------------------Horse Power.
			fuel(1200) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(2000) ;---------------------------------Range in Kilometers.
		)
	}

	{bone "gun_rot"
		{limits -30 10}
		{speed2 10}
	}
	{bone "turret"
		{speed2 25}
	}
	{bone "mgun1_rot1"
		{limits -10 10}
	}
	{bone "mgun1_rot2"
		{limits -5 5}
	}
	{bone "mgun2_rot1"
		{limits -10 10}
	}
	{bone "mgun2_rot2"
		{limits -5 5}
	}
}
