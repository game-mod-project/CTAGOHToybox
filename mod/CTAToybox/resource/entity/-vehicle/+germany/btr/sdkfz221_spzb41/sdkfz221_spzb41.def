{game_entity
	(include "/properties/armoredcar__ctb_sdkfz221_spzb41_ffd3cda5.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.0))
	(include "/properties/shadow/tank.inc" scale(0.8))
	{props "vehicle" "armored_car" "tank" "turret" "wheeled" "shell_eject" "explosion_throw_crew" "vision_lev03" "muzzle_37mm_47mm" "trailer" "trailer_heavy" "sq_at_light"}
	{PatherId "vehicle.small"}
	{targetClass "armoredcar" "ap fg bullet"}
	{targetSelector "tank"}
	(include "sdkfz221_spzb41.ext")
	(include "crew.ext")
	

	{Extension "sdkfz221_spzb41.mdl"}
	
	
	
	{extender "shield"
			{on}
	}

	

