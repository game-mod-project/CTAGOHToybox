;==============================================

		{extender "inventory"
		{box
			{item "bulletger_28 apcr" 495}		; 168 rounds
			{item "bulletger_28 he" 340}
			{item "ammo mgun_ger belt" 5500}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "28mm_pzb41_ctb_ger" filling "bulletger_28 apcr" 1}
			{charger "gunner"}
			("abm_dymamic_td"
				zeroing(2.5)
				dispersion(0.25)
			)
		}
	}
	{sensor
		{visor "main"
			{bone "visor1"}
		}
	}
	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")

	{mass 4800}
		{Chassis "wheel"
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_btr"
			speed(120) ;----------------------------------Max speed.
			speedatmaxturn(26) ;-------------------------Max speed at max turn.
			reverse(26) ;--------------------------------Max speed in Reverse.
			weight(3.85) ;-------------------------------Weight in Tonnes.
			power(75) ;----------------------------------Horse Power.
			fuel(1100) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(2000) ;---------------------------------Range in Kilometers.
		)
	}
}
