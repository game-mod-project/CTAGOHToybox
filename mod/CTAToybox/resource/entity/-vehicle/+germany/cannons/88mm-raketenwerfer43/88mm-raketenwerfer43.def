{game_entity
	(include "/properties/cannon__ctb_88mm_raketenwerfer43_88145a6a.ext")
	(include "/properties/shadow/tank.inc" scale(0.6))
	(include "/properties/selection/cannon.inc" scale(0.7))
	{props "wheeled" "vision_lev02_can" "muzzle_50mm_57mm_sides" "cannon_sandbag_small" "trailer" "trailer_light" "detect_atgun_small" "sq_at_light"}
	{collider "cannon_small"}
	{targetclass "cannon_small"}
	{targetSelector "cannon_small"}

	{Volume "shield"
		{Thickness 10}
	}

	("solid_wheel" args "wheelright")
	("solid_wheel" args "wheelleft")

	("gun" repair(30) thickness(20))
	("shield" args "shield" 6)

	("armor_light_cannon")
	
	("wheel" args "wheelright")
	("wheel" args "wheelleft")

	("crew_wheeled_cannon_4")
	{boarder
		{anm "gunner"
			{forward {end "cannon_small_gunner" 10}}
		}
		{anm "charger"
			{forward {end "cannon_small_charger" 10}}
		}
		{anm "charger2"
			{forward {end "cannon_small_charger2" 10}}
		}
		{anm "commander"
			{forward {end "cannon_small_commander" 10}}
		}
		{anm "driver1"	;// gunner
			{forward {end "cannon_pak40_pusher_left" 10}}
		}
		{anm "driver2"	;// charger
			{forward {end "cannon_pak40_pusher_right" 10}}
		}
		{anm "driver3"	;// charger2
			{forward {end "mgun_browning_driver_l" 10}}
		}
		{anm "driver4"	;// commander
			{forward {end "mgun_browning_driver_r" 10}}
		}
		{anm "seat1"	;// gunner
			{forward {end "pose_seat_cannon_left" 10}}
		}
		{anm "seat2"	;// charger
			{forward {end "pose_seat_cannon_right" 10}}
		}
		{anm "seat3"	;// charger2
			{forward {end "pose_seat_cannon_right" 10}}
		}
		{anm "seat4"	;// commander
			{forward {end "pose_seat_cannon_left" 10}}
		}
	}

	{extender "cannon"
		{animation
			{switch "close"}
			;// "gunner" "charger" "charger2" "commander"
			{move "cannon_pak40_pusher_left" "cannon_pak40_pusher_right" "mgun_browning_driver_l" "mgun_browning_driver_r" }
			{aim "cannon_small_gunner_aim" "cannon_small_charger_aim" "cannon_small_charger2_aim" "cannon_small_commander_aim"}
			{fire "cannon_small_gunner_fire" "cannon_small_charger_fire" "cannon_small_charger2_fire" "cannon_small_commander_fire"}
			{reload "cannon_small_gunner_reload" "cannon_small_charger_reload" "cannon_small_charger2_reload" "cannon_small_commander_reload"}
		}
		{move {workers "driver1" "driver2" "driver3" "driver4" minWorkers 1} {obstacle "close"}}			;// move state: cannon being pushed and which positions play animations
		{attack {workers "gunner" "charger" "charger2" "commander"} {obstacle "open"}}		;// fire/attack state: cannon aim, fire, and reload events
		{trailing {workers "seat1" "seat2" "seat3" "seat4"}}								;// trailing state: cannon is being towed {obstacle} not needed. Uses "close"
	}

	{extender "inventory"
		{box
			{item "ammo panzershreck" 150}
			{item "sandbag_vehicle" 2}
		}
	}
	{Weaponry

		{place "gun"
			{weapon "raketenwerfer43_ctb_ger" filled}
			{foresight "foresight1"}
			{RestoreIKAfterAim}
			{gunner "gunner" minWorkers 1}
			{charger "charger charger2" minWorkers 1}
			{Rotate}
			("abm_dymamic_gun"
				zeroing(1.25)
				dispersion(0.35)
			)
		}
	}

	{Extension "88mm-raketenwerfer43.mdl"}

	{mass 590}
	{Chassis "track"
		("car_trace" fx("tracewheel05") step(0.07) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("mobility_cannon"
			speed(8.8) ;----------------------------------Max speed.
			weight(590) ;---------------------------------Weight in Kilograms.
		)
	}

	{bone "gun_rot"
		{speed 0.005}
	}
	{bone "basis"
	    {limits}
	    {speed 0.007}
	}
}
