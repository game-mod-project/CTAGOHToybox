{game_entity
	(include "/properties/car__ctb_v1_0578b547.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.1))
	{props "truck" "vision_lev02" "tractor" "tractor_heavy"}
	{collider "vehicle"}
	{patherId "blitz36"}
	
	{Volume "Body"
		{tags "body"}
		{component "body"}
		{thickness 8}
	}
	("bodyback" repair(30))

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")
	("wheel" args "wheelright3")
	("wheel" args "wheelleft3")


	("crew_2_human")

	{placer
		{place "driver"		{group "driver"} {visor "driver"}}
		{place "commander"	{group "driver"} {visor "main"} {turnoff {targetable 0}}}
	}

	("board_animation" place(driver) board_begin(board_willis_driver) board_end(seat_Willis_driver) base(doorleft))
	("board_animation" place(commander) board_begin(board_willis) board_end(seat_Willis_passenger) base(doorright))


	{extender "inventory"
		{Box
			{size 8 8}
			{item "ammo rocket_v1" 10}
		}
	}
	{Weaponry
		{place "rocket"
			{weapon "weapon rocket_v1_ctb_ger" filling "ammo rocket_v1" 1} 
			{barrels 1}
			{shooter "shooter"}
			{charger "driver"}
			{gunner "driver"}
			{basic}
		}
	}
	
	{mass 1250}
	{Chassis
		("mobility_car"
			speed(35) ;----------------------------------Max speed.
			speedatmaxturn(15) ;-------------------------Max speed at max turn.
			reverse(25) ;--------------------------------Max speed in Reverse.
			weight(8.1) ;--------------------------------Weight in Tonnes.
			power(68) ;----------------------------------Horse Power.
			fuel(80) ;-----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(130) ;---------------------------------Range in Kilometers.
		)
		("car_trace" fx("tracewheel01a") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel01a") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
	}
	{Extension "v1.mdl"}


}
