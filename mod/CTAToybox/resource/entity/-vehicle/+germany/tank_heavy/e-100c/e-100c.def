{game_entity
	(include "/properties/tank__ctb_e_100c_3b7bdabf.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3))
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "heavy" "vision_lev05" "muzzle_122mm_128mm_sides" "shield" "nwg" "detect_tank_heavy"}
	{extension "e-100c.mdl"}
	(include "e-100c.ext")
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	{collider "tank.heavy"}
	{PatherId "tiger"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	("crew_6_human")
	
	{boarder
		{anm "driver"
			{forward	{begin	"board_jtiger_driver"} {end "seat_gunner_stand"} {base "open1"}}
			{reverse 	{end	"board_jtiger_driver" -1} {base "open1"}}
		}
		{anm "left"
			{forward	{begin	"board_Is-2"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_Is-2"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_Is-2"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_Is-2"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor2"
			{forward	{begin	"board_Is-2"} {end "seat_isu"}}
			{reverse 	{end	"emit_body"}}
		}
	}
	("seat_human" place(seat3) bone(seat06) door(emit3)  animation(armor1))
	("seat_human" place(seat5) bone(seat04) door(emit5)  animation(armor))
	("seat_human" place(seat6) bone(seat03) door(emit6)  animation(armor))
	("seat_human" place(seat4) bone(seat05) door(emit4)  animation(armor1))

	("seat_human" place(seat1) bone(seat01) door(emit8)  animation(armor2))
	("seat_human" place(seat2) bone(seat02) door(emit7)  animation(armor2))

	{extender "shield"{on}}

	{extender "vision_mode"
		{timer_object
			{tag		"night"}
			{active_time	   60}
			{recharge_rate	  1}
			{type	     "recharge"}
	    }
	}


	{extender "inventory"
		{box
			{item "bulletger_128 apcbche" 210} 	
			{item "bulletger_128 apcr" 25} 	
			{item "bulletger_128 heat" 25} 	
			{item "bulletger_128 he" 200}
			{item "ammo mgun_ger drum" 2750}				; 12 drums (50 rounds each)
			{item "mg34_drum_ctb_ger" filling "ammo mgun_ger drum" 100 {user "mgun"}}
			{item "ammo mgun_ger belt" 22500}		; 32 belts (150 rounds each)
			{item "geballteladung_3kg" 2}
			{item "nbk39 grenade" 4}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "128mm_kwk46_ctb_ger" filling "ammo bulletger_128 apcbche" 1}
			{gunner "gunner"}
			{charger "charger charger2"}
			("abm_dymamic"
				zeroing(3.0)
				dispersion(0.20)
			)
		}
		{place "mgun1"
			{type "coaxial"}
			{weapon "mg34_tank_ctb_ger" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "charger2"}
			{basic}
			{ai_in_manual}
		}
		{place "mgun"
			{type "aa"}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "mgun_rot"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 57000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.91))
		("mobility_tank"
			speed(44) ;----------Max speed when fully accelerated on road, km/h.
			reverse(12) ;--------Max speed in reverse on road, km/h. (+2 of real life speed)
			traverse(21) ;-------Track traverse, per second, in degrees.
			weight(57) ;---------Weight in Tonnes.
			power(600) ;---------Engine Power, in hp. //engine was governed to 2500 max rpm which reduced it from 700HP to 600HP
			track(3.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(5400) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(800) ;----------Range in km, off-road.
		)
	}

	{bone "gun_rot"
		{limits -15 5}
		{speed2 4}
	}
	{bone "turret"
		{speed2 6}
	}
}