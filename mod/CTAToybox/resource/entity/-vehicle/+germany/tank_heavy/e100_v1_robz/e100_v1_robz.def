{game_entity
	(include "/properties/tank__ctb_e100_v1_robz_d8e8920a.ext")
	(include "/properties/shadow/tank.inc" scale(1.3))
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{collider "tank.heavy"}
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	{props "heavy" "vision_lev05" "muzzle_122mm_128mm" "shield" "smoke" "nvw" "detect_tank_heavy" "wheeled"}
	{PatherId "smk"}
	{Extension "e100_v1_robz.mdl"}
	(include "e100_v1_robz.ext")

	{extender "enumerator"}

	("crew_4_human")
	("seat_4_human")

	{placer
		{place "driver"		{visor "driver"}}
		{place "gunner"		{visor "main"}}
		{place "commander"	{visor "mgun"}{sealable}}
	}

	{extender "smokescreen"
		{cooldown 120}
	}

	{extender "vision_mode"
		{timer_object
			{tag		"thermal"}
			{active_time	   30}
			{recharge_rate	  0.5}
			{type	     "recharge"}
	    }
	}

	{extender "inventory"
		{box
			{item "ammo v1rocket" 30}
		}
	}


	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon 	"v1rocket_gun_ctb_ger" filled}
			{foresight 	"foresight1"}
			("abm_dymamic_stabilised"
				zeroing(1.1)
				dispersion(0.01)
			)
			{basic}
		}
	}

	{mass 90000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(1.25))
		("mobility_tank"
			speed(30) ;----------Max speed when fully accelerated on road, km/h.
			reverse(11) ;--------Max speed in reverse on road, km/h.
			traverse(15) ;-------Track traverse, per second, in degrees.
			weight(90.8) ;-------Weight in Tonnes.
			power(850) ;---------Engine Power, in hp. //engine was governed to 2500 max rpm which reduced it from 700HP to 600HP
			track(3.3) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(8600) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(900) ;----------Range in km, off-road.
		)
	}

	{bone "turret"			;gun horizontal
		{speed 0.0012}
	}
	{bone "gun_rot"			;gun vertical
		{speed 0.0005}
	}
}