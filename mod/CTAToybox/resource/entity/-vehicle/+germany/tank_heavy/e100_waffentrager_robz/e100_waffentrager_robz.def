{game_entity
	(include "/properties/tank_assaultgun__ctb_e100_waffentrager_robz_7cb3655b.ext")
	(include "/properties/shadow/tank.inc" scale(1.2))
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "td" "heavy" "-turret" "multi_board" "vision_lev06" "shield" "muzzle_170mm_210mm" "detect_td_heavy"}
	{extension "e100_waffentrager_robz.mdl"}
	(include "e100_waffentrager_robz.ext")
	{collider "tank.heavy"}
	{PatherId "elefant"}
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{sensor
		{visor "main"
			{vision "tank_range_250"}
		}
	}

	{boarder
		{anm "driver"
			{forward {begin "board_tank_right"} {base "open"}}
			{reverse {end "board_pz4_driver" -1} {base "open"}}
		}
		{anm "co_driver"
			{forward {begin "board_tank_right"} {base "open1"}}
			{reverse {end "board_pz4_driver" -1} {base "open1"}}
		}
		{anm "gunner_l"
			{forward {begin "board_tank_left"} {end "seat_armor"}}	;placeholder pose
			{reverse {end "emit_tank_1"}}
		}
		{anm "gunner_r"
			{forward {begin "board_tank_left"} {end "seat_armor"}}	;placeholder pose
			{reverse {end "emit_tank_1"}}
		}
		{anm "gunner2_l"
			{forward {begin "board_tank_left"} {end "seat_armor"}}	;placeholder pose
			{reverse {end "emit_tank_1"}}
		}
		{anm "gunner2_r"
			{forward {begin "board_tank_left"} {end "seat_armor"}}	;placeholder pose
			{reverse {end "emit_tank_1"}}
		}
		{anm "charger_l"
			{forward {begin "board_tank_right"} {end "m12_gmc_charger"}}	;placeholder pose
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "charger_r"
			{forward {begin "board_tank_right"} {end "m12_gmc_charger"}}	;placeholder pose
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "charger2_l"
			{forward {begin "board_tank_left"} {end "m12_gmc_gunner2"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "charger2_r"
			{forward {begin "board_tank_right"} {end "m12_gmc_gunner2"}}
			{reverse {end "emit_tank_2_hold"}}
		}
	}

	("crew_driver" door(emit1) door2(emit1) door3(emit1))
	("crew_co_driver" 		place(commander) 	door(emit4) door2(emit4) door3(emit4))
	("crew_human_visible_anm"	place(gunner)	 door(emit3)  visor(main)	anm_left(gunner_l)	anm_right(gunner_r))
	("crew_human_visible_anm"	place(gunner2)	 door(emit3)  visor(main)	anm_left(gunner2_l)	anm_right(gunner2_r))
	("crew_human_visible_anm"	place(charger)	 door(emit2)  visor(none)	anm_left(charger_l)	anm_right(charger_r))
	("crew_human_visible_anm"	place(charger2)	 door(emit2)  visor(none)	anm_left(charger2_l)	anm_right(charger2_r))

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "bulletger_128 apcbche" 100}
			{item "bulletger_128 apcr" 60}
			{item "bulletger_128 heat" 60}
			{item "bulletger_128 he" 100}
			{item "geballteladung_3kg" 2}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "128mm_kwk44_auto_ctb_ger" filling "bulletger_128 apcbche" 5}
			{foresight "foresight1"}
			{gunner "gunner gunner2" minWorkers 1}
			{charger "charger charger2" minWorkers 1}
			("abm_dymamic_td"
				zeroing(5.5)
				dispersion(0.25)
			)
		}
	}

	{mass 50800} ;71700
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.58))
		("mobility_tank"
			speed(33) ;----------Max speed when fully accelerated on road, km/h.
			reverse(12) ;--------Max speed in reverse on road, km/h.
			traverse(20) ;-------Track traverse, per second, in degrees.
			weight(50.8) ;-------Weight in Tonnes. ;71.7
			power(900) ;---------Engine Power, in hp.
			track(7.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(8400) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(1000) ;----------Range in km, off-road.
		)
	}

	{bone "turret"
		{speed2 10}
	}
	{bone "gun_rot"			;gun vertical
		{speed2 3}
	}
}