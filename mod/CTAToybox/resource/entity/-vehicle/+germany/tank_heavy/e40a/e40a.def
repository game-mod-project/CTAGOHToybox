{game_entity
	(include "/properties/tank__ctb_e40a_2a31c9b8.ext")
	(include "/properties/shadow/tank.inc" scale(1.3))
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{collider "tank.heavy"}
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	{props "heavy" "vision_lev05" "muzzle_85mm_93mm_sides" "shield" "smoke" "nvw" "detect_tank_heavy" "wheeled"}
	{PatherId "tiger2"}
	(include "e40a.ext")
	{Extension "e40a.mdl"}

	{extender "enumerator"}

	("transmission" args "transmission")
	("crew_4_human")

	{placer
		{place "driver"		{visor "driver"}}
		{place "gunner"		{visor "main"}}
		{place "commander"	{visor "mgun"}{sealable}}
	}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbk39"}
	}

	{extender "vision_mode"
		{timer_object
			{tag		"thermal"}
			{active_time	   120}
			{recharge_rate	  1.0}
			{type	     "recharge"}
	    }
	}

	{extender "inventory"
		{box
			{item "bulletger_88_l71 apcbche" 200}	; 86 rounds
			{item "bulletger_88_l71 he" 200}
			{item "bulletger_88_l71 apcr" 25}
			{item "ammo mgun_ger belt" 30000}
			{item "geballteladung_3kg" 2}
			{item "nbk39 grenade" 12}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "88mm_kwk43_ctb_ger" filling "bulletger_88_l71 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(3.0)
				dispersion(0.15)
			)
		}	
		{place "mgun2"
			{type "coaxial"}
			{weapon "mg42_tank_ctb_ger" filled}
			{foresight "foresight5"}
			("abm_mgun")
			{basic}
		}
		{place "mgun"
			{RestoreIKAfterAim}
			{weapon "mg42_tank_ctb_ger" filled}
			{gunner		"commander"}
			{charger		"commander"}
			{LinkBone		"mgun_rot"}
			("abm_mgun")
            		{basic}
			{ai_in_manual}
		}
	}

	{mass 45000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(1.25))
		("mobility_tank"
			speed(84) ;----------Max speed when fully accelerated on road, km/h.
			reverse(11) ;--------Max speed in reverse on road, km/h.
			traverse(20) ;-------Track traverse, per second, in degrees.
			weight(45.8) ;-------Weight in Tonnes.
			power(600) ;---------Engine Power, in hp. //engine was governed to 2500 max rpm which reduced it from 700HP to 600HP
			track(3.3) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(8600) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(900) ;----------Range in km, off-road.
		)
	}

	{bone "turret"			;gun horizontal
		{speed 0.0062}
	}
	{bone "mgun_rot"			;gun horizontal
		{speed 0.0142}
	}
	{bone "gun_rot"			;gun vertical
		{speed 0.0015}
	}
	{texmod "5"}
}