{game_entity
	(include "/properties/tank__ctb_e65_9833a231.ext")
	(include "/properties/shadow/tank.inc"  scale(1.0)) ;1.3
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "heavy" "vision_lev05" "muzzle_100mm_105mm" "shield" "nwg" "detect_tank_heavy"}
	{extension "e65.mdl"}
	(include "e65.ext")
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	{collider "tank.heavy"}
	{PatherId "tiger2"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{sensor
		{visor "main"
			{vision "tank_range_250"}
		}
	}

	;("crew_4_human_extended")

	("crew_6_human")

	;{boarder
	;	{anm "left"
	;		{forward	{begin	"board_Kv"} {end "seat_gunner_stand"}}
	;		{reverse 	{end	"emit_tank_2_hold"}}
	;	}
	;	{anm "right"
	;		{forward	{begin	"board_tank_right"} {end "seat_gunner_stand"}}
	;		{reverse 	{end	"emit_tank_2_hold"}}
	;	}
	;}
	
	{boarder
		{anm "driver"
			{forward	{begin	"board_jtiger_driver"} {end "seat_gunner_stand"} {base "open_driver1"}}
			{reverse 	{end	"board_jtiger_driver" -1} {base "open_driver1"}}
		}
		{anm "left"
			{forward	{begin	"board_jtiger_driver"} {end "seat_armor"}{base "open_driver2"}}
			{reverse 	{end	"board_jtiger_driver" -1} {base "open_driver2"}}
		}
		{anm "right"
			{forward	{begin	"board_Is-2"}{end "seat_armor"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor1"
			{forward	{begin	"board_Is-2"} {end "seat_armor"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	("seat_human" place(seat1) bone(seat1) door(emit5)  animation(armor))
	("seat_human" place(seat2) bone(seat2) door(emit6)  animation(armor))

	{extender "shield"{on}}

	{extender "vision_mode"
		{timer_object
			{tag		"thermal"}
			{active_time	   80}
			{recharge_rate	  1.0}
			{type	     "recharge"}
	    }
	}
	
	;{extender "smokescreen"
	;	{cooldown 5}
	;	{itemTags "grenade nbk39"}
	;}

	{extender "inventory"
		{box
			{item "bulletger_88_l71 apcbche" 195}	; 80 rounds
			{item "bulletger_88_l71 he" 200}	 	
			{item "ammo mgun_ger belt" 22500}		; 32 belts (150 rounds each)
			{item "ammo mgun_ger drum" 2750}				; 12 drums (50 rounds each)
			{item "mg42_drum_ctb_ger" filled}
			{item "geballteladung_3kg" 2}
			{item "nbk39 grenade" 16}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "88mm_kwk43_d_ctb_ger" filling "bulletger_88_l71 apcbche" 2}
			{foresight "foresight1"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(3.0)
				dispersion(0.17)
			)
			{basic}
		}
		{place "gun2"
			{RestoreIKAfterAim}
			{weapon "88mm_kwk43_d_ctb_ger" filling "bulletger_88_l71 apcbche" 2}
			{foresight "foresight2"}
			{gunner "gunner"}
			{charger "charger2"}
			("abm_dymamic_stabilised"
				zeroing(3.0)
				dispersion(0.17)
			)
			{basic}
		}
		{place "mgun_turret2"
			{type "coaxial"}
			{weapon "mg42_tank_ctb_ger" filled}
			{foresight "foresight4"}
			{gunner "gunner"}
			{charger "charger2"}
			{basic}
			{ai_in_manual}
		}
		{place "mgun"
			{type "hull"}
			{weapon "mg42_tank_ctb_ger" filled}
			{foresight "foresight3"}
			{gunner "commander"}
			{charger "commander"}
			{basic}
			{ai_in_manual}
		}
		{place "mgun_body"
			{type "hull"}
			{weapon "mg42_tank_ctb_ger" filled}
			{foresight "foresight5"}
			{gunner "gunner3"}
			{charger "gunner3"}
			{basic}
			{ai_in_manual}
		}

	}

	{mass 61000} ;45
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.57))
		("mobility_tank"
			speed(57) ;----------Max speed when fully accelerated on road, km/h. ;35
			reverse(22) ;--------Max speed in reverse on road, km/h. (+2 of real life speed) ;16
			traverse(26) ;-------Track traverse, per second, in degrees. ;21
			weight(61.0) ;---------Weight in Tonnes.
			power(1200) ;---------Engine Power, in hp. Maybach HL234 Mekydro - 1200.
			track(5.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(7000) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(1200) ;----------Range in km, off-road.
		)
	}
	{bone "turret"
		{speed2 15}
	}
	{bone "gun_rot"
		{speed2 10}
	}
	{bone "mgun_turret2"
		{speed2 30}
	}
	{bone "mgun_rot"
		{limits -80 80}
		{speed2 30}
	}
	{bone "mgun"
		{speed2 30}
	}
	{bone "mgunbody_rot"
		{speed2 30}
	}
	{bone "mgun_body"
		{speed2 30}
	}

}