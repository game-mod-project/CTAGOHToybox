{game_entity
	(include "/properties/tank__ctb_e75_f1d08a47.ext")
	
	(include "/properties/selection/vehicle_big.inc" scale(1.0))
	{props "heavy" "vision_lev05" "muzzle_85mm_93mm_sides" "shield" "smoke" "nvw" "detect_tank_heavy"}
	(include "e75.ext")
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	{collider "tank.heavy"}
	{PatherId "tiger2"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{sensor
		{visor "main"
			{vision "tank_range_220"}
		}
	}

	("crew_5_human_2")

	{boarder
		{anm "driver"
			{forward {begin "board_pz4_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse {end "board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "left"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"} {end "pose_mgun_pz6"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "bulletger_128 apcbche" 100} 	
			{item "bulletger_128 he" 100}
			{item "bulletger_128 heat" 25}
			{item "bulletger_128 apcr" 25}
			{item "ammo mgun_ger belt" 22500}		; 32 belts (150 rounds each)
			{item "geballteladung_3kg" 2}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "128mm_kwk44-2_ctb_ger" filling "ammo bulletger_128 apcbche" 1}
			{gunner "gunner"}
			{charger "charger charger2" minWorkers 1}
			("abm_dymamic"
				zeroing(3.0)
				dispersion(0.20)
			)
		}
		{place "mgun"
			{type "coaxial"}
			{weapon "mg34_tank_ctb_ger" filled}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger charger2" minWorkers 1}
			{basic}
			{ai_in_manual}
		}
	}
	{mass 69800}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(1.16))
		("mobility_tank"
			speed(53) ;----------Max speed when fully accelerated on road, km/h.
			reverse(11) ;--------Max speed in reverse on road, km/h. (+2 of real life speed)
			traverse(20) ;-------Track traverse, per second, in degrees.
			weight(69.8) ;-------Weight in Tonnes.
			power(600) ;---------Engine Power, in hp. //engine was governed to 2500 max rpm which reduced it from 700HP to 600HP
			track(3.3) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(8600) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(900) ;----------Range in km, off-road.
		)
	}
	{Extension "e75.mdl"}
}