{game_entity
	(include "/properties/tank__ctb_e77_5d1a39ea.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3)) 
	(include "/properties/selection/vehicle_big.inc" scale(1.2))
	{props "heavy" "vision_lev05" "muzzle_100mm_105mm" "shield" "detect_tank_heavy"}
	{extension "e77.mdl"}
	(include "e77.ext")
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	{collider "tank.heavy"}
	{PatherId "tiger2"}

	{sensor
		{visor "main"
			{vision "tank_range_250"}
			{bone "foresight1"}
		}
	}
	
;==============================================
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	
	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "driver"
			{forward {begin "board_jtiger_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse {end "board_jtiger_driver" -1} {base "open_driver" -1}}
		}
		{anm "gunner"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open"}}
			{reverse {end "emit_tank_2_hold"}  {base "open" -1}}
		}
		{anm "gunner3"
			{forward {begin "board_jtiger_driver"} {end "seat_gunner_stand"} {base "open_codriver"}}
			{reverse {end "board_jtiger_driver" -1} {base "open_codriver" -1}}
		}
		{anm "charger"
			{forward {begin "board_tank_right"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"} {base "open1" -1}}
		}
		{anm "commander"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open"}}
			{reverse {end "emit_tank_2_hold"} {base "open" -1}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("crew_human" place(driver)		door(emit1)  visor(visor1))
	("crew_human" place(gunner)		door(emit3) visor(main))
	("crew_human" place(gunner3)		door(emit2) visor(visor1))
	("crew_human" place(charger)	door(emit4) visor(none))
	("crew_human" place(commander)		door(emit3) visor(around))

	("seat_human" place(seat1) bone(seat1) door(emit11)  animation(armor))
	("seat_human" place(seat2) bone(seat2) door(emit12)  animation(armor))
	("seat_human" place(seat3) bone(seat3) door(emit13)  animation(armor))
	("seat_human" place(seat4) bone(seat4) door(emit14)  animation(armor))
	("seat_human" place(seat5) bone(seat5) door(emit15)  animation(armor))
	("seat_human" place(seat6) bone(seat6) door(emit16)  animation(armor))
	("seat_human" place(seat7) bone(seat7) door(emit17)  animation(armor))
;==============================================

	{extender "shield"{on}}

	{extender "vision_mode"
		{timer_object
			{tag		"thermal"}
			{active_time	   80}
			{recharge_rate	  1.0}
			{type	     "recharge"}
	    }
	}
	
	;{extender "smokescreen"
	;	{cooldown 5}
	;	{itemTags "grenade nbk39"}
	;}

	{extender "inventory"
		{box
			{item "bulletger_128 apcbche" 160} 	
			{item "bulletger_128 he" 150}	
		    {item "ammo mgun_ger belt ap2" 24000}			; 12 drums (50 rounds each)
			{item "geballteladung_3kg" 2}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "128mm_kwk_l50_ctb_ger" filling "ammo bulletger_128 apcbche" 1}
			{foresight "foresight1"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(3.0)
				dispersion(0.17)
			)
			{basic}
		}

		{place "mgun_turret"
			{type "coaxial"}
			{weapon "mg42_tank_ctb_ger" filled}
			{foresight "foresight2"}
			{gunner "gunner"}
			{charger "charger"}
			{basic}
			{ai_in_manual}
		}

		{place "mgun"
			{type "aa"}
			{weapon "mg42_tank_ctb_ger" filled}
			{foresight "foresight3"}
			{gunner "gunner"}
			{charger "charger"}
			{basic}
			{ai_in_manual}
		}

		{place "mgun_body"
			{type "hull"}
			{weapon "mg42_tank_ctb_ger" filled}
			{foresight "foresight5"}
			{gunner "gunner3"}
			{charger "gunner3"}
			{basic}
			{ai_in_manual}
		}

	}

	{mass 69800}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.56))
		("mobility_tank"
			speed(83) ;----------Max speed when fully accelerated on road, km/h.
			reverse(11) ;--------Max speed in reverse on road, km/h. (+2 of real life speed)
			traverse(20) ;-------Track traverse, per second, in degrees.
			weight(69.8) ;-------Weight in Tonnes.
			power(800) ;---------Engine Power, in hp. //engine was governed to 2500 max rpm which reduced it from 700HP to 600HP
			track(3.3) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(8600) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(900) ;----------Range in km, off-road.
		)
	}
	{bone "turret"
		{speed2 17}
	}
	{bone "gun_rot"
		{speed2 10}
	}
	{bone "mgun_rot"
		{speed2 40}
	}
	{bone "mgun"
		{speed2 40}
	}
	{bone "mgun_body_rot"
		{speed2 40}
	}
	{bone "mgun_body"
		{speed2 40}
	}
	{bone "mgun_turret"
		{speed2 40}
	}

}