;SDL
	
	; armor notes
	; tracks and wheels 20mm
	; gun 30mm
	; spare tracks 20mm
	; schürzen 5mm

	("tank_heavy_tier1")

	("shield_track" args "shield1" 60)
	("shield_track" args "shield2" 60)

	("shield_tear" args "shieldl1" 15)
	("shield_tear" args "shieldl2" 15)
	("shield_tear" args "shieldl3" 15)
	("shield_tear" args "shieldl4" 15)
	("shield_tear" args "shieldl5" 15)
	("shield_tear" args "shieldr1" 15)
	("shield_tear" args "shieldr2" 15)
	("shield_tear" args "shieldr3" 15)
	("shield_tear" args "shieldr4" 15)
	("shield_tear" args "shieldr5" 15)

	("tracks" repair(30) thickness(60))
	("gun" repair(30) thickness(90))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("ammo" args "ammo4")
	("fuel" args "fuel1")
	("fuel" args "fuel2")
	("fuel" args "fuel3")
	("fuel" args "fuel4")
	("transmission" args "transmission")

	{volume "body1"			; Hull
		{thickness 390
			{front 540}		; Lower Nose
			{top 165}		; Glacis
			{rear 300}
		}
	}
	{volume "body2"			; Superstructure Bottom
		{thickness 420
			{front 420}		; Glacis
			{rear 300}
			{bottom 120}		; Overhang (above tracks)
		}
	}
	{volume "body3"			; Superstructure Top
		{thickness 570
		}
	}
	{volume "mgturret"		; Hull
		{thickness 300
			{front 630}	
			{top 105}
			{bottom 120}		
		}
	}
	{volume "engine"		; Hull
		{thickness 420
			{front 420}
			{top 135}	
			{rear 300}
			{bottom 120}		
		}
	}
	{volume "gunshield"	
		{thickness 630
		}
	}
	{volume "gunshield2"	
		{thickness 630
		}
	}
