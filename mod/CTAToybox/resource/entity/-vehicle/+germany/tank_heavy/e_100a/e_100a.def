{game_entity
	(include "/properties/tank__ctb_e_100a_8adb397b.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3))
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "heavy" "vision_lev05" "muzzle_122mm_128mm" "muzzle_75mm_76mm_2" "shield" "smoke" "nvw" "detect_tank_heavy" "sq_armor_super_heavy"} 
	{extension "e_100a.mdl"}
	(include "e_100a.ext")
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	{collider "tank.heavy"}
	{PatherId "tiger2"}

	{sensor
		{visor "main"
			{vision "tank_range_220"}
		}
	}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbk39"}
	}

	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "commander"
			{forward {begin "board_kv"} {base "open_commander"}}
			{reverse {end "board_t26_driver" -1} {base "open_commander" -1}}
		}
		{anm "gunner3"
			{forward {begin "board_kv"} {base "open_driver"} {base "open_gunner" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_gunner" -1}}
		}
		{anm "gunner"
			{forward {begin "board_tank_right"} {base "open_commander" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_commander" -1}}
		}
		{anm "charger"
			{forward {begin "board_tank_right"} {base "open_gunner" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_gunner" -1}}
		}
		{anm "charger3"
			{forward {begin "board_tank_right"} {base "open_co_driver" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_co_driver" -1}}
		}
		{anm "driver"
			{forward {begin "board_kv"} {base "open_driver"} {base "open_driver" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_driver" -1}}
		}
		{anm "armor"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor1"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_2"}}
			{reverse {end "emit_body"}}
		}
	}

	("crew_human" place(driver) door(emit1) visor(driver))
	("crew_human" place(gunner) door(emit3) visor(main))
    	("crew_human" place(gunner3)    door(emit4) visor(main))
	("crew_human" place(charger)    door(emit4) visor(none))
	("crew_human" place(charger3)    door(emit2) visor(none))
   	("crew_human" place(commander) door(emit3) visor(around))

	{extender "inventory"
		{weapon "mgun1" {mask "mountable"}}
		{weapon "mgun2" {mask "mountable"}}
		{weapon "mgun3" {mask "mountable"}}
		{box
			{item "bulletger_128_2 apc" 100}
			{item "bulletger_128_2 he" 75}
			{item "bulletger_75_l24 sm" 50} 		; 150 rounds 75mm
			{item "bulletger_75_l24 heat" 245}
			{item "bulletger_75_l24 he" 250}
			{item "ammo mgun_ger belt" 22500}		; 32 belts (150 rounds each)
			{item "geballteladung_3kg" 2}
			{item "mg34_tank_ctb_ger" filled {user "mgun1"}}
			{item "mg34_tank_ctb_ger" filled {user "mgun2"}}
			{item "mg34_tank_ctb_ger" filled {user "mgun3"}}
			{item "nbk39 grenade" 12}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "128mm_kwk44_ctb_ger" filling "bulletger_128_2 apc" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(3.0)
				dispersion(0.20)
			)
			{basic}
		}
		{place "gun2"
			{RestoreIKAfterAim}
			{weapon "75mm_stuk42_0_ctb_ger" filling "bulletger_75_l24 heat" 1};{weapon "75mm_kwk37" filling "bulletger_75_l24 apcbche" 1}
			{foresight "foresight1a"}
			{gunner "gunner3"}
			{charger "charger3"}
			("abm_dymamic_stabilised"
				zeroing(4.0)
				dispersion(0.20)
			)
			{basic}
		}
		{place "mgun1"
			{type "coaxial"}
			{weapon "mg34_tank_ctb_ger" filled}
			{LinkBone "mgun1"}
			{LinkAnimation "off"}
			{gunner "gunner"}
			{charger "gunner"}
			{basic}
			{ai_in_manual}
		}
		{place "mgun2"
			{type "left"}
			{weapon "mg34_tank_ctb_ger" filled}
			{LinkBone "mgun2"}
			{LinkAnimation "off"}
			{gunner "gunner3"}
			{charger "gunner3"}
			{basic}
			{ai_in_manual}
		}
		{place "mgun3"
			{type "right"}
			{weapon "mg34_tank_ctb_ger" filled}
			{LinkBone "mgun3"}
			{LinkAnimation "off"}
			{gunner "charger3"}
			{charger "charger3"}
			{basic}
			{ai_in_manual}
		}
	}

	{mass 160000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(-0.45)) 
		("mobility_tank"
			speed(20) ;----------Max speed when fully accelerated on road, km/h.
			reverse(4) ;--------Max speed in reverse on road, km/h. (+2 of real life speed)
			traverse(6.2) ;-------Track traverse, per second, in degrees. ;21
			weight(160) ;---------Weight in Tonnes.
			power(405) ;---------Engine Power, in hp. Daimler Benz MB 517 V-12 - 1200 (also Type 213 (diesel) or Maybach HL234 Mekydro - 1200 (fuel)).
			track(1.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(21000) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(200) ;----------Range in km, off-road.
		)

	}

	{bone "turret"
		("turret_heavy" power_traverse(2))
	}
	{bone "gun_rot"
		{limits -7 23}
		{speed2 3.5}
	}

	{bone "mgun1"
		{limits -3 3}
	}

	{bone "mgun2_rot1"
		{limits -10 10}
	}
	{bone "mgun2_rot2"
		{limits -10 10}
	}
	{bone "mgun3_rot1"
		{limits -10 10}
	}
	{bone "mgun3_rot2"
		{limits -10 10}
	}
}