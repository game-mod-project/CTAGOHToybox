	{volume "turret1"		; Main Turret
		{thickness 600
			{front 660} 	; 14.5mm base
			{top 180}		; Glacis
			{bottom 240}
		}
		{Quality "large_flaw"}														
	}
	{volume "turret2"		; Front Lower Cheek
		{thickness 600
			{front 600} 	; 14.5mm base
			{top 180}		; Glacis
			{bottom 240}
		}
