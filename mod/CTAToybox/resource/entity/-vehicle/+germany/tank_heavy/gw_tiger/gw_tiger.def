{game_entity
	(include "/properties/tank_assaultgun__ctb_gw_tiger_0600afff.ext")
	(include "/properties/selection/vehicle.inc" scale(1.3))
	{props "cannon" "heavy"  "-turret" "motorized" "vision_lev04" "muzzle_150mm_155mm" "no_shell" "detect_artillery" "artillery_minimap_heavy" "open_top" "c_how_s_hvy"}
	{Extension "gw_tiger.mdl"}
	(include  "gw_tiger.ext")
	{PatherId "thor"}
	{targetclass "howitzer"}
	{targetSelector "cannon_howitzer"}

	(define "crew_human_visible_anm"
		{placer
			{place "%place"
				{group "crew"}
				{visor "%visor"}
				{linkbone "%bone"}
				{turnoff %off}
			}
		}
		{boarder
			{door "emit1"}
			{door "emit2"}
			{door "emit3"}
			{door "emit4"}

			{link "emit1" "%place" {anm "%place"} {forward putoff} {reverse puton}}
			{link "emit4" "%place" {anm "%place"} {forward putoff} {reverse puton}}
		}
	)

	{boarder
		{anm "gunner"
			{forward {begin "board_thor_front"} {end "pose_thor_gunner_animation" 10}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "gunner2"
			{forward {begin "board_thor_front"} {end "pose_thor_gunner2_animation" 10}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "gunner3"
			{forward {begin "board_thor_front"} {end "pose_thor_gunner2_animation" 10}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "charger"
			{forward {begin "board_thor_front"} {end "pose_thor_charger_animation" 10}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "charger2"
			{forward {begin "board_thor_front"} {end "pose_thor_charger2_animation" 10}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "charger3"
			{forward {begin "board_thor_front"} {end "pose_thor_charger2_animation" 10}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "commander"
			{forward {begin "board_thor_front"} {end "pose_watch_binocular" 10}}
			{reverse {end "emit_tank_2_hold"}}
		}

		{anm "driver"
			{forward {end "pose_watch_binocular"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "driver1"
			{forward {end "m12_gmc_charger"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "driver2"
			{forward {end "m12_gmc_gunner2"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "driver3"
			{forward {end "pose_nashorn_charger"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "driver4"
			{forward {end "m12_gmc_charger2"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "driver5"
			{forward {end "pose_nashorn_commander"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "driver6"
			{forward {end "m12_gmc_gunner2"}}
			{reverse {end "emit_tank_2_hold"}}
		}

		{link "driver" "commander"}
		{link "driver1" "gunner"}
		{link "driver2" "gunner2"}
		{link "driver3" "gunner3"}
		{link "driver4" "charger"}
		{link "driver5" "charger2"}
		{link "driver6" "charger3"}
	}

	("crew_human_visible_anm" place(gunner)    bone(gunner)    visor(main) off({sensor}))
	("crew_human_visible_anm" place(gunner2)   bone(gunner2)   visor(none) off())
	("crew_human_visible_anm" place(gunner3)   bone(gunner3)   visor(none) off())
	("crew_human_visible_anm" place(charger)   bone(charger)   visor(none) off())
	("crew_human_visible_anm" place(charger2)  bone(charger2)  visor(none) off())
	("crew_human_visible_anm" place(charger3)  bone(charger3)  visor(none) off())
	("crew_human_visible_anm" place(commander) bone(commander) visor(none) off())

	("crew_human_visible_anm" place(driver)    bone()          visor(none) off())
	("crew_human_visible_anm" place(driver1)   bone(gunner)    visor(none) off())
	("crew_human_visible_anm" place(driver2)   bone(gunner2)   visor(none) off())
	("crew_human_visible_anm" place(driver3)   bone(gunner3)   visor(none) off())
	("crew_human_visible_anm" place(driver4)   bone(charger)   visor(none) off())
	("crew_human_visible_anm" place(driver5)   bone(charger2)  visor(none) off())
	("crew_human_visible_anm" place(driver6)   bone(charger3)  visor(none) off())

	{extender "cannon"
		{animation
			{switch "close"}
		}
		{move {workers "driver" "driver1" "driver2" "driver3" "driver4" "driver5" "driver6" minWorkers 1} {obstacle "close"}}
		{attack {workers "commander" "gunner" "gunner2" "gunner3" "charger" "charger2" "charger3"} {obstacle "open"}}
	}

	{extender "inventory"
		{box
			{item "bulletger_170 he" 75}
			{item "bulletger_170 ic" 10}
                                                {item "bulletger_170 apcbche" 25}
			{item "ammo mgun_ger belt" 22500}
		}
	}

	(define "restore_ik_time"
		{RestoreIKTime 4}
	)

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "170mm_k18_2_ctb_ger" filling "bulletger_170 he" 1} 
			{foresight "foresight1"} 
			{gunner "gunner gunner2 gunner3" minWorkers 2}
			{charger "charger charger2 charger3" minWorkers 2}
			("abm_dymamic_gun" zeroing(1.0) dispersion(1.0))
			{basic}
		}

		{place "mgun"
			{type "hull"}
			{weapon "mg42_tank_ctb_ger" filled}
			{foresight "foresight2"}
			{gunner "driver commander" minWorkers 1}
			{charger "driver commander" minWorkers 1}
			{basic}
			{ai_in_manual}
		}
	}

	{mass 67000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.3) len(0.77))
		("mobility_tank"
			speed(45)
			reverse(6)
			traverse(15)
			weight(67)
			power(470)
			track(4)
			fuel(6600)
			type(fuel)
			range(1930)
		)
	}
	
	{bone "basis"
		{speed 0.001}
	}
	{bone "turret"
		{speed2 5}
	}
	{bone "gun_rot"
		{limits -10 45}
		{speed2 5}
	}
	{bone "mgun"
		{speed2 30}
	}
	{bone "mgun_rot"
		{speed2 30}
	}
	(mod "mp"
		{brain
			{properties
				{fire_mode hold}
			}
		}
	)
}