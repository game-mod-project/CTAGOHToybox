{game_entity
	(include "/properties/tank_assaultgun__ctb_gwe100_9512b274.ext")
	(include "/properties/shadow/tank.inc" scale(1.2))
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "td" "heavy" "-turret" "multi_board" "vision_lev06" "smoke" "nwg" "shield" "muzzle_170mm_210mm" "detect_td_heavy"}
	{extension "gwe100.mdl"}
	(include "gwe100.ext")
	{collider "tank.heavy"}
	{PatherId "elefant"}
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{extender "smokescreen"
		{cooldown 10}
		{itemTags "grenade nbk39"}
	}

	{sensor
		{visor "main"
			{vision "tank_range_250"}
		}
	}

	{boarder
		{anm "driver"
			{forward {begin "board_pz4_driver"} {end "pose_t26_driver"} {base "open_driver"}}
			{reverse {end "board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "left"
			{forward {begin "board_tank_left"} {end "seat_armor"} {base "board"}}	;placeholder pose
			{reverse {end "emit_tank_1"} {base "board"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"} {end "seat_armor"} {base "board"}}	;placeholder pose
			{reverse {end "emit_tank_2_hold"} {base "board"}}
		}
	}

	("crew_driver" door(emit0))
	("crew_human_visible_anm"	place(gunner)	 door(emit2) door2(emit3) visor(main)	anm_left(left)	anm_right(right))
	("crew_human_visible_anm"	place(charger)	 door(emit2) door2(emit3) visor(none)	anm_left(left)	anm_right(right))
	("crew_human_visible_anm"	place(gunner2)	 door(emit1) door2(emit2) visor(main)	anm_left(left)	anm_right(right))
	("crew_human" 				place(gunner3)	 door(emit2) door2(emit3) visor(none))
	("crew_human_visible_anm"	place(commander) door(emit1) door2(emit2) visor(around)	anm_left(left)	anm_right(right))

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "bulletger_210 he" 50}
			{item "geballteladung_3kg" 2}
			{item "ammo mgun_ger belt" 22500}	; 32 belts (150 rounds each)
			{item "bulletger_75_l24 apcbche" 45}
			{item "bulletger_75_l24 heat" 80}
			{item "bulletger_75_l24 he" 120}
			{item "nbk39 grenade" 24}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "210mm_gw_ctb_ger" filling "ammo bulletger_210 he" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_td"
				zeroing(5.5)
				dispersion(0.25)
			)
		}
		{place "mgun"
			{type "hull"}
			{weapon "mg42_tank_ctb_ger" filled}
			{foresight "foresight2"}
			{gunner "gunner2"}
			{charger "gunner2"}
			{basic}
			{ai_in_manual}
		}
		{place "gun2"
			{type "hull"}
			{weapon "75mm_lg40_ctb_ger" filling "bulletger_75_l24 he" 1}
			{foresight "foresight3"}
			{gunner "gunner3"}
			{charger "gunner3"}
			{basic}
			{ai_in_manual}
			("abm_dymamic_gun"
				zeroing(4.0)
				dispersion(0.25)
			)
		}
	}

	{mass 100800} ;71700
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.81)) ;("tank_trace" fx("tracks_big") step(0.47) len(0.6))
		("mobility_tank"
			speed(27) ;----------Max speed when fully accelerated on road, km/h.
			reverse(12) ;--------Max speed in reverse on road, km/h.
			traverse(20) ;-------Track traverse, per second, in degrees.
			weight(100.8) ;-------Weight in Tonnes. ;71.7
			power(900) ;---------Engine Power, in hp.
			track(7.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(8400) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(1000) ;----------Range in km, off-road.
		)
	}

	{bone "gunseat"
		{limits 5 -5} ;-5 5
		{speed2 3}
	}
	{bone "gunrot"			;gun vertical
		{speed2 3.25}
	}
}