{game_entity
	(include "/properties/tank__ctb_krv_9f976ebc.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3)) 
	(include "/properties/selection/vehicle_big.inc" scale(1.2))
	{props "heavy" "vision_lev05" "shield" "smoke" "nwg" "detect_tank_heavy"}
	{extension "krv.mdl"}
	(include "krv.ext")
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	{collider "tank.heavy"}
	{PatherId "tiger2"}

	{sensor
		{visor "main"
			{vision "tank_range_250"}
		}
	}
	
;==============================================
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	
	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "driver"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"} {base "open1" -1}}
		}
		{anm "gunner"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"}  {base "open1" -1}}
		}
		{anm "commander"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open"}}
			{reverse {end "emit_tank_2_hold"} {base "open" -1}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("crew_human" place(driver)		door(emit1)  visor(visor1))
	("crew_human" place(gunner)		door(emit1) visor(visor2))
	("crew_human" place(commander)	door(emit2) visor(around))

	("seat_human" place(seat1) bone(seat1) door(emit11)  animation(armor))
	("seat_human" place(seat2) bone(seat2) door(emit12)  animation(armor))
	("seat_human" place(seat3) bone(seat3) door(emit13)  animation(armor))
;==============================================

	{extender "shield"{on}}

	{extender "vision_mode"
		{timer_object
			{tag		"thermal"}
			{active_time	   80}
			{recharge_rate	  1.0}
			{type	     "recharge"}
	    }
	}
	
	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		{box
			{item "bulletger_128 apcbche" 160} 	
			{item "bulletger_128 he" 150}
			{item "bulletger_37_auto ap" 4000}
			{item "bulletger_37_auto he" 4000}
			{item "ammo mgun_usa belt" 11250}
			{item "geballteladung_3kg" 2}
			{item "nbks grenade" 12}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "128mm_l40_auto_ctb_ger" filling "ammo bulletger_128 apcbche" 3}
			{foresight "foresight1"}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_dymamic_stabilised"
				zeroing(3.0)
				dispersion(0.17)
			)
			{basic}
		}

		{place "mgun"
			{type "aa"}
			{weapon "browning_m19a4_ctb_ger" filled}
			{foresight "foresight3"}
			{gunner "commander"}
			{charger "commander"}
			("abm_mgun")
			{basic}
		}

		{place "gun2"
			{Barrels 2}
			{weapon "37mm_flak43_2_ctb_ger" filling "bulletger_37_auto he" 32}
			{foresight "foresight2"}
			{shooter "shooter"}
			{charger "gunner"}
			{gunner "gunner"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 69800}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.61))
		("mobility_tank"
			speed(83) ;----------Max speed when fully accelerated on road, km/h.
			reverse(11) ;--------Max speed in reverse on road, km/h. (+2 of real life speed)
			traverse(20) ;-------Track traverse, per second, in degrees.
			weight(69.8) ;-------Weight in Tonnes.
			power(820) ;---------Engine Power, in hp. //engine was governed to 2500 max rpm which reduced it from 700HP to 600HP
			track(4.3) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(8600) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(900) ;----------Range in km, off-road.
		)
	}
	{bone "turret"
		{speed2 10}
	}
	{bone "turret2"
		{speed2 10}
	}
	{bone "mgun_rot"
		{speed2 40}
	}
	{bone "mgun"
		{speed2 35}
	}
	{bone "gun2"
		{speed2 35}
	}

}