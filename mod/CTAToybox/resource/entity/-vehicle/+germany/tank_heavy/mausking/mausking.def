{game_entity
	(include "/properties/tank__ctb_mausking_04b99f0c.ext")
	(include "/properties/shadow/tank.inc" scale(1.3))
	(include "/properties/selection/vehicle_big.inc" scale(1.3))
	{collider "tank.heavy"}
	{props "heavy" "multi_turret" "vision_lev05" "smoke" "nwg" "detect_tank_heavy" "muzzle_122mm_128mm_sides" }
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	(include "mausking.ext")
	{PatherId "tiger2"}

	{sensor
		{visor "main"
			{vision "tank_range_250"}
			{bone "visor2"}
		}
	}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbk39"}
	}

    ;==============================================
    
	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)


	{boarder
		{anm "charger"
			{forward {begin "board_pz4_driver"} {end "seat_gunner_stand"} {base "open1"}}
			{reverse {end "board_pz4_driver" -1} {base "open1" -1}}
		}
		{anm "gunner"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"} {base "open1" -1}}
		}
		{anm "gunner2"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open2"}}
			{reverse {end "emit_tank_2_hold"} {base "open2" -1}}
		}
		{anm "gunner3"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open2"}}
			{reverse {end "emit_tank_2_hold"} {base "open2" -1}}
		}
		{anm "gunner4"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open2"}}
			{reverse {end "emit_tank_2_hold"} {base "open2" -1}}
		}
		{anm "driver"
			{forward {begin "board_tank_right"} {end "pose_mgun_pz6"} {base "open"}}
			{reverse {end "emit_tank_2_hold"} {base "open" -1}}
		}
		{anm "commander"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"} {base "open1"}}
			{reverse {end "emit_tank_1"} {base "open1" -1}}
		}
		{anm "charger3"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"} {base "open1" -1}}
		}
		{anm "charger4"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"} {base "open1" -1}}
		}

	}
	
	("crew_human" place(driver)		door(emit1)  visor(visor1) animation(driver))
	("crew_human" place(gunner)		door(emit3) visor(visor2) animation(gunner))
	("crew_human" place(gunner2)		door(emit3) visor(visor3) animation(gunner2))
	("crew_human" place(gunner3)		door(emit3) visor(visor4) animation(gunner3))
	("crew_human" place(gunner4)		door(emit3) visor(visor5) animation(gunner4))
	("crew_human" place(charger)	door(emit2) visor(none) animation(gunner))
	("crew_human" place(commander)	door(emit3) visor(around) animation(gunner))
	("crew_human" place(charger3)	door(emit2) visor(none) animation(gunner))
	("crew_human" place(charger4)	door(emit2) visor(none) animation(gunner))

	{extender "inventory"
		{box
			{item "bulletger_128 apcbche" 225}
			{item "bulletger_128 apcr" 75}
			{item "bulletger_128 he" 200}	        ; 82 rounds 128mm
			{item "bulletger_20_auto ap" 1000}		; 14 clips (20 rounds each) 33/66 AP/HE
			{item "bulletger_20_auto he" 1800}
			{item "ammo mgun_ger belt" 12500}
			{item "bulletger_37_auto ap" 2200}		; 50 magazines (6 rounds each)	33/66 AP/HE
			{item "bulletger_37_auto he" 3000}
			{item "mg34_tank_2_ctb_ger" filled {user "mgunr"}}
			{item "mg34_tank_2_ctb_ger" filled {user "mgunl"}}
			{item "nbk39 grenade" 24}
			{item "repair_kit" 14}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "128mm_pak80_2_ctb_ger" filling "bulletger_128 apcbche" 1}
			{foresight "foresight1"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_gun"
				zeroing(4.0)
				dispersion(0.20)
			)
			{basic}
		}
		{place "gun2"
			{RestoreIKAfterAim}
			{weapon "128mm_pak80_2_ctb_ger" filling "bulletger_128 apcbche" 1}
			{foresight "foresight2"}
			{gunner "gunner"}
			{charger "charger3"}
			("abm_dymamic_gun"
				zeroing(4.0)
				dispersion(0.20)
			)
			{basic}
		}
		{place "mgun_turret"
			{type "coaxial"}
			{weapon "mg34_tank_2_ctb_ger" filled}
			{foresight "foresight6"}
			{gunner "gunner"}
			{charger "charger3"}
			{basic}
			{ai_in_manual}
		}
		{place "gun3"
			{RestoreIKAfterAim}
			{weapon "37mm_flak37_ctb_ger" filling "bulletger_37_auto he" 12}
			{foresight "foresight4"}
			{gunner "gunner2"}
			{charger "charger3 charger4" minWorkers 1}
			("abm_dymamic_aaa"
				zeroing(1.2)
				dispersion(0.15)
			)
			{basic}
			{ai_in_manual}		
		}
		{place "gun4"
			{RestoreIKAfterAim}
			{weapon "20mm_flak38_ctb_ger" filling "bulletger_20_auto he" 20}
			{foresight "foresight5"}
			{gunner "gunner2"}
			{charger "charger3"}
			("abm_dymamic_aaa"
				zeroing(1.2)
				dispersion(0.15)
			)
			{basic}
			{ai_in_manual}		
		}
		{place "mgunl"
			{type "hull"}
			{weapon "mg34_tank_2_ctb_ger" filled}
			{gunner "gunner3"}
			{charger "gunner3"}
			{LinkBone "mgunl"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgunr"
			{type "hull"}
			{weapon "mg34_tank_2_ctb_ger" filled}
			{gunner "gunner4"}
			{charger "gunner4"}
			{LinkBone "mgunr"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}
	
	{mass 220000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.20) len(0.49))
		("mobility_tank"
			speed(27) ;----------Max speed when fully accelerated on road, km/h.
			reverse(10.5) ;--------Max speed in reverse on road, km/h.
			traverse(15) ;-------Track traverse, per second, in degrees.
			weight(220.0) ;-------Weight in Tonnes.
			power(1000) ;---------Engine Power, in hp.
			track(3.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(27000) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(850) ;----------Range in km, off-road.
		)
	}

	{Extension "mausking.mdl"}

	{bone "turret"
		("turret_heavy" power_traverse(20))
	}
	{bone "aux_turret1"
		("turret_light" power_traverse(45))
	}
	{bone "gun_rot"
		{speed2 5}
	}
	{bone "gun3_rot2"
		{speed2 30}
	}
	{bone "mgunl_rot1"
		{speed2 30}
	}
	{bone "mgunl_rot2"
		{speed2 30}
	}
	{bone "mgunr_rot1"
		{speed2 30}
	}
	{bone "mgunr_rot2"
		{speed2 30}
	}
	{bone "gun4"
		{speed2 30}
	}

}




