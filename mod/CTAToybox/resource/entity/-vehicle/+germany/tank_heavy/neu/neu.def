{game_entity
	(include "/properties/tank__ctb_neu_7328096f.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3)) 
	(include "/properties/selection/vehicle_big.inc" scale(1.2))
	{props "heavy" "vision_lev05" "muzzle_100mm_105mm" "shield" "nwg" "smoke" "smine" "fire_test" "detect_tank_heavy"}
	{extension "neu.mdl"}
	(include "neu.ext")
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	{collider "tank.heavy"}
	{PatherId "tiger2"}

	{sensor
		{visor "main"
			{vision "tank_range_250"}
			{bone "visor1"}
		}
		{visor "commander"
			{vision "searchlight"}
			{bone "foresight4"}
		}
	}
	
;==============================================
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	
	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "driver"
			{forward {begin "board_jtiger_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse {end "board_jtiger_driver" -1} {base "open_driver" -1}}
		}
		{anm "gunner"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open"}}
			{reverse {end "emit_tank_2_hold"}  {base "open" -1}}
		}
		{anm "charger"
			{forward {begin "board_tank_right"} {end "pose_mgun_pz6"} {base "open"}}
			{reverse {end "emit_tank_2_hold"} {base "open" -1}}
		}
		{anm "commander"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"} {base "open1" -1}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("crew_human" place(driver)		door(emit1)  visor(visor1))
	("crew_human" place(gunner)		door(emit2) visor(visor2))
	("crew_human" place(charger)	door(emit2) visor(none))
	("crew_human" place(commander)		door(emit3) visor(around))

	("seat_human" place(seat1) bone(seat1) door(emit5)  animation(armor))
	("seat_human" place(seat2) bone(seat2) door(emit6)  animation(armor))
;==============================================

	{extender "shield"{on}}

	{extender "vision_mode"
		{timer_object
			{tag		"thermal"}
			{active_time	   80}
			{recharge_rate	  1.0}
			{type	     "recharge"}
	    }
	}
	
	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		{box
			{item "bulletger_128 apcbche" 160} 	
			{item "bulletger_128 apds" 40} 	
			{item "bulletger_128 he" 150}	
			{item "bulletger_20_auto ap" 3000}		; 3200 rounds, 160 clips (20 rounds each)
			{item "bulletger_20_auto he" 3000}
		    {item "ammo mgun_ger belt ap2" 9000}			; 12 drums (50 rounds each)
			{item "geballteladung_3kg" 2}
			{item "s.mine" 12}
			{item "nbks grenade" 12}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "128mm_hochdruck_ctb_ger" filling "ammo bulletger_128 apcbche" 1}
			{foresight "foresight1"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(3.0)
				dispersion(0.17)
			)
			{basic}
		}

		{place "gun3"
			{type "coaxial"}
			{weapon "20mm_flak38_3_ctb_ger" filling "bulletger_20_auto he" 20}
			{foresight "foresight3"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_aaa"
				zeroing(1.8)
				dispersion(0.15)
			)
			{basic}
	    }

		{place "mgun11"
			{weapon "mg34_tank_x2_3_ctb_ger" filling "mgun_ger belt ap2" 550}
			{foresight "foresight2"}
			{charger "commander"}
			{gunner "commander"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}

		{place "s_mine"
			{type "s_mine"}
			{weapon "s_weapon_ctb_ger" filled}
			{foresight "foresight11"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}

		{place "gun2"
			{RestoreIKAfterAim}
			{weapon "searchlight"}
			{foresight "foresight4"}
			{gunner "commander"}
			{basic}
			{ai_in_manual}
			{rotate}
		}

	}

	{mass 77800}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.94))
		("mobility_tank"
			speed(120) ;----------Max speed when fully accelerated on road, km/h.
			reverse(11) ;--------Max speed in reverse on road, km/h. (+2 of real life speed)
			traverse(20) ;-------Track traverse, per second, in degrees.
			weight(77.8) ;-------Weight in Tonnes.
			power(1200) ;---------Engine Power, in hp. //engine was governed to 2500 max rpm which reduced it from 700HP to 600HP
			track(3.3) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(8600) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(900) ;----------Range in km, off-road.
		)
	}
	{bone "turret"
		{speed2 30}
	}
	{bone "gun_rot"
		{speed2 10}
	}
	{bone "mgun_rot2"
		{speed2 45}
	}
	{bone "mgun_rot"
		{speed2 30}
	}

}