{game_entity
	(include "/properties/tank__ctb_tiger_h_west_ac248164.ext")
	
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "heavy" "vision_lev00" "muzzle_85mm_93mm_sides" "shield" "fire_test"  "smoke" "nwg" "smine" "tiger_h_wt" "88mm_shell_eject" "detect_tank_heavy"}
	{extension "tiger_h_west.mdl"}
	(include "tiger_h.ext")
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	{collider "tank.heavy"}
	{PatherId "tiger"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{sensor
		{visor "main"
			{vision "tank_range_210"}
		}
	}

	{extender "smokescreen"
		{cooldown 20}
		{itemTags "grenade nbks"}
	}

	("commander_visible")

	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	(define "seat_human_d"
		{placer{place "%place" {group "passenger"} {LinkBone "%bone"}{attach squat_lie}}}
		{boarder
		{door "%door"}
		{link "%door" "%place" {anm "%animation"}}
		}
	)
	(define "seat_human_z"
		{placer{place "%place"{group "passenger"}{LinkBone "%bone"}{attach snipe_cover}}}
		{boarder{door "%door"}{link "%door" "%place" {anm "%animation"}}}
	)

	{boarder
		{anm "driver"
			{forward	{begin	"board_pz4_driver"} {end "seat_driver_car"} {base "open3_off"}}
			{reverse 	{end	"board_pz4_driver" -1} {base "open3_off"}}
		}
		{anm "charger"
			{forward	{begin	"board_pz-6"} {end "seat_driver_car"} {base "open1_off"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open2_off"}}
		}
		{anm "gunner3"
			{forward	{begin	"board_pz-6"} {end "seat_driver_car"} {base "open2_off"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open2_off"}}
		}
		{anm "gunner"			
			{forward	{begin	"board_pz-6"} {end "seat_driver_car"} {base "open1_off"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open1_off"}}
		}
		{anm "commander"			
			{forward	{begin	"board_pz-6"} {end "seat_commander_hatch"} {base "open"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_1"}}
		}
	}

	("crew_human" place(driver)	door(emit1) visor(driver) animation(driver))
	("crew_human" place(charger)	door(emit3) visor(main) animation(charger))
	("crew_human" place(gunner3)	door(emit4) visor(main) animation(gunner3))
	("crew_human" place(gunner)	door(emit3) visor(main) animation(gunner))
	("crew_human" place(commander)	door(emit2) visor(up) animation(commander))

	("seat_human_z" place(seat4) bone(seat06) door(emit7)  animation(armor))
	("seat_human_z" place(seat3) bone(seat07) door(emit8)  animation(armor))
	("seat_human_d" place(seat2) bone(seat08) door(emit6)  animation(armor))
	("seat_human_d" place(seat1) bone(seat09) door(emit10)  animation(armor))

	("seat_human" place(seat5) bone(seat01) door(emit6)  animation(armor))
	("seat_human" place(seat6) bone(seat02) door(emit7)  animation(armor))
	("seat_human" place(seat7) bone(seat03) door(emit9)  animation(armor))
	("seat_human" place(seat8) bone(seat00) door(emit5)  animation(armor))
	("seat_human" place(seat9) bone(seat04) door(emit10)  animation(armor))
	("seat_human" place(seat10) bone(seat05) door(emit8)  animation(armor))



	{extender "shield" {on}}


	{extender "inventory"
		{weapon "mgun" {mask "mountable"}}
		{box
			{item "bulletger_88_l56 apcbche" 165} 	; 92 rounds
			{item "bulletger_88_l56 he" 230}
			{item "bulletger_88_l56 apcr" 15}
			{item "bulletger_88_l56 heat" 45}
			{item "ammo mgun_ger belt" 22500}		; 32 belts (150 rounds each)
			{item "geballteladung_3kg" 2}
			{item "nbks grenade" 12}
			{item "mine s" 12}
			{item "repair_kit" 20}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "88mm_kwk36_wt_ctb_ger" filling "bulletger_88_l56 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(3.0)
				dispersion(0.20)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "mg34_tank_ctb_ger" filled}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "mg34_tank_ctb_ger" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun"
			{type "commander"}
			{weapon "commander_vision"}
			{foresight "vision_rot"}
			{gunner "commander"}
			{basic}
			{ai_in_manual}
		}
		{place "s_mine"
			{type "s_mine"}
			{weapon "s_weapon_ctb_ger" filled}
			{foresight "vision_rot"}	
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 57000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(-0.58))
		("mobility_tank"
			speed(57) ;----------Max speed when fully accelerated on road, km/h.
			reverse(12) ;--------Max speed in reverse on road, km/h. (+2 of real life speed)
			traverse(26) ;-------Track traverse, per second, in degrees.
			weight(57) ;---------Weight in Tonnes.
			power(600) ;---------Engine Power, in hp. //engine was governed to 2500 max rpm which reduced it from 700HP to 600HP
			track(3.3) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(5400) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(800) ;----------Range in km, off-road.
		)
	}

	{bone "gun_rot"
		{limits 16 -8}
		{speed2 4}
	}
	{bone "gunner2_rot"
		{speed2 60}
	}
	{bone "turret"
		{speed2 19}
	}

	{texmod "camo2"}
}