{game_entity
	(include "/properties/tank__ctb_vk4503_13489e2c.ext")
	(include "/properties/shadow/tank.inc" scale(1.3))
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "heavy" "vision_lev05" "muzzle_85mm_93mm_sides" "shield" "smoke" "nvw" "detect_tank_heavy"}
	{extension "vk4503.mdl"}
	(include "vk4503.ext")
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	{collider "tank.heavy"}
	{PatherId "tiger2"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{sensor
		{visor "main"
			{vision "tank_range_250"}
		}
	}

	("crew_5_human")

	("gunner_visible")

	{boarder
		{anm "left"
			{forward	{begin	"board_pz4_driver"} {end "pz-4_driver_seat"} {base "open_driver" }}
			{reverse 	{end	"board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "right"
			{forward	{begin	"board_sherman_right"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "seat_armor"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "seat_armor"}}
			{reverse 	{end	"emit_body"}}
		}
	}


	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))
	
	{extender "shield" {on}}
	{extender "inventory"
		{weapon "mgun" {mask "mountable"}}
		{box
			{item "bulletger_88_l71 apcbche" 195}	; 80 rounds
			{item "bulletger_88_l71 he" 200}
			{item "ammo mgun_ger belt" 22500}		; 32 belts (150 rounds each)
			{item "mg34_drum_ctb_ger" filled {user "mgun"}}
			{item "geballteladung_3kg" 2}
			{item "nbk39 grenade" 12}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "88mm_kwk43_ctb_ger" filling "bulletger_88_l71 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(3.0)
				dispersion(0.20)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "mg34_tank_ctb_ger" filled}
			{foresight "foresight5"}
			{gunner "gunner3"}
			{gunner "gunner3"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "mg34_tank_ctb_ger" filled}
			{foresight "foresight4"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun"
			{type "aa"}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "mgun_rot"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 68000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(1.16))
		("mobility_tank"
			speed(53) ;----------Max speed when fully accelerated on road, km/h.
			reverse(11) ;--------Max speed in reverse on road, km/h. (+2 of real life speed)
			traverse(20) ;-------Track traverse, per second, in degrees.
			weight(68) ;-------Weight in Tonnes.
			power(600) ;---------Engine Power, in hp.
			track(5.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(8600) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(900) ;----------Range in km, off-road.
		)
	}

	{bone "gun_rot"
		{limits -8 15}
		{speed2 3}
	}
	;{bone "turret"
	;	{speed2 6}
	;}
	{bone "turret"
		;{speed 0.003}
		{speed2 7}
	}

	{texmod "camo"}
}