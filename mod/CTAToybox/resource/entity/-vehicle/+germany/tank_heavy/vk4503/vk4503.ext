;SDL
	
	; armor notes
	; tracks and wheels 30mm
	; gun 30mm
	; schürzen 5mm

	("tank_heavy_tier1")

	("tracks" repair(30) thickness(120))
	("gun" repair(30) thickness(120))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("ammo" args "ammo4")
	("fuel" args "fuel1")
	("fuel" args "fuel2")
	("fuel" args "fuel3")
	("transmission" args "transmission")
	
	{volume "body"			; Hull
		{thickness 240
			{front 300}		; Lower Nose
			{top 450}		; Glacis
			{rear 75}
			{bottom 75}
		}
	}
	{volume "body1"			; Superstructure
		{thickness 240
			{front 450}
			{top 120}
			{rear 75}
			{bottom 75}		; Overhang (above tracks)
		}
	}
	{volume "engine"		
		{thickness 240
			{front 75}
			{top 120}
			{rear 240}
			{bottom 75}		; Overhang (above tracks)
		}
	}
	{volume "turret"		; Main Turret
		{thickness 240
			{front 300}
			{top 120}
			{bottom 75}
		}
	}
	{volume "turret2"		; Buldge for Cupola
		{thickness 240
			{top 120}
			{bottom 75}
		}
	}
	{volume "turret1"		; Turret Ring
		{thickness 240
			{front 300}
			{top 75}
			{bottom 75}
		}
	}
	{volume "mantlet"
		{thickness 360}
		{CastSteel 0.8063}
	}
