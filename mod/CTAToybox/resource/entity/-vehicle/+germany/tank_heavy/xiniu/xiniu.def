{game_entity
	(include "/properties/tank__ctb_xiniu_12b5d5c6.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3)) 
	(include "/properties/selection/vehicle_big.inc" scale(1.2))
	{props "heavy" "vision_lev05" "muzzle_100mm_105mm" "shield" "smoke" "nwg" "detect_tank_heavy"}
	{extension "xiniu.mdl"}
	(include "xiniu.ext")
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	{collider "tank.heavy"}
	{PatherId "tiger2"}

	{sensor
		{visor "main"
			{vision "tank_range_250"}
		}
	}
	
;==============================================
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	
	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "driver"
			{forward {begin "board_jtiger_driver"} {end "seat_gunner_stand"} {base "open"}}
			{reverse {end "board_jtiger_driver" -1} {base "open -1"}}
		}
		{anm "gunner"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open"}}
			{reverse {end "emit_tank_2_hold"}  {base "open" -1}}
		}
		{anm "gunner3"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open"}}
			{reverse {end "emit_tank_2_hold"}  {base "open" -1}}
		}
		{anm "gunner4"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open"}}
			{reverse {end "emit_tank_2_hold"}  {base "open" -1}}
		}
		{anm "charger"
			{forward {begin "board_tank_right"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"} {base "open1" -1}}
		}
		{anm "commander"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"} {base "open1" -1}}
		}
	}

	("crew_human" place(driver)		door(emit1)  visor(visor1))
	("crew_human" place(gunner)		door(emit2) visor(visor2))
	("crew_human" place(gunner3)		door(emit2) visor(visor2))
	("crew_human" place(gunner4)		door(emit2) visor(visor2))
	("crew_human" place(charger)	door(emit3) visor(none))
	("crew_human" place(commander)		door(emit3) visor(around))
;==============================================

	{extender "shield"{on}}

	{extender "vision_mode"
		{timer_object
			{tag		"thermal"}
			{active_time	   80}
			{recharge_rate	  1.0}
			{type	     "recharge"}
	    }
	}
	
	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		{box
			{item "bulletger_128 apcbche" 160} 	
			{item "bulletger_128 he" 150}
		    {item "ammo mgun_ger belt ap2" 24000}	
			{item "bulletger_20_auto ap" 2100}		
			{item "bulletger_20_auto apcr" 1200}		
			{item "bulletger_20_auto he" 3000}
			{item "bulletger_150at heat" 80}
			{item "bulletger_150at he" 120}
			{item "geballteladung_3kg" 2}
			{item "nbks grenade" 12}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "128oto_ctb_ger" filling "ammo bulletger_128 apcbche" 3}
			{foresight "foresight1"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(3.0)
				dispersion(0.17)
			)
			{basic}
		}

		{place "mgun"
			{type "coaxial"}
			{weapon "mg42_tank_ctb_ger" filled}
			{foresight "foresight3"}
			{gunner "gunner3"}
			{charger "gunner3"}
			{basic}
			{ai_in_manual}
		}

		{place "mgun2"
			{type "coaxial"}
			{weapon "20mm_mg151_tank_ctb_ger" filling "bulletger_20_auto he" 200}
			{foresight "foresight5"}
			{gunner "gunner4"}
			{charger "gunner4"}
			{basic}
			{ai_in_manual}
		}

		{place "at"
			{type "hull"}
			{weapon "ger_at_ctb_ger" filling "bulletger_150at he" 1}
			{foresight "foresight7"}
			{gunner "commander"}
			{charger "commander"}
			{basic}
			{ai_in_manual}
			("abm_dymamic_gun"
				zeroing(4.0)
				dispersion(0.25)
			)
		}
		{place "at2"
			{type "hull"}
			{weapon "ger_at_ctb_ger" filling "bulletger_150at he" 1}
			{foresight "foresight6"}
			{gunner "commander"}
			{charger "commander"}
			{basic}
			{ai_in_manual}
			("abm_dymamic_gun"
				zeroing(4.0)
				dispersion(0.25)
			)
		}
	}

	{mass 69800}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.54))
		("mobility_tank"
			speed(53) ;----------Max speed when fully accelerated on road, km/h.
			reverse(11) ;--------Max speed in reverse on road, km/h. (+2 of real life speed)
			traverse(20) ;-------Track traverse, per second, in degrees.
			weight(69.8) ;-------Weight in Tonnes.
			power(800) ;---------Engine Power, in hp. //engine was governed to 2500 max rpm which reduced it from 700HP to 600HP
			track(3.3) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(8600) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(900) ;----------Range in km, off-road.
		)
	}
	{bone "turret"
		{speed2 10}
	}
	{bone "gun_rot"
		{speed2 10}
	}
	{bone "mgun_rot"
		{speed2 40}
	}
	{bone "mgun"
		{speed2 30}
	}
	{bone "mgun2_rot"
		{speed2 40}
	}
	{bone "mgun2"
		{speed2 30}
	}
	{bone "at"
		{speed2 30}
	}
	{bone "at_rot"
		{speed2 30}
	}

}