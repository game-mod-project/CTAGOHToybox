{game_entity
	(include "/properties/tank__ctb_flakpanzer1a_2f1b8aad.ext")
	(include "/properties/shadow/tank.inc" scale(1.0))
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "light" "vision_lev03" "muzzle_20mm_25mm_auto" "detect_cannon_aa" "open_top" "ammo_open_top_turret" "sq_autocannon"}
        (include "flakpanzer1a.ext")
	{targetclass "tank_light"}
	{targetSelector "tank_zenite"}
	{patherId "panzer1"}
	{collider "tank.light"}

	



	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "driver"
			{forward	{begin	"board_tank"} {end "pose_flak38-1_charger"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "commander"			
			{forward	{begin	"board_tank"} {end "pose_flak38-1_gunlayer"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "charger"
			{forward	{begin "board_SdKfz251-1"} {end "pose_flak30_loader"} {base "board"}}
			{reverse	{end "emit_body" 1}}
		}
	}

	("crew_human_visible" place(driver)	door(emit0) visor(driver))
	("crew_human_visible" place(commander)	door(emit1) visor(main))
	("crew_human_visible" place(charger)	door(emit1) visor(main))


	{extender "inventory"
		{box
			{item "bulletger_20_auto he" 1000}
			{item "bulletger_20_auto ap" 500}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{weapon "20mm_flak38_ctb_ger" filling "bulletger_20_auto he" 20}
			{gunner "commander"}
			("abm_dymamic_aa"
				zeroing(2.9)
				dispersion(0.08)
			)
		}
	}

	{mass 5500}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(0.43))
		("mobility_tank"
			speed(60) ;----------Max speed when fully accelerated on road, km/h.
			reverse(6) ;---------Max speed in reverse on road, km/h.
			traverse(32) ;-------Track traverse, per second, in degrees.
			weight(6.4) ;--------Weight in Tonnes.
			power(100) ;---------Engine Power, in hp.
			track(4) ;-----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(1460) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(1150) ;---------Range in km, off-road.
		)
	}

	{Extension "flak_pz1a.mdl"}

	{bone "gun_rot"
		{speed2 15}
	}
	{bone "turret"
		{speed2 35}
	}
}
