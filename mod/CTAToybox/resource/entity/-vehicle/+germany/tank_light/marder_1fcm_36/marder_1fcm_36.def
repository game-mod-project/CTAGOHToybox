{game_entity
	(include "/properties/tank_assaultgun__ctb_marder_1fcm_36_30d99b24.ext")
	(include "/properties/shadow/tank.inc" scale(1.2))
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props "td" "medium" "-turret" "vision_lev04" "muzzle_75mm_76mm_sides" "shell_eject" "open_top" "ammo_open_top" "detect_td_medium" "sq_at_gun"}
	(include "marder_1fcm_36.ext")
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{PatherId "panzer3"}

	


	{boarder
		{anm "driver"
			{forward	{begin	"board_t34_driver"} {end "seat_gunner_stand"} {base "open1"}}
			{reverse 	{end	"emit_t34_hold"} {base "close_driver"}{base "open1" -1}}
		}
		{anm "charger"
			{forward	{begin	"board_tank_right"} {end "pose_pak40_gunlayer"} }
			{reverse 	{end	"emit_body" 1} }
		}
		{anm "gunner"
			{forward	{begin	"board_tank_right"} {end "pose_pak40_charger"} }
			{reverse 	{end	"emit_body" 1}}
		}
		{anm "commander"
			{forward	{begin	"board_tank_right"} {end "pose_pak40_gunlayer"} }
			{reverse 	{end	"emit_body" 1}}
		}
		{anm "gunner2"
			{forward	{begin	"board_tank_right"} {end "pose_mgun_stan1"}}
			{reverse 	{end	"emit_tank_2_hold"} }
		}
	}

	(define "crew_human"
		{placer
			{place "%place" {group "crew"} {linkbone "%place"} {turnoff {sensor} {shadow}}}
		}
		{boarder
			{door "%door1"}
			{door "%door2"}
			{link "%door1" "%place" {anm "%place"} {forward putoff} {reverse puton}}
			{link "%door2" "%place" {anm "%place"} {forward putoff} {reverse puton}}
		}
	)

	{placer
		{place "driver"  {visor "driver"} {group "crew"}} 
	}
	{placer
		{place "gunner" {visor "main"}}
	}

	{boarder
		{door "emit0"}
		{door "emit1"}
		{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}
	}

	("crew_human" place(gunner)	door1(emit1))
	("crew_human" place(charger)	door1(emit1))
	("crew_human" place(gunner2)	door1(emit1))

	{extender "inventory"
		{box
			{item "bulletger_75_l43 apcbche" 50} 	; 70 rounds
			{item "bulletger_75_l43 he" 15}
			{item "bulletger_75_l43 apcr" 5}
			{item "geballteladung_3kg" 1}
			{item "ammo mgun_ger drum" 550}	
			{item "mg34_drum" filled {user "mgun"}}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_pak40_2" filling "bulletger_75_l43 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_td"
				zeroing(2.5)
				dispersion(0.25)
			)
			{rotate}
		}
		{place "mgun"
			{type "aa"}
			{gunner "gunner2"}
			{charger "gunner2"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			{ai_in_manual}
			{basic}
		}
	}

	{mass 12800}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(1.05))
		("mobility_tank"	
			speed(24)  ;---------Max speed when fully accelerated on road, km/h.
			reverse(6);----------Max speed in reverse on road, km/h.
			traverse(15) ;-------Track traverse, per second, in degrees.
			weight(12.8) ;-------Weight in Tonnes.
			power(105) ;---------Engine Power, in hp. //engine under normal use was rated 265hp at 2600 rpm
			track(5) ;-----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(217) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(140) ;----------Range in km, off-road.
		)
	}

	{Extension "marder_1fcm_36.mdl"}


	{bone "turret"
		{limits -5 5}
		{speed2 5}
	}
	{bone "gun_rot"
		{limits -25 5}
		{speed2 4}
	}

}
