{game_entity
	(include "/properties/tank__ctb_pz38tna_b_5983581b.ext")
	(include "/properties/shadow/tank.inc" scale(1.0))
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "light" "vision_lev03" "muzzle_37mm_47mm" "shield" "smoke" "nkav" "detect_tank_light" "sq_armor_light"}
	{targetclass "tank_light"}
	{targetSelector "tank_light"}
	(include "pz38tna_b.ext")
	{patherId "panzer38"}
	{collider "tank.light"}

	{extender "enumerator"
		{digit_folder "ger2"}
	}


	;("armor_light" turret(25 15 15 10) body(25 15 15 8))
	;("armor_mantlet" t(25))
	;("armor_engine"  t(10 15 15 8))

	("crew_4_human")

	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor2"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor2))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor2))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor2))
	
	{extender "shield"
		{on}
	}

	{extender "inventory"
		{box
			{item "bulletger_37 aphe" 42}		; 90 rounds
			{item "bulletger_37 apcr" 5}
			{item "bulletger_37 he" 42}
			{item "ammo mgun_ger" 2500}	; 27 belts (100 rounds each)
			{item "geballteladung_3kg" 1}
			{item "nbk39 grenade" 5}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "37mm_kwk38t" filling "bulletger_37 aphe" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_poor"
				zeroing(2.0)
				dispersion(0.20)
			)
		}
		{place "mgun1"
			{type "coaxial"}
			{weapon "mg37t" filled}
			{foresight "foresight4"}
			{gunner "gunner"}
			{charger "commander"}
			("abm_mgun")
			{basic}
		}

	}

	{mass 9850}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.32) len(0.12))
		("mobility_tank"
			speed(42) ;----------Max speed when fully accelerated on road, km/h.
			reverse(10) ;--------Max speed in reverse on road, km/h.
			traverse(34) ;-------Track traverse, per second, in degrees.
			weight(9.85) ;-------Weight in Tonnes.
			power(125) ;---------Engine Power, in hp.
			track(5) ;-----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(220) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(100) ;---------Range in km, off-road.
		)
	}

	{Extension "pz38tna_b.mdl"}
	
	{bone "turret"
		("turret_light" power_traverse(0)) ;// manual
	}
	{bone "gun_rot"
		{speed2 3}
		{limits -25 10}
	}

}
