;SDL

	; armor notes
	; tracks and wheels 15mm
	; gun 20mm

	("tank_light_tier1")

	("tracks" repair(30) thickness(40))
	("gun" repair(35) thickness(60))

	("fuel" args "fuel")
	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("transmission" args "transmission")

		{volume "body"
		{thickness 30		; Glacis
			{front 50}		; Lower Hull
			{rear 20}
		}
	}
	{volume "body1"
		{thickness 30		; Glacis
			{front 50}		; Lower Hull
			{rear 20}
		}
	}

	{volume "turret"
		{thickness 30		; Glacis
			{front 50}		; Lower Hull
			{rear 20}
		}
	}
	
	{volume "engine"		; Internal
		{thickness 10}
		{able {NoWoundDecal 0}}
	}

	{volume "mantlet"
		{thickness 50}
	}
	{volume "mantlet2"
		{thickness 20}
	}