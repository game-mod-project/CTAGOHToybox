{game_entity
	(include "/properties/tank_assaultgun__ctb_pzkpfw_2hvk903_733a66f3.ext")
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{collider "tank.light"}
	(include "pzkpfw_2hvk903.ext")
	{props "td" "light" "open_top" "ammo_open_top_turret" "vision_lev04" "shell_eject" "muzzle_50mm_57mm" "sq_at_gun"}
	{targetclass "tank_light"}
	{targetSelector "tank_medium"}
	{patherId "tank.light"}

	{Extension "pzkpfw_2hvk903.mdl"}
	
	
	{texmod "desert"}
;==============================================
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {targetable 0}}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "driver"
			{forward	{begin	"board_tank"} {end "seat_driver_car"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "charger"
			{forward	{begin	"board_tank"} {end "seat_driver_car"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "commander"			
			{forward	{begin	"board_tank"} {end "seat_driver_car"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
	}

	("crew_human_visible" place(driver) door(emit0) animation(driver) visor(driver))
	("crew_human_visible" place(charger) door(emit1)  animation(charger)  visor(main))
	("crew_human_visible" place(commander) door(emit0) animation(commander) visor(main))

;==============================================


	{extender "shield"
		{on}
	}
	{component "shieldl1" {tags "cut_part"}}
	{component "shieldl2" {tags "cut_part"}}
	{component "shieldl3" {tags "cut_part"}}
	{component "shieldl4" {tags "cut_part"}}
	{component "shieldl5" {tags "cut_part"}}
	{component "shieldl6" {tags "cut_part"}}
	{component "shieldl7" {tags "cut_part"}}
	{component "shieldr1" {tags "cut_part"}}
	{component "shieldr2" {tags "cut_part"}}
	{component "shieldr3" {tags "cut_part"}}
	{component "shieldr4" {tags "cut_part"}}
	{component "shieldr5" {tags "cut_part"}}
	{component "shieldr6" {tags "cut_part"}}

	{extender "inventory"
		{box
			{item "ammo bulletger_50_l60 apche" 275}
			{item "ammo bulletger_50_l60 he" 220}
			{item "ammo bulletger_50_l60 apcr" 25}
			{item "ammo mgun_ger belt" 12750}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "50mm_pak38_ctb_ger" filling "ammo bulletger_50_l60 apche" 1}
			{gunner "commander"}
			{charger "charger"}
				("abm_dymamic"
				zeroing(2.3)
				dispersion(1.0)
			)
		}
	}

	{mass 10500}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(-0.90))
		("mobility_tank"
			speed(90) ;----------Max speed when fully accelerated on road, km/h.
			reverse(10) ;--------Max speed in reverse on road, km/h.
			traverse(42) ;-------Track traverse, per second, in degrees.
			weight(11.8) ;-------Weight in Tonnes.
			power(180) ;---------Engine Power, in hp.
			track(4.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(2350) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(1550) ;---------Range in km, off-road.
		)
	}
	{bone "turret"
		("turret_light" power_traverse(0)) ;// manual
	}
}
