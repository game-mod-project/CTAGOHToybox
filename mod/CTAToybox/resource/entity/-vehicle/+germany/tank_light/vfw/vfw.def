{game_entity
	(include "/properties/tank__ctb_vfw_5785259e.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "vision_lev06" "explosion_throw_crew" "fire_test" "detect_td_medium"}
	{extension "vfw.mdl"}
	(include "vfw.ext")
	{PatherId "panzer3"}
	{targetclass "tank_medium"}
	{targetSelector "cannon_aa"}

	{sensor
		{visor "main"
			{vision "tank_range_250"}
			{bone "visor1"}
		}
	}

;==============================================
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	
	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "driver"
			{forward {begin "board_jtiger_driver"} {end "seat_gunner_stand"} {base "open"}}
			{reverse {end "board_jtiger_driver" -1} {base "open"}}
		}
		{anm "gunner"
			{forward {begin "board_tank_left"} {end "seat_ostwind_gunner"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "gunner2"
			{forward {begin "board_tank_left"} {end "seat_ostwind_gunner"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "gunner3"
			{forward {begin "board_tank_left"} {end "seat_ostwind_gunner"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "charger"
			{forward {begin "board_tank_left"} {end "seat_ostwind_gunner"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "charger2"
			{forward {begin "board_tank_left"} {end "pose_thor_gunner_animation"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "charger3"
			{forward {begin "board_tank_left"} {end "pose_thor_charger2_animation"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "commander"
			{forward {begin "board_tank_left"} {end "pose_watch_binocular"}}
			{reverse {end "emit_tank_2_hold"}}
		}
	}


	("crew_driver"	place(driver)	door(emit1) visor(visor1))

	("crew_human_visible_anm"	place(gunner)		door(emit4) visor(main) anm_left(gunner)	anm_right(gunner))
	("crew_human_visible_anm"	place(gunner3)		door(emit4) visor(main2) anm_left(gunner2)	anm_right(gunner2))
	("crew_human_visible_anm"	place(gunner4)		door(emit6) visor(main2) anm_left(gunner3)	anm_right(gunner3))
	("crew_human_visible_anm"	place(charger)		door(emit3) visor(main3) anm_left(charger)	anm_right(charger))
	("crew_human_visible_anm"	place(charger3)		door(emit3) visor(main3) anm_left(charger2)	anm_right(charger2))
	("crew_human_visible_anm"	place(charger4)		door(emit5) visor(main3) anm_left(charger3)	anm_right(charger3))
	("crew_human_visible_anm"	place(commander)	door(emit5) visor(around) anm_left(commander)	anm_right(commander))

;==============================================
	;("gunner_visible")

	{extender "inventory"
		{Box
			{item "bulletger_88_l56 apcbche" 15}
			{item "bulletger_88_l56 apcr" 3}
			{item "bulletger_88_l56 he" 10}
			{item "geballteladung_3kg" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "88mm_flak41" filling "ammo bulletger_88_l56 apcbche" 1}
			{gunner "gunner gunner3 gunner4" minWorkers 2}
			{charger "charger charger3 charger4" minWorkers 2}
			("abm_dymamic_td"
				zeroing(5.0)
				dispersion(0.25)
			)
		}

	}

	{mass 21500}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.50))
		("mobility_tank"
			speed(70) ;----------Max speed when fully accelerated on road, km/h. ;30
			reverse(12) ;--------Max speed in reverse on road, km/h.
			traverse(20) ;-------Track traverse, per second, in degrees.
			weight(21.5) ;-------Weight in Tonnes.
			power(640) ;---------Engine Power, in hp.
			track(7.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(860) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(110) ;----------Range in km, off-road.
		)
	}
	{bone "gun_rot2"
		{speed2 30}
	}
	{bone "gun_rot"
		{speed2 20}
	}

}