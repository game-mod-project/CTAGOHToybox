{game_entity
	(include "/properties/tank__ctb_vk1602_30mm_db5104fe.ext")
	(include "/properties/shadow/tank.inc" scale(1.2))
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "light" "vision_lev03" "automatic" "muzzle_37mm_40mm_auto" "shield" "smoke" "nwg" "detect_tank_light"} ;muzzle_37mm_40mm_auto_sides
	{extension "vk1602_30mm.mdl"}
	(include "vk1602_30mm.ext")
	{targetclass "tank_light"}
	{targetSelector "tank_zenite"}
	{patherId "panzer2l"}
	{collider "tank.light"}

	{extender "enumerator"
		{digit_folder "ger2"}
	}

	{sensor
		{visor "main"
			{vision "recon_main"}
		}
	}

	("crew_4_human")

	{boarder
		{anm "left"
			{forward {begin "board_Kv"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"} {end "seat_m7_com"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))

	{extender "shield" {on}}

	{extender "smokescreen"
		{cooldown 20}
		{itemTags "grenade nbk39"}
	}

	{extender "inventory"
		{box
			{item "bulletger_30_auto apcr" 480}		; 12 belts of 80 rounds
			{item "bulletger_30_auto he" 480}
			{item "ammo mgun_ger belt" 2400}	; 16 belts (150 rounds each)
			{item "geballteladung_3kg" 1}
			{item "nbk39 grenade" 2}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{weapon "30mm_mk103" filling "bulletger_30_auto apcr" 80}
			{gunner "gunner"}
			{charger "commander"}
			("abm_dymamic_autocannon"
				zeroing(2.5)
				dispersion(0.15)
			)
		}
		{place "mgun"
			{type "coaxial"}
			{weapon "mg42_tank" filled}
			{foresight "foresight3"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 19000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(1.05))
		("mobility_tank"
			speed(60) ;----------Max speed when fully accelerated on road, km/h.
			reverse(12) ;--------Max speed in reverse on road, km/h.
			traverse(46) ;-------Track traverse, per second, in degrees.
			weight(19) ;-------Weight in Tonnes.
			power(550) ;---------Engine Power, in hp.
			track(5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(520) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(150) ;---------Range in km, off-road.
		)
	}

	{bone "gun_rot"
		{limits -10 20}
		{speed2 16}
	}
	{bone "turret"
		{speed2 17}
	}

	{texmod "camo"}
}