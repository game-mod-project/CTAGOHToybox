{game_entity
	(include "/properties/tank__ctb_coelian_i_4a132d6f.ext")
	
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "medium" "vision_lev04" "flak_mace" "shield" "smoke" "nwg" "detect_tank_heavy" "detect_cannon_aa" "sq_autocannon"}
	{extension "panzer5d.mdl"}
	(include "panzer5d.ext")
	{PatherId "panzer5"}
	{targetclass "tank_heavy"}
	{targetSelector "tank_zenite"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{sensor
		{visor "main"
			{vision "tank_range_210"}
		}
	}

	("crew_5_human_extended")
	("commander_visible")

	{boarder
		{anm "driver"
			{forward	{begin	"board_pz4_driver"} {end "pose_mgun_pz6"} {base "open_driver"}}
			{reverse 	{end	"board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "left"
			{forward	{begin	"board_cromwell"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"board_cromwell" -1}}
		}
		{anm "right"
			{forward	{begin	"board_cromwell"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"board_cromwell" -1}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))

	{extender "shield" {on}}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		{weapon "mgun" {mask "mountable"}}
		{box
			{item "bulletger_37_auto apcbc" 400}	
			{item "bulletger_37_auto he" 800}
			{item "bulletger_37_auto apcr" 150}
			{item "ammo mgun_ger belt" 4500}		; 32 belts (150 rounds each)
			{item "mg42_drum" filled {user "mgun"}}
			{item "geballteladung_3kg" 1}
			{item "nbks grenade" 6}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "37mm_flak43_x2" filling "bulletger_37_auto he" 20}
			{Barrels 2}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_aaa"
				zeroing(1.95)
				dispersion(0.24)
			)
		}
		{place "mgun1"
			{type "hull"}
			{weapon "mg34_tank" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun"
			{type "aa"}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 45500}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.94))
		("mobility_tank"
			speed(55) ;----------Max speed when fully accelerated on road, km/h.
			reverse(5.9) ;-------Max speed in reverse on road, km/h. 3.9 + 2kmh
			traverse(35) ;-------Track traverse, per second, in degrees.
			weight(45.5) ;-------Weight in Tonnes.
			power(690) ;---------Engine Power, in hp. //engine was not yet governed, was in Nov.43 (after panther D production ended)
			track(6.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(700) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(100) ;---------Range in km, off-road.
		)
	}

	{bone "turret"
		{speed2 25.5}
	}
    	{bone "gun_rot"
		{limits 80 -4}
		{speed2 10}
    	}
	{bone "mgun_top_rot1"
		{limits 5 -5}
	}
	{bone "mgun_top_rot2"
		{limits 35 -8}
	}
}
