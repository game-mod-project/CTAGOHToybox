{game_entity
	(include "/properties/tank_assaultgun__ctb_e25x7_fc296853.ext")
	(include "/properties/shadow/tank.inc"  scale(1.2))
	(include "/properties/selection/vehicle.inc"  scale(1.1))
	{props "td" "medium" "-turret" "mantlet" "vision_lev03" "muzzle_75mm_76mm_sides" "shield" "nkav"}
	{PatherId "panzer3"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{Extension "e25x7.mdl"}
	(include "e25x7.ext")

	{extender "enumerator"}

	("crew_4_human")

	{placer
		{place "driver"		{visor "driver"}}
		{place "gunner"		{visor "main"}}
		{place "commander"	{visor "mgun"}{sealable}}
	}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbk39"}
	}

	{extender "vision_mode"
		{timer_object
			{tag		"thermal"}
			{active_time	   120}
			{recharge_rate	  1.0}
			{type	     "recharge"}
	    }
	}

	{extender "inventory"
		{box
			{item "bulletger_75_l70 apcbche" 190} 	; 82 rounds
			{item "bulletger_75_l70 he" 200}
			{item "bulletger_75_l70 apcr" 15}
			{item "ammo bulletx7 atgm" 60}
			{item "geballteladung_3kg" 2}
			{item "nbk39 grenade" 12}
			{item "ammo hmgun_ger" 20000}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{rotate}
			{RestoreIKAfterAim}
			{weapon "75mm_kwk42_ctb_ger" filling "bulletger_75_l70 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_td"
				zeroing(2.5)
				dispersion(0.15)
			)
			{basic}
			{ai_in_manual}
                        {rotate}
		}
		{place "gun2"
			{RestoreIKAfterAim}
			{weapon 	"150mm_x7_ctb_ger" filling "ammo bulletx7 atgm" 1}
			{foresight 	"foresight2"}
			("abm_dymamic_stabilised"
				zeroing(1.1)
				dispersion(0.01)
			)
			{basic}
			{ai_in_manual}
		}
		{place "mgun"
			{type "aa"}
			{weapon "mg131_mount_ctb_ger" filled}
			{gunner "commander"}
			{charger "commander"}
			{foresight 	"foresight3"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 30000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.94))
		("mobility_tank"
			speed(83) ;----------Max speed when fully accelerated on road, km/h.
			reverse(13) ;---------Max speed in reverse on road, km/h.
			traverse(30) ;-------Track traverse, per second, in degrees.
			weight(30.5) ;-------Weight in Tonnes.
			power(600) ;---------Engine Power, in hp. //engine was governed to 2500 max rpm which reduced it from 700HP to 600HP
			track(3.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(7000) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(1300) ;---------Range in km, off-road.
		)
	}

	{bone "turret"			;gun horizontal
		{speed 0.0042}
	}
	{bone "gun_rot"			;gun vertical
		{speed2 45}
	}
	{bone "turret1"			;gun horizontal
		{speed2 45}
	}
	{bone "mgun_rot"			;gun vertical
		{speed 0.0045}
	}
}