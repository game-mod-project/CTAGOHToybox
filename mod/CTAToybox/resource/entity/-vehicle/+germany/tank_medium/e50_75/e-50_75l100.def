{game_entity
	(include "/properties/tank__ctb_e_50_75l100_5b7e27d2.ext")
	(include "e-50_75l100_armor.ext") ; This file must contain the body/turret definitions
	(include "/properties/shadow/tank.inc"  scale(1.0)) ;1.4
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "heavy" "vision_lev04" "muzzle_85mm_93mm" "shield" "smoke" "nvw" "detect_tank_heavy"}
	{PatherId "panzer5"}
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}

	{boarder
		{anm "left"
			{forward	{begin	"board_sherman_left"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_sherman_right"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}
	}
	("gunner_visible")

{placer
	{place "driver" {group "crew"} {visor "driver"}}
}
{boarder
	{door "emit1"}
	{link "emit1" "driver" {anm "left"} {forward putoff} {reverse puton}}
}

{placer
	{place "gunner" {group "crew"} {visor "tur1"} {visor "tur1_2"}}
}
{boarder

	{door "emit2"}
	{link "emit2" "gunner" {anm "left"} {forward putoff} {reverse puton}}
}

{placer
	{place "charger" {group "crew"}}
}
{boarder
	{door "emit5"}
	{link "emit5" "charger" {anm "left"} {forward putoff} {reverse puton}}
}
{placer
	{place "charger2" {group "crew"}}
}
{boarder
	{door "emit6"}
	{link "emit6" "charger2" {anm "left"} {forward putoff} {reverse puton}}
}

{placer
	{place "commander" {group "crew"} {linkbone "gunner2"} {visor "tur2_1"} {visor "tur2_2"} {visor "tur2_3"} {turnoff {sensor} {shadow}} {openForCrush} {visor "mgun_aa"}}
}
{boarder

	{door "emit4"}
	{link "emit4" "commander" {anm "left"} {forward putoff} {reverse puton}}
}


	(define "seat_human"
		{placer
			{place "%place" {group "%group"} {linkbone "%bone"} {turnoff {sensor} {shadow}}}
		}
		{boarder
			{door "%door"}
			{link "%door" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
		}
	)

	("seat_human" place(seat1) bone(seat7) door(emit7)  animation(armor))
	("seat_human" place(seat2) bone(seat8) door(emit8)  animation(armor1))
	("seat_human" place(seat3) bone(seat9) door(emit9)  animation(armor1))
	("seat_human" place(seat4) bone(seat10) door(emit10)  animation(armor))
	
	{sensor
		{visor "tur1" {vision "tank_main-l"} {bone "visor1"}}
		{visor "mgun_aa" {vision "vehicle_top_mgun"} {bone "visor8"}}
		{visor "driver" {vision "tank_driver"} {bone "visor2"}}
	}

	{extender "inventory"
		{box
			{item "ammo mgun_ger belt" 2500}
			{item "bulletger_75_l70 apcbche" 70}
			{item "bulletger_75_l70 he" 35}
			{item "bulletger_75_l70 apcr" 5}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_kwk45l100_1" filling "ammo bulletger_75_l70 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			{foresight "foresight1"}
			("abm_dymamic" zeroing(3.0) dispersion(0.20))
			{basic}
		}
		{place "mgun1"
			{type "aa"}
			{weapon "mg42_tank" filled}	
			{foresight "foresight4"}
			{gunner "charger"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun2"
			{type "cupola"}
			{weapon "mg42_tank" filled}	
			{foresight "foresight3"}
			{gunner "commander"}
			{charger "commander"} 
			("abm_mgun")
			{basic}
		}
	}

	{mass 60000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(1.85))
		("mobility_tank"
			speed(60)
			reverse(15)
			traverse(30)
			weight(60.0)
			power(700)
			track(3.5)
			fuel(700)
			type(fuel)
			range(100)
		)
	}
	{Extension "e-50_75l100.mdl"}
}