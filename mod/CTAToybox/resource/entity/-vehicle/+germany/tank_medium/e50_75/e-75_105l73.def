{game_entity
	(include "/properties/tank__ctb_e_75_105l73_33545f02.ext")
	(include "e-75_105l73_armor.ext")
	(include "/properties/shadow/tank.inc"  scale(1.0)) ;1.4
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "heavy" "vision_lev04" "muzzle_20mm_25mm_auto" "muzzle_100mm_105mm_sides" "shield" "detect_tank_heavy"}
	{PatherId "tiger2"}
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}

	{boarder
		{anm "left"
			{forward	{begin	"board_sherman_left"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_sherman_right"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}
	}

{placer
	{place "driver" {group "crew"} {visor "driver"}}
}
{boarder
	{door "emit1"}
	{link "emit1" "driver" {anm "left"} {forward putoff} {reverse puton}}
}

{placer
	{place "commander" {group "crew"} {visor "tur2"}}
}
{boarder
	{door "emit4"}
	{link "emit4" "commander" {anm "left"} {forward putoff} {reverse puton}}
}

{placer
	{place "gunner" {group "crew"} {visor "tur1"}} 
}
{boarder
	{door "emit2"}
	{link "emit2" "gunner" {anm "left"} {forward putoff} {reverse puton}}
}

{placer
	{place "charger" {group "crew"}}
}
{boarder
	{door "emit5"}
	{link "emit5" "charger" {anm "left"} {forward putoff} {reverse puton}}
}
{placer
	{place "charger2" {group "crew"}}
}
{boarder
	{door "emit6"}
	{link "emit6" "charger2" {anm "left"} {forward putoff} {reverse puton}}
}

(define "seat_human"
	{placer
		{place "%place" {group "%group"} {linkbone "%bone"} {turnoff {sensor} {shadow}}}
	}
	{boarder
		{door "%door"}
		{link "%door" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
	}
)

("seat_human" place(seat1) bone(seat7) door(emit7)  animation(armor))
("seat_human" place(seat2) bone(seat8) door(emit8)  animation(armor1))
("seat_human" place(seat3) bone(seat9) door(emit9)  animation(armor1))
("seat_human" place(seat4) bone(seat10) door(emit10)  animation(armor))

	{sensor
		{visor "tur1" {vision "tank_main-l"} {bone "visor1"}}
		{visor "tur2" {vision "tank_main-l"} {bone "visor9"}} 
		{visor "driver" {vision "tank_driver"} {bone "visor2"}}
		{visor "driver_2" {vision "tank_driver"} {bone "visor3"}}
	}

	{extender "inventory"
		{box
			{item "ammo bulletger_105_l68 apcbche" 80}
			{item "ammo bulletger_105_l68 apcr" 80}
			{item "ammo bulletger_105_l68 he" 50}
			{item "ammo bulletger_20_auto apcr" 5250}
			{item "ammo bulletger_20_auto he" 5250}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "105mm_kwk46_l73_ctb_ger" filling "ammo bulletger_105_l68 apcbche" 1}
			{gunner "gunner"}
			{charger "charger charger2" minWorkers 1}
			{foresight "foresight1"}
			{basic}
		}
		{place "mgun1"
			{type "coaxial_cannon"}
			{weapon "20mm_mg151_coax_ctb_ger" filling "bulletger_20_auto apcr" 200}
			{foresight "foresight3"}
			{gunner "gunner"}
			{charger "charger2"}
			("abm_mgun")
			{basic}
		}
		{place "mgun2"
			{weapon "20mm_mg151_coax_ctb_ger" filling "bulletger_20_auto apcr" 200}
			{foresight "foresight2"}
			{gunner "commander"}
			{charger "commander"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 78000}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(2.45))
		("mobility_tank"
			speed(60)
			reverse(15)
			traverse(30)
			weight(78.0)
			power(900)
			track(3.3)
			fuel(8600)
			type(fuel)
			range(900)
		)
	}
	{Extension "e-75_105l73.mdl"}
}