	; Components for damage logic
	{component "body" {tags "body"}}
	{component "engine" {tags "engine"}}
	{component "fuel" {tags "fuel"}}
	{component "ammo" {tags "ammo"}}

	; Main hull body - base thickness = SIDE armor
	{volume "body"
