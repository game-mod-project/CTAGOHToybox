{game_entity
	(include "/properties/tank__ctb_jagdpz_e_75_c19b41c7.ext")
	(include "jagdpz_e-75_armor.ext")
	(include "/properties/shadow/tank.inc"  scale(1.2))
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "tractor" "heavy" "vision_lev04" "muzzle_150mm_155mm" "shield" "detect_tank_heavy" "turret_rotator" "-turret"}
	{PatherId "tiger2"}
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}
	{extension "crew_jagd2.ext"}

	{sensor
		{visor "tur1" {vision "tank_main-l"} {bone "visor1"}}
		{visor "tur1_2" {vision "tank_main-l"} {bone "visor6"}}
		{visor "tur2" {vision "tank_main-l"} {bone "visor7"}}
		{visor "tur2_2" {vision "tank_main-l"} {bone "visor9"}}
		{visor "driver" {vision "tank_driver"} {bone "visor2"}}
		{visor "driver_2" {vision "tank_driver"} {bone "visor3"}}
	}

	{extender "inventory"
		{box
			{item "ammo bulletger_150 apcbche" 50}
			{item "ammo bulletger_150 apcr" 50}
			{item "ammo bulletger_150 heat" 50}
			{item "ammo bulletger_150 he" 75}
			{item "ammo bulletger_20_auto apcr" 5250}
			{item "ammo bulletger_20_auto he" 5250}
			{item "ammo mgun_ger" 9250}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "150mm_pak46_l52_ctb_ger" filling "ammo bulletger_150 apcbche" 1}
			{gunner "gunner"}
			{charger "charger charger2" minWorkers 1}
			{foresight "foresight1"}
			{basic}
			{rotate}
		}
		{place "mgun2"
			{type "cupola_cannon"}
			{weapon "20mm_mg151_coax_ctb_ger" filling "bulletger_20_auto apcr" 200}
			{foresight "foresight2"}
			{gunner "commander"}
			{charger "charger2"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "coaxial"}
			{weapon "mg42_tank_ctb_ger" filled}
			("abm_mgun")
			{foresight "foresight4"}
			{gunner "gunner2"}
			{charger "gunner2"}
			{basic}
		}
		{place "mgun"
			{type "hull"}
			{weapon "mg42_tank_ctb_ger" filled}
			("abm_mgun")
			{foresight "foresight3"}
			{gunner "gunner3"}
			{charger "gunner3"}
			{basic}
		}
	}

	{mass 91600}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(2.45))
		("mobility_tank"
			speed(60)
			reverse(15)
			traverse(30)
			weight(91.6)
			power(900)
			track(3.3)
			fuel(8600)
			type(fuel)
			range(900)
		)
	}
	{Extension "jagdpz_e-75.mdl"}
}
