{game_entity	
	(include "/properties/tank_assaultgun__ctb_jagdpanzer_iv_a_1810b2f2.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "td" "medium" "-turret" "vision_lev04" "muzzle_75mm_76mm_sides" "smoke" "nvw" "sq_at_gun"}
	(include "jagdpanzer_iv_a_armor.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3))
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{PatherId "panzer3"}
	
	("crew_5_human")
	;("crew_human" place(gunner3) door(emit1) door2(emit2) visor(main))
	
	{extender "shield"
		{on}
	}

	
	{boarder
		{anm "left"
			{forward	{begin	"board_Kv"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}

	}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbk39"}
	}
	
	{extender "inventory"
		{box
			{item "bulletger_75_l70 apcbche" 30} 	; 55 rounds
			{item "bulletger_75_l70 he" 20}
			{item "bulletger_75_l70 apcr" 5}
			{item "ammo mgun_ger belt" 1200}
			{item "geballteladung_3kg" 1}
			{item "nbk39 grenade" 6}
		}
	}
	
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{rotate}
			{gunner "gunner"}
            		{charger "charger"}
			{weapon "75mm_pak42" filling "bulletger_75_l70 apcbche" 1}
			("abm_dymamic_td"
				zeroing(2.5)
				dispersion(0.20)
			)
		}
		{place "mgun1"
			{type "hull"}
			{weapon "mg34_tank" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{ai_in_manual}
			{basic}
		}
	}

	{mass 25800}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.45))
		("mobility_tank"
			speed(42) ;----------Max speed when fully accelerated on road, km/h.
			reverse(8) ;---------Max speed in reverse on road, km/h.
			traverse(30) ;-------Track traverse, per second, in degrees.
			weight(23.6) ;-------Weight in Tonnes.
			power(265) ;---------Engine Power, in hp. //engine under normal use was rated 265hp at 2600 rpm
			track(4.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(470) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(130) ;---------Range in km, off-road.
		)
	}
	
	{Extension "jagdpanzer_iv_a.mdl"}	
	
	{bone "turret"
		{limits -13 7}
        {speed 0.004}
	}
	{bone "gun_rot"
		{limits -3.5 12}
        {speed 0.003}
    }  
}
