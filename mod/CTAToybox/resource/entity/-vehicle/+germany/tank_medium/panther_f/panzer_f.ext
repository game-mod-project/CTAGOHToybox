	{volume "body1"			
		{thickness 125
			{front 200}		
			{top 100}	
			{rear 40}
			{bottom 63}
		}
	}
	{volume "body2"			
		{thickness 100
			{front 200}		
			{top 100}
			{rear 40}
			{bottom 63}
