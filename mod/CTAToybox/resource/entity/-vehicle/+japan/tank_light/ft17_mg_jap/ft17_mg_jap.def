{game_entity
	(include "/properties/tank__ctb_ft17_mg_jap_efff1bf0.ext")
	(include "/properties/selection/vehicle_elongated.inc" scale(0.9))
	{props "light" "vision_lev03" "detect_tank_mg" "sq_mg"}
	{extension "ft17_mg_jap.mdl"}
	(include "ft17_jap.ext")
	{targetclass "tank_light"}
	{targetSelector "tank_light"}
	{patherId "ft17"}
	{collider "tank.light"}

	{volume "mantlet" {able {holed}}}
	{volume "turret2" {able {holed}}}

	{boarder
		{anm "left"
			{forward {begin "board_tank_left"} {end "pose_mgun_pz6"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "right"
			{forward {begin "board_tank_right"} {end "pose_mgun_pz6"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "driver"
			{forward {begin "board_t26_driver"} {end "pose_t26_driver"} {base "open_driver"}}
			{reverse {end "board_t26_driver" -1} {base "open_driver" -1}}
		}
		{anm "armor1"
			{forward {begin "board_LowArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("crew_driver" 							 	door(emit0) door2(emit1) door3(emit2))
	("crew_human_visible_anm" place(gunner)		door(emit1) door2(emit2) visor(main)   anm_left(left)	anm_right(right))

	("seat_human" place(seat1) bone(seat1) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat2) door(emit4)  animation(armor1))

	{sensor
		{visor "main"
			{bone "foresight14"}
			{vision "tank_main_mg"}
		}
	}

	{extender "inventory"
		{box
			{item "ammo type38_ammo clip" 2600}
			{item "satchel_charge_jap" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "mgun"
			{type "main"}
			{weapon "type_91" filled}
			{foresight "foresight14"}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 6800}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.4) len(0.7))
		("mobility_tank_slow"
			speed(7.7) ;---------Max speed when fully accelerated on road, km/h.
			reverse(4) ;---------Max speed in reverse on road, km/h.
			traverse(20) ;-------Track traverse, per second, in degrees.
			weight(6.8) ;--------Weight in Tonnes.
			power(35) ;----------Engine Power, in hp.
			track(25.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(95) ;-----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(35) ;----------Range in km, off-road.
		)
	}

	{bone "mgun_rot1"
		{limits -15 15}
		{speed2 20}
	}
	{bone "mgun_rot2"
		{limits -15 15}
		{speed2 20}
	}
	{bone "turret"
		("turret_light" power_traverse(0)) ;// manual
	}
}
