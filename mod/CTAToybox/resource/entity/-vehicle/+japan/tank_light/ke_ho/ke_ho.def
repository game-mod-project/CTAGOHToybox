{game_entity
	(include "/properties/tank__ctb_ke_ho_60b9f0c1.ext")
	(include "/properties/shadow/tank.inc" scale(1.0))
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{collider "tank.light"}
	{props "light" "vision_lev03" "turret_rotator" "vision_vehicle_low" "muzzle_37mm_47mm"}
	{targetClass "light_tank"}
	{targetSelector "tank_light"}
	{patherId "tank.light"}
	
	{extender "enumerator"}
	
		{Volume "Body"
		{tags "body"}
		{component "body"}
		{thickness 12
			{front 20}
			{left 16}
			{right 16}
			{bottom 8}
		}
	}
	{Volume "Body2"
		{tags "body"}
		{component "body"}
		{thickness 12
			{front 20}
			{left 16}
			{right 16}
			{bottom 8}
		}
	}
	{Volume "turret"
		{tags "turret"}
		{component "turret"}
		{thickness 19
			{front 20}
			{rear 16}
			{top 16}
		}
	}
	{Volume "mantlet"
		{thickness 20}
	}
	{volume "engine"		
		{thickness 20
			{front 10}		
			{top 10}		
		}
	}
	{Volume "track"
		{thickness 15}
	}
	
	("crew_4_human_2")

	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"}{end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"}{end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"}{end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_2"}}
		}


	}


	{extender "shield"
		{on}
	}
	{extender "inventory"
		{box
			{item "satchel_charge_jap"}
			{item "ammo bulletjap_47 aphe" 47}
			{item "ammo bulletjap_47 ap" 22}
			{item "ammo bulletjap_47 he" 20}
			{item "ammo mgun_jap" 3000}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "47mm_short" filling "bulletjap_47 aphe" 1}
			{gunner "gunner"}
			{charger "commander"}
			("abm_dymamic"
				zeroing(2.8)
				dispersion(0.20)
			)
			{basic}
		}

		{place "mgun2"
			{type "hull"}
			{weapon "type_97" filled} 
			{foresight "foresight5"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun3"
			{type "rear"}
			{weapon "type_97" filled}
			{foresight "foresight6"}
			{gunner "commander"}
			{charger "commander"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}

	}
	{mass 10000}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(0.20))
		("mobility_tank"
			speed(50) ;----------Max speed when fully accelerated on road, km/h.
			reverse(10);---------Max speed in reverse on road, km/h.
			traverse(30) ;-------Track traverse, per second, in degrees.
			weight(10) ;-------Weight in Tonnes.
			power(150) ;---------Engine Power, in hp.
			track(6) ;-----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(130) ;----------Fuel capacity in Litres.
			type(diesel) ;---------Fuel type. (diesel OR fuel)
			range(280) ;---------Range in km, off-road.
		)
	}
	
	{Extension "ke_ho.mdl"}
	{texmod ""}
	{bone "turret"
		{limits}
		{speed 0.0075}
	}
	{bone "gun_rot"
		{limits -20 10}
		{speed 0.0075}
	}





        
}