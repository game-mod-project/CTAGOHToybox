{game_entity
	(include "/properties/tank__ctb_ke_ni_92721a6f.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "light" "vision_lev03" "muzzle_37mm_47mm" "detect_tank_light" "diesel" "tractor" "tractor_light" "sq_armor_light"}
	{targetclass "tank_light"}
	{targetSelector "tank_light"}
	{patherId "stuart"}
	{collider "tank.light"}
	{Extension "ke_ni.mdl"}
	(include "ke_ni.ext")				

;==============================================crew==============================================
	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "driver"
			{forward	{begin	"board_HighArmor"} {end "seat_driver_car"} {base "driver_open"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "close_driver" 1}}
		}
		{anm "commander"			
			{forward	{begin	"board_HighArmor"} {end "seat_driver_car"} {base "main_open"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "close_charger" 1}}
		}
		{anm "gunner"
			{forward	{begin	"board_HighArmor"} {end "seat_driver_car"} {base "main_open"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "close_gunner" 1}}
		}
	}

	("crew_human" place(driver)	    door(emit3) visor(driver))	
	("crew_human" place(gunner)	    door(emit2) visor(main))	
	("crew_human" place(commander)	door(emit1) visor(main))	
;================================================================================================

	{extender "inventory"
		{box
			{item "bulletjap_37 aphe" 67}	
			{item "bulletjap_37 ap" 22}	
			{item "bulletjap_37 he" 20}	
			{item "ammo mgun_jap" 3000}
			{item "satchel_charge_jap" 1}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "37mm_type100" filling "bulletjap_37 aphe" 1}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_dymamic"
				zeroing(2.5)
				dispersion(0.20)
			)
		}
		{place "mgun1"
			{type "coaxial"}
			{weapon "type_97" filled}
			{foresight "foresight4"}
			{gunner "gunner"}
			{charger "commander"}
			("abm_mgun")
			{basic}			
		}
	}

	{mass 7000}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.3) len(0.49))
       		("mobility_tank"
			speed(50) ;----------Max speed when fully accelerated on road, km/h.
			reverse(7) ;---------Max speed in reverse on road, km/h.
			traverse(30) ;-------Track traverse, per second, in degrees.
			weight(7) ;-------Weight in Tonnes.
			power(130) ;---------Engine Power, in hp. //engine under normal use was rated 265hp at 2600 rpm
			track(5.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(340) ;----------Fuel capacity in Litres.
			type(diesel) ;---------Fuel type. (diesel OR fuel)
			range(300) ;---------Range in km, off-road.
		)
	}
	{bone "turret"
		("turret_light" power_traverse(12))
	}
	{bone "gun_rot"
		{speed2 8}
		{limits -10 10}
	}
}
