{game_entity
	(include "/properties/tank__ctb_ke_to_dab46d9a.ext")
	(include "/properties/shadow/tank.inc" scale(1.0))
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{collider "tank.light"}
	{props "light" "vision_lev03" "turret_rotator" "vision_vehicle_low" "muzzle_37mm_47mm"}
	{targetClass "light_tank"}
	{targetSelector "tank_light"}
	{patherId "tank.light"}
	
	{extender "enumerator"}
	
	{Volume "Body"
		{tags "body"}
		{component "body"}
		{thickness 12
			{front 16}	
		}
	}
	{Volume "Body2"
		{tags "body"}
		{component "body"}
		{thickness 12
			{front 16}	
		}
	}
	{Volume "turret"
		{tags "turret"}
		{component "turret"}
		{thickness 16
			{front 16}
			{top 6}
		}
	}
	{Volume "mantlet"
		{thickness 16}
	}
	{volume "engine"		
		{thickness 40
			{front 30}		
			{top 22}		
			{bottom 22}
		}
	}
	{Volume "track"
		{thickness 15}
	}
	
	("crew_2_human")
	("crew_human" place(commander)	door1(emit1) door2(emit2) visor(back))

	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"}{end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"}{end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"}{end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_2"}}
		}


	}



	{extender "shield"
		{on}
	}
	{extender "inventory"
		{box
			{item "satchel_charge_jap"}
			{item "bulletjap_37 aphe" 67}	
			{item "bulletjap_37 ap" 22}	
			{item "bulletjap_37 he" 20}	
			{item "ammo mgun_jap" 3000}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "37mm_type1" filling "bulletjap_37 aphe" 1}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_dymamic"
				zeroing(2.5)
				dispersion(0.20)
			)
			{basic}
		}

		{place "mgun1"
			{type "coaxial"}
			{weapon "type_97" filled} 
			{foresight "foresight4"}
			("abm_mgun")
			{gunner "gunner"}
			{charger "gunner"}
			{basic}
			{ai_in_manual}
		}

	}
	{mass 7200}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.15) len(0.25))
		("mobility_tank"
			speed(50) ;----------Max speed when fully accelerated on road, km/h.
			reverse(10);---------Max speed in reverse on road, km/h.
			traverse(30) ;-------Track traverse, per second, in degrees.
			weight(7.2) ;-------Weight in Tonnes.
			power(130) ;---------Engine Power, in hp.
			track(5) ;-----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(130) ;----------Fuel capacity in Litres.
			type(diesel) ;---------Fuel type. (diesel OR fuel)
			range(300) ;---------Range in km, off-road.
		)
	}
	
	{Extension "ke_ni.mdl"}
	{texmod ""}

	{bone "turret"
		{speed 0.012}
	}

        {bone "gun_rot"
		{limits -12 20}
		{speed 0.009}
        }

        
}




