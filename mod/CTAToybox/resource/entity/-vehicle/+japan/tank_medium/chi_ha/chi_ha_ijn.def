{game_entity
	(include "/properties/tank__ctb_chi_ha_ijn_d9554135.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "medium" "vision_lev04" "muzzle_50mm_57mm" "diesel" "detect_tank_medium" "sq_armor_medium"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{patherId "panzer3"}
	{collider "tank.medium"}
	{Extension "chi_ha.mdl"}
	(include "chi_ha.ext")				

;==============================================crew==============================================

	{sensor
		{visor "back"
			{vision "tank_rear-mg"}
			{bone "foresight5"}
		}
	}

	("crew_4_human")
	("crew_human" place(charger) door(emit2) door2(emit4) visor(back))

	{boarder
		{anm "left"
			{forward	{begin	"board_tank_right"} {end "seat_commander_hatch"} {base "open_driver"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open_driver" -1}}
		}
		{anm "right"
			{forward	{begin	"board_tank_left"} {end "seat_commander_hatch"} {base "open_commander"}}
			{reverse 	{end	"emit_tank_2_hold"}  {base "open_commander" -1}}
		}
		{anm "gunner2"
			{forward {begin "board_HighArmor"} {end "mg_pose_chi_ha"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_1"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} 	{end "pose_pz3_right"}}
			{reverse 	{end	"emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3) animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4) animation(armor))
;================================================================================================

	{extender "inventory"
		{box
			{item "bulletjap_57 aphe" 33}	
			{item "bulletjap_57 he" 87}	
			{item "ammo mgun_jap" 3000}
			{item "satchel_charge_jap" 1}
			{item "10kg_naval_smoke_candle_grenade" 3}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "57mm_type97" filling "bulletjap_57 aphe" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(2.5)
				dispersion(0.20)
			)
		}
		{place "mgun1"
			{type "hull"}
			{weapon "type_97" filled}
			{foresight "foresight4"}
			{gunner "gunner"}
			{charger "commander"}
			("abm_mgun")
			{basic}			
		}
		{place "mgun2"
			{type "rear"}
			{weapon "type_97" filled}
			{foresight "foresight5"}
			{gunner "charger"}
			{charger "charger"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun"
			{type "aa"}
			{weapon "type_97" filled}
			{gunner "gunner2"}
			{charger "gunner2"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}
	{mass 14800}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.3) len(-0.10))
       		("mobility_tank"
			speed(40) ;----------Max speed when fully accelerated on road, km/h.
			reverse(19) ;---------Max speed in reverse on road, km/h.
			traverse(25) ;-------Track traverse, per second, in degrees.
			weight(14.8) ;-------Weight in Tonnes.
			power(200) ;---------Engine Power, in hp. //engine under normal use was rated 265hp at 2600 rpm
			track(4.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(889) ;----------Fuel capacity in Litres.
			type(diesel) ;---------Fuel type. (diesel OR fuel)
			range(210 ) ;---------Range in km, off-road.
		)
	}
	{bone "turret"
		("turret_medium" power_traverse(10))
	}
	{bone "gun_rot"
		{speed2 8}
		{limits -10 20}
	}
	{bone "mgun_h_rot1"
		{limits -15 15}
	}
	{bone "mgun_h_rot2"
		{limits -15 15}
	}
	{bone "mgun_t_rot1"
		{limits -15 15}
	}
	{bone "mgun_t_rot2"
		{limits -15 15}
	}
	{texmod "ijn"}
}
