{game_entity
	(include "/properties/tank__ctb_chi_ri_2_4d47a805.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "medium" "vision_lev03" "muzzle_75mm_76mm" "muzzle_37mm_47mm" "shell_eject" "diesel" "detect_tank_medium" "multi_turret" "toggle_back_mg" "sq_armor_medium"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{PatherId "t34"}
	{Extension "chi_ri_2.mdl"}
	(include "chi_ri_2.ext")		

	("fuel" args "fuel1")
	("fuel" args "fuel2")
	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("ammo" args "ammo4")
	("transmission" args "transmission")		

	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "commander"
			{forward {begin "board_kv"} {end "seat_isu152_gunner2"} {base "open_commander"}}
			{reverse {end "board_t26_driver" -1} {base "open_commander" -1}}
		}
		{anm "gunner"
			{forward {begin "board_tank_right"} {base "open_charger" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_charger" -1}}
		}
		{anm "gunner3"
			{forward {begin "board_kv"} {base "open_driver"} {base "open_gunner3" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_gunner3" -1}}
		}
		{anm "charger"
			{forward {begin "board_tank_right"} {base "open_charger" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_charger" -1}}
		}
		{anm "driver"
			{forward {begin "board_kv"} {base "open_driver"}}
			{reverse {end "emit_tank_1_hold"} {base "open_driver" -1}}
		}
		{anm "armor"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor1"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_2"}}
			{reverse {end "emit_body"}}
		}
	}

	("crew_human" place(driver) door(emit2) visor(driver))
    	("crew_human" place(charger)   door(emit1) visor(none))
    	("crew_human" place(gunner) door(emit3) visor(main))
	("crew_human" place(gunner3)    door(emit4) visor(none))
   	("crew_human" place(commander) door(emit3) visor(around))

	{extender "inventory"
		{box
			{item "bulletjap_75_l56 aphe2" 25}
			{item "bulletjap_75_l56 ap" 3}
			{item "bulletjap_75_l56 he" 16}
			{item "bulletjap_37 aphe2" 55}
			{item "bulletjap_37 he2" 45}
			{item "bulletjap_37 wp" 12}
			{item "ammo mgun_jap" 4035}		;30 drums	
			{item "satchel_charge_jap" 1}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_type5_auto" filling "bulletjap_75_l56 aphe2" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(2.5)
				dispersion(0.20)
			)
		}
		{place "gun1"
			{RestoreIKAfterAim}
			{weapon "37mm_type94" filling "bulletjap_37 aphe2" 1}
			{foresight "foresight1a"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_dymamic"
				zeroing(2.5)
				dispersion(0.20)
			)
			{basic}
			{ai_in_manual}
		}
		{place "mgun1"
			{type "rear"}
			{weapon "type_97" filling "ammo mgun_jap" 20}
			{foresight "foresight4"}
			{gunner "commander"}
			{charger "commander"}
			("abm_mgun")
			{basic}
		}
		{place "mgun2"
			{type "hull"}
			{weapon "type_97" filling "ammo mgun_jap" 20}
			{foresight "foresight5"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 41000}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.3) len(0.49))
       		("mobility_tank"
			speed(46) ;----------Max speed when fully accelerated on road, km/h.
			reverse(8) ;---------Max speed in reverse on road, km/h.
			traverse(15) ;-------Track traverse, per second, in degrees.
			weight(41) ;-------Weight in Tonnes.
			power(660) ;---------Engine Power, in hp. //engine under normal use was rated 265hp at 2600 rpm
			track(5.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(340) ;----------Fuel capacity in Litres.
			type(diesel) ;---------Fuel type. (diesel OR fuel)
			range(200) ;---------Range in km, off-road.
		)
	}
	{bone "turret"
		("turret_medium" power_traverse(8))
	}
	{bone "gun_rot"
		{speed2 6}
		{limits -10 20}
	}
	{bone "mgun_rot2"
		{limits -15 15};left/right
		{speed2 60}
	}
	{bone "mgun_rot1"
		{limits -15 15};up/down
		{speed2 60}
	}

	{bone "gun_rot1"
		{speed2 6}
		{limits -8 17}
	}

	{bone "foresight5"
		{limits -1 1}
	}

	{bone "foresight1a"
		{limits -1 1}
	}
}

