{game_entity
	(include "/properties/tank__ctb_chi_to_545b8efc.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "medium" "vision_lev03" "muzzle_75mm_76mm" "diesel" "detect_tank_medium" "tractor" "tractor_medium" "toggle_back_mg" "sq_armor_medium"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{PatherId "t34"}
	{Extension "chi_to.mdl"}
	(include "chi_to.ext")		

	("fuel" args "fuel1")
	("fuel" args "fuel2")
	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("ammo" args "ammo4")
	("transmission" args "transmission")		

	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	("commander_visible")

	{boarder
		{anm "commander"
			{forward {begin "board_kv"} {end "seat_isu152_gunner2"} {base "open_commander"}}
			{reverse {end "board_t26_driver" -1} {base "open_commander" -1}}
		}
		{anm "gunner"
			{forward {begin "board_tank_right"} {base "open_charger" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_charger" -1}}
		}
		{anm "gunner3"
			{forward {begin "board_kv"} {base "open_driver"} {base "open_charger" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_charger" -1}}
		}
		{anm "charger"
			{forward {begin "board_tank_right"} {base "open_commander" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_commander" -1}}
		}
		{anm "driver"
			{forward {begin "board_kv"} {base "open_driver"}}
			{reverse {end "emit_tank_1_hold"} {base "open_driver" -1}}
		}
		{anm "armor"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor1"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_2"}}
			{reverse {end "emit_body"}}
		}
	}

	("crew_human" place(driver) door(emit1) visor(driver))
    	("crew_human" place(charger)   door(emit2) visor(none))
    	("crew_human" place(gunner) door(emit2) visor(main))
	("crew_human" place(gunner3)    door(emit1) visor(none))
   	("crew_human" place(commander) door(emit3) visor(around))

	{extender "inventory"
		{box
			{item "bulletjap_75_l56 aphe" 28}
			{item "bulletjap_75_l56 he" 16}
			{item "ammo mgun_jap" 4035}		;30 drums	
			{item "satchel_charge_jap" 1}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_type5" filling "bulletjap_75_l56 aphe" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(2.5)
				dispersion(0.20)
			)
		}
		{place "mgun1"
			{type "hull"}
			{weapon "type_97" filling "ammo mgun_jap" 20}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
		}
		{place "mgun3"
			{type "rear"}
			{weapon "type_97" filling "ammo mgun_jap" 20}
			{foresight "foresight6"}
			{gunner "charger"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun"
			{type "aa"}
			{weapon "type_97" filling "ammo mgun_jap" 20}
			{foresight "foresight7"}
			{gunner "commander"}
			{charger "commander"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 30500}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.3) len(-0.49))
       		("mobility_tank"
			speed(45) ;----------Max speed when fully accelerated on road, km/h.
			reverse(8) ;---------Max speed in reverse on road, km/h.
			traverse(25) ;-------Track traverse, per second, in degrees.
			weight(30.5) ;-------Weight in Tonnes.
			power(500) ;---------Engine Power, in hp. //engine under normal use was rated 265hp at 2600 rpm
			track(6.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(340) ;----------Fuel capacity in Litres.
			type(diesel) ;---------Fuel type. (diesel OR fuel)
			range(200) ;---------Range in km, off-road.
		)
	}
	{bone "turret"
		("turret_medium" power_traverse(8.9))
	}
	{bone "gun_rot"
		{speed2 6}
		{limits -10 20}
	}
	{bone "mgun1_rot2"
		{limits -2 15};left/right
		{speed2 60}
	}
	{bone "mgun1_rot1"
		{limits -20 20};up/down
		{speed2 60}
	}
	{bone "mgun2_rot2"
		{limits -2 15};left/right
		{speed2 60}
	}
	{bone "mgun2_rot1"
		{limits -20 20};up/down
		{speed2 60}
	}

	{bone "mgun3"
		{limits -15 15};up/down
		{speed2 60}
	}
	{bone "mgun3_rot1"
		{limits -10 10};left/right
		{speed2 60}
	}
}

