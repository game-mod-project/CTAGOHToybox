{game_entity
	(include "/properties/tank__ctb_to_ku_a2fa590f.ext")
	
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "medium" "vision_lev03" "diesel" "muzzle_37mm_47mm" "detect_tank_medium" "multi_turret" "amphibia" "sq_autocannon"}
	{Extension "to_ku.mdl"}
	(include "to_ku_pontoon.ext")
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{PatherId "shermandd"}

	{sensor
		{visor "back"
			{vision "tank_rear-mg"}
			{bone "foresight3"}
		}
	}

	{sensor
		{visor "main2"
			{vision "tank_main-m"}
			{bone "foresight1a"}
		}
	}

	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "commander"
			{forward {begin "board_kv"} {base "open_commander"}}
			{reverse {end "board_t26_driver" -1} {base "open_commander" -1}}
		}
		{anm "gunner3"
			{forward {begin "board_kv"} {base "open_driver"} {base "open_gunner" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_gunner" -1}}
		}
		{anm "gunner"
			{forward {begin "board_tank_right"} {base "open_charger" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_charger" -1}}
		}
		{anm "charger"
			{forward {begin "board_tank_right"} {base "open_gunner" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_gunner" -1}}
		}
		{anm "charger2"
			{forward {begin "board_tank_right"} {base "open_gunner" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_gunner" -1}}
		}

		{anm "charger3"
			{forward {begin "board_tank_right"} {base "open_gunner" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_gunner" -1}}
		}
		{anm "driver"
			{forward {begin "board_kv"} {base "open_driver"} {base "open_charger" 1}}
			{reverse {end "emit_tank_1_hold"} {base "open_charger" -1}}
		}
		{anm "armor"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor1"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_2"}}
			{reverse {end "emit_body"}}
		}
	}

	("crew_human" place(driver) door(emit1) visor(driver))
    	("crew_human" place(gunner3)    door(emit1) visor(main2))
	("crew_human" place(charger)    door(emit2) visor(none))
    	("crew_human" place(charger2)   door(emit2) visor(back))
	("crew_human" place(charger3)    door(emit3) visor(none))
    	("crew_human" place(gunner) door(emit3) visor(main))
   	("crew_human" place(commander) door(emit3) visor(around))


	{extender "inventory"
		{box
			{item "bulletjap_25_auto aphe" 300}
			{item "bulletjap_25_auto he"   300}
			{item "bulletjap_47 aphe" 56}	
			{item "bulletjap_47 ap" 23}	
			{item "bulletjap_47 he" 30}
			{item "ammo mgun_jap" 3500}
			{item "10kg_naval_smoke_candle_grenade" 3}
			{item "satchel_charge_jap" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "25mm_type96" filling "bulletjap_25_auto aphe" 1}
			{gunner "gunner"}
			{charger "charger" minWorkers 1}
			("abm_dymamic"
				zeroing(2.5)
				dispersion(0.20)
			)  
		}
		{place "gun1"
			{RestoreIKAfterAim}
			{weapon "47mm_type1" filling "bulletjap_47 aphe" 1}
			{foresight "foresight1a"}
			{gunner "gunner3"}
			{charger "charger3"}
			("abm_dymamic"
				zeroing(2.5)
				dispersion(0.20)
			)
			{basic}
			{ai_in_manual}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "type_97" filling "ammo mgun_jap" 20}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
		}
		{place "mgun"
			{type "rear"}
			{weapon "type_97" filled}
			{foresight "foresight3"}
			{gunner "charger2"}
			{charger "charger2"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 30400}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.3) len(0.20))
		("mobility_tank"
			speed(35) ;----------Max speed when fully accelerated on road, km/h.
			reverse(8) ;--------Max speed in reverse on road, km/h.
			traverse(22) ;-------Track traverse, per second, in degrees.
			weight(30.4) ;-------Weight in Tonnes.
			power(240) ;---------Engine Power, in hp.
			track(4.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(250) ;----------Fuel capacity in Litres.
			type(diesel) ;---------Fuel type. (diesel OR fuel)
			range(200) ;----------Range in km, off-road.
		)
		{switch
			{exitFromWater}
			{terrain not "water" "deep_water"}
		}
	}
	{chassis "water"
		("chassis_defaults")
		(mod not "mp" {ignorePatherBounds})
		{waterline 1.2}
		{switch
			{terrain "water" "deep_water"}
		}
	}
	{bone "gun1_rot1"
		{limits -10 10}
		{speed2 8}
	}
	{bone "gun_rot"
		{limits -3 3}
		{speed2 8}
	}
	{bone "turret"
		("turret_medium" power_traverse(24))
	}

	{bone "mgun1_rot1"
		{limits -10 10}
	}
	{bone "mgun1_rot2"
		{limits -10 10}
	}

	{bone "mgun2_rot1"
		{limits -10 10}
	}
	{bone "mgun2_rot2"
		{limits -10 10}
	}
	{bone "foresight1a"
		{limits -2 2}
	}
}