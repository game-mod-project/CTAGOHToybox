{game_entity
	(include "/properties/tank__ctb_t49_fe2baa8f.ext")
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "light" "vision_lev03" "muzzle_150mm_155mm" "shield" "detect_tank_light" "shell_eject" "muzzle_hmg_m2hb"}
	{patherId "panzer38"}
	{targetclass "tank_light"}
	{targetSelector "tank_light"}
	{collider "tank.light"}
	{Extension "t49.mdl"}
	(include "t49.ext")


	{extender "enumerator"
		{digit_folder "us1"}
	}


	{sensor
		{visor "main"
			{vision "tank_range_200"}
		}
		{visor "around"
			{vision "ctb_tank_light"}
			{bone "visor"}
		}
		{visor "top"
			{vision "tank_remote-mg"}
			{bone "mgun"}
		}
	}

	("crew_5_human")
	("crew_human" place(commander) door(emit1) door2(emit2) visor(top))

	{boarder
		{anm "driver"
			{forward {begin "board_kv2_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "left"
			{forward {begin "board_Kv-85"} {end "seat_commander_hatch"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "right"
			{forward {begin "board_Kv-85"} {end "seat_commander_hatch"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} 	{end "seat_armor"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor1"
			{forward {begin "board_HighArmor"} {end "seat_armor"}}
			{reverse {end "emit_body"}}
		}
	}

 	{extender "shield"
		{on}
	}

	{extender "inventory"
		{weapon "mgun" {mask "mountable"}}
		{box
			{item "ammo bulletusa_152 he" 10}
			{item "ammo bulletusa_152 heat" 5}
			{item "ammo hmgun_usa" 2500}				; .50cal
			{item "satchel_charge_usa" 1}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "152mm_xm81" filled}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(3)
				dispersion(0.3)
			)
		}
		{place "mgun1"
			{type "coaxial"}
			{weapon "browning_m2" filled}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun"
			{type "aa"}
			{weapon "browning_m2" filled}
			{foresight "foresight3"}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 25700}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.32) len(0.58))
		("mobility_tank"
			speed(65) ;----------Max speed when fully accelerated on road, km/h.
			reverse(32) ;--------Max speed in reverse on road, km/h.
			traverse(38) ;-------Track traverse, per second, in degrees.
			weight(25.7) ;-------Weight in Tonnes.
			power(840) ;---------Engine Power, in hp.
			track(5) ;-----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(500) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(160) ;---------Range in km, off-road.
		)
	}

	{bone "turret"
		("turret_medium" power_traverse(24))
	}
	{bone "gun_rot"
		{limits -10 15}
		{speed2 6}
	}
}