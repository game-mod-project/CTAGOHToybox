{game_entity
	(include "/properties/tank__ctb_us_lvta1_dcf2f8de.ext")
	(include "US_LVTA1.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "light" "vision_lev03" "muzzle_37mm_47mm" "detect_tank_light" "amphibia" "sq_armor_light"}
	{Extension "US_LVTA1.mdl"}
	{targetclass "tank_light"}
	{targetSelector "tank_light"}
	{patherId "stuart"}
	{collider "tank.light"}
	
	
	

;==============================================crew==============================================
	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)	

	{boarder
		{anm "driver"
			{forward	{begin	"board_HighArmor"} {end "seat_driver_car"} {base "open_driver"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open_driver" -1}}
		}
		{anm "commander"			
			{forward	{begin	"board_HighArmor"} {end "seat_driver_car"} {base "open_commander"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open_commander" -1}}
		}
		{anm "gunner"
			{forward	{begin	"board_HighArmor"} {end "seat_driver_car"} {base "open_gunner"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open_gunner" -1}}
		}
		{anm "gunner1"			
			{forward	{begin	"board_HighArmor"} {end "seat_driver_car"} {base "open_gunner1"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open_gunner1" -1}}
		}
		{anm "charger"
			{forward	{begin	"board_HighArmor"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "charger2"
			{forward	{begin	"board_HighArmor"} {end "pose_mgun_pz6"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_lowArmor"} 	{end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor2"
			{forward	{begin	"board_lowArmor"} {end "pose_pz3_right"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor3"
			{forward	{begin	"board_lowArmor"} {end "pose_univ_carrier_pass_seat04"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	("crew_human" place(driver)	    door(emit0) visor(driver))
	("crew_human" place(commander)	door(emit1) visor(main))
	("crew_human" place(gunner)	    door(emit2) visor(main))
	("crew_human" place(gunner1)	door(emit3) visor(main))
	("crew_human_visible" place(charger2)	door(emit4) visor(main))
	("crew_human_visible" place(charger)	door(emit5) visor(main))

	("seat_human" place(seat1) bone(seat01) door(emit4)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit5)  animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit4)  animation(armor2))
	("seat_human" place(seat4) bone(seat04) door(emit5)  animation(armor3))	
	("seat_human" place(seat5) bone(seat05) door(emit4)  animation(armor2))
	("seat_human" place(seat6) bone(seat06) door(emit5)  animation(armor))	
;================================================================================================

	{extender "inventory"
		{box
			{item "bulletusa_37 apcbc" 43}		;147 rounds ;30/70% AP/HE		;historical 30% AP, 60% HE, 10% CAN
			{item "bulletusa_37 he" 103}
			{item "ammo mgun_usa belt" 7250}		;6750 rounds
			{item "satchel_charge_usa" 1}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "37mm_m6" filling "bulletusa_37 apcbc" 1}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_dymamic"
				zeroing(2.5)
				dispersion(0.20)
			)
		}
		{place "mgun1"
			{type "coaxial"}
			{weapon "browning_m19a5" filled}
			{foresight "foresight4"}
			{gunner "gunner1"}
			{charger "gunner1"}
			("abm_mgun")
			{basic}			
		}
		{place "mgun2"
			{type "right"}
			{weapon "browning_m19a5" filled}
			{foresight "foresight5"}
			{gunner "charger"}
			{charger "charger"}
			{ai_in_manual}
			("abm_mgun")
			{basic}
		}
		{place "mgun3"
			{type "left"}
			{weapon "browning_m19a5" filled}
			{foresight "foresight6"}
			{gunner "charger2"}
			{charger "charger2"}
			{ai_in_manual}
			("abm_mgun")
			{basic}
		}
	}

	{sensor
		{visor "gunner"
		    {vision "tank_main-l"}
			{bone "visor1"}
		}
		{visor "gunner1"
		    {vision "tank_main-l"}
			{bone "visor4"}
		}		
		{Visor "driver"
            {vision "tank_driver"}
            {bone "visor2"}
		}
		{visor "charger"
		    {vision "tank_main-l"}
			{bone "visor5"}
		}		
		{visor "charger2"
		    {vision "tank_main-l"}
			{bone "visor6"}
		}
		{visor "commander"
		    {vision "tank_main-l"}
			{bone "visor3"}
		}
	}

	{mass 14800}
	{Chassis
		("tank_trace_ex" fx("tracks_sm2") step(0.3) len(0.6) boneleft("wheels_l") boneright("wheels_r"))
		("mobility_tank"
			speed(40) ;----------Max speed when fully accelerated on road, km/h.
			reverse(7) ;--------Max speed in reverse on road, km/h.
			traverse(15) ;-------Track traverse, per second, in degrees.
			weight(14.8) ;--------Weight in Tonnes.
			power(250) ;---------Engine Power, in hp.
			track(3.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(380) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(201) ;---------Range in km, off-road.
		)
		{switch
			{exitFromWater}
			{terrain not "water" "deep_water"}
		}
	}

	{bone "turret"
		("turret_light" power_traverse(24))
	}
	
	{chassis "water"
	   	("chassis_defaults")
		(mod not "mp" {ignorePatherBounds})
		{waterline 1.4}
		{switch
			{terrain "water" "deep_water"}
		}	
	}
}
