{game_entity
	(include "/properties/tank__ctb_us_lvta4_7196d182.ext")
	(include "US_LVTA4.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "light" "vision_lev03" "amphibia" "shell_eject" "muzzle_75mm_76mm" "detect_tank_light" "tractor" "tractor_light" "muzzle_hmg_m2hb" "sq_he_medium"}
	{targetclass "tank_light"}
	{targetSelector "tank_light"}
	{Extension "US_LVTA4.mdl"}
	{collider "tank.light"}
	{PatherID "amphibia"}	
	
	
	

;==============================================crew==============================================
	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)	

	{boarder
		{anm "driver"
			{forward	{begin	"board_HighArmor"} {end "seat_driver_car"} {base "open_driver"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open_driver" -1}}
		}
		{anm "charger2"			
			{forward	{begin	"board_HighArmor"} {end "seat_driver_car"} {base "open_commander"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open_commander" -1}}
		}
		{anm "charger"			
			{forward	{begin	"board_HighArmor"} {end "pose_M8A1_charger"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "gunner"
			{forward	{begin	"board_HighArmor"} {end "pose_M8A1_gunner"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "commander"			
			{forward	{begin	"board_HighArmor"} {end "pose_M8A1_commander"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_lowArmor"} 	{end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor2"
			{forward	{begin	"board_lowArmor"} {end "pose_pz3_right"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor3"
			{forward	{begin	"board_lowArmor"} {end "pose_univ_carrier_pass_seat04"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	("crew_human_visible" place(driver)	    door(emit0) visor(driver))
	("crew_human_visible" place(charger2)	door(emit1) visor(main))
	("crew_human_visible" place(gunner)	    door(emit3) visor(main))
	("crew_human_visible" place(charger)	door(emit2) visor(none))
	("crew_human_visible" place(commander)	door(emit4) visor(around))	

	("seat_human" place(seat1) bone(seat01) door(emit4)  animation(armor3))
	("seat_human" place(seat2) bone(seat02) door(emit3)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit4)  animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit3)  animation(armor2))	
	("seat_human" place(seat5) bone(seat05) door(emit4)  animation(armor))
	("seat_human" place(seat6) bone(seat06) door(emit3)  animation(armor1))	
	("seat_human" place(seat7) bone(seat07) door(emit3)  animation(armor1))	
	("seat_human" place(seat8) bone(seat08) door(emit4)  animation(armor3))
	("seat_human" place(seat9) bone(seat09) door(emit3)  animation(armor))	
	("seat_human" place(seat10) bone(seat010) door(emit3)  animation(armor3))	
	("seat_human" place(seat11) bone(seat011) door(emit4)  animation(armor3))
	("seat_human" place(seat12) bone(seat012) door(emit3)  animation(armor1))

	{sensor
		{visor "around"
			{vision "ctb_tank_light"}		;// better vision than a in-closed turret 
		}
	}	
;================================================================================================

	{extender "inventory"
		{box
			
			{item "ammo bulletusa_75x272 he" 30}	;46 rounds, 70/15/15%, HE/HEAT/WP
			{item "ammo bulletusa_75x272 heat" 10}
			{item "ammo bulletusa_75x272 wp" 8}
			{item "ammo hmgun_usa" 600}				; 4 belts (100 rounds each)
			{item "satchel_charge_usa" 1}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_m2_how" filling "bulletusa_75x272 he" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(4.00)
				dispersion(0.25)
			)
		}
		{place "mgun1"
			{type "aa"}
			{weapon "browning_m2" filled}
			{foresight "foresight4"}
			{gunner "commander"}
			{charger "charger2"}
			{ai_in_manual}
			("abm_mgun")
			{basic}	
		}
	}

	{mass 14800}
	{Chassis
		("tank_trace_ex" fx("tracks_sm2") step(0.3) len(0.6) boneleft("wheels_l") boneright("wheels_r"))
		("mobility_tank"
			speed(40) ;----------Max speed when fully accelerated on road, km/h.
			reverse(7) ;--------Max speed in reverse on road, km/h.
			traverse(15) ;-------Track traverse, per second, in degrees.
			weight(14.8) ;--------Weight in Tonnes.
			power(250) ;---------Engine Power, in hp.
			track(3.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(380) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(201) ;---------Range in km, off-road.
		)
		{switch
			{exitFromWater}
			{terrain not "water" "deep_water"}
		}
	}

	{bone "turret"
		("turret_light" power_traverse(0)) ;// manual
	}
	
	{chassis "water"
		("chassis_defaults")
		(mod not "mp" {ignorePatherBounds})
		{waterline 1.4}
		{switch
			{terrain "water" "deep_water"}
		}
	}
}

