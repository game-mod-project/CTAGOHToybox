{game_entity
	(include "/properties/tank__ctb_ares90c_2e70a588.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "medium" "vision_lev04" "muzzle_85mm_93mm_sides" "shield" "smoke" "nwg" "detect_tank_heavy"}
	{Extension "ares90c.mdl"}
	(include "ares90c.ext")
	{PatherId "m4a3"}
	{targetclass "tank_heavy"}
	{targetSelector "tank_medium"}

	{sensor
		{visor "main"
			{vision "tank_range_210"}
		}
	}
	;==============================================
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	
	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "driver"
			{forward {begin "board_jtiger_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse {end "board_jtiger_driver" -1} {base "open_driver -1"}}
		}
		{anm "gunner"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open"}}
			{reverse {end "emit_tank_2_hold"}  {base "open" -1}}
		}
		{anm "charger"
			{forward {begin "board_tank_right"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"} {base "open1" -1}}
		}
		{anm "commander"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"} {base "open1" -1}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("crew_human" place(driver)		door(emit1)  visor(visor1))
	("crew_human" place(gunner)		door(emit1) visor(visor2))
	("crew_human" place(charger)	door(emit2) visor(none))
	("crew_human" place(commander)		door(emit2) visor(around))

	("seat_human" place(seat1) bone(seat1) door(emit5)  animation(armor))
	("seat_human" place(seat2) bone(seat2) door(emit6)  animation(armor))
	("seat_human" place(seat3) bone(seat3) door(emit7)  animation(armor))
	("seat_human" place(seat4) bone(seat4) door(emit8)  animation(armor))
	("seat_human" place(seat5) bone(seat5) door(emit9)  animation(armor))
	("seat_human" place(seat6) bone(seat6) door(emit10)  animation(armor))
;==============================================

	{extender "shield" {on}}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "mortareng_50 sm"}
	}

	{extender "inventory"
		{box
			{item "ammo bulletusa_90x600 apcbche" 70} 
			{item "ammo bulletusa_90x600 apbc" 10}
			{item "ammo bulletusa_90x600 he" 40}
			{item "ammo bulletusa_90x600 hvap" 10}
			{item "ammo hmgun_usa api" 8200}		
			{item "ammo mgun_usa belt" 2250}
			{item "mortareng_50 sm" 18}		;2-inch smoke mortar
			{item "satchel_charge_usa" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "90mm_m3_10" filling "ammo bulletusa_90x600 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(3)
				dispersion(0.3)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "browning_m19a4" filled}
			{foresight "foresight4"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun"
			{type "aa"}
			{foresight "foresight2"}
			{gunner "commander"}
			{charger "commander"}
			{weapon "browning_m2_x4_2" filling "hmgun_usa api" 800}
			("abm_mgun")
			{Rotate}
			{basic}
		}
	}

	{mass 45500}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.39))
		("mobility_tank"
			speed(46) ;----------Max speed when fully accelerated on road, km/h.
			reverse(5.3) ;-------Max speed in reverse on road, km/h. 3.3 + 2kmh
			traverse(35) ;-------Track traverse, per second, in degrees.
			weight(45.5) ;-------Weight in Tonnes.
			power(600) ;---------Engine Power, in hp. //engine was governed to 2500 max rpm which reduced it from 700HP to 600HP
			track(6.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(700) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(100) ;---------Range in km, off-road.
		)
	}

	{bone "gun_rot"
		{limits -7 18}
		{speed2 4}
	}
	{bone "turret"
		("turret_medium" power_traverse(20))
	}
}
