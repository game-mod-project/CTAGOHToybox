{game_entity
	(include "/properties/tank__ctb_skink_172e503d.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "medium" "vision_lev04" "shield"}
	{Extension "skink.mdl"}
	(include "skink.ext")
	{PatherId "m4a3"}
	{targetclass "tank_medium"}
	{targetSelector "tank_zenite"}

	{sensor
		{visor "main"
			{vision "tank_range_210"}
			{bone "visor2"}
		}
	}
	;==============================================
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	
	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "driver"
			{forward {begin "board_jtiger_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse {end "board_jtiger_driver" -1} {base "open_driver -1"}}
		}
		{anm "gunner"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open"}}
			{reverse {end "emit_tank_2_hold"}  {base "open" -1}}
		}
		{anm "gunner3"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open_codriver"}}
			{reverse {end "emit_tank_2_hold"}  {base "open_codriver" -1}}
		}
		{anm "charger"
			{forward {begin "board_tank_right"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"} {base "open1" -1}}
		}
		{anm "commander"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"} {base "open1" -1}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("crew_human" place(driver)		door(emit1)  visor(visor1))
	("crew_human" place(gunner)		door(emit3) visor(main))
	("crew_human" place(gunner3)	door(emit2) visor(visor1))
	("crew_human" place(charger)	door(emit4) visor(none))
	("crew_human" place(commander)		door(emit4) visor(around))

;==============================================

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "bulleteng_20_auto box ap" 1000}
			{item "bulleteng_20_auto box hei" 1240}	
			{item "ammo mgun_usa belt" 2250}
			{item "mortareng_50 sm" 18}		;2-inch smoke mortar
			{item "satchel_charge_usa" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{Barrels 2}
			{weapon "20mm_polsten_2" filling "bulleteng_20_auto box hei" 30}
			{foresight "foresight1"}
			{shooter "shootera"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(3.0)
				dispersion(0.17)
			)
			{basic}
			{ai_in_manual}
		}
		{place "gun2"
			{RestoreIKAfterAim}
			{Barrels 2}
			{weapon "20mm_polsten_2" filling "bulleteng_20_auto box hei" 30}
			{foresight "foresight2"}
			{shooter "shooterb"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(3.0)
				dispersion(0.17)
			)
			{basic}
			{ai_in_manual}
		}
		{place "mgun"
			{type "hull"}
			{foresight "foresight3"}
			{gunner "gunner3"}
			{charger "gunner3"}
			{weapon "browning_m19a4" filled}
			("abm_mgun")
			{Rotate}
			{basic}
		}
	}

	{mass 30500}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.47))
		("mobility_tank"
			speed(45) ;----------Max speed when fully accelerated on road, km/h.
			reverse(7.3) ;-------Max speed in reverse on road, km/h. 3.3 + 2kmh
			traverse(35) ;-------Track traverse, per second, in degrees.
			weight(45.5) ;-------Weight in Tonnes.
			power(610) ;---------Engine Power, in hp. //engine was governed to 2500 max rpm which reduced it from 700HP to 600HP
			track(6.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(700) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(100) ;---------Range in km, off-road.
		)
	}

	{bone "gun1_rot"
		{speed2 40}
	}
	{bone "gun2_rot"
		{speed2 40}
	}
	{bone "mgun_rot1"
		{speed2 40}
	}
	{bone "mgun_rot2"
		{speed2 40}
	}
	{bone "turret"
		{speed2 40}
	}
}
