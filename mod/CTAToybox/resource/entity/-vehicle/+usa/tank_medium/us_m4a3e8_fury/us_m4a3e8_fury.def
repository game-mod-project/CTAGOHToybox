{game_entity
	(include "/properties/tank__ctb_us_m4a3e8_fury_58b3155e.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "vision_lev04" "muzzle_75mm_76mm" "muzzle_hmg_m2hb" "sq_armor_medium"}
	{PatherId "sherman"}
	{targetclass "tank_heavy"}
	{targetSelector "tank_medium"}
	{Extension "US_m4a3e8_FURY.mdl"}
	(include "US_m4a3e8_FURY.ext")
	
	;("armor_m4a3e8" turret1(64 64 64 25) body1(64 38 38 20) body2(108 38 64 20))
	;("armor_engine"  t(40 40 40 40))		

	;("shield" args 20)
	{extender "shield"
		{on}
	}

	

;==============================================
	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	("commander_visible")	

	{boarder
		{anm "driver"
			{forward	{begin	"board_tank_left"} {end "seat_driver_car"} {base "open_driver"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open_driver" -1}}
		}
		{anm "charger"
			{forward	{begin	"board_HighArmor"} {end "seat_driver_car"} {base "open_gunner"}}
			{reverse 	{end	"emit_tank_1_hold"} {base "open_gunner" -1}}
		}
		{anm "charger3"			
			{forward	{begin	"board_Kv"} {end "seat_driver_car"} {base "open_charger2"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open_charger2" -1}}
		}
		{anm "gunner"
			{forward	{begin	"board_Kv"} {end "seat_driver_car"} {base "open_charger2"}}
			{reverse 	{end	"emit_tank_1_hold"} {base "open_charger2" -1}}
		}
		{anm "commander"			
			{forward	{begin	"board_HighArmor"} {end "pose_watch_binocular"} {base "open_charger2"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open_commander" -1}}
		}
	}

	("crew_human" place(driver)	    door(emit1) visor(driver))
	("crew_human" place(charger)	door(emit2) visor(main))
	("crew_human" place(charger3)	door(emit0) visor(main))
	("crew_human" place(gunner)	    door(emit3) visor(main))
	("crew_human_visible" place(commander)	door(emit3) visor(main))

;==============================================

	{extender "inventory"
		{box
			{item "ammo bulletusa_76x539 apcbche" 31}	;71 rounds
			{item "ammo bulletusa_76x539 he" 34}
			{item "ammo bulletusa_76x539 sm" 3}
			{item "ammo bulletusa_76x539 hvap" 2}
			{item "ammo hmgun_usa" 500}		;600 rounds
			{item "ammo mgun_usa" 6250}		;6750 rounds
			{item "satchel_charge_usa" 1}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "76mm_m1a1c" filling "ammo bulletusa_76x539 apcbche" 1}	
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(3.0)
				dispersion(0.20)
			)
		}
		{place "mgun1"
			{type "coaxial"}
			{weapon "browning_m19a4" filled}
			{foresight "foresight4"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun2"
			{type "hull"}
			{weapon "browning_m19a4" filled}
			{foresight "foresight5"}
			{gunner "charger3"}
			{charger "charger3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}

		{place "mgun3"
			{type "aa"}
			{weapon "browning_m19a4" filled}
			{foresight "foresight6"}
			{gunner "commander"}
			{charger "commander"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
			
    	{place "mgun4"
			{type "rear"}
			{weapon "browning_m2" filled}
			{foresight "foresight7"}
			{gunner "commander"}
			{charger "commander"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}	
	}    
	
	{sensor
		{visor "gunner"
		    {vision "tank_main-l"}
			{bone "visor1"}
		}
		{Visor "driver"
            {vision "tank_driver"}
            {bone "visor2"}
		}
		{visor "charger2"
		    {vision "tank_main-l"}
			{bone "visor3"}
		}
		{visor "commander"
		    {vision "tank_main-l"}
			{bone "visor4"}
		}
		{visor "charger"
		    {vision "tank_main-l"}
			{bone "visor5"}
		}
	}

	{mass 32300}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.3) len(-0.49))
		("mobility_tank"
			speed(43) ;----------Max speed when fully accelerated on road, km/h.
			reverse(8) ;---------Max speed in reverse on road, km/h.
			traverse(30) ;-------Track traverse, per second, in degrees.
			weight(32.3) ;-------Weight in Tonnes.
			power(450) ;---------Engine Power, in hp. //engine under normal use was rated 265hp at 2600 rpm
			track(5.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(520) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(220) ;---------Range in km, off-road.
		)
	}
	{bone "turret"
		("turret_heavy" power_traverse(24))
	}
}
