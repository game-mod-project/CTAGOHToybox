{game_entity
	(include "/properties/tank__ctb_us_m4a3e8_thundervii_17a9a4ea.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "vision_lev04" "muzzle_75mm_76mm" "muzzle_hmg_m2hb" "sq_armor_medium"}
	{PatherId "sherman"}
	{targetclass "tank_heavy"}
	{targetSelector "tank_medium"}
	{Extension "US_m4a3e8_thunderVII.mdl"}
	(include "US_m4a3e8_thunderVII.ext")

	{extender "enumerator"}

	



	;("armor_m4a3e8" turret1(64 64 64 25) body1(64 38 38 20) body2(108 38 64 20))
	;("armor_engine"  t(40 40 40 40))		

	;("shield" args 20)
	{extender "shield"
		{on}
	}

	

;==============================================	
	

	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	("charger_visible")
	
	{boarder
		{anm "driver"
			{forward	{begin	"board_tank_left"} {end "seat_driver_car"} {base "open_driver"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open_driver" -1}}
		}
		{anm "charger"
			{forward	{begin	"board_HighArmor"} {end "com_fire"} {base "com_fire"}}
			{reverse 	{end	"emit_tank_1_hold"} {base "open_gunner" -1}}
		}
		{anm "charger2"			
			{forward	{begin	"board_Kv"} {end "seat_driver_car"} {base "open_charger2"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open_charger2" -1}}
		}
		{anm "gunner"
			{forward	{begin	"board_Kv"} {end "seat_driver_car"} {base "open_commander"}}
			{reverse 	{end	"emit_tank_1_hold"} {base "open_commander" -1}}
		}
		{anm "commander"			
			{forward	{begin	"board_HighArmor"} {end "pose_watch_binocular"} {base "open_commander"}}
			{reverse 	{end	"emit_tank_2_hold"} {base "open_commander" -1}}
		}
		{anm "gunner3"
			{forward {begin "board_HighArmor"} {end "seat_m4a276w_commander"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor"
			{forward	{begin	"board_lowArmor"} 	{end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor2"
			{forward	{begin	"board_lowArmor"} {end "pose_pz3_right"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor3"
			{forward	{begin	"board_lowArmor"} {end "pose_univ_carrier_pass_seat04"}}
			{reverse 	{end	"emit_body"}}
		}
	}

	("crew_human" place(driver)	    door(emit1) visor(driver))
	("crew_human_visible" place(charger)	door(emit2) visor(main))
	("crew_human" place(charger2)	door(emit0) visor(main))
	("crew_human" place(gunner)	    door(emit3) visor(main))
	("crew_human" place(commander)	door(emit3) visor(main))

	("gunner_open" place(gunner3) bone(gunner3) visorbone(mgun_rot) door(emit3) door2(emit2) anm_left(gunner3) anm_right(gunner3) group(passenger))

	("seat_human" place(seat1) bone(seat01) door(emit1)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit2)  animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit1)  animation(armor2))
	("seat_human" place(seat4) bone(seat04) door(emit3)  animation(armor3))

	(define "define_place"
	{placer
		{place "%place" {visor "%visor"}{LinkBone "%bone"}{openForCrush} {turnoff {shadow}}{attach squat_lie}}
	}
	{boarder
		{door "%door"}
		{link "%door" "%place" {anm "%animation"} }
	}
	{Volume "%place"
		{tags "attach" "attach_%place"}
		{able clear {bullet 0} {touch 1}}
	}
	)
	
	("define_place" place(seat5) bone(seat001) door(emit3)  animation(armor1))
	("define_place" place(seat6) bone(seat002) door(emit3)  animation(armor)) 	 
;==============================================

	{extender "inventory"
		{box
			{item "ammo bulletusa_76x539 apcbche" 31}	;71 rounds
			{item "ammo bulletusa_76x539 he" 34}
			{item "ammo bulletusa_76x539 sm" 3}
			{item "ammo bulletusa_76x539 hvap" 2}
			{item "ammo hmgun_usa" 2500}		;600 rounds
			{item "ammo mgun_usa" 6250}		;6750 rounds
			{item "satchel_charge_usa" 1}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "76mm_m1a1c" filling "ammo bulletusa_76x539 apcbche" 1}	
			{gunner "gunner"}
			{charger "commander"}
			("abm_dymamic_stabilised"
				zeroing(3.0)
				dispersion(0.20)
			)
		}
		{place "mgun1"
			{type "coaxial"}
			{weapon "browning_m2" filled}
			{foresight "foresight4"}
			{gunner "gunner"}
			{charger "commander"}
			("abm_mgun")
			{basic}
		}
		{place "mgun2"
			{type "hull"}
			{weapon "browning_m19a4" filled}
			{foresight "foresight5"}
			{gunner "charger2"}
			{charger "charger2"}
			{basic}
			{ai_in_manual}
		}
		{place "mgun3"
			{type "aa"}
			{weapon "browning_m19a4" filled}
			{foresight "foresight6"}
			{gunner "charger"}
			{charger "charger"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
    	{place "mgun4"
			{type "aa"}
			{weapon "browning_m2" filled}
			{foresight "foresight7"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}	
	}     
	
	{sensor
		{visor "gunner1"
		    {vision "tank_main-l"}
			{bone "visor1"}
		}
		{Visor "driver"
            {vision "tank_driver"}
            {bone "visor2"}
		}
		{visor "gunner3"
		    {vision "tank_main-l"}
			{bone "visor3"}
		}
		{visor "commander"
		    {vision "tank_main-l"}
			{bone "visor4"}
		}
		{visor "charger"
		    {vision "tank_main-l"}
			{bone "visor5"}
		}
	}

	{mass 32300}
	{Chassis
		("tank_trace" fx("tracks_sm") step(0.3) len(-0.49))
		("mobility_tank"
			speed(43) ;----------Max speed when fully accelerated on road, km/h.
			reverse(8) ;---------Max speed in reverse on road, km/h.
			traverse(30) ;-------Track traverse, per second, in degrees.
			weight(32.3) ;-------Weight in Tonnes.
			power(450) ;---------Engine Power, in hp. //engine under normal use was rated 265hp at 2600 rpm
			track(5.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(520) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(220) ;---------Range in km, off-road.
		)
	}
	{bone "turret"
		("turret_heavy" power_traverse(24))
	}
}
