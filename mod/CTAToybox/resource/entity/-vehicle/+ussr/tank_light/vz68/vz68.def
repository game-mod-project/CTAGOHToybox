{game_entity
	(include "/properties/tank__ctb_vz68_ab5631e4.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "light" "vision_lev04" "shield" "detect_tank_light"}
	{Extension "vz68.mdl"}
	(include "vz68.ext")
	{PatherId "panzer5"}
	{targetclass "tank_light"}
	{targetSelector "tank_zenite"}

	{sensor
		{visor "main"
			{vision "tank_range_210"}
		}
	}
	;==============================================
	(define "crew_human_visible"
		{placer	{place "%place" {group "crew"} {linkbone "%place"} {visor "%visor"} {turnoff {sensor} {shadow} {targetable}}}  	}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)
	
	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	{boarder
		{anm "driver"
			{forward {begin "board_jtiger_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse {end "board_jtiger_driver" -1} {base "open_driver"-1}}
		}
		{anm "gunner"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open"}}
			{reverse {end "emit_tank_2_hold"}  {base "open" -1}}
		}
		{anm "commander"
			{forward {begin "board_Kv"} {end "pose_mgun_pz6"} {base "open1"}}
			{reverse {end "emit_tank_2_hold"} {base "open1" -1}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("crew_human" place(driver)		door(emit1)  visor(visor1))
	("crew_human" place(gunner)		door(emit2) visor(visor2))
	("crew_human" place(commander)		door(emit3) visor(around))

	("seat_human" place(seat1) bone(seat1) door(emit5)  animation(armor))
	("seat_human" place(seat2) bone(seat2) door(emit6)  animation(armor))
	("seat_human" place(seat3) bone(seat3) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat4) door(emit6)  animation(armor))
;==============================================

	{extender "shield" {on}}

	{extender "inventory"
		{weapon "mgun" {mask "mountable"}}
		{box
			{item "bulletrus_50_l60 apcr" 500}
			{item "bulletrus_50_l60 he" 450}
			{item "ammo hmgun_rus_145 ap" 1500}		; 32 belts (150 rounds each)
			{item "geballteladung_3kg" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "50mm_zk500s" filling "bulletrus_50_l60 he" 60}
			{Barrels 2}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_dymamic_aaa"
				zeroing(0.8)
				dispersion(0.15)
			)
		}
		{place "mgun"
			{type "coaxial"}
			{weapon "kpvt" filled}
			{foresight "foresight3"}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 19500}
	{Chassis
		("tank_trace" fx("tracks_big") step(0.47) len(0.30))
		("mobility_tank"
			speed(90) ;----------Max speed when fully accelerated on road, km/h.
			reverse(5.3) ;-------Max speed in reverse on road, km/h. 3.3 + 2kmh
			traverse(35) ;-------Track traverse, per second, in degrees.
			weight(19.5) ;-------Weight in Tonnes.
			power(600) ;---------Engine Power, in hp. //engine was governed to 2500 max rpm which reduced it from 700HP to 600HP
			track(6.0) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(700) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(100) ;---------Range in km, off-road.
		)
	}

	{bone "gun_rot"
		{speed2 8}
	}
	{bone "turret"
		{speed2 30}
	}
}
