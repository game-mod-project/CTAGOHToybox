{game_entity
	(include "/properties/tank__ctb_zut_37_d4c842c8.ext")
	
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "light" "vision_lev03" "automatic" "muzzle_37mm_40mm_auto" "tractor" "tractor_medium" "detect_tank_light" "open_top" "ammo_open_top_turret" "sq_autocannon"}
	{Extension "zut_37.mdl"}
	(include "zut_37.ext")
	{PatherID "t70"}
	{collider "tank.light"}
	{targetclass "tank_light"}
	{targetSelector "tank_light"}

	{extender "enumerator"
		{digit_folder "ru1"}
	}

	{boarder
		{anm "driver"
			{forward {begin "board_t26_driver"} {end "pose_t26_driver"} {base "open_driver"}}
			{reverse {end "board_t26_driver" -1} {base "open_driver" -1}}
		}
		{anm "left"
			{forward {begin "board_tank_left"} {end "aagun_72k_gunner"}}
			{reverse {end "emit_tank_1_hold"}}
		}
		{anm "armor1"
			{forward {begin "board_LowArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("crew_driver" door(emit1) door2(emit1) door3(emit1))
	("crew_human_visible_anm" place(gunner)		door(emit2) door2(emit2) visor(main)	anm_left(left)  anm_right(left))

	("seat_human" place(seat0) bone(seat00) door(emit3) animation(armor1))
	("seat_human" place(seat1) bone(seat01) door(emit4) animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit5) animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit6) animation(armor1))

	{extender "inventory"
		{box
			{item "bulletrus_37_auto ap" 250}		; 60 clips (5 rounds each)
			{item "bulletrus_37_auto he" 250}
			{item "satchel_charge_rus" 1}
		}
	}
	
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "37mm_Sh37" filling "bulletrus_37_auto ap" 5}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_dymamic_aaa"
				zeroing(1.2)
				dispersion(0.15)
			)
		}
	}
	
	{mass 9800}
	{Chassis
		("tank_trace" fx("tracks_sm2") step(0.17) len(-0.6))
		("mobility_tank"
			speed(45) ;----------Max speed when fully accelerated on road, km/h.
			reverse(15) ;--------Max speed in reverse on road, km/h.
			traverse(32) ;-------Track traverse, per second, in degrees.
			weight(9.2) ;--------Weight in Tonnes.
			power(170) ;---------Engine Power, in hp.
			track(4.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(480) ;----------Fuel capacity in Litres.
			type(diesel) ;---------Fuel type. (diesel OR fuel)
			range(180) ;---------Range in km, off-road.
		)
	}

	{bone "gun_rot"
		{limits -6 20}
		{speed2 10}
	}
	{bone "turret"
		("turret_light" power_traverse(0)) ;// manual
	}
}