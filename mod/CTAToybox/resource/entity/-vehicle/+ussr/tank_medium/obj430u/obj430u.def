{game_entity
	(include "/properties/tank__ctb_obj430u_aa5d3289.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{collider "tank.medium"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{PatherId "t34"}
                {props "tractor" "medium" "muzzle_kpvt_aa2" "shield" "turret_rotator" "smoke" "ess" "autoshot" "with_open_zpu" "vision_lev04" "muzzle_122mm_128mm_sides"}
	{extension "object430u.mdl"}
	(include "obj430u.ext")

	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"} {end "pose_mgun_pz6"} {base "open1" +1}}
			{reverse 	{end	"emit_tank_1_hold"} {base "open1" -1}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"} {end "seat_m7_mgunner"} {base "open" +1}}
			{reverse 	{end	"emit_tank_1_hold"} {base "open" -1}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}
}

{placer
	{place "driver" {group "crew"} {visor "driver"}}
}
{boarder
	{door "emit1"}
	{link "emit1" "driver" {anm "left"} {forward putoff} {reverse puton}}
}

{placer
	{place "commander" {group "crew"}}
}
{boarder
	{door "emit2"}
	{link "emit2" "commander" {anm "left"} {forward putoff} {reverse puton}}
}

{placer
	{place "gunner" {group "crew"} {visor "tur1"} {visor "tur1_2"}}
}
{boarder

	{door "emit4"}
	{link "emit4" "gunner" {anm "right"} {forward putoff} {reverse puton}}
}

{placer
	{place "charger" {group "crew"} {visor "tur2"} {visor "tur2_2"} {visor "tur2_3"} {visor "tur2_4"} {visor "tur2_5"} {visor "tur2_6"} {visor "tur2_7"}}
}
{boarder
	{door "emit3"}
	{link "emit3" "charger" {anm "right"} {forward putoff} {reverse puton}}
}

{placer
	{place "commander" {group "crew"} {linkbone "commander"} {turnoff {sensor} {shadow}} {openForCrush} {visor "mgun_aa"}}
}
{boarder

	{door "emit2"}
	{link "emit2" "commander" {anm "right"} {forward putoff} {reverse puton}}
}

(define "seat_human"
	{placer
		{place "%place" {group "%group"} {linkbone "%bone"} {turnoff {sensor} {shadow}}}
	}
	{boarder
		{door "%door"}
		{link "%door" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
	}
)

("seat_human" place(seat1) bone(seat5) door(emit5)  animation(armor))
("seat_human" place(seat2) bone(seat6) door(emit6)  animation(armor))
("seat_human" place(seat3) bone(seat7) door(emit7)  animation(armor))
("seat_human" place(seat4) bone(seat8) door(emit8)  animation(armor))
("seat_human" place(seat5) bone(seat9) door(emit9)  animation(armor))

	{extender "shield"
			{on}
	}

	{sensor
		{visor "tur1"
			{vision "tank_range_250"}
			{bone "visor1"}
		}
		{visor "tur1_2"
			{vision "tank_range_250"}
			{bone "visor4"}
		}
	        {visor "tur2"
			{vision "tank_range_250"}
			{bone "visor3"}
		}
	        {visor "tur2_2"
			{vision "tank_range_250"}
			{bone "visor5"}
		}
	        {visor "tur2_3"
			{vision "tank_range_250"}
			{bone "visor6"}
		}
	        {visor "tur2_4"
			{vision "tank_range_250"}
			{bone "visor7"}
		}
	        {visor "tur2_5"
			{vision "tank_range_250"}
			{bone "visor8"}
		}
	        {visor "tur2_6"
			{vision "tank_range_250"}
			{bone "visor9"}
		}
	        {visor "tur2_7"
			{vision "tank_range_250"}
			{bone "visor10"}
		}
		{visor "mgun_aa"
			{vision "vehicle_top_mgun"}
			{bone "visor11"}
		}
		{visor "driver"
			{vision "tank_range_250"}
			{bone "visor2"}
		}
	}



	{extender "inventory"
			{box
				;{size 6 11}
					{item "bulletrus_122_l48 aphebc" 22}		;68 rounds
					{item "bulletrus_122_l48 he" 44}
					{item "ammo bulletger_15_auto ap" 1000}
					{item "ammo bulletger_15_auto he" 1000}
					{item "ammo hmgun_rus_145" 1000}
                                                                                {item "ammo hmgun_rus" 1000}
			}
		}
		{Weaponry
		("restore_ik_time")
			{place "gun"
				{RestoreIKAfterAim}
				{weapon "122mm_m62_t3" filling "ammo bulletrus_122_l48 he" 1}
				{gunner "gunner"}
				{charger "charger"}
				{foresight "foresight1"}
				("abm_dymamic"
					zeroing(2.5)
					dispersion(0.20)
				)
				{basic}
				{ai_in_manual}
			}
			{place "mgun"
				{type "coaxial"}
				{weapon "dshk" filled}
                			{gunner "gunner"}
            				{charger "gunner"}
				{foresight "foresight3"}
                			("abm_mgun")
				{basic}
			}
			{place "mgun2"
				{type "aa_hmg"}
				{weapon "kpvt_2" filled}
                			{gunner "commander"}
                			{charger "commander"}
				{foresight "foresight5"}
				{basic}
				{ai_in_manual}
                			("abm_mgun")
			}
	    }


	{mass 42000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(1.9))
		("mobility_tank"
			speed(50)  ;---------Max speed when fully accelerated on road, km/h.
			reverse(18);---------Max speed in reverse on road, km/h. ;//7.5 historical + 2 due to terrain modifier
			traverse(54.24) ;-------Track traverse, per second, in degrees.
			weight(42) ;-------Weight in Tonnes.
			power(600) ;---------Engine Power, in hp.
			track(3.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(550) ;----------Fuel capacity in Litres.
			type(diesel) ;-------Fuel type. (diesel OR fuel)
			range(300) ;---------Range in km, off-road.
		)
	}
}



