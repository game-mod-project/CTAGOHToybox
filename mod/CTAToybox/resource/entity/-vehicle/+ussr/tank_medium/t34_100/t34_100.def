{game_entity
	(include "/properties/tank__ctb_t34_100_e79c305d.ext")
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "vision_lev04" "muzzle_85mm_93mm" "diesel" "sq_armor_medium"}
	{Extension "t34_100.mdl"}
	(include "t34_100.ext")
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{PatherId "t34"}

	{extender "enumerator"
		{digit_folder "ru1"}
	}

	(define "crew_human"
		{placer	{place "%place" {group "crew"} {visor "%visor"}}}
		{boarder {door "%door"}	{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}}
	)

	("crew_human" place(driver) door(emit1) visor(driver))
    	("crew_human" place(charger)    door(emit3) visor(main))
    	("crew_human" place(gunner) door(emit2) visor(main))
	("crew_human" place(gunner3) door(emit3) visor(main))
    	("crew_human" place(commander) door(emit2) visor(around))


	{boarder
		{anm "driver"
			{forward {begin "board_t34_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse {end "emit_t34_hold"} {base "close_driver"}}
		}
		{anm "gunner"
			{forward {begin "board_Is-2"} {end "seat_commander_hatch"} {base "open_gunner"}}
			{reverse {end "emit_tank_2_hold"} {base "close_charger"}}
		}
		{anm "gunner3"
			{forward {begin "board_Is-2"} {end "seat_commander_hatch"} {base "open_charger"}}
			{reverse {end "emit_tank_2_hold"} {base "close_charger"}}
		}
		{anm "charger"
			{forward {begin "board_Is-2"} {end "seat_commander_hatch"} {base "open_commander"}}
			{reverse {end "emit_tank_1_hold"} {base "close_commander"}}
		}
		{anm "commander"
			{forward {begin "board_Is-2"} {end "seat_commander_hatch"} {base "open_commander"}}
			{reverse {end "emit_tank_1_hold"} {base "close_commander"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} {end "pose_seat_armor_2"}}
			{reverse	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} {end "pose_pz3_right"}}
			{reverse	{end	"emit_body"}}
		}
	}

	{sensor
		{visor "back"
			{vision "tank_rear-mg"}
			{bone "foresight6"}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit6)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit6)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit5)  animation(armor1))

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "bulletrus_100 aphe" 25}
			{item "bulletrus_100 he" 16}
			{item "ammo mgun_rus dt" 2394}		;40 drums
			{item "satchel_charge_rus" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "100mm_lb1" filling "bulletrus_100 aphe" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(3.0)
				dispersion(0.20)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "dt" filling "ammo mgun_rus dt" 63}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "dt" filling "ammo mgun_rus dt" 63}
			{foresight "foresight4"}
			{gunner "gunner3"}
			{charger "gunner3"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "flamer1"
			{type "ussr_smoke_barrel"}
			{weapon "ussr_smoke_barrel1" filled}
			{foresight "foresight7"}
			{basic}
		}
		{place "flamer2"
			{type "ussr_smoke_barrel"}
			{weapon "ussr_smoke_barrel2" filled}
			{foresight "foresight8"}
			{basic}
		}
	}

	{mass 32000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(-0.7))
		("mobility_tank"
			speed(55)  ;---------Max speed when fully accelerated on road, km/h.
			reverse(9.5);---------Max speed in reverse on road, km/h. ;//7.5 historical + 2 due to terrain modifier
			traverse(36) ;-------Track traverse, per second, in degrees.
			weight(32.0) ;-------Weight in Tonnes.
			power(500) ;---------Engine Power, in hp.
			track(3.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(420) ;----------Fuel capacity in Litres.
			type(diesel) ;-------Fuel type. (diesel OR fuel)
			range(210) ;---------Range in km, off-road.
		)
	}

	{bone "gun_rot"
		{limits -5 20}
		{speed2 5}
	}
	{bone "turret" 
		("turret_medium" power_traverse(19))
	}
}