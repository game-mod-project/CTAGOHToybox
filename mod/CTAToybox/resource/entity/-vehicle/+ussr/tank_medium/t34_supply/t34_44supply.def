{game_entity
	(include "/properties/tank__ctb_t34_44supply_3cce2531.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3))
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	(include "/properties/resupply.inc" scale(1.2))
	{props "t3485_44" "medium" "vision_lev04" "muzzle_85mm_93mm" "diesel" "recovery"}
	{extension "t34_44supply.mdl"}
	(include "t34_44supply.ext")
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{PatherId "t34"}


	("truck_ammo_heavy")

	("supply_engineer")

	("crew_2_human_extended")

	{boarder
		{anm "driver"
			{forward {begin "board_t34_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse {end "emit_t34_hold"} {base "close_driver"}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor1"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_body"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor1))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "ammo mgun_rus dt" 2394}		;40 drums
			{item "satchel_charge_rus" 1}
			{item "repair_kit" 15}
			{item "shovel_rus" 5}
			{item "pickaxe" 5}
			{item "wirecutters" 2}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "mgun1"
			{type "hull"}
			{weapon "dt" filling "ammo mgun_rus dt" 63}
			{foresight "foresight4"}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 32000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(0.7))
		("mobility_tank"
			speed(55)  ;---------Max speed when fully accelerated on road, km/h.
			reverse(9.5);---------Max speed in reverse on road, km/h. ;//7.5 historical + 2 due to terrain modifier
			traverse(36) ;-------Track traverse, per second, in degrees.
			weight(32.0) ;-------Weight in Tonnes.
			power(500) ;---------Engine Power, in hp.
			track(5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(420) ;----------Fuel capacity in Litres.
			type(diesel) ;-------Fuel type. (diesel OR fuel)
			range(210) ;---------Range in km, off-road.
		)
	}

	{bone "gun_rot"
		{limits -5 20}
		{speed2 5}
	}
	{bone "turret" 
		{speed2 10}
	}
}