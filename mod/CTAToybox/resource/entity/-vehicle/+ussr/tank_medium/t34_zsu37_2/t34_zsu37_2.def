{game_entity
	(include "/properties/tank__ctb_t34_zsu37_2_13358afe.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3))
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "vision_lev04" "shell_eject" "open_top" "diesel" "shield" "zsu37_multi"}
	{extension "t34_zsu37_2.mdl"}
	{targetclass "tank_medium"}
	{targetSelector "tank_zenite"}
	{PatherId "t34"}
	{extender "enumerator"
		{digit_folder "ru1"}
	}
	("tank_medium_tier3")

	("fuel" args "fuel1")
	("fuel" args "fuel2")
	("fuel" args "fuel3")
	("fuel" args "fuel4")

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("ammo" args "ammo4")

	("transmission" args "transmission")

	{Volume "armor_front"
		{thickness 15
		}
	}

	{volume "body1"
		{component "body"}
		{tags "body"}
		{thickness 45
			{front 45}		; Glacis
			{top 25}
			{rear 37}
			{bottom 25}
		}
		{HighHardness}
	}
	{volume "body2"
		{component "body"}
		{tags "body"}
		{thickness 45
			{front 45}		; Glacis
			{top 25}
			{rear 37}
			{bottom 25}
		}
		{HighHardness}
	}
	{volume "body"
		{component "body"}
		{tags "body"}
		{thickness 45
			{front 45}		; Glacis
			{top 25}
			{rear 37}
			{bottom 25}
		}
		{HighHardness}
	}
	{Volume "body4"
		{Thickness 75}
	}
	{Volume "body3"
		{Thickness 65}
	}
	{Volume "barrel1"
		{Thickness 25}
	}
	{Volume "barrel2"
		{Thickness 25}
	}
	{Volume "barrel3"
		{Thickness 150}
	}
	{Volume "turret"
		{Thickness 15}
		{component "turret"}
		{tags "turret"}
		{able {holed}}
	}
	{volume "engine"		; Hull
		{thickness 30
		}
		{HighHardness}
	}
	{Volume "mantlet"
		{Thickness 30}
	}
	{extender "shield" {on}}

	("shield" args "detail1" 5)
	("shield" args "detail2" 5)
	("shield" args "detail3" 6)
	("shield" args "detail4" 6)
	("shield" args "detail5" 6)

	("shield" args "shieldl1" 5)
	("shield" args "shieldl2" 5)

	("shield" args "shieldr1" 5)
	("shield" args "shieldr2" 5)

	{component "detail1" {tags "cut_part"}}
	{component "detail2" {tags "cut_part"}}
	{component "detail3" {tags "cut_part"}}
	{component "detail4" {tags "cut_part"}}
	{component "detail5" {tags "cut_part"}}

	{component "shieldl1" {tags "cut_part"}}
	{component "shieldl2" {tags "cut_part"}}


	{component "shieldr1" {tags "cut_part"}}
	{component "shieldr2" {tags "cut_part"}}

	{boarder
		{anm "driver"
			{forward	{begin	"board_t34_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse 	{end	"emit_t34_hold"} {base "close_driver"}}
		}
		{anm "charger"
			{forward	{begin	"board_tank_right"} {end "pose_flak38_charger_right" 10}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "commander"
			{forward	{begin	"board_tank_right"} {end "pose_flak38_charger_right" 10}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "charger2"
			{forward	{begin	"board_tank_left"} {end "pose_flak38_charger_left" 10}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "gunner"
			{forward	{begin	"board_tank_right"} {end "pose_flak38_gunlayer" 10}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}

	}

	(define "crew_human"
		{placer
			{place "%place" {group "crew"} {linkbone "%place"} {turnoff {sensor} {shadow}}}
		}
		{boarder
			{door "%door1"}
			{door "%door2"}
			{link "%door1" "%place" {anm "%place"} {forward putoff} {reverse puton}}
			{link "%door2" "%place" {anm "%place"} {forward putoff} {reverse puton}}
		}
	)

	{placer
		{place "driver" {group "crew"} {visor "driver"}}
	}
	{placer
		{place "gunner" {visor "main"}}
	}
	{boarder
		{door "emit0"}
		{door "emit1"}
		{link "emit0" "driver" {anm "driver"} {forward putoff} {reverse puton}}
	}



	("crew_human" place(commander)	door1(emit2))
	("crew_human" place(gunner)	door1(emit1))
	("crew_human" place(charger)	door1(emit2))
	("crew_human" place(charger2)	door1(emit1))


	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))

	{extender "inventory"
		{box
			{item "bulletrus_37_auto ap" 800}		; 40 clips (20 rounds each)
			{item "bulletrus_37_auto he" 800}
			{item "ammo mgun_rus" 3150}		;50 drums
			{item "satchel_charge_rus" 1}			
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "37mm_61k_x2" filling "bulletrus_37_auto he" 20}
			{Barrels 2}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_aaa"
				zeroing(1.2)
				dispersion(0.15)
			)
			{rotate}	
		}
		{place "mgun1"
			{type "hull"}
			{weapon "dt" filled}
			{foresight "foresight4"}
			{gunner "charger2"}
			{charger "charger2"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}
	
	{mass 24900}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(-0.7))
		("mobility_tank"
			speed(55)  ;---------Max speed when fully accelerated on road, km/h.
			reverse(9);---------Max speed in reverse on road, km/h. ;//7.5 historical + 2 due to terrain modifier
			traverse(36) ;-------Track traverse, per second, in degrees.
			weight(24.9) ;-------Weight in Tonnes.
			power(500) ;---------Engine Power, in hp.
			track(3.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(420) ;----------Fuel capacity in Litres.
			type(diesel) ;-------Fuel type. (diesel OR fuel)
			range(610) ;---------Range in km, off-road.
		)
	}
	{bone "gun_rot"
		{speed2 30}
		{limits -7 85}
	}
	{bone "turret"
		{speed2 30}
	}

}
