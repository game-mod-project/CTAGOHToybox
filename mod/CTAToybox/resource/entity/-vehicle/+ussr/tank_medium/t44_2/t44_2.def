{game_entity
	(include "/properties/tank__ctb_t44_2_9013010e.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3))
	(include "/properties/selection/vehicle_big.inc" scale(0.8))
	{props "medium" "vision_lev04" "muzzle_85mm_93mm_sides" "diesel"}
	{extension "t44_2.mdl"}
	(include "t44_2.ext")
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{collider "tank.medium"}
	{PatherId "t34"}
	{extender "enumerator"
		{digit_folder "ru1"}
	}
	("tank_medium_tier3")

	{sensor
		{visor "main"
			{vision "tank_range_230"}
		}
	}

	("crew_4_human")
	("gunner_visible")

	{boarder
		{anm "driver"
			{forward	{begin	"board_pz4_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse 	{end	"board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "left"
			{forward	{begin	"board_tank_right"} {end "pose_gunner_isu"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_left"} {end "pose_gunner_isu"}}
			{reverse 	{end	"emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_highArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_2"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor2"
			{forward	{begin	"board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor3"
			{forward	{begin	"board_body"} 	{end "seat_isu"}}
			{reverse 	{end	"emit_tank_2"}}
		}
	}
	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit6)  animation(armor2))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))
	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "bulletrus_100 aphe" 24}		;34 rounds
			{item "bulletrus_100 aphebc" 8}
			{item "bulletrus_100 he" 15}
			{item "ammo atrifle_rus" 750}
			{item "ammo mgun_rus dt" 2394}		;40 drums
			{item "satchel_charge_rus" 1}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "100mm_d10c" filling "bulletrus_100 aphe" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(3.0)
				dispersion(0.20)
			)
		}
		{place "mgun"
			{type "aa"}
			{weapon "dshk_100" filled}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "mgun_bone"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "dt" filling "ammo mgun_rus dt" 63}
			{foresight "foresight5"}
			{gunner "charger"}
			{gunner "charger"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 34500}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(1.3))
		("mobility_tank"
			speed(50)  ;---------Max speed when fully accelerated on road, km/h.
			reverse(9.5);---------Max speed in reverse on road, km/h. ;//7.5 historical + 2 due to terrain modifier
			traverse(36) ;-------Track traverse, per second, in degrees.
			weight(34.5) ;-------Weight in Tonnes.
			power(490) ;---------Engine Power, in hp.
			track(3.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(420) ;----------Fuel capacity in Litres.
			type(diesel) ;-------Fuel type. (diesel OR fuel)
			range(180) ;---------Range in km, off-road.
		)
	}

	{bone "gun_rot"
		{limits -5 20}
		{speed2 4.4}
	}
	{bone "turret" 
		{speed2 9.5}
	}
	{##bone "commander_rot"
		{speed2 180}
	}

	{texmod "camo"}
}