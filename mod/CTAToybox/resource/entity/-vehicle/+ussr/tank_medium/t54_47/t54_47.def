{game_entity
	(include "/properties/tank__ctb_t54_47_8b69e04e.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3))
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium" "vision_lev04" "muzzle_100mm_105mm" "shield" "smoke" "4in"}
	{extension "t54_47.mdl"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{PatherId "t34"}
	{extender "enumerator"
		{digit_folder "ru1"}
	}
	("tank_medium_tier3")
	("crew_4_human")

	("fuel" args "fuel1")
	("fuel" args "fuel2")
	("fuel" args "fuel3")
	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("transmission" args "transmission")

	{Volume "body"
		{tags "body"}
		{component "body"}
		{thickness 80
			{front 120}		; Nose
			{top 30}		; Glacis
			{rear 45}
			{bottom 30}
		}
	}
	{Volume "engine"
		{tags "engine"}
		{component "engine"}
		{thickness 30
		}
	}
	{Volume "gun"
		{tags "gun"}
		{component "gun"}
		{thickness 35
		}
	}
	{Volume "hull_mg_turretl"
		{thickness 30
		}
	}
	{Volume "hull_mg_turretr"
		{thickness 30
		}
	}
	{Volume "trackleft"
		{tags "trackleft"}
		{component "trackleft"}
		{thickness 30
		}
	}
	{Volume "trackright"
		{tags "trackright"}
		{component "trackright"}
		{thickness 30
		}
	}
	{Volume "mantlet"
		{tags "gun"}
		{component "gun"}
		{thickness 200
		}
	}
	{Volume "turret1"
		{tags "turret"}
		{component "turret"}
		{thickness 100
			{top 30}
		}
	}
	{Volume "turret"
		{tags "turret"}
		{component "turret"}
		{thickness 160
			{front 180}
			{rear 52}
			{top 50}
		}
	}

	{Volume "smoke_barrell"
		{thickness 10
		}
	}
	{Volume "smoke_barrelr"
		{thickness 10
		}
	}

	{extender "shield" {on}}

	("shield" args "detail1" 5)
	("shield" args "detail2" 5)
	("shield" args "detail3" 5)
	("shield" args "detail4" 5)
	("shield" args "detail5" 5)
	("shield" args "detail6" 5)
	("shield" args "detail7" 5)
	("shield" args "detail8" 5)
	("shield" args "detail9" 5)

	("shield" args "shieldl1" 10)
	("shield" args "shieldl2" 20)

	("shield" args "shieldr1" 10)
	("shield" args "shieldr2" 10)

	{component "shieldl1" {tags "cut_part"}}
	{component "shieldl2" {tags "cut_part"}}

	{component "shieldr1" {tags "cut_part"}}
	{component "shieldr2" {tags "cut_part"}}

	{component "detail1" {tags "cut_part"}}
	{component "detail2" {tags "cut_part"}}
	{component "detail3" {tags "cut_part"}}
	{component "detail4" {tags "cut_part"}}
	{component "detail5" {tags "cut_part"}}
	{component "detail6" {tags "cut_part"}}
	{component "detail7" {tags "cut_part"}}
	{component "detail8" {tags "cut_part"}}
	{component "detail9" {tags "cut_part"}}

	{boarder
		{anm "driver"
			{forward	{begin	"board_HighArmor"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse 	{end	"emit_tank_1_hold"} {base "open_driver" -1}}
		}
		{anm "left"
			{forward	{begin	"board_Is-2"} {end "seat_isu152_gunner2"} {base "com_open"}}
			{reverse 	{end	"emit_tank_1_hold"} {base "com_open" -1}}
		}
		{anm "right"
			{forward	{begin	"board_Is-2"} {end "seat_m7_mgunner"} {base "open_crew"}}
			{reverse 	{end	"emit_tank_1_hold"} {base "open_crew" -1}}
		}
		{anm "armor"
			{forward	{begin	"board_HighArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_2"}}
		}
		{anm "armor1"
			{forward	{begin	"board_HighArmor"} 	{end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor2"
			{forward	{begin	"board_body"} {end "seat_isu1"}}
			{reverse 	{end	"emit_body"}}
		}
		{anm "armor3"
			{forward	{begin	"board_body"} 	{end "seat_isu"}}
			{reverse 	{end	"emit_tank_2"}}
		}
	}
	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))

	{extender "smokescreen"
		{cooldown 4}
		{itemTags "grenade no8_smoke"}
	}

	{extender "inventory"
		{weapon "mgun" {mask "mountable"}}
		{box
			{item "bulletrus_100 aphebc" 10}
			{item "bulletrus_100 apcbc" 15}
			{item "bulletrus_100 he" 15}
			{item "ammo mgun_rus" 6300}		;100 drums
			{item "hmgun_aa_dshkm" filled {user "mgun"}}		;100 drums
			{item "ammo hmgun_rus ap" 1500}		;30 drum boxes
			{item "ammo hmgun_rus api" 1500}		;30 drum boxes
			{item "satchel_charge_rus" 1}
			{item "no8_smoke grenade" 12}
		}
	}
	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "100mm_d10t" filled}
			("abm_dymamic"
				zeroing(1.0)
				dispersion(0.10)
			)	
		}
		{place "mgun"
			{type "aa"}
			{gunner "commander"}
			{charger "commander"}
			{LinkBone "mgun_rot"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun1"
			{type "hull"}
			{weapon "dt_x2" filled}
			{Barrels 2}
			{foresight "foresight4"}
			{shooter "shooterm"}
			{gunner "driver"}
			{charger "driver"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "sgmt" filled}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}
	
	{mass 36000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(-0.7))
		("mobility_tank"
			speed(51)  ;---------Max speed when fully accelerated on road, km/h.
			reverse(8);---------Max speed in reverse on road, km/h. ;//7.5 historical + 2 due to terrain modifier
			traverse(36) ;-------Track traverse, per second, in degrees.
			weight(36) ;-------Weight in Tonnes.
			power(520) ;---------Engine Power, in hp.
			track(3.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(650) ;----------Fuel capacity in Litres.
			type(diesel) ;-------Fuel type. (diesel OR fuel)
			range(810) ;---------Range in km, off-road.
		)
	}
	{bone "gun_rot"
		{limits -5 22}
		{speed2 3}
	}
	{bone "turret" 
		{speed2 16}
	}
	{bone "mgun_aa_v"
		{limits -25 85}
		{speed2 30}
	}
}
