{game_entity
	(include "/properties/armoredcar__ctb_p204_f_rail_41b94fe1.ext")
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "railway" "tank" "turret" "with_gun" "wheeled" "vision_lev02" "muzzle_25mm" "sq_at_light"}
	{extension "p204_f_rail.mdl"}
	{extension "crew.ext"}
	(include "p204_f_rail.ext")
	{collider "train"}
	{PatherID  "railway"}
	{targetclass "armoredcar"}
	{targetSelector "tank_light"}

	{sensor
		{visor "main"
			{vision "recon_main"}
		}
	}

	{extender "inventory"
		{box
			{item "bulletger_25 ap" 745} 		; 150 rounds
			{item "ammo mgun_ger belt" 18000}	; 15 belts (250 rounds each)
			{item "geballteladung_3kg" 2}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "25mm_kwk121f_ctb_ger" filling "bulletger_25 ap"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(2.8)
				dispersion(0.20)
			)
		}
		{place "mgun"
			{type "coaxial"}
			{weapon "mg31f_ctb_ger" filled}
			{foresight "foresight3"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 8200}
	{Chassis "railway"
		(mod not "mp" {ignorePatherBounds})
		("mobility_train"
			speed(108) ;----------------------------------Max speed.
			speedatmaxturn(17) ;-------------------------Max speed at max turn.
			reverse(30) ;--------------------------------Max speed in Reverse.
			weight(8.2) ;--------------------------------Weight in Tonnes.
			power(105) ;---------------------------------Horse Power.
			fuel(1450) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(2000) ;---------------------------------Range in Kilometers.
		)
	}

	{bone "gun_rot"
		{limits 15 -12}
		{speed2 10}
	}
	{bone "mgun_rot"
		{limits 15 -12}
		{speed2 20}
	}
	{bone "turret"
		{speed2 15}
	}
}