{game_entity
	(include "/properties/halftrack__ctb_sdkfz10_14905300.ext")
	(include "/properties/selection/vehicle.inc" scale(1.0))
	{props "truck" "vision_lev02" "tractor" "tractor_heavy" "Captor"}
	{able "emit_passangers_on_enemy"}
	{extension "sdkfz10.mdl"}
	{extension "crew.ext"}
	{collider "truck"}
	{patherId "sdkfz251"}
	("armoredcar_tier1")

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("tracks" repair(30) thickness(30))

	("glass" args "glassr")
	("glass" args "glassl")

	("shield_cover")

	("fuel" args "fuel")
	("transmission" args "transmission")
	
	{volume "body2" {able {holed}}}
	{volume "body5" {able {holed}}}
	{volume "body6" {able {holed}}}
	{volume "transmission" {able {NoWoundDecal 0}}}
	{volume "shield_cover" {able {visible 0}}}
	{volume "shield_cover2"{able {visible 0}}}

	{extender "shield" {on}}

	{extender "inventory"
		{Box
		}
	}

	{mass 4900}
	{Chassis "wheel"
		("tank_trace_ex" fx("tracks_sm2") step(0.2) len(0.50) boneleft("FXtraceL3") boneright("FXtraceR3"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("mobility_car"
			speed(98) ;----------------------------------Max speed.
			speedatmaxturn(20) ;-------------------------Max speed at max turn.
			reverse(13) ;--------------------------------Max speed in Reverse.
			weight(4.9) ;--------------------------------Weight in Tonnes.
			power(100) ;---------------------------------Horse Power.
			fuel(1100) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(1500) ;---------------------------------Range in Kilometers.
		)
	}
}