{game_entity
	(include "/properties/armoredcar__ctb_sdkfz222a_6c19a271.ext")
	(include "/properties/selection/vehicle.inc" scale(0.9))
	{props "tank" "turret" "wheeled" "-hatch" "with_gun" "vision_lev02" "muzzle_20mm_25mm_auto" "sq_autocannon"}
	{extension "sdkfz222a.mdl"}
	{extension "crew.ext"}
	{patherId "sdkfz222"}
	(include "sdkfz222a.ext")
	{targetclass "armoredcar"}
	{targetSelector "tank_zenite"}

	("shield_cover")

	{sensor
		{visor "main"
			{vision "recon_main"}
		}
	}

	{extender "shield" {off}}

	{extender "inventory"
		{box
			{item "bulletger_20_auto ap" 300}		; 18 magazines (10 rounds each)
			{item "bulletger_20_auto apcr" 100}
			{item "bulletger_20_auto he" 450}
			{item "ammo mgun_ger belt ap" 6750}		; 19 drums (75 rounds each)
			{item "geballteladung_3kg" 2}
			{item "nbks grenade" 10}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "20mm_kwk30_ctb_ger" filling "bulletger_20_auto ap" 10}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_dymamic_autocannon"
				zeroing(2)
				dispersion(0.15)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "mg34_tank_early_ctb_ger" filling "ammo mgun_ger belt ap" 75}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "gunner"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 4800}
	{Chassis "wheel"
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_car"
			speed(105) ;----------------------------------Max speed.
			speedatmaxturn(26) ;-------------------------Max speed at max turn.
			reverse(26) ;--------------------------------Max speed in Reverse.
			weight(4.8) ;--------------------------------Weight in Tonnes.
			power(75) ;----------------------------------Horse Power.
			fuel(1100) ;-----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(1800) ;---------------------------------Range in Kilometers.
		)
	}

	{bone "gun_rot"
		{limits -7 85}		;// AA mode limits
		;{limits -7 3}		;// hatch closed limits
		{speed2 20}
	}
	{bone "turret"
		{speed2 25}
	}
}