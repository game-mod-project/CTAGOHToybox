{game_entity
	(include "/properties/armoredcar__ctb_sdkfz231_2d78e6ba.ext")
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props "tank" "turret" "wheeled" "8_wheels" "with_gun" "vision_lev02" "muzzle_20mm_25mm_auto" "sq_autocannon"}
	{extension "sdkfz231.mdl"}
	{extension "crew.ext"}
	(include "sdkfz231.ext")
	{targetclass "armoredcar"}
	{targetSelector "tank_light"}
	{patherId "sdkfz232"}

	{extender "enumerator"
		{digit_folder "np"}
	}

	{sensor
		{visor "main"
			{vision "recon_main"}
		}
	}

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "bulletger_20_auto ap" 250}	; 18 magazines (10 rounds each)
			{item "bulletger_20_auto apcr" 150}
			{item "bulletger_20_auto he" 450}
			{item "ammo mgun_ger belt ap" 9750}	; 14 belts (150 rounds each)
			{item "geballteladung_3kg" 2}
		}
	}

	{Weaponry
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "20mm_kwk30_ctb_ger" filling "bulletger_20_auto ap" 10}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_autocannon"
				zeroing(2.0)
				dispersion(0.15)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "mg34_tank_ctb_ger" filling "ammo mgun_ger belt ap" 150}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 8300}
	{Chassis "wheel"
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_btr"
			speed(128) ;----------------------------------Max speed.
			speedatmaxturn(25) ;-------------------------Max speed at max turn.
			reverse(85) ;--------------------------------Max speed in Reverse.
			weight(8.3) ;--------------------------------Weight in Tonnes.
			power(180) ;---------------------------------Horse Power.
			fuel(1800) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(1700) ;---------------------------------Range in Kilometers.
		)
	}

	{bone "gun_rot"
		{limits -10 20}
		{speed2 15}
	}
	{bone "turret"
		{speed2 15}
	}
}