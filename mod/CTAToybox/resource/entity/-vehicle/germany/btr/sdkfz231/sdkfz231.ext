;SDL

	; armor notes
	; wheels 10mm (wheels did not deflate when piereced by bullet)
	; gun 20mm
	; shields 2-8mm

	("armoredcar_tier1")

	("solid_wheel" args "wheelleft1")
	("solid_wheel" args "wheelleft2")
	("solid_wheel" args "wheelleft3")
	("solid_wheel" args "wheelleft4")
	("solid_wheel" args "wheelright1")
	("solid_wheel" args "wheelright2")
	("solid_wheel" args "wheelright3")
	("solid_wheel" args "wheelright4")

	("turret" repair(45))
	("mantlet" repair(30))
	("gun" repair(30) thickness(40))

	("shield_group" args "shield1" 16 "shield1")
	("shield_group" args "shield1a" 4 "shield1")
	("shield_group" args "shield1b" 4 "shield1")
	("shield" args "shield2" 16)

	("fuel" args "fuel")
	("transmission" args "transmission")

	{volume "transmission" {able {NoWoundDecal 0}}}

	{volume "body1"			; Hull
		{thickness 16
			{front 29}
			{top 11}
			{bottom 11}
			{rear 11}
		}
		{tags "no_target"}
	}
	{volume "body2"			; Superstructure
		{thickness 16
			{front 29}
			{top 11}		; Glacis
			{bottom 11}
			{rear 11}
		}
	}
	{volume "body3"			; Top Superstructure
		{thickness 16
			{top 11}
			{bottom 11}
		}
		{tags "no_target"}
	}
	{volume "body4"			; Lower Front Hull
		{thickness 16}
		{tags "no_target"}
	}
	{volume "turret"
		{thickness 16
			{front 29}
			{top 11}
		}
	}
	{volume "mantlet"
		{thickness 29}
	}
	{volume "engine1"		; Hull
		{thickness 20
			{front 11}
			{top 11}
			{bottom 11}
		}
	}
	{volume "engine2"		; Superstructure
		{thickness 20
			{front 11}
			{top 11}
			{bottom 11}
		}
	}
	{volume "engine3"		; Lower Rear Hull
		{thickness 20}
	}