{game_entity
	(include "/properties/armoredcar__ctb_sdkfz234_1_02c9fe0f.ext")
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props  "tank" "turret" "-hatch" "vision_lev02" "muzzle_20mm_25mm_auto" "wheeled" "8_wheels" "with_gun" "open_top" "sq_autocannon"}
	{extension "crew.ext"}
	{extension "sdkfz234_1.mdl"}
	(include "sdkfz234_1.ext")
	{targetclass "armoredcar"}
	{targetSelector "tank_zenite"}
	{patherId "sdkfz232"}

	{sensor
		{visor "main"
			{vision "recon_main"}
		}
		{visor "around"
			{vision "vehicle_around"}		;// better vision than a in-closed turret 
		}
	}

;	{extender "shield" {on}}

	{extender "inventory"
		{weapon "mgun" {mask "mountable"}}
		{box
			{item "bulletger_20_auto ap" 500}		; 25 magazines (10 rounds each)
			{item "bulletger_20_auto apcr" 50}
			{item "bulletger_20_auto he" 650}
			{item "ammo mgun_ger belt ap" 11250}		; 16 belts (150 rounds each)
			{item "geballteladung_3kg" 2}
			{item "mg42_tank_ctb_ger" filling "ammo mgun_ger belt ap" 300 {user "mgun"}}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "20mm_kwk38_ctb_ger" filling "bulletger_20_auto ap" 10}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_autocannon"
				zeroing(2)
				dispersion(0.15)
			)
		}
		{place "mgun"
			{type "coaxial"}
			{gunner "gunner"}
			{charger "charger"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 11500}
	{Chassis "wheel"
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_btr"
			speed(120) ;----------------------------------Max speed.
			speedatmaxturn(25) ;-------------------------Max speed at max turn. 
			reverse(80) ;--------------------------------Max speed in Reverse.
			weight(11.5) ;-------------------------------Weight in Tonnes.
			power(220) ;---------------------------------Horse Power.
			fuel(3600) ;----------------------------------Fuel capacity in Litres.
			type(diesel) ;-------------------------------Fuel type.
			range(6000) ;---------------------------------Range in Kilometers.
		)
	}

	{bone "gun_rot"
		{limits -4 70}		;// AA mode limits
		;{limits -4 4}		;// hatch closed limits
		{speed2 20}
	}
	{bone "turret"
		{speed2 25}
	}
}