;SDL

	; armor notes
	; wheels 10mm (wheels did not deflate when piereced by bullet)
	; gun 20mm
	; shields 2-8mm

	("armoredcar_tier2")

	("solid_wheel" args "wheelleft1")
	("solid_wheel" args "wheelleft2")
	("solid_wheel" args "wheelleft3")
	("solid_wheel" args "wheelleft4")
	("solid_wheel" args "wheelright1")
	("solid_wheel" args "wheelright2")
	("solid_wheel" args "wheelright3")
	("solid_wheel" args "wheelright4")

	("turret" repair(45))
	("mantlet" repair(30))
	("gun" repair(30) thickness(40))

	("shield_tear" args "detail10" 20)
	("shield_group" args "shield1" 16 "shield")
	("shield_group" args "shield1a" 4 "shield")
	("shield_group" args "shield1b" 4 "shield")
	("shield" args "shield2" 16)

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("fuel" args "fuel")
	("transmission" args "transmission")

	{volume "transmission" {able {NoWoundDecal 0}}}

	{volume "body1"			; Under Hull
		{thickness 16
			{front 20}
		}
		{tags "no_target"}
	}
	{volume "body2"			; Superstructure
		{thickness 16
			{front 60}		; Nose
			{top 30}		; Glacis
		}
	}
	{volume "body3"			; Top Superstructure
		{thickness 16
			{front 60}
			{top 10}
		}
		{tags "no_target"}
	}
	{volume "turret1"		; Main turret
		{thickness 29
			{front 60}
			{top 16}
		}
	}
	{volume "turret2"		; Inside Mantlet
		{thickness 60}
		{CastSteel 0.8063}
	}
	{volume "mantlet1"		; Nose
		{thickness 100
			{front 200}
		}
		{CastSteel 0.8063}
	}
	{volume "mantlet2"
		{thickness 100}
		{CastSteel 0.8063}
	}
	{volume "engine1"		; Hull
		{thickness 16
			{rear 20}
		}
	}
	{volume "engine2"		; Superstructure
		{thickness 16
			{top 10}
			{rear 20}
		}
	}