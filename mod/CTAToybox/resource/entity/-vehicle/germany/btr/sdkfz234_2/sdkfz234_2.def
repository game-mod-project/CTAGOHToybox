{game_entity
	(include "/properties/armoredcar__ctb_sdkfz234_2_2022fed7.ext")
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props "tank" "turret" "wheeled" "8_wheels" "with_gun" "vision_lev02" "muzzle_50mm_57mm_sides" "smoke" "nwg" "sq_at_gun"}
	{extension "crew.ext"}
	(include "sdkfz234.ext")
	{Extension "sdkfz234_2.mdl"}
	{targetclass "armoredcar"}
	{targetSelector "tank_light"}
	{patherId "sdkfz232"}

	{sensor
		{visor "main"
			{vision "recon_main"}
		}
	}

	{extender "shield" {on}}

	{extender "inventory"
		{box
			{item "bulletger_50_l60 apche" 130}		; 55 rounds
			{item "bulletger_50_l60 he" 140}
			{item "ammo mgun_ger belt ap" 14250}		; 19 belts (150 rounds each)
			{item "nbks grenade" 2}
			{item "geballteladung_3kg" 2}
		}
	}
	{extender "smokescreen"
		{cooldown 20}
		{itemTags "grenade nbks"}
	}

	{Weaponry
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "50mm_kwk39_ctb_ger" filling "bulletger_50_l60 apche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_stabilised"
				zeroing(2.5)
				dispersion(0.20)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "mg42_tank_ctb_ger" filling "ammo mgun_ger belt ap" 150}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger"}
			("abm_mgun")
			{basic}
		}
	}

	{mass 11700}
	{Chassis "wheel"
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_btr"
			speed(128) ;----------------------------------Max speed.
			speedatmaxturn(25) ;-------------------------Max speed at max turn. 
			reverse(85) ;--------------------------------Max speed in Reverse.
			weight(11.7) ;-------------------------------Weight in Tonnes.
			power(220) ;---------------------------------Horse Power.
			fuel(3600) ;----------------------------------Fuel capacity in Litres.
			type(diesel) ;-------------------------------Fuel type.
			range(5350) ;---------------------------------Range in Kilometers.
		)
	}

	{bone "gun_rot"
		{limits -7 23}
		{speed2 8}
	}
	{bone "turret"
		("turret_light" power_traverse(0)) ;// manual
	}
}