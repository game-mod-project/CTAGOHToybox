{game_entity
	(include "/properties/armoredcar__ctb_sdkfz234_3_57c9f1af.ext")
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props "td" "tank" "-turret" "mantlet" "vision_lev02" "muzzle_50mm_57mm" "shell_eject" "wheeled" "8_wheels" "with_gun" "open_top" "open_death_fx_low" "btr_large_ammo" "sq_he_medium"}
	{extension "crew.ext"}
	(include "sdkfz234_3.ext")
	{extension "sdkfz234_3.mdl"}
	{targetclass "armoredcar"}
	{targetSelector "tank_medium"}
	{patherId "sdkfz232"}

	{sensor
		{visor "main"
			{vision "recon_main"}
		}
		{visor "around"
			{vision "vehicle_around"}		;// better vision than a in-closed turret 
		}
	}

;	{extender "shield" {on}}

	{extender "inventory"
		{weapon "mgun" {mask "mountable"}}
		;{weapon "mgun2" {mask "mountable"}}
		{box
			{item "bulletger_75_l24 heatc" 110}		; 50 rounds
			{item "bulletger_75_l24 he" 110}
			{item "bulletger_75_l24 sm" 25}
			{item "ammo mgun_ger drum" 9750}		; 39 drums (50 rounds each)
			{item "mg42_drum_ctb_ger" filling "ammo mgun_ger drum" 100 {user "mgun"}}
			{item "geballteladung_3kg" 2}
		}
	}

	{Weaponry
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_k51_ctb_ger" filling "bulletger_75_l24 heatc" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(4.0)
				dispersion(0.20)
			)
		}
		{place "mgun"
			{type "coaxial"}
			{gunner "gunner"}
			{charger "charger"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
		}
		{##place "mgun2"
			{type "rear"}
			{gunner "gunner2"}
			{charger "gunner2"}
			{LinkBone "mgun2"}
			{LinkAnimation "off"}
			("abm_mgun")
			{ai_in_manual}
			{basic}
		}
	}

	{mass 11500}
	{Chassis "wheel"
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_btr"
			speed(120) ;----------------------------------Max speed.
			speedatmaxturn(25) ;-------------------------Max speed at max turn. 
			reverse(80) ;--------------------------------Max speed in Reverse.
			weight(11.5) ;-------------------------------Weight in Tonnes.
			power(220) ;---------------------------------Horse Power.
			fuel(3600) ;----------------------------------Fuel capacity in Litres.
			type(diesel) ;-------------------------------Fuel type.
			range(6000) ;---------------------------------Range in Kilometers.
		)
	}

	{bone "gun_rot"
		{limits -10 16}
		{speed2 6}
	}
	{bone "turret"
		{limits -20 20}
		{speed2 10}
	}
}