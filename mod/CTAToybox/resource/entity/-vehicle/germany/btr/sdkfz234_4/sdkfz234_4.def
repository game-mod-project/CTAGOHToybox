{game_entity
	(include "/properties/armoredcar__ctb_sdkfz234_4_8fa96337.ext")
	(include "/properties/selection/vehicle.inc" scale(1.1))
	{props "td" "tank" "-turret" "mantlet" "wheeled" "8_wheels" "with_gun" "vision_lev02" "muzzle_75mm_76mm_sides" "shell_eject" "open_top" "detect_td_medium" "open_death_fx" "btr_large_ammo" "sq_at_gun"}
	{extension "crew.ext"}
	(include "sdkfz234_4.ext")
	{extension "sdkfz234_4.mdl"}
	{targetclass "armoredcar"}
	{targetSelector "tank_medium"}
	{patherId "sdkfz232"}

	{sensor
		{visor "around"
			{vision "vehicle_around"}		;// better vision than a in-closed turret 
		}
	}

	{extender "shield" {on}}

	{extender "inventory"
		{weapon "mgun" {mask "mountable"}}
		{box
			{item "bulletger_75_l43 apcbche" 60}	; 36 rounds
			{item "bulletger_75_l43 he" 90}
			{item "bulletger_75_l43 heatc" 25}
			{item "ammo mgun_ger drum" 9750}		; 39 drums (50 rounds each)
			{item "mg42_drum_ctb_ger" filling "ammo mgun_ger drum" 100 {user "mgun"}}
			{item "geballteladung_3kg" 2}
		}
	}

	{Weaponry
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_pak40_ctb_ger" filling "bulletger_75_l43 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic_gun"
				zeroing(2.0)
				dispersion(0.35)
			)
		}
		{place "mgun"
			{type "aa"}
			{gunner "charger"}
			{charger "charger"}
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 12000}
	{Chassis "wheel"
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("car_trace" fx("tracewheel03") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
		("mobility_btr"
			speed(120) ;----------------------------------Max speed.
			speedatmaxturn(25) ;-------------------------Max speed at max turn. 
			reverse(80) ;--------------------------------Max speed in Reverse.
			weight(12.0) ;-------------------------------Weight in Tonnes.
			power(220) ;---------------------------------Horse Power.
			fuel(3600) ;----------------------------------Fuel capacity in Litres.
			type(diesel) ;-------------------------------Fuel type.
			range(6000) ;---------------------------------Range in Kilometers.
		)
	}

	{bone "gun_rot"
		{limits -5 22}
		{speed2 6}
	}
	{bone "turret"
		{limits -20 20}
		{speed2 8}
	}
	{bone "mgun_a_rot1"
		{speed2 60}
	}
	{bone "mgun_a_rot2"
		{speed2 60}
	}
}