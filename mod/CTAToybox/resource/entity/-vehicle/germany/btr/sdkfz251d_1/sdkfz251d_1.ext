;SDL

	; armor notes
	; tracks 15mm

	("armoredcar_tier1")

	("shield_track" args "shield1" 30)
	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")

	("fuel" args "fuel")
	("transmission" args "transmission")

	("tracks" repair(30) thickness(30))

	{volume "body1"		; Lower Hull
		{thickness 16
			{front 29}
		}
	}
	{volume "body2"		; Upper Hull
		{thickness 16
			{front 20}
		}
		{able {holed}}
	}
	{volume "engine1"	; Lower
		{thickness 16
			{front 29}
		}
	}
	{volume "engine2"	; Upper
		{thickness 16
			{front 29}
			{top 20}
		}
	}
	{volume "gun_shield" ; MG Shield
		{thickness 16}
	}
	{volume "doorl"
		{thickness 16}
	}
	{volume "doorr"
		{thickness 16}
	}

	{volume "hole3"
		{tags "sticky"}
	}

	{volume "armor1"	; side tool boxes
		{thickness 16}
	}
	{volume "armor2"	; side tool boxes
		{thickness 16}
	}

	{volume "detail11"	; side tool boxes
		{thickness 30}
	}

	{volume "trackleft1"
		{tags "mover" "track"}
		{able {NoWoundDecal} {holed} {contact_ground 0}}
	}
	{volume "trackright1"
		{tags "mover" "track"}
		{able {NoWoundDecal} {holed} {contact_ground 0}}
	}
