;Added {props "aa"}

{game_entity
	(include "/properties/armoredcar__ctb_sdkfz8_flak18_dcc7b4f8.ext")
	(include "/properties/selection/vehicle.inc" scale(1.4))
	{props "aa" "td" "tank" "halftrack" "wheeled" "shell_eject" "open_top" "turret" "with_gun" "vision_lev02" "muzzle_85mm_93mm" "tractor" "tractor_heavy" "detect_td_medium" "open_death_fx_low"}
	{extension "sdkfz8_flak18.mdl"}
	(include "sdkfz8_flak18.ext")
	{extension "crew.ext"}
	{targetclass "armoredcar"}
	{targetSelector "cannon_aa"}
	{patherId "sdkfz8"}

	{extender "enumerator"
		{digit_folder "np"}
	}

	{extender "inventory"
		{box
			{item "bulletger_88_l56 apcbche2" 70}	;40 rounds
			{item "bulletger_88_l56 he" 125}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "88mm_flak18_2_ctb_ger" filling "bulletger_88_l56 apcbche2" 1}
			{gunner "gunner gunner2" minWorkers 1}
			{charger "charger charger2" minWorkers 1}
			("abm_dymamic_td"
				zeroing(3.5)
				dispersion(0.25)
			)
		}
	}

	{mass 20000}
	{Chassis "wheel"
		("tank_trace" fx("tracks_mid") step(0.5) len(0.78) boneleft("FXtraceL2") boneright("FXtraceR2"))
		("car_trace" fx("tracewheel02") step(0.09) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
		("mobility_car"
			speed(60) ;----------------------------------Max speed.
			speedatmaxturn(15) ;-------------------------Max speed at max turn.
			reverse(25) ;--------------------------------Max speed in Reverse.
			weight(20.0) ;-------------------------------Weight in Tonnes.
			power(185) ;---------------------------------Horse Power.
			fuel(2500) ;----------------------------------Fuel capacity in Litres.
			type(fuel) ;---------------------------------Fuel type.
			range(1100) ;---------------------------------Range in Kilometers.
		)
	}

	{bone "gun_rot"
		{limits -3 85}
		{speed2 15}
	}
	{bone "turret"
		{limits -150 150}
		{speed2 15}
	}
}