{game_entity
	(include "/properties/vehicle_xx.ext")
	{extension "sdkfz250a_11_xx.mdl"}

	{volume "body1"		; Lower Hull
		{thickness 16}
	}

	{volume "body2"		; Upper Hull
		{thickness 16}
		{able {holed}}
	}

	{volume "body3"		; Upper Hull
		{thickness 16
			{front 20}
		}
		{able {holed}}
	}

	{volume "engine1"	; Lower
		{thickness 16
			{front 29}
		}
	}

	{volume "engine2"	; Upper
		{thickness 16
			{front 29}
			{top 12}
		}
	}

	{volume "door_back"
		{thickness 16}
		{able {obstacle 0}}
	}

	{volume "gun1"
		{thickness 40}
	}

	{volume "gun2"
		{thickness 40}
	}

	{volume "gun3"
		{thickness 40}
	}

	{volume "gun4"
		{thickness 40}
	}

	{volume "part3"		; engine cover
		{thickness 16}
	}

	{volume "part4"
	}

	{volume "shield1"
		{thickness 16}
	}

	{volume "shield2"
		{thickness 16}
	}

	{volume "wheelleft1"
		{thickness 1}
	}
	{volume "wheelright1"
		{thickness 1}
	}

	("tracks" thickness(30))

	{volume "trackleft3"
		{able {obstacle 0}}
	}
}
