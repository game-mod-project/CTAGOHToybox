;SDL

	; armor notes
	; tracks and wheels 30mm
	; gun 30mm

	("tank_heavy_tier1")

	("tracks" repair(40) thickness(90))
	("gun" repair(30) thickness(90))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("ammo" args "ammo4")
	("fuel" args "fuel1")
	("fuel" args "fuel2")
	("transmission" args "transmission")

	{volume "body1"			; Front Nose Armor
		{thickness 600}
	}
	{volume "body2"			; Front Hull
		{thickness 180
			{front 240}
			{rear 30}
			{bottom 150}
		}
	}
	{volume "body3"			; Front Superstructure
		{thickness 240
			{front 600}
			{top 90}
			{rear 30}
			{bottom 75}
		}
	}
	{volume "engine1"		; Hull
		{thickness 180
			{front 30}
			{rear 30}
			{bottom 60}
		}
	}
	{volume "engine2"		; Superstructure
		{thickness 240
			{front 30}
			{top 240}
			{rear 30}
			{bottom 75}
		}
	}
	{volume "body4"			; Rear Hull
		{thickness 180
			{rear 240}
			{bottom 60}
		}
	}
	{volume "body5"			; Rear Superstructure
		{thickness 240
			{rear 240}
			{bottom 75}
		}
	}
	{volume "body6"			; Top Superstructure
		{thickness 240
			{front 600}
			{top 90}
		}
	}
	{volume "mantlet1"		; Front Mantlet
		{thickness 375
			{front 750}
		}
		{CastSteel 0.8063}
	}
	{volume "mantlet2"		; Ball Joint
		{thickness 375}
		{CastSteel 0.8063}
	}

	{volume "armor1" {thickness 180}} ;// Gun Shield
	{volume "armor2" 
		{thickness 240}
		{able {holed}}
	} ;// Mantlet Shield