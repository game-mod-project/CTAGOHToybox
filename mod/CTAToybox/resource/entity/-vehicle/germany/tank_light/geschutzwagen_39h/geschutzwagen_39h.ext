;SDL

	; armor notes
	; tracks and wheels 15mm
	; gun 20mm

	;// Defines
	("tank_light_tier2")
	("tracks" repair(30) thickness(30))
	("gun" repair(30) thickness(50))
	("fuel" args "fuel1")
	("fuel" args "fuel2")
	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("transmission" args "transmission1")
	("transmission" args "transmission2")
	("shield_group" args "tshield1"  20 "shieldt") ;// Rear
	("shield_group" args "tshield2"  20 "shieldt") ;// Rear
	("shield_group" args "tshield3"  20 "shieldt") ;// Rear
	("shield_group" args "tshield4"  40 "shieldt")
	("shield_group" args "tshield5"  40 "shieldt")
	("shield_group" args "tshield6"  40 "shieldt")
	("shield_group" args "tshield7"  40 "shieldt")
	("shield_group" args "tshield8"  40 "shieldt")
	("shield_group" args "tshield9"  40 "shieldt")
	("shield_group" args "tshield10" 20 "shieldt") ;// Rear
	("shield_group" args "tshield11" 20 "shieldt") ;// Rear
	("shield_group" args "gun_shield1"  40 "gun_shield")
	("shield_group" args "gun_shield2"  40 "gun_shield")
	("shield_group" args "gun_shield3"  40 "gun_shield")
	("shield" args "shield1" 40)
	("shield" args "shield2" 40)

	;// Components
	{volume "body1" ;// Lower Front Hull
		{thickness 80
			{top 24}
			{bottom 40}
		}
	}
	{volume "body2" {thickness 68}} ;// Left Frontal Wheel Cover
	{volume "body3" {thickness 68}} ;// Right Frontal Wheel Cover
	{volume "body4"  ;// Upper Front Hull
		{thickness 80
			{top 44}
			{bottom 40}
		}
	}
	{volume "body5" ;// Superstructure
		{thickness 80
			{top 44}
			{bottom 40}
		}
	}
	{volume "body6" ;// Upper Plate, directly frontal plate in front of driver
			{thickness 80
				{top 44}
				{bottom 40}
			}
		}
	{volume "body7" ;// Left Superstructure Plane
		{thickness 80
			{top 44}
			{bottom 40}
		}
	}
	{volume "body8" ;// Right Superstructure Plane
		{thickness 80
			{top 44}
			{bottom 40}
		}
	}
	{volume "engine1" {thickness 80 {top 44} {bottom 40}} {able {holed}}} ;// Intenrally behind shields
	{volume "engine2" {thickness 80 {top 44} {bottom 40}} {able {holed}}}

	;// Shields
	{volume "tshield1" {tags "gun_shield"}}
	{volume "tshield2" {tags "gun_shield"}}
	{volume "tshield3" {tags "gun_shield"}}
	{volume "tshield4" {tags "gun_shield"}}
	{volume "tshield5" {tags "gun_shield"}}
	{volume "tshield6" {tags "gun_shield"}}
	{volume "tshield7" {tags "gun_shield"}}
	{volume "tshield8" {tags "gun_shield"}}
	{volume "tshield9" {tags "gun_shield"}}
	{volume "tshield10" {tags "gun_shield"}}
	{volume "tshield11" {tags "gun_shield"}}
	{volume "shield1" {tags "gun_shield"} {able {holed}}}
	{volume "shield2" {tags "gun_shield"}}
	{volume "gun_shield3" {able {holed}}}