;SDL
	; armor notes
	; tracks and wheels 15mm
	; gun 15mm
	; spare tracks 15mm

	("tank_light_tier2")

	("shield_track" args "detail1" 30)
	("shield_track" args "detail2" 30)
	("shield_group" args "tshield1" 20 "shieldt")
	("shield_group" args "tshield2" 20 "shieldt")
	("shield_group" args "tshield3" 20 "shieldt")
	("shield_group" args "tshield4" 20 "shieldt")
	("shield_group" args "tshield5" 20 "shieldt")
	("shield_group" args "tshield6" 20 "shieldt")
	("shield_group" args "tshield7" 20 "shieldt")
	("shield_group" args "tshield8" 20 "shieldt")
	("shield_group" args "tshield9" 20 "shieldt")
	("shield_group" args "tshield10" 20 "shieldt")

	("tracks" repair(30) thickness(30))
	("gun" repair(30) thickness(30))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("fuel" args "fuel")
	("transmission" args "transmission")
	
	{volume "body1"			; Hull and Superstructure Front Half
		{thickness 30
			{front 30}
			{top 20}		; Glacis
			{rear 12}
			{bottom 16}
		}
	}
	{volume "body2"			; Driver's Cabin
		{thickness 30
			{top 16}
		}
	}
	{volume "body3"			; Hull Rear Half
		{thickness 30
			{front 12}
			{top 12}
			{rear 20}
			{bottom 16}
		}
	}
	{volume "body4"			; Super Superstructure Rear Half
		{thickness 30
			{top 16}
			{front 12}
			{bottom 16}
		}
		{able {holed}}
	}
	{volume "engine1"		; Lower Half
		{thickness 30
			{front 12}
			{top 12}
			{rear 12}
			{bottom 16}
		}
	}
	{volume "engine2"		; Upper Half
		{thickness 30
			{front 12}
			{top 16}
			{rear 12}
			{bottom 16}
		}
	}

	{volume "tshield1"
		{tags "gun_shield"}
	}
	{volume "tshield2"
		{tags "gun_shield"}
	}
	{volume "tshield3"
		{tags "gun_shield"}
	}
