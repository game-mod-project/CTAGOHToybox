;SDL
	
	; armor notes
	; tracks and wheels 15mm
	; gun 25mm

	("tank_light_tier1")

	("shield_group" args "gun_shield1" 16 "gun_shield")
	("shield_group" args "gun_shield2" 16 "gun_shield")
	("shield_group" args "gun_shield3" 16 "gun_shield")
	("shield_group" args "gun_shield4" 16 "gun_shield")
