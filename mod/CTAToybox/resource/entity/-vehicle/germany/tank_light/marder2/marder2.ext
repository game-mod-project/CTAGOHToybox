	("shield_group" args "tshield2" 20 "shieldt")
	("shield_group" args "tshield3" 20 "shieldt")
	("shield_group" args "tshield4" 20 "shieldt")

	("tracks" repair(30) thickness(30))
	("gun" repair(30) thickness(50))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("fuel" args "fuel")
	("transmission" args "transmission")

	{volume "body1"			; Hull
		{thickness 29
			{front 70}
			{top 29}		; Glacis
			{rear 10}
			{bottom 10}
		}
		{able {holed}}
	}
	{volume "body2"			; Superstructure
		{thickness 29
			{front 60}
			{top 20}
			{bottom 10}
		}
	}
	{volume "body3"			; Ammo protection
		{thickness 20}
	}
	{volume "engine1"		; Hull
		{thickness 29
			{front 10}
			{top 20}
			{bottom 10}
		}
	}
	{volume "detail1"
		{thickness 20}
		{material "wood"}
	}
	{volume "detail2"
		{thickness 20}
		{material "wood"}
	}
	{volume "detail3"
		{thickness 1}
		{material "fabric"}
		{able {visible 0}{NoWoundDecal}}
	}
	{volume "armor1"
		{thickness 20}
	}
