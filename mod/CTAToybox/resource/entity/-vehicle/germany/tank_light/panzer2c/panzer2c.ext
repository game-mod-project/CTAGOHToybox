;SDL

	; armor notes
	; tracks and wheels 15mm
	; gun 15mm

	("tank_light_tier1")

	("tracks" repair(30) thickness(30))
	("gun" repair(30) thickness(30))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("fuel" args "fuel")
	("transmission" args "transmission")

	{volume "body1"			; Hull
		{thickness 29
			{front 29} 	; 14.5mm base
			{top 29}		; Glacis
			{rear 10}
			{bottom 10}
		}
	}
	{volume "body2"			; Superstructure
		{thickness 29
			{front 29} 	; 14.5mm base
			{top 20}
			{bottom 20}
		}
	}
	{volume "engine1"		; Hull
		{thickness 29
			{front 10}
			{bottom 10}
		}
	}
	{volume "engine2"		; Superstructure
		{thickness 29
			{front 10}
			{top 20}
			{bottom 10}
		}
	}
	{volume "turret1"		; Main Turret
		{thickness 29
			{front 29}
			{top 20}
		}
	}
	{volume "turret2"		; Front Lower Cheek
