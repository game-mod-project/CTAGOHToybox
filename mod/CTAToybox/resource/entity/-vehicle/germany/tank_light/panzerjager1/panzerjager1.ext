;SDL

	; armor notes
	; tracks and wheels 15mm
	; gun 20mm
	; spare tracks 15mm

	("tank_light_tier1")

	("shield_track" args "shield1" 30)
	("shield_track" args "shield2" 30)
	("shield" args "gun_shield" 16)
	("shield_group" args "tshield1" 29 "shieldt")
	("shield_group" args "tshield2" 29 "shieldt")
	("shield_group" args "tshield3" 29 "shieldt")

	("tracks" repair(30) thickness(30))
	("gun" repair(30) thickness(40))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("fuel" args "fuel")
	("transmission" args "transmission")

	{volume "body"			; Hull
		{thickness 26
			{top 16}			; Glacis
			{rear 10}
			{bottom 10}
		}
		{able {holed}}
	}
	{volume "body1"			; Superstructure
		{thickness 26
			{top 10}
			{rear 16}
			{bottom 10}
		}
		{able {holed}}
	}
	{volume "body2"			; Superstructure
		{thickness 26
			{front 16}
			{rear 16}
			{bottom 10}
		}
	}
	{volume "engine1"		; Hull
		{thickness 26
			{front 10}
			{top 10}
			{bottom 10}
		}
	}
	{volume "engine2"		; Superstructure
		{thickness 26
			{front 10}
			{top 16}
			{bottom 10}
		}
	}
	{Volume "tshield1"			; Superstructure
		{tags "gun_shield"}
	}
	{Volume "tshield2"			; Superstructure
		{tags "gun_shield"}
		{able {holed}}
	}
	{Volume "tshield3"			; Superstructure
		{tags "gun_shield"}
	}
	{Volume "1"
		{thickness 2}
	}
	{Volume "2"
		{thickness 2}
	}
	{Volume "3"
		{thickness 2}
	}