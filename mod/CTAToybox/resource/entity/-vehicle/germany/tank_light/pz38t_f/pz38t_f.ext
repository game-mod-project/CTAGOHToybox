;SDL
	
	; armor notes
	; tracks and wheels 15mm
	; gun 15mm
	; spare tracks 15mm
	; 25mm & 15mm plates were add to the hull, superstructure and turret.

	("tank_light_tier1")

	("shield_track" args "shieldL1" 30)
	("shield_track" args "shieldL2" 30)
	("shield_track" args "shieldR1" 30)
	("shield" args "shieldw1" 30)
	("shield" args "shieldw2" 30)

	("tracks" repair(30) thickness(30))
	("gun" repair(30) thickness(30))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("ammo" args "ammo4")
	("fuel" args "fuel1")
	("fuel" args "fuel2")
	("transmission" args "transmission")

	{volume "body1"			; Hull
		{thickness 30
			{front 100}		; 25mm base + 25mm plate
			{top 24}		; Glacis
			{rear 16}
			{bottom 16}
		}
	}
	{volume "body2"			; Superstructure
		{thickness 
			{front 100}		; 25mm base + 25mm plate
			{top 16}
			{left 60}		; 15mm base + 15mm plate
			{right 60}		; 15mm base + 15mm plate
			{rear 30}
			{bottom 16}
		}
	}
	{volume "engine1"		; Hull
		{thickness 30
			{front 16}
			{top 16}
			{bottom 16}
		}
	}
	{volume "engine2"		; Superstructure
		{thickness 30
			{front 16}
			{top 20}
			{bottom 16}
		}
	}
	{volume "turret"		; Front side (box shape)
		{thickness 60
			{front 100}		; 25mm base + 25mm plate
			{top 24}
			{rear 24}
			{bottom 60}
		}
	}
	{volume "turret1"		; Front half
		{thickness 60
			{top 24}
			{rear 24}
			{bottom 24}
		}
	}
	{volume "turret2"		; Rear half
		{thickness 60
			{front 16}
			{top 24}
			{rear 50}
			{bottom 16}
		}
	}
	{volume "mantlet1"
		{thickness 50}
	}
	{volume "mantlet2"
		{thickness 50}
	}
	{volume "cupola"
		{thickness 30
			{top 16}
		}
	}
	{component "shieldw1" {tags "cut_part"}}
	{component "shieldw2" {tags "cut_part"}}
