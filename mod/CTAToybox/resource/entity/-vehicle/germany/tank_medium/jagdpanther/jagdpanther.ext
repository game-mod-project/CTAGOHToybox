;SDL
	
	; armor notes
	; tracks and wheels 20mm
	; gun 30mm
	; spare tracks 20mm
	; schürzen 5mm

	("tank_heavy_tier1")

	("shield_track" args "shield1" 50)
	("shield_track" args "shield2" 50)

	("shield_tear" args "shieldl1" 13)
	("shield_tear" args "shieldl2" 13)
	("shield_tear" args "shieldl3" 13)
	("shield_tear" args "shieldl4" 13)
	("shield_tear" args "shieldl5" 13)
	("shield_tear" args "shieldr1" 13)
	("shield_tear" args "shieldr2" 13)
	("shield_tear" args "shieldr3" 13)
	("shield_tear" args "shieldr4" 13)
	("shield_tear" args "shieldr5" 13)

	("tracks" repair(30) thickness(50))
	("gun" repair(30) thickness(75))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("ammo" args "ammo4")
	("fuel" args "fuel1")
	("fuel" args "fuel2")
	("fuel" args "fuel3")
	("fuel" args "fuel4")
	("transmission" args "transmission")

	{volume "body1"			; Hull
		{thickness 100
			{front 125}		; Lower Nose
			{top 200}		; Glacis
			{rear 25}
			{bottom 63}
		}
	}
	{volume "body2"			; Superstructure Bottom
		{thickness 125
			{front 200}		; Glacis
			{rear 25}
			{bottom 100}		; Overhang (above tracks)
		}
	}
	{volume "body3"			; Superstructure Top
		{thickness 125
			{front 200}		; Glacis 
			{top 63}
			{rear 100}
		}
	}
	{volume "engine1"		; Hull
		{thickness 100
			{front 25}
			{bottom 40}
		}
	}
	{volume "engine2"		; Superstructure
		{thickness 125
			{front 25}
			{top 63}
			{rear 100}
		}
	}
	{volume "mantlet"
		{thickness 300
			{front 625}
		}
	}
	{volume "mantlet1"
		{thickness 175}
	}
	{volume "mg_port"
		{thickness 200}
		{component "body"}
	}