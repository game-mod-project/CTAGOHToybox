{game_entity
	(include "/properties/tank_assaultgun__ctb_jagdpanzer4_l48_early_5f542e61.ext")
	(include "/properties/selection/vehicle_elongated.inc" scale(1.1))
	{props "jagdpanzer4_l48" "td" "medium" "-turret" "smoke" "nvw" "vision_lev03" "muzzle_75mm_76mm_sides" "shield" "sq_at_gun"}
	{extension "jagdpanzer4_l48_early.mdl"}
	(include "jagdpanzer4_l48_early.ext")
	{PatherId "panzer3"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}

	{extender "enumerator"
		{digit_folder "ger"}
	}

	{texmod "camo2"}

	("crew_4_human")

	{boarder
		{anm "left"
			{forward {begin "board_tank_left"} {end "pose_mgun_pz6"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "right"
			{forward {begin "board_tank_left"} {end "pose_mgun_pz6"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_2"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor1"
			{forward {begin "board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor2"
			{forward {begin "board_lowArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor2))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor1))

	{sensor
		{visor "main"
			{bone "visor1"}
		}
		{visor "around"
			{bone "visor"}
		}
	}

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		{box
			{item "bulletger_75_l43 apcbche" 210} 	; 79 rounds
			{item "bulletger_75_l43 he" 135}
			{item "bulletger_75_l43 apcr" 10}
			{item "bulletger_75_l43 heatc" 40}
			{item "ammo mgun_ger belt" 5250}		; 8 belts (150 rounds each)
			{item "geballteladung_3kg" 2}
			{item "nbks grenade" 12}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_pak39_ctb_ger" filling "bulletger_75_l43 apcbche" 1}
			{gunner "gunner"}
			{charger "charger commander" minWorkers 1}
			("abm_dymamic_td"
				zeroing(2.25)
				dispersion(0.25)
			)
		}
		{place "mgun1"
			{type "hull"}
			{weapon "mg42_tank_ctb_ger" filled}
			{foresight "foresight4"}
			{gunner "charger"}
			{charger "charger"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
	}

	{mass 24000}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(-0.5))
		("mobility_tank"
			speed(60) ;----------Max speed when fully accelerated on road, km/h.
			reverse(8) ;---------Max speed in reverse on road, km/h.
			traverse(30) ;-------Track traverse, per second, in degrees.
			weight(24) ;---------Weight in Tonnes.
			power(265) ;---------Engine Power, in hp. //engine under normal use was rated 265hp at 2600 rpm
			track(5) ;-----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(4700) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(1300) ;---------Range in km, off-road.
		)
	}

	{bone "gun_rot"
		{limits -8 15}
		{speed2 6}
	}
	{bone "turret"
		{limits -15 12}
		{speed2 8}
	}
}
