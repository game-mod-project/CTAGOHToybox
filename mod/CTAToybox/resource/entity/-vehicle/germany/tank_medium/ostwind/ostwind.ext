;SDL

	; armor notes
	; tracks and wheels 20mm
	; gun 20mm
	; 30mm plates were add to the hull, superstructure front.

	("tank_medium_tier2")

	("tracks" repair(30) thickness(50))
	("gun" repair(30) thickness(50))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("ammo" args "ammo4")
	("ammo" args "ammo5")
	("fuel" args "fuel")
	("transmission" args "transmission")

	("shield_track" args "shield1" 50)
	("shield_track" args "shield2" 50)
	("shield" args "shield3" 50)
	("shield" args "shield4" 50)

	{volume "body1"			; Hull
		{thickness 75
			{front 200}		; 50mm base + 30mm plate
			{top 50}		; Glacis
			{rear 25}
			{bottom 25}
		}
	}
	{volume "body2"			; Superstructure
		{thickness 75
			{front 200}		; 50mm base + 30mm plate
			{top 30}
			{rear 25}
		}
	}
	{volume "engine1"
		{thickness 75
			{front 25}
			{rear 50}
			{bottom 25}
		}
	}
	{volume "engine2"
		{thickness 75
			{front 25}
			{top 25}
			{rear 50}
		}
	}
	{volume "turret1"	;main
		{thickness 63}
		{able {holed}}
	}
	{volume "turret2"	;ring
		{thickness 63}
	}

	{component "shield1" {tags "cut_part"}}