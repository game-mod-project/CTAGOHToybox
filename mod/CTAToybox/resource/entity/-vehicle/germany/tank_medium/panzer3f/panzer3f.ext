			{front 75}
			{top 63}		; Glacis
			{rear 25}
			{bottom 40}
		}
	}

	{volume "body2"			; Superstructure
		{thickness 75
			{top 40}
			{rear 25}
		}
	}

	{volume "engine"
		{thickness 75
			{front 25}
			{top 40}
			{rear 50}
			{bottom 40}
		}
	}

	{volume "turret1"
		{thickness 75
			{top 25}
		}
	}

	{volume "turret2"
		{thickness 75}
	}

	{volume "mantlet1"
		{thickness 50
			{front 75}
		}
	}


	{volume "cupola"
