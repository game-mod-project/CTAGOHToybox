;SDL
	
	; armor notes
	; tracks and wheels 20mm
	; gun 20mm
	; spare tracks 20mm 
	; hull/turret front spaced armor 20mm
	; schürzen 5mm

	("tank_medium_tier1")

	("shield_track" args "shield3" 50)
	("shield_track" args "shield4" 50)
	("shield" args "shieldl1" 13)
	("shield" args "shieldl2" 13)
	("shield" args "shieldl3" 13)
	("shield" args "shieldl4" 13)
	("shield" args "shieldl5" 13)
	("shield" args "shieldr1" 13)
	("shield" args "shieldr2" 13)
	("shield" args "shieldr3" 13)
	("shield" args "shieldr4" 13)
	("shield" args "shieldr5" 13)

	("shield_group" args "shieldt" 13 "shieldt")
	("shield_group" args "shieldt1" 13 "shieldt")
	("shield_group" args "shieldt2" 13 "shieldt")
	("shield_group" args "shieldt3" 13 "shieldt")
	("shield_group" args "shieldt4" 13 "shieldt")
	("shield_group" args "shieldt5" 13 "shieldt")
	("shield_group" args "shieldt6" 13 "shieldt")
	("shield_group" args "shieldt7" 13 "shieldt")

	("tracks" repair(30) thickness(50))
	("gun" repair(30) thickness(50))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("fuel" args "fuel")
	("transmission" args "transmission")

	{volume "body1"			; Hull
		{thickness 75
			{front 125}
			{top 63}		; Glacis
			{rear 25}
			{bottom 40}
		}
	}
	{volume "body2"			; Superstructure
		{thickness 75
			{front 125}
			{top 40}
			{rear 25}
		}
	}
	{volume "engine"
		{thickness 75
			{front 25}
			{top 40}
			{rear 125}
			{bottom 40}
		}
	}
	{volume "turret"
		{thickness 75
			{front 125}
			{top 25}
		}
	}
	{volume "turret1"
		{thickness 125}
	}
	{volume "mantlet1"
		{thickness 75
			{front 125}
		}
		{tags "gun"}
		{component "gun"}
	}
	{volume "cupola"
		{thickness 125
			{top 25}
		}
	}
	{volume "basket"
		{thickness 13}
	}
	{volume "armor_mantlet"
		{thickness 50}
		{tags "armor"}
	}
	{volume "armor_hull"
		{thickness 50}
		{able {holed}}
		{tags "armor"}
	}

	{component "shieldl1" {tags "cut_part"}}
	{component "shieldl2" {tags "cut_part"}}
	{component "shieldl3" {tags "cut_part"}}
	{component "shieldl4" {tags "cut_part"}}
	{component "shieldl5" {tags "cut_part"}}
	{component "shieldr1" {tags "cut_part"}}
	{component "shieldr2" {tags "cut_part"}}
	{component "shieldr3" {tags "cut_part"}}
	{component "shieldr4" {tags "cut_part"}}
	{component "shieldr5" {tags "cut_part"}}
