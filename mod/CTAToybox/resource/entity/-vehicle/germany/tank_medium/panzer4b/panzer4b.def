{game_entity
	(include "/properties/tank__ctb_panzer4b_eca2bec6.ext")
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props "medium" "vision_lev04" "muzzle_50mm_57mm" "smoke" "nkav" "sq_armor_medium"}
	{extension "panzer4b.mdl"}
	(include  "panzer4b.ext")
	{PatherId "panzer3"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{extender "enumerator"
		{digit_folder "ger"}
	}

	("crew_5_human_extended2")

	{boarder
		{anm "driver"
			{forward	{begin	"board_pz4_driver"} {end "seat_commander_hatch"} {base "open_driver"}}
			{reverse 	{end	"board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "co_driver"
			{forward	{begin	"board_lowarmor"} {end "seat_commander_hatch"} {base "open_co_driver"}}
			{reverse 	{end	"board_lowarmor" -1} {base "open_co_driver" -1}}
		}
		{anm "left"
			{forward	{begin	"board_cromwell"} {end "seat_commander_hatch"}}
			{reverse 	{end	"board_cromwell" -1}}
		}
		{anm "right"
			{forward	{begin	"board_cromwell"} {end "seat_commander_hatch"}}
			{reverse 	{end	"board_cromwell" -1}}
		}
		{anm "armor1"
			{forward {begin "board_lowarmor"} {end "pose_seat_passenger_unic304f_02"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor2"
			{forward {begin "board_lowarmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_2"}}
		}
		{anm "armor3"
			{forward	{begin	"board_MiddleArmor"} {end "pose_seat_armor_1"}}
			{reverse 	{end	"emit_tank_1"}}
		}
		{anm "armor4"
			{forward {begin "board_lowarmor"} {end "pose_seat_armor_2"}}
			{reverse {end "emit_tank_2"}}
		}
	}

	("seat_human" place(seat1) bone(seat1) door(emit4)  animation(armor3))
	("seat_human" place(seat2) bone(seat2) door(emit5)  animation(armor2))
	("seat_human" place(seat3) bone(seat3) door(emit6)  animation(armor1))
	("seat_human" place(seat4) bone(seat4) door(emit7)  animation(armor4))

	{extender "smokescreen"
		{cooldown 5}
		{itemTags "grenade nbks"}
	}

	{extender "inventory"
		{box
			{item "bulletger_75_l24 apcbche" 175} 		; 80 rounds
			{item "bulletger_75_l24 he" 200}
			{item "bulletger_75_l24 sm" 20}
			{item "ammo mgun_ger belt" 12750}		; 36 drums (75 rounds each)
			{item "geballteladung_3kg" 2}
			{item "nbks grenade" 10}
		}
	}

	{Weaponry
		("restore_ik_time")
		{place "gun"
			{RestoreIKAfterAim}
			{weapon "75mm_kwk37_ctb_ger" filling "bulletger_75_l24 apcbche" 1}
			{gunner "gunner"}
			{charger "charger"}
			("abm_dymamic"
				zeroing(4.0)
				dispersion(0.20)
			)
		}
		{place "mgun2"
			{type "coaxial"}
			{weapon "mg34_tank_early_ctb_ger" filled}
			{foresight "foresight5"}
			{gunner "gunner"}
			{charger "charger gunner3" minWorkers 1} ;// done to keep gunner3 from emitting
			("abm_mgun")
			{basic}
		}
	}

	{mass 18500}
	{Chassis
		("tank_trace" fx("tracks_mid") step(0.52) len(-0.45))
		("mobility_tank"
			speed(63) ;----------Max speed when fully accelerated on road, km/h.
			reverse(5.8) ;---------Max speed in reverse on road, km/h.
			traverse(32) ;-------Track traverse, per second, in degrees.
			weight(18.5) ;-------Weight in Tonnes.
			power(265) ;---------Engine Power, in hp. //engine under normal use was rated 265hp at 2600 rpm
			track(4.5) ;---------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(4700) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(1300) ;---------Range in km, off-road.
		)
	}

	{bone "gun_rot"
		{limits -10 20}
		{speed2 6}
	}
	{bone "turret"
		("turret_medium" power_traverse(16))
	}
}