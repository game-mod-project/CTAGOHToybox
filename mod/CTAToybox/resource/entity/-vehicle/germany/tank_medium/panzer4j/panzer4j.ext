;SDL
	
	; armor notes
	; tracks and wheels 20mm
	; gun 25mm
	; spare tracks 20mm
	; schürzen 5mm

	("tank_medium_tier2")

	("shield" args "shield1" 50)
	("shield" args "shield2" 50)
	("shield_track" args "shield3" 50)
	("shield_track" args "shield4" 50)
	("shield_track" args "shield5" 50)
