;SDL
	
	; armor notes
	; tracks and wheels 20mm
	; gun 25mm
	; spare tracks 20mm
	; schürzen 5mm

	("tank_heavy_tier1")

	("shield_track" args "detail7" 50)
	("shield_track" args "detail6" 50)
	("shield_track" args "detail8" 50)
	("shield_track" args "detail16" 50)
	("shield_track" args "detail17" 50)
	("shield_track" args "detail18" 50)
	("shield_track" args "detail19" 50)
	("shield_track" args "turret_armor1" 50)
	("shield_track" args "turret_armor2" 50)
	("shield_track" args "turret_armor3" 50)
	("shield_track" args "turret_armor4" 50)
	("shield_track" args "turret_armor5" 50)
	("shield" args "detail9" 50)
	("shield" args "detail15" 50)
	
	("shield" args "fenderl" 13)
	("shield" args "shieldl2" 13)
	("shield" args "shieldl3" 13)
	("shield" args "shieldl4" 13)
	("shield" args "shieldl5" 13)
	("shield" args "shieldl6" 13)
	("shield" args "shieldl7" 13)

	("shield" args "fenderr" 13)
	("shield" args "shieldr2" 13)
	("shield" args "shieldr3" 13)
	("shield" args "shieldr4" 13)
	("shield" args "shieldr5" 13)
	("shield" args "shieldr6" 13)
	("shield" args "shieldr7" 13)


	("tracks" repair(30) thickness(50))
	("gun" repair(30) thickness(63))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("ammo" args "ammo4")
	("fuel" args "fuel1")
	("fuel" args "fuel2")
	("fuel" args "fuel3")
	("fuel" args "fuel4")
	("transmission" args "transmission")

	{volume "body1"			; Hull
		{thickness 100
			{front 150}		; Lower Nose
			{top 200}		; Glacis
			{rear 40}
			{bottom 40}
		}
	}
	{volume "body2"			; Superstructure
		{thickness 100
			{front 200}
			{top 40}
			{rear 40}
			{bottom 40}
		}
	}
	{volume "body3"			; Hull MG
		{thickness 200}
		{tags "mg_port"}
	}
	{volume "engine1"
		{thickness 100
			{front 40}
			{top 40}
			{bottom 40}
		}
	}
	{volume "engine2"
		{thickness 100
			{front 40}
			{top 40}
			{bottom 40}
		}
	}
	{volume "turret"
		{thickness 113
			{front 250}
			{top 40}
		}
	}
	{volume "turret2"
		{thickness 113
			{front 275}		;  behind mantlet hole
			{top 250}
			{bottom 250}
		}
	}
	{volume "mantlet"
		{thickness 250}
		{CastSteel 0.8063}
		{component "turret"}
		{tags "turret"}
	}
	{volume "mantlet2"
		{thickness 250}
		{CastSteel 0.8063}
		{component "gun"}
		{tags "gun"}
	}
	{volume "cupola"
		{thickness 200
			{top 40}
		}
		{CastSteel 0.8063}
	}

