;SDL
	
	; armor notes
	; tracks and wheels 20mm
	; gun 25mm
	; spare tracks 20mm
	; schürzen 5mm

	("tank_medium_tier2")

	("shield_track" args "shield1" 50)
	("shield_track" args "shield2" 50)

	("shield" args "shieldl1" 13)
	("shield" args "shieldl2" 13)
	("shield" args "shieldl3" 13)
	("shield" args "shieldl4" 13)
	("shield" args "shieldr1" 13)
	("shield" args "shieldr2" 13)
	("shield" args "shieldr3" 13)
	("shield" args "shieldr4" 13)

	("tracks" repair(30) thickness(50))
	("gun" repair(30) thickness(63))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("fuel" args "fuel")
	("transmission" args "transmission")

	{volume "body1"			; Hull
		{thickness	75
			{front 200}		; 50mm base + 30mm plate
			{top 63}		; Glacis
			{rear 25}
			{bottom 38}
		}
	}
	{volume "body2"			; Superstructure
		{thickness 75
			{front 125}
			{right 48}		; Overhang (above tracks)
		}
		{able {holed}}
	}
	{volume "body3"			; Superstructure Top
		{thickness 25
			{front 125}
			{rear 75}
		}
	}
	{volume "body4"			; Superstructure Front
		{thickness 75
			{front 200}		; 50mm base + 30mm plate
		}
		{able {holed}}
	}
	{volume "engine"		; Hull 
		{thickness 75
			{front 25}
			{top 40}
			{rear 125}
			{bottom 38}
		}
	}
	{volume "mantlet"
		{thickness 125}
		{tags "armor"}
	}
	{volume "mantlet1"
		{thickness 125
			{front 200}
		}
		{tags "gun"}
		{component "gun"}
	}
	{volume "cupola"
		{thickness 75
			{top 25}
		}
	}
	{volume "mgunshield"
		{thickness 15}
		{able {holed}}
	}

	{component "shield1" {tags "cut_part"}}
	{component "shieldl1" {tags "cut_part"}}
	{component "shieldl2" {tags "cut_part"}}
	{component "shieldl3" {tags "cut_part"}}
	{component "shieldl4" {tags "cut_part"}}
	{component "shieldr1" {tags "cut_part"}}
	{component "shieldr2" {tags "cut_part"}}
	{component "shieldr3" {tags "cut_part"}}
	{component "shieldr4" {tags "cut_part"}}