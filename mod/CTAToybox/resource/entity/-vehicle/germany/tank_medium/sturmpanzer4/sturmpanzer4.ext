;SDL
	
	; armor notes
	; tracks and wheels 20mm
	; gun 30mm
	; schürzen 5mm

	("tank_medium_tier2")

	("shield" args "shield1" 50)
	("shield" args "shield2" 50)

	("shield" args "shieldl1" 13)
	("shield" args "shieldl2" 13)
	("shield" args "shieldl3" 13)
	("shield" args "shieldl4" 13)
	("shield" args "shieldl5" 13)
	("shield" args "shieldr1" 13)
	("shield" args "shieldr2" 13)
	("shield" args "shieldr3" 13)
	("shield" args "shieldr4" 13)
	("shield" args "shieldr5" 13)

	("tracks" repair(30) thickness(50))
	("gun" repair(30) thickness(75))

	("ammo" args "ammo1")
	("ammo" args "ammo2")
	("ammo" args "ammo3")
	("fuel" args "fuel")
	("transmission" args "transmission")

	{Volume "body1"			; Hull
		{thickness 75
			{front 200}		; Nose
			{top 50}		; Glacis
			{left 150}		; Bottom Nose
			{rear 25}
			{bottom 25}
		}
	}
	{Volume "body2"			; Superstructure
		{thickness 125
			{front 250}		; Front
			{left 150}		; Angled Front Sides 
			{top 50}
			{rear 75}
			{bottom 63}
		}
	}
	{Volume "body3"			; Driver Box
		{thickness 100
			{front 250}
			{top 63}
		}
	}
	{Volume "engine1"		; Hull
		{thickness 75
			{front 25}
			{top 38}		; Lower Angled Rear
			{rear 50}
			{bottom 25}
		}
	}
	{Volume "engine2"		; Superstructure
		{thickness 75
			{front 25}
			{top 25}
			{rear 50}
			{bottom 13}
		}
	}
	{Volume "mantlet"		; Cast Armor
		{thickness 625}
		{CastSteel 0.8063}
	}
	{volume "mgun_shield1"
		{thickness 15}
	}
	{volume "mgun_shield2"
		{thickness 15}
	}

	{component "shieldl1" {tags "cut_part"}}
	{component "shieldl2" {tags "cut_part"}}
	{component "shieldl3" {tags "cut_part"}}
	{component "shieldl4" {tags "cut_part"}}
	{component "shieldl5" {tags "cut_part"}}
	{component "shieldr1" {tags "cut_part"}}
	{component "shieldr2" {tags "cut_part"}}
	{component "shieldr3" {tags "cut_part"}}
	{component "shieldr4" {tags "cut_part"}}
	{component "shieldr5" {tags "cut_part"}}