actor
(include "abm.inc")
(include "mobility.inc")
(include "vehicle.ext")
(include "armor.ext")
(include "tank_crew.ext")

{collider "tank.medium"}
{props "tank" "hatch" "engine"}
{PatherID "tank"}

("brain_vehicle")

{hearingBias 2.0} 	;// reduces units ability to hear sound signals. value = meters

{sensor
	{visor "main"
		{vision "tank_range_200"}
		{bone "foresight1"}
	}
	{Visor "driver"
		{vision "tank_driver"}
		{bone "visor2"}
	}
	{visor "around"
		{vision "ctb_tank_medium"}
		{bone "visor1"}
	}
	{visor "human"
		{vision "human"}
		{bone "visor3"}
	}
	{visor "none"
		{vision "none"}
	}
	{visor "hearing"
		{vision "noise_detection"}
		{bone "hearing_bone"}
	}
}

{Skeleton
	{bone "hearing_bone"
		{Position 0 0 70}
	}
}

{extender "inventory"
	{box
		{Size 9 12}
		{Weight 15000}
		{item "can" 2}
		{item "repair_kit" 10}
	}
}

{extender "talk"
	{talker "tank"}
}
{able "talk"}

{Chassis "track"
	; left track must be first
	{FuelBag
		{volume 2500 }	;// liters
		{rate   10 }	;// liters per kilometer
		{remain 2500 }
		{fuel "fuel"}
	}
}

("basic_armor" args 20)

("body" repair(130))
("engine" repair(45))
("tracks" repair(30) thickness(50))


("general_durability" body(250) engine(150) turret(150) mantlet(150) gun(150) track(150) ammo(120))

{perks {blastwave_modifier 6.0}}

;---------MACE USSR SMOKE BARRELS COMPONENTS
("barrel1_ammo" repair(25) thickness(1));--MACE
("barrel2_ammo" repair(25) thickness(1));--MACE
("smoke1" repair(25) thickness(20));--MACE
("smoke2" repair(25) thickness(20));--MACE
;---------MINE WANZE COMPONENTS
("mine" repair(35) thickness(20));--MACE
;---------MACE CHAR C2 FUEL COMPONENTS
("fuel_tank1" repair(25) thickness(22));--MACE
("fuel_tank2" repair(25) thickness(22));--MACE
("fuel_tank3" repair(25) thickness(22));--MACE
("fuel_tank4" repair(25) thickness(22));--MACE
("fuel_tank5" repair(25) thickness(22));--MACE
("fuel_tank6" repair(25) thickness(22));--MACE
("fuel_tank7" repair(25) thickness(22));--MACE
;---------MACE CHAR C2 UPPER EXHAUST COMPONENTS
("exhaust_body" repair(30) thickness(22));--MACE
;---------MACE M2 FUEL COMPONENTS
("m2_fuel" repair(30) thickness(3.5));--MACE

(define "accuracy_by_motion" ;  spreading depending on the speed of "body", "gun" volumes
	{AccuracyByMotion
        {MaxLinearSpeed %max_linear}               ;km/h
        {ByLinearSpeed %accuracy_by_linear}
        {MaxAngularSpeed %max_angular}             ;deg/s
        {ByAngularSpeed %accuracy_by_angular}
        {DisorderTime %disorder_time}              ;s
        {OrderTime %order_time}                    ;s
    }
)

(define "abm_low"
    ("accuracy_by_motion"
        max_linear(7) accuracy_by_linear(0.3)
        max_angular(4) accuracy_by_angular(0.4)
        disorder_time(1.0) order_time(2.0)
    )
)

