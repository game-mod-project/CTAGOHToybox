(define "components_tank"
    {component "body"
        {RepairTime (* %repair 100)}
        {tags "mover" "noDestroyedView"}
    }
    {component "internal_components"
        {RepairTime (* %repair 75)}
        {tags "mover" "noDestroyedView"}
    }
    {component "engine"
        {RepairTime (* %repair 50)}
    }
    {component "transmission"
        {RepairTime (* %repair 50)}
        {tags "mover" "noDestroyedView"}
    }
    {component "turret"
        {RepairTime (* %repair 75)}
    }
    {component "turret_drive"
        {RepairTime (* %repair 35)}
        {tags "noDestroyedView"}
    }
    {component "vertical_drive"
        {RepairTime (* %repair 25)}
        {tags "noDestroyedView"}
    }
    {component "gun"
        {RepairTime (* %repair 35)}
    }
    {component "gun_breech"
        {RepairTime (* %repair 30)}
        {tags "noDestroyedView"}
    }
    {component "trackleft"
        {RepairTime (* %repair 25)}
    }
    {component "trackright"
        {RepairTime (* %repair 25)}
    }
)

(define "locomotion"
    {MaxSpeed       25 }
    {StartTime      6  }
    {TurnTime       5  }
    {TurnStart      0.8} 
    {BrakeTime      0.6}
    {StopTime       1  } 
    {TurnRadius     5  } 
    {TurnStop       0.5} 
    {Gears 0.2 0.3 0.5 0.7 1.0}
    {RearGears 0.2 0.5} 
    {GearSwitchDelay 2.0}  
)

(define "armor_mantlet"
    {volume "mantlet"
        {tags "mantlet"}
        {component "mantlet"}
    }
    {armor
        {setting "mantlet"
            {thickness %t}
            {volumes "mantlet*"}
		{threshold
			{pierce
				{value 20}
			}
		}
        }
    }
)

(define "armor_spa_mantlet"
    {volume "mantlet"
        {tags "mantlet"}
        {component "mantlet"}
    }
    {armor
        {setting "mantlet"
            {thickness %t}
            {volumes "mantlet"}
		{threshold
			{pierce
				{value 20}
			}
		}
        }
    }
)

(define "armor_engine"
    {armor
        {setting "engine"
            {thickness %t}
            {volumes "engine*"}
        }
    }
)

(define "armor_tank" ; armor system details you will find at "set/interaction_entity/tank.inc"
    {armor
        {setting "track"
            {thickness %t}
            {durability
                {blast
                    {koef (* %dur 2.5)}
                }
                {pierce
                    {value 1000}
                }
            }
            {threshold
                {blast
                    {value %track_b}
                }
            }
            {volumes "track*"}
            {whole_wound}
        }
        {setting "turret"
            {thickness %tur}
            {durability
                {pierce
                    {koef %pierce_dur}
                }
            }
            {threshold
                {blast
                    {koef  0.8}
                }
            }
            {volumes "turret*"}
        }
        {setting "gun"
            {thickness %gun}
            {durability
                {blast  {koef 3}}
                {pierce {koef 3}}
            }
            {threshold
                {blast
                    {value 15}
                }
                {pierce
                    {value 12}
                }
            }
            {volumes "gun*"}
        }
        {setting "body"
            {thickness %bod}
            {durability
                {blast
                    {koef %dur}
                }
        		{pierce
                    {koef %pierce_dur}
                }
            }
            {threshold
                {blast
                    {koef %thr}
                }
            }
            {volumes "body*"}
        }
        {setting "engine"
            {thickness %en}
			{durability
                {blast
                    {koef %dur}
                }
            }
            {threshold
                {blast
                    {koef %thr}
                }
            }
            {volumes "engine*"}
        }
	}
)

