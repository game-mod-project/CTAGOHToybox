	}

	; Pzgr.39
	("penetration_short" shell(ap) range(200) a(65) b(53) c(43) d(35) e(21))

	; Pzgr.40
	("penetration_short" shell(apcr) range(200) a(83) b(46) c(28) d(13) e(6))


	("accuracy_direct_auto" r1(0.8) range_ap(200) range_he(200) range_heat(200))

	{parameters "he"										; Sprgr.
		(mod "mp" {unlimitedRangeTPC 1})	;// unrestricts range in TPC/FPC for shooting at aircraft
		{FalloffStrength 0}
	}
