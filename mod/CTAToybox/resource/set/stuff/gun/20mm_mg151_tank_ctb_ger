;_________________________________________
; German Aircraft Autocannon
;=========================================


{from "pattern gun"			; on tanks
	{filling "bulletger_20_auto" 120} ;200 bullet_20_auto aphe 
	{fireSound "cannon/s1/d1/Shared/Autocannon_20to30mm/"}
	{fireSoundclose "cannon/s1/1p/Shared/Autocannon_20to30mm/"}
	{reloadSound "interior/large/auto_reload_interior"}
	("range_autocannon_12-20")
	{cursor "ironsights/aa"}
	{calibre 20}

	("fire rate" rpm(600)) ;1040
	("reload time" seconds(18)) ;16

	("velocity m/s" ap(700) apcr(990) he(840) heat(1))
	("armor health" damage(30))

	;{parameters "aphe" 										;
	;	("penetration" a(28) b(19) c(16) d(12) e(7))
	;}

	{burst
		{short 10 0.70}			;// short burst shots on long distance, rand (+-)shots
		{long 20 0.95}				;// long burst shots on short distance, rand (+-)shots
		{rangeKoef 0.80}		;// rangeKoef * aimRange = max long burst distance
	}

	; Pzgr.39
	("penetration_short" shell(ap) range(160) a(45) b(33) c(23) d(15) e(11))

	; Pzgr.40
	("penetration_short" shell(apcr) range(160) a(63) b(26) c(8) d(3) e(1))

	{parameters "he"										; Sprgr.
		{range 160 160}
		(mod "mp" {unlimitedRangeTPC 1})	;// unrestricts range in TPC/FPC for shooting at aircraft
	}

	("accuracy_direct" r1(0.75) range_ap(160) range_he(160) range_heat(160))
}
