	("88_ger_slope_multipliers")

	("penetration_long" shell(apcbche) range(260) a(237) b(220) c(200) d(180) e(165))

	("penetration_long" shell(apcr) range(260) a(290) b(270) c(245) d(220) e(195))
	{parameters "apcr"
		("large_apcr_slope_multiplier")
	}
	
	("penetration_long" shell(heat) range(260) a(100) b(100) c(100) d(100) e(100))

	("accuracy_direct" r1(0.65) range_ap(260) range_he(260) range_heat(260))

	{parameters "he"										; SPgGr.
		(mod "mp" {unlimitedRangeTPC 1})	;// unrestricts range in TPC/FPC for shooting at aircraft
		{FalloffStrength 0}
	}
}