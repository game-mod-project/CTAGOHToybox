		("large_apcr_slope_multiplier")
	}
	; Gr.39 Hl
	("penetration_long" shell(heat) range(270) a(110) b(110) c(110) d(110) e(110))

	("accuracy_direct" r1(0.65) range_ap(270) range_he(270) range_heat(270))

	{parameters "he"										; SPgGr.
