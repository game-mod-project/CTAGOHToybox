	("penetration_long" shell(apcbche) range(270) a(249) b(219) c(187) d(156) e(136))

	; Pzgr. ;early war Flak ammo through mid 1942
	("penetration_long" shell(apcbche2) range(270) a(123) b(116) c(108) d(100) e(93))

	; Pzgr.40
	("penetration_long" shell(apcr) range(270) a(291) b(272) c(242) d(213) e(187))
