;/*-------------------------------------- AMMUNITION SETTINGS-------------------------------------*/


(define "minimum_range_short"
	{possibleDamageRadius 20}
)

(define "minimum_range_medium"
	{possibleDamageRadius 25}
)

(define "minimum_range_heavy"
	{possibleDamageRadius 30}
)

(define "he_light"
	{detonationThickness 0.5}
	("minimum_range_short")
)

(define "he_medium"
	{detonationThickness 0.5}
	("minimum_range_medium")
)

(define "he_heavy"
	{detonationThickness 0.5}
	("minimum_range_heavy")
)

