; Soviet Light Aerial Rocket Launcher
;=========================================


{from "pattern reactive"		; "IL-2"
	{tag "gun"}
	{filling "ammo 55mm_r4m" 48}
	{fillingVisible "rocket"}
	{fireSound "reactive/rocket_burst/"}
	{inventory {noView}}
	{calibre 55}

	{spreading
		{SpreadRadius 4}
		{SpreadXYRatio 5}
		{SpreadYadjust 0.1}
		{radiusFunction
			1		0.1
			350		0.1
			500		0.1
		}
	}

	{Automatic}
	{burst
		{min 48}
		{noaiming}
	}

	{range 1 300}
	("fire rate" rpm(750))
	("reload time" seconds(20))
	("velocity" mps(520))
	("aerial gravity")
}