					{terms
						{"1.event" {id "ctb_e_god_on"}}
					}
				}
				{actions
					{"set_i" {var "ctb_god$"} {op "="} {value 1}}
					{"event" {event "ctb_e_god_on"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_god_on"}}
				}
			}
			{"ctb_e_god_off"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_god_off"}}
					}
				}
				{actions
					{"set_i" {var "ctb_god$"} {op "="} {value 0}}
					{"entity_state"
						{selector
							{source advanced}
							{group
								{include
									{state {state user_control}}
								}
								{exclude
									{tag {tag "hidden"}}
								}
							}
						}
						{impregnability disabled}
					}
					{"event" {event "ctb_e_god_off"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_god_off"}}
				}
			}
			{"ctb_e_vet_all"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_vet_all"}}
					}
				}
				{actions
					{"actor_state"
						{selector
							{source advanced}
							{group
								{include
									{state {state user_control}}
								}
								{exclude
									{tag {tag "hidden"}}
								}
							}
						}
						{human {veterancy 8}}
					}
					{"event" {event "ctb_e_vet_all"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_vet_all"}}
				}
			}
			{"ctb_e_vet_one"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_vet_one"}}
					}
				}
				{actions
					{"actor_state"
						{selector
							{source advanced}
							{group
								{include
									{state {state user_control}}
									{prop {prop human}}
								}
								{exclude
									{tag {tag "hidden"}}
									{state {state dead}}
								}
							}
							{amount 12}
							{sort {type waypoint} {wpid "ctb_target"}}
						}
						{human {veterancy 8}}
					}
					{"event" {event "ctb_e_vet_one"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_vet_one"}}
				}
			}
			{"ctb_e_maxvet_on"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_maxvet_on"}}
					}
				}
				{actions
					{"set_i" {var "ctb_maxvet$"} {op "="} {value 1}}
					{"event" {event "ctb_e_maxvet_on"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_maxvet_on"}}
				}
			}
			{"ctb_e_maxvet_off"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_maxvet_off"}}
					}
				}
				{actions
					{"set_i" {var "ctb_maxvet$"} {op "="} {value 0}}
					{"event" {event "ctb_e_maxvet_off"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_maxvet_off"}}
				}
			}
			{"ctb_e_del_one"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_del_one"}}
					}
				}
				{actions
					{"delete"
						{selector
							{source advanced}
							{group
								{include
									{prop {prop human}}
								}
								{exclude
									{tag {tag "hidden"}}
									{state {state inactive}}
								}
							}
							{group
								{include
									{prop {prop vehicle}}
								}
								{exclude
									{tag {tag "hidden"}}
									{state {state inactive}}
								}
							}
							{amount 1}
							{sort {type waypoint} {wpid "ctb_target"}}
						}
					}
					{"event" {event "ctb_e_del_one"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_del_one"}}
				}
			}
			{"ctb_e_del_air"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_del_air"}}
					}
				}
				{actions
					{"delete"
						{selector
							{source advanced}
							{group
								{select
									{tag {tag "ctb_air"}}
								}
								{exclude
									{tag {tag "hidden"}}
									{state {state inactive}}
								}
							}
						}
					}
					{"event" {event "ctb_e_del_air"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_del_air"}}
				}
			}
			{"ctb_e_wrecks"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_wrecks"}}
					}
				}
				{actions
					{"delete"
						{selector {tag _bleedout_} {type human}}
					}
					{"delete"
						{selector
							{source advanced}
							{group
								{select
									{tag {tag "no_scavenge"}}
									{tag {tag "destroyed"}}
								}
								{include
									{prop {prop vehicle}}
								}
							}
						}
					}
					{"event" {event "ctb_e_wrecks"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_wrecks"}}
				}
			}
			{"ctb_e_root"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_root"}}
					}
				}
				{actions
					{"if"
						{condition {type cmp_i} {var "ctb_open$"} {op "=="} {value 1}}
						{"reinforcement" {operation hide} {name "ctb_s*"}}
						{"set_i" {var "ctb_open$"} {op "="} {value 2}}
					}
					{"if"
						{condition {type cmp_i} {var "ctb_open$"} {op "=="} {value 0}}
						{"call" {function "ctb_home"}}
					}
					{"if"
						{condition {type cmp_i} {var "ctb_open$"} {op "=="} {value 2}}
						{"set_i" {var "ctb_open$"} {op "="} {value 0}}
					}
					{"event" {event "ctb_e_root"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_root"}}
				}
			}
			{"ctb_e_home"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_home"}}
					}
				}
				{actions
					{"call" {function "ctb_home"}}
					{"event" {event "ctb_e_home"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_home"}}
				}
			}
		}
		{waypoints "ctb_waypoints"
			{"ctb_wait_inf" {position 77777 77777 0} {radius 1}}
			{"ctb_wait_veh" {position 88888 88888 0} {radius 1}}
			{"ctb_place" {position -9553.58 7012.8 0} {radius 1}}
			{"ctb_target" {position -9546.01 7248.6 0} {radius 1}}
			{"ctb_wp_air" {position -9546.01 7248.6 0} {radius 1}}
			{"ctb_wp_arty_s" {position -9546.01 7248.6 0} {radius 20}}
			{"ctb_wp_arty_m" {position -9546.01 7248.6 0} {radius 40}}
			{"ctb_wp_arty_l" {position -9546.01 7248.6 0} {radius 70}}
		}
	}
