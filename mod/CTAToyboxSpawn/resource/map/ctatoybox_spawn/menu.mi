							{source advanced}
							{group
								{include
									{prop {prop human}}
								}
								{exclude
									{tag {tag "hidden"}}
									{state {state inactive}}
								}
							}
							{group
								{include
									{prop {prop vehicle}}
								}
								{exclude
									{tag {tag "hidden"}}
									{state {state inactive}}
								}
							}
							{amount 1}
							{sort {type waypoint} {wpid "ctb_target"}}
						}
					}
					{"event" {event "ctb_e_del_one"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_del_one"}}
				}
			}
			{"ctb_e_del_air"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_del_air"}}
					}
				}
				{actions
					{"delete"
						{selector
							{source advanced}
							{group
								{select
									{tag {tag "ctb_air"}}
								}
								{exclude
									{tag {tag "hidden"}}
									{state {state inactive}}
								}
							}
						}
					}
					{"event" {event "ctb_e_del_air"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_del_air"}}
				}
			}
			{"ctb_e_wrecks"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_wrecks"}}
					}
				}
				{actions
					{"delete"
						{selector {tag _bleedout_} {type human}}
					}
					{"delete"
						{selector
							{source advanced}
							{group
								{select
									{tag {tag "no_scavenge"}}
									{tag {tag "destroyed"}}
								}
								{include
									{prop {prop vehicle}}
								}
							}
						}
					}
					{"event" {event "ctb_e_wrecks"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_wrecks"}}
				}
			}
			{"ctb_e_root"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_root"}}
					}
				}
				{actions
					{"call" {function "ctb_home"}}
					{"event" {event "ctb_e_root"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_root"}}
				}
			}
			{"ctb_e_home"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_home"}}
					}
				}
				{actions
					{"call" {function "ctb_home"}}
					{"event" {event "ctb_e_home"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_home"}}
				}
			}
		}
		{waypoints "ctb_waypoints"
			{"ctb_wait_inf" {position 77777 77777 0} {radius 1}}
			{"ctb_wait_veh" {position 88888 88888 0} {radius 1}}
			{"ctb_place" {position -9553.58 7012.8 0} {radius 1}}
			{"ctb_target" {position -9546.01 7248.6 0} {radius 1}}
		}
	}
