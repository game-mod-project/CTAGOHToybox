				{condition
					{terms
						{"1.event" {id "ctb_e_s11"}}
					}
				}
				{actions
					{"reinforcement" {operation hide} {name "ctb_s*"}}
					{"reinforcement" {operation show} {name "ctb_s11_*"}}
					{"event" {event "ctb_e_s11"} {mode reset} {delay 0}}
					{"trigger" {name "ctb_e_s11"}}
				}
			}
			{"ctb_e_q1"
				{autoreset}
				{condition
					{terms
						{"1.event" {id "ctb_e_q1"}}
					}
				}
				{actions
					{"loop" 1
						{"actor_to_waypoint"
							{selector
								{source advanced}
								{group
									{select
										{tag {tag "ctb_h1"}}
									}
									{exclude
										{tag {tag "un"}}
									}
								}
							}
							{waypoint "ctb_wait_inf"}
							{clone}
							{approach teleport}
						}
					}
					{"loop" 1
						{"actor_to_waypoint"
							{selector
								{source advanced}
								{group
									{select
										{tag {tag "ctb_h2"}}
									}
									{exclude
										{tag {tag "un"}}
									}
								}
							}
							{waypoint "ctb_wait_inf"}
							{clone}
							{approach teleport}
						}
					}
					{"loop" 8
						{"actor_to_waypoint"
							{selector
								{source advanced}
								{group
									{select
										{tag {tag "ctb_h3"}}
									}
									{exclude
										{tag {tag "un"}}
									}
								}
							}
							{waypoint "ctb_wait_inf"}
							{clone}
							{approach teleport}
