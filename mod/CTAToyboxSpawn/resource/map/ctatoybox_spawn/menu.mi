		{triggers
			{"ctb_start"
				{condition }
				{actions
					{"delay" {time 1}}
					{"if"
						{condition {type cmp_i} {var "ctb_campaign$"} {op "=="} {value 0}}
						{"switch"
							{"case"
								{condition {type side} {side ger}}
								{"set_i" {var "ctb_nation_side$"} {op "="} {value 1}}
							}
							{"case"
								{condition {type side} {side rus}}
								{"set_i" {var "ctb_nation_side$"} {op "="} {value 2}}
							}
							{"case"
								{condition {type side} {side usa}}
								{"set_i" {var "ctb_nation_side$"} {op "="} {value 3}}
							}
							{"case"
								{condition {type side} {side eng}}
								{"set_i" {var "ctb_nation_side$"} {op "="} {value 4}}
							}
							{"case"
								{condition {type side} {side fin}}
								{"set_i" {var "ctb_nation_side$"} {op "="} {value 5}}
							}
							{"case"
								{condition {type side} {side jap}}
								{"set_i" {var "ctb_nation_side$"} {op "="} {value 6}}
							}
							{"default"
								{"set_i" {var "ctb_nation_side$"} {op "="} {value 1}}
							}
						}
						{"set_i" {var "ctb_nation$"} {op "="} {value 0}}
					}
					{"if"
						{condition {type cmp_i} {var "ctb_campaign$"} {op "=="} {value 0}}
						{"if"
							{condition {type cmp_i} {var "ctb_nation_side$"} {op "=="} {value 1}}
							{"set_i" {var "ctb_nation$"} {op "="} {value 1}}
						}
					}
					{"if"
						{condition {type cmp_i} {var "ctb_campaign$"} {op "=="} {value 0}}
						{"if"
							{condition {type cmp_i} {var "ctb_nation_side$"} {op "=="} {value 2}}
							{"set_i" {var "ctb_nation$"} {op "="} {value 2}}
						}
					}
					{"if"
						{condition {type cmp_i} {var "ctb_campaign$"} {op "=="} {value 0}}
						{"if"
							{condition {type cmp_i} {var "ctb_nation_side$"} {op "=="} {value 3}}
							{"set_i" {var "ctb_nation$"} {op "="} {value 3}}
						}
					}
					{"if"
						{condition {type cmp_i} {var "ctb_campaign$"} {op "=="} {value 0}}
						{"if"
							{condition {type cmp_i} {var "ctb_nation_side$"} {op "=="} {value 4}}
							{"set_i" {var "ctb_nation$"} {op "="} {value 4}}
						}
					}
					{"if"
						{condition {type cmp_i} {var "ctb_campaign$"} {op "=="} {value 0}}
						{"if"
							{condition {type cmp_i} {var "ctb_nation_side$"} {op "=="} {value 5}}
							{"set_i" {var "ctb_nation$"} {op "="} {value 5}}
						}
					}
					{"if"
						{condition {type cmp_i} {var "ctb_campaign$"} {op "=="} {value 0}}
						{"if"
							{condition {type cmp_i} {var "ctb_nation_side$"} {op "=="} {value 6}}
							{"set_i" {var "ctb_nation$"} {op "="} {value 6}}
						}
					}
					{"if"
						{condition {type cmp_i} {var "ctb_campaign$"} {op "=="} {value 1}}
						{"set_i" {var "ctb_owner$"} {op "="} {value 1}}
					}
					{"reinforcement" {operation show} {name "ctb_root"}}
					{"if"
						{condition {type cmp_i} {var "ctb_campaign$"} {op "=="} {value 0}}
						{"reinforcement" {operation hide} {name "ctb_s*"}}
						{"reinforcement" {operation show} {name "ctb_s2_*"}}
						{"set_i" {var "ctb_open$"} {op "="} {value 1}}
					}
				}
			}
			{"ctb_keep_menu"
