;SDL

;===================================
;        INSTRUCTIONS    
;===================================

; In this file onee configures the humans which are spawned in vehicles or squads
; The humans have a CP and cost associated with them which collectively add up for the final squad value
; Check ../settings_inf.set for the global defines for CP, capture weight (CW), score, etc.

;===================================
;        PRICING CHART	       
;===================================

; // Standard prices below are for tier2 infantry

;Shotgun	            = 5
;Type 13/18		        = 6
;Type 99s               = 8
;Type 38s               = 8
;C96s 10                = 8
;C96s 20                = 9
;rifle grenade 	        = +5
;Type 100 early	        = 9
;Type 100 late	        = 10
;MP 34       	        = 10
;SiG 1920   	        = 10
;Type 2/1 SMG		    = 10
;Type 2 mukden          = 10
;Type hei 5 	        = 13
;Type hei 10	        = 13
;Type 4     	        = 13
;Tokyo      	        = 13
;Type hei auto 20       = 18
;Type hei auto          = 20
;Type 11 LMG            = 25
;Type 92 LMG            = 25
;Type 96 LMG             = 25
;Type 99 LMG             = 25
;Type 98/1 and 97/89 LMG = 35
;type 10/27              = 35
;type 89                 = 40
;miner 			        = 40
;engineer		        = 50
;any flamer		        = 60

; // price modifiers (If not tier2)
;tier 0 		= -3, MG -10
;tier 1 		= -1, MG -10
;tier 1 vet 	= 0, MG 0
;tier 2 vet		= +2, MG +5
;tier 3 		= +5, MG +10
;tier 3 vet 	= +8, MG +15
;tier 4 		= +10, MG +20
;tier 4 vet 	= +13, MG +25


