;SDL

;===================================
;        INSTRUCTIONS    
;===================================

; In this file onee configures the humans which are spawned in vehicles or squads
; The humans have a CP and cost associated with them which collectively add up for the final squad value
; Check ../settings_inf.set for the global defines for CP, capture weight (CW), score, etc.

;===================================
;        PRICING CHART	       
;===================================

; // Standard prices below are for tier2 infantry
;m12			= 5
;M50 Reising 12	= 7
;M50 Reising 30	= 8
;m1903 			= 8
;thompson 20	= 9
;thompson 30/m3 = 10
;thompson 50/m3 = 12
;carbine 		= 10
;garand 		= 12
;Johnson Rifle	= 12
;1918 bar		= 18
;1918a1 bar		= 19
;1918a2 bar		= 20
;Lewis Gun	    = 25
;Johnson LMG	= 25
;m1919a6 belt	= 40
;rifle grenade	= +5
;marksman 		= +2
;any % pzfaust 	= +0
;repair skill	= +10
;any Mortar 	= +30
;any bazooka 	= +40
;any flamer		= 60
;engineer		= 50
;miner 			= 40

; // price modifiers (If not tier2)
;tier 0 		= -3, MG -10
;tier 1 		= -1, MG -10
;tier 1 vet 	= 0, MG 0
;tier 2 vet		= +2, MG +5
;tier 3 		= +5, MG +10
;tier 3 vet 	= +8, MG +15
;tier 4 		= +10, MG +20
;tier 4 vet 	= +12, MG +25

;===================================
;        BREED DECLARATIONS       
